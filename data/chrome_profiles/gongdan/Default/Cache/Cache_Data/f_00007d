pForm.rMateChartClear = function(chartObj) {
    if (chartObj == null)
        return;
        
    chartObj.removeEventHandler("onloadcompleted", this.rMateChart_DocumentComplete);
    chartObj.removeEventHandler("onusernotify", this.rMateChart_UserNotify);
    chartObj.destroy();
    chartObj = null;
}

