        		}
        	}
        };



        this.Calendar_canchange = function(obj,e)
        {
        	if(this._notNull == "true") {
        		var sDate = e.postvalue+"";
        		if(!this.fn_isDate(sDate)) {
        			this.alert("유효한 날짜가 아니거나 필수입력값입니다.");
        			obj.setFocus();
        			return false;
        		}
        	} else {
        		var sDate = e.postvalue+"";
        		if ( this.fn_isNull(sDate) ) return true;
        	}

        	if(!this.fn_isNull(this._minDate)) {
        		if(this._caltype == "D") {
        			if(e.postvalue < this._minDate || e.postvalue > this._maxDate) {
        				this.alert("허용범위 : [" + this._minDate + " ~ " + this._maxDate + "]\n\n입력한 날짜가 허용범위를 벗어났습니다");
        				obj.setFocus();
        				return false;
        			}
        		} else {

        			var eValue = new String(e.postvalue).substr(0,6);
        			var minDate = new String(this._minDate).substr(0,6);
        			var maxDate = new String(this._maxDate).substr(0,6);

        			if(eValue < minDate || eValue > maxDate) {
        				this.alert("허용범위 : [" + minDate + " ~ " + maxDate + "]\n\n입력한 날짜가 허용범위를 벗어났습니다");
        				obj.setFocus();
        				return false;
        			}
        		}
        	}
        };


        this.fn_isDate = function(sDate) {
        	var nYear   = parseInt(sDate.substring(0,4), 10);
        	var nMonth  = parseInt(sDate.substring(4,6), 10);
        	var nDate   = parseInt(sDate.substring(6,8), 10);

        	if( this.fn_isNull(sDate) )								return false;
        	if( sDate.length != 8 ) 								return false;
        	if( nYear < 1800 || nYear > 3000 ) 						return false;
        	if( nMonth < 1 || nMonth > 12 ) 						return false;
        	if( nDate < 1 || nDate > this.gfn_getLastDateNum(sDate)) 	return false;

        	return true;
        };


