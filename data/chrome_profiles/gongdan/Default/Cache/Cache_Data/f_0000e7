        /*======================================================================================*
         * 2.Form Area
         *======================================================================================*/
        /*--------------------------------------------------------------------------------------*
         * Method : singleCalendar_onload
         * Desc   : 달력 로드
         *--------------------------------------------------------------------------------------*/
        this.singleCalendar_onload = function(obj,e)
        {
        	var oParentDiv = this.parent;
        	this.oParentForm = oParentDiv.parent;

        	//설정 초기화
        	this._caltype           = this.gfn_nvl(oParentDiv._caltype,"");
        	this._binddataset		= this.gfn_nvl(oParentDiv._binddataset,"");
        	this._datecolumn     	= this.gfn_nvl(oParentDiv._datecolumn,"");
        	this._requiredmark		= this.gfn_nvl(oParentDiv._requiredmark,"");
        	this._readonly			= this.gfn_nvl(oParentDiv._readonly,"");
        	this._notNull			= this.gfn_nvl(oParentDiv._notNull,"");
        	this._beforeYear		= this.gfn_nvl(oParentDiv._beforeYear,"");

        	this._minDate			= this.gfn_nvl(oParentDiv._minDate,"19000101");
        	this._maxDate			= this.gfn_nvl(oParentDiv._maxDate,"29001231");

        	if(!this.fn_isNull(oParentDiv.validate))
        	{
        		this.cal_begin.validate = oParentDiv.validate;
        	}

        	if(this.fn_isNull(this._caltype))
        	{
        		this._caltype = "D";
        	}

        	this.fn_calendarInit();
        	this.fn_calendarInitValue();
        	this.fn_checkProperties();

        	if(!this.fn_isNull(this._binddataset) && !this.fn_isNull(this._datecolumn))
        	{
        		this.fn_bindCalendar();
        	}

        	this.cal_begin.set_cssclass(this.cal_begin.cssclass + "," + this._requiredmark);

        	if(this._readonly == "true") {
        		this.cal_begin.set_readonly(true);
        		this.btn_calOpen.set_enable(false);
        	}

        	this.fn_setStyle(this);
        };

        this.singleCalendar_onkillfocus = function(obj,e) {
        	this.fn_checkMixMax(this.cal_begin.value);
        };

        this.fn_checkMixMax = function(sDate)
        {
        	if ( this.fn_isNull(sDate) ) return true;

        	if(!this.fn_isNull(this._minDate) || !this.fn_isNull(this._maxDate)) {
        		if(this._caltype == "D") {
        			if(sDate < this._minDate || sDate > this._maxDate) {
        				this.alert("허용범위 : [" + this._minDate + " ~ " + this._maxDate + "]\n\n입력한 날짜가 허용범위를 벗어났습니다");
        				this.fn_dayCalendarOpen();
        				return false;
        			}
        		} else {
        			var sValue = (sDate).toString().substr(0,6);
        			var minDate = (this._minDate).toString().substr(0,6);
        			var maxDate = (this._maxDate).toString().substr(0,6);
        			if(sValue < minDate || sValue > maxDate) {
        				this.alert("허용범위 : [" + minDate + " ~ " + maxDate + "]\n\n입력한 날짜가 허용범위를 벗어났습니다");
        				this.fn_monthCalendarOpen();
        				return false;
        			}
        		}
        	}

        	return true;
        };

        /*--------------------------------------------------------------------------------------*
         * Method : fn_calendarInit()
         * Desc   : 초기화
         *--------------------------------------------------------------------------------------*/
        this.fn_calendarInit = function()
        {
        	if(this._caltype == "D") {
        		this.cal_begin.set_dateformat("yyyy-MM-dd");
        		this.cal_begin.set_editformat("yyyy-MM-dd");
        	} else {
        		this.cal_begin.set_dateformat("yyyy-MM");
        		this.cal_begin.set_editformat("yyyy-MM");
        	}

        	if(this._readonly == "true") {
        		this.cal_begin.set_readonly(true);
        		this.btn_calOpen.set_enable(false);
        	} else {
        		this.cal_begin.set_readonly(false);
        		this.btn_calOpen.set_enable(true);
        	}

        };

        this.fn_calendarInitValue = function()
        {
        	this.cal_begin.set_value(this.fn_getToday());
        };



        /*--------------------------------------------------------------------------------------*
         * Method : fn_setStyle
         * Desc   : style 및 position 셋팅
         *--------------------------------------------------------------------------------------*/
        this.fn_setStyle = function(oForm)
        {
        	var nHeight = this.getOffsetHeight();
        	var nWidth = this.getOffsetWidth();
        	var nBtnWidth = this.btn_calOpen.getOffsetWidth();


        	this.cal_begin.setOffsetHeight(nHeight);
        	this.cal_begin.setOffsetWidth(nWidth);

        	this.btn_calOpen.setOffsetHeight(nHeight);
        	this.btn_calOpen.setOffsetLeft(nWidth -this.btn_calOpen.getOffsetWidth());
        	this.btn_calOpen.setOffsetWidth(nBtnWidth);
        };

        /*======================================================================================*
         * 3.Transaction Area
         *======================================================================================*/


        /*======================================================================================*
         * 4.User function Area
         *======================================================================================*/
        /*--------------------------------------------------------------------------------------*
         * Method : fn_checkProperties
         * Desc   : 바인딩 관련 Properties 체크
         *--------------------------------------------------------------------------------------*/
        this.fn_checkProperties = function()
        {
        	if(!this.fn_isNull(this._binddataset))
        	{
        		if(this.fn_isNull(this._datecolumn)) trace("_datecolumn을(를) 입력하세요");
        	}
        };

        /*--------------------------------------------------------------------------------------*
         * Method : fn_isNull
         * Desc   : Null 체크
         *--------------------------------------------------------------------------------------*/
        this.fn_isNull = function(sValue)
        {
        	if( new String(sValue).valueOf() == "undefined")
        		return true;
        	if( sValue == null )
        		return true;
        	if( ("x"+sValue == "xNaN") && ( new String(sValue.length).valueOf() == "undefined" ) )
        		return true;
        	if( sValue.length == 0 )
        		return true;
        	return false;
        };

        /*--------------------------------------------------------------------------------------*
         * Method : fn_bindCalendar
         * Desc   : 바인딩 셋팅
         *--------------------------------------------------------------------------------------*/
        this.fn_bindCalendar = function()
        {
        	var oBindBegin = new BindItem("bind_beginDate", "cal_begin", "value", this._binddataset, this._datecolumn);
        	this.addChild("bind_beginDate", oBindBegin);
        	oBindBegin.bind();
        };

        /*--------------------------------------------------------------------------------------*
         * Method : fn_getToday
         * Desc   : 오늘날짜 구하기
         *--------------------------------------------------------------------------------------*/
        this.fn_getToday = function()
        {
        	var objDate = new Date();
        	var strToday  = objDate.getFullYear().toString();
        		strToday += (objDate.getMonth()+1).toString().padLeft(2, "0");
        		strToday += objDate.getDate().toString().padLeft(2, "0");
        	return strToday ;
        };

        /*======================================================================================*
         * 5.Event Area
         *======================================================================================*/
        /*--------------------------------------------------------------------------------------*
         * Method : btn_calOpen_onclick
         * Desc   : 달력열기
         *--------------------------------------------------------------------------------------*/
        this.btn_calOpen_onclick = function(obj,e)
        {
        	if(this._caltype == "D") {
        		this.fn_dayCalendarOpen();
        	} else if (this._caltype == "M") {
        		this.fn_monthCalendarOpen();
        	} else {
        		trace("_caltype이 잘못지정 되었습니다. \n_caltype : D (일력)\n_caltype : M (월력)");
        		trace("파일을 Refresh 하세요");
        	}
        	this.cal_begin.setFocus();
        };

        /*--------------------------------------------------------------------------------------*
         * Method : fn_dayCalendarOpen
         * Desc   : 일력열기
         *--------------------------------------------------------------------------------------*/
        this.fn_dayCalendarOpen = function()
        {
        	if(this.fn_isNull(this.cal_begin.value)) {
        		if(this.fn_isNull(this._beforeYear)) {
        			this.pdiv_dayCalendar.form.cal_from.set_value(this.fn_getToday());
        		} else {
        			if(!nexacro.isNumeric(this._beforeYear)) {
        				trace("_beforeYear Properties는 0 이상의 정수를 입력하세요");
        				this.pdiv_dayCalendar.form.cal_from.set_value(this.fn_getToday());
        			} else {
        				var nBeforeYear 					= nexacro.toNumber(this._beforeYear);
        				var nBeforeMonth 					= nBeforeYear * 12;
        				this.pdiv_dayCalendar.form.cal_from.set_value(this.gfn_addMonth(this.fn_getToday(),- nBeforeMonth));
        			}
        		}
        	} else {
        		this.pdiv_dayCalendar.form.cal_begin.set_value(this.cal_begin.value);
        		this.pdiv_dayCalendar.form.cal_from.set_value(this.cal_begin.value);
        	}

         	var nX = 0;
         	var nY = this.cal_begin.getOffsetHeight();
        	this.pdiv_dayCalendar.trackPopupByComponent(this.cal_begin, nX, nY);
        };

        /*--------------------------------------------------------------------------------------*
         * Method : fn_monthCalendarOpen
         * Desc   : 월력열기
         *--------------------------------------------------------------------------------------*/
        this.fn_monthCalendarOpen = function()
        {

        	if(this.fn_isNull(this.cal_begin.value)) {
        		if(this.fn_isNull(this._beforeYear)) {
        			var sYYYYMMDD = this.fn_getToday();
        		} else {
        			if(!nexacro.isNumeric(this._beforeYear)) {
        				trace("_beforeYear Properties는 0 이상의 정수를 입력하세요");
        				var sYYYYMMDD = this.fn_getToday();
        			} else {
        				var nBeforeYear 	= nexacro.toNumber(this._beforeYear);
        				var nBeforeMonth 	= nBeforeYear * 12;
        				var sYYYYMMDD = this.gfn_addMonth(this.fn_getToday(),- nBeforeMonth);
        			}
        		}
        	} else {
        		var sYYYYMMDD = this.cal_begin.value;
        	}

        	var sYear	= new String(sYYYYMMDD).substr(0,4);

        	var sYear	= new String(sYYYYMMDD).substr(0,4);
        	this.pdiv_monthCalendar.form.cal_begin.set_value(sYYYYMMDD);
        	this.pdiv_monthCalendar.form.spi_sYear.set_value(sYear);

        	this.fn_setSelectClass(this.pdiv_monthCalendar,new String(sYYYYMMDD).substr(4,2));

         	var nX = 0;
         	var nY = this.cal_begin.getOffsetHeight();
        	this.pdiv_monthCalendar.trackPopupByComponent(this.cal_begin, nX, nY);
        };

        /*--------------------------------------------------------------------------------------*
         * Method : pdiv_dayCalendar_cal_from_onchanged
         * Desc   : 일력클릭
         *--------------------------------------------------------------------------------------*/
