//파일다운로드 callback
pForm._gfn_callbackDownloadFile = function(sSvcId, nErrorCode, sErrorMsg)
{
	var objSvcID = JSON.parse(sSvcId);
	var svcId			= objSvcID.svcId;
	var fileName		= objSvcID.fileName;
	
	//trace("----- sSvcId :"+ svcId + "----- errorcode :"+ nErrorCode + "..... errormsg:"+ sErrorMsg);
	if(nErrorCode < 0 )	return;
	
	//서버에 임시파일 저장 후 파일다운로드 실행
	if(svcId == "filesave" )
	{
		//var sFileUrl = "svcUrl::sample/multipart/downAttachFile.do";
		var sFileUrl = "svcUrl::" + nexacro.getApplication().av_aFileInfo.downloadAttachFile + "?filename=" + encodeURI(fileName);
		//trace("sFileUrl==="+sFileUrl);
		this._comp_fileDownload.set_downloadfilename(fileName);
		this._comp_fileDownload.download(sFileUrl);
	}
	//파일다운로드 실행 후 서버의 임시 파일 삭제(삭제로직 검토중 2018.11.29)
	else if(svcId == "filedelete" )
	{
		this.gfn_msgShow(this, "XITZ0088",["다운로드에 성공"]);//{0}하였습니다.
	}
};

