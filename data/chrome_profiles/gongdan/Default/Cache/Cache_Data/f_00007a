/**---------------------------------------------------------------------------------------
 * Dataset에 BLOB 형태로 존재하는 파일을 다운로드 하게 합니다.
 * @param : dataset  objDsFileInfoList     : 파일정보가 들어있는 데이타셋(ds_fileInfoList)
 * @param : string   nRow                  : ds_fileInfoList에 들어있는 다운로드할 파일의 행번호
 * @retun : 
 * @ 관련함수 : gfn_attachFileDownload()
 * @사용예 : 
 *       this.gfn_attachFileDownload(this.ds_fileInfoList, this.ds_fileInfoList.rowposition);
 *--------------------------------------------------------------------------------------*/
pForm.gfn_attachFileDownload = function(objDsFileInfoList, nRow)
{
	if(this.gfn_isNull(objDsFileInfoList)) 
	{
		trace("파일다운로드 대상 Dataset을 지정하세요");
		return;
	}
	
	this.gfn_initFileDownload();	//초기화(다운로드Component, Dataset생성)

	//임시파일 생성
	var objFileDs = this._ds_fileDownload;
	objFileDs.clearData();
	var nAddRow = objFileDs.addRow();
	var sFileName = objDsFileInfoList.getColumn(nRow,"ATMT_FILE_NM");
	objFileDs.setColumn(nAddRow, "filename", sFileName);
	objFileDs.setColumn(nAddRow, "file", objDsFileInfoList.getColumn(nRow,"ATMT_FILE"));

	var objTrId = { svcId     : "filesave",
					fileName  : sFileName      };
	//var svcUrl = "svcUrl::sample/multipart/saveAttachFile.do";
	var svcUrl = "svcUrl::" + nexacro.getApplication().av_aFileInfo.saveAttachFile;
	var inputds = "ds_download=" + objFileDs.name + ":A";
	var outputds = "";
	var args = "";
	var callback = "_gfn_callbackDownloadFile";

	this.transaction(JSON.stringify(objTrId), svcUrl, inputds, outputds, args, callback);
};

