/**---------------------------------------------------------------------
* 기능 : 문자열 시간(hhmi)에 형식(hh:mi)을 추가하여 반환합니다.
* param  : String strTime : 시간(hhmi)
* Return : String hh:mi   : format time
* 2018.11.07 수/Yi Geon-Jin
----------------------------------------------------------------------*/
pForm.gfn_strTimeFormat = function(strTime){
    if (this.gfn_isEmpty(strTime) || strTime.toString().length != 4) return strTime;
    return strTime.substr(0,2) + ':' + strTime.substr(2);
};
/**---------------------------------------------------------------------
* 기능   : 문자열 시간(yyyymmdd)에 형식(yyyy-mm-dd)을 추가하여 반환합니다.
* param  : String   strTime       : 시간(yyyymmdd)
* Return : String   yyyy-mm-dd    : format date
* 2018.11.07 수/Yi Geon-Jin
----------------------------------------------------------------------*/
pForm.gfn_strDateFormat = function(strDate){
    if (this.gfn_isEmpty(strDate) || strDate.toString().length != 8) return strDate;
    return strDate.substr(0,4) + '-' + strDate.substr(4, 2) + '-' + strDate.substr(6, 2);
};

