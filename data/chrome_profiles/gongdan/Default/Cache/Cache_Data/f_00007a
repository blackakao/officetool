var pForm = nexacro.Form.prototype;
/*--------------------------------------------------------------------------------------*
* 화면정보를 반환한다.
*--------------------------------------------------------------------------------------*/
pForm.gfn_getScreenInfo = function (sPgmId)
{
	var arrRetVal = [];
	var oProgramDs = nexacro.getApplication().gds_program;
	var nRow = oProgramDs.findRow("PGM_ID", sPgmId);
	
	if (nRow > -1) {
		arrRetVal["PROGRAM_ID"]   		= oProgramDs.getColumn(nRow, "PGM_ID");
		arrRetVal["PROGRAM_NAME"]   	= oProgramDs.getColumn(nRow, "PGM_NM");
		arrRetVal["PROGRAM_PATH"]      	= oProgramDs.getColumn(nRow, "PGM_URL");
		arrRetVal["RESULT"]   = true;
	} else {
		this.gfn_msgShow(this,"XWTZ0040"); // 등록된 메뉴ID를 찾을 수 없습니다.
		arrRetVal["RESULT"]   = false;
	}
	
	return arrRetVal;
};

/**------------------------------------------------------------------
* 기능 : Async Popup 생성 및 호출(modal)
* 인수 : 1. objOpener   : Opener
		  2. sPopId      : Popup화면 ChildFrame ID
		  3. sScrId      : Popup화면 ID
		  4. sArgs       : Popup에 전달될 sArgsument - {변수명:'변수값'}
		  5. bIsModal    : Async Popup은 무조건 modal
		  6. nLeft       : Popup Left위치 정보
		  7. nTop        : Popup Top위치 정보
		  8. bResize     : Resize 유무(default false)
		  9. bTitleBar   : TitleBar 유무(default true)
		  10. bStatusBar : StatusBar 유무(default true)
		  11. sPopupTitle : 화면정보와 별도로 Popup Title 설정용
		  12. bWrapForm  : 표준 popup 화면에 Embed 여부(default true)
* Return : object
------------------------------------------------------------------*/
pForm.gfn_showAsyncPopupByID = function(objOpener, sPopId, sScrId, sArgs, bIsModal, nWidth, nHeight, bVscrollbar,
							  nLeft, nTop, bResize, bTitleBar, bStatusBar,
							  sPopupTitle, bWrapForm, sPopupCallback) 
{
	var arrScrInfo = this.gfn_getScreenInfo(sScrId);

	arrScrInfo["PROGRAM_WIDTH"] = nWidth;
	arrScrInfo["PROGRAM_HEIGHT"] = nHeight;

	if (arrScrInfo["RESULT"]) {

		this._gfn_showPopupByURL(objOpener, sPopId, arrScrInfo, sArgs, bIsModal, bVscrollbar,
								nLeft, nTop, bResize, bTitleBar, bStatusBar,
								sPopupTitle, bWrapForm, sPopupCallback);
	}
};
//URL에 정보에 해당하는 팝업호출
pForm.gfn_showAsyncPopupByURL = function(objOpener, sPopId, sScrNm, sURL, nWidth, nHeight, 
							   sArgs, bIsModal, bVscrollbar, nLeft, nTop,
							   bResize, bTitleBar, bStatusBar, bWrapForm, sPopupCallback) 
{
	var arrScrInfo = [];
	arrScrInfo["PROGRAM_ID"]   		= "";
	arrScrInfo["PROGRAM_NAME"]  	= sScrNm;
	arrScrInfo["PROGRAM_PATH"]  	= sURL;
	arrScrInfo["PROGRAM_WIDTH"] 	= nWidth;
	arrScrInfo["PROGRAM_HEIGHT"] 	= nHeight;
	
	// AsyncPopup은 무조건 modal
	bIsModal = true;

	this._gfn_showPopupByURL(objOpener, sPopId, arrScrInfo, sArgs, bIsModal, bVscrollbar,
							nLeft, nTop, bResize, bTitleBar, bStatusBar, null,
							bWrapForm, sPopupCallback);
};

/**------------------------------------------------------------------
* 기능 : Popup 생성 및 호출(modal & modeless)
* 인수 : 1. objOpener   : Opener
2. sPopId      : Popup화면 ChildFrame ID
3. sScrId      : Popup화면 ID
4. oArgs       : Popup에 전달될 Argsument - {변수명:'변수값'}
5. bIsModal : Popup Modal여부(default false, modeless)
6. nLeft       : Popup Left위치 정보
7. nTop        : Popup Top위치 정보
8. bResize     : Resize 유무(default false)
9. bTitleBar   : TitleBar 유무(default true)
10. bStatusBar : StatusBar 유무(default false)
11. sPopupTitle : 화면정보와 별도로 Popup Title 설정용
12. bWrapForm  : 표준 popup 화면에 Embed 여부(default true)
13. sPopupCallback : modeless인 경우 callback지원하지 않음.
                   : modal인 경우 반드시 기술할것(default-fn_popupCallback), 존재하지 않는경우 error발생
* Return : object
------------------------------------------------------------------*/
pForm.gfn_showPopupByID = function (objOpener, sPopId, sScrId, oArgs, bIsModal, nWidth, nHeight, bVscrollbar,
								nLeft, nTop, bResize, bTitleBar, bStatusBar,
								sPopupTitle, bWrapForm, sPopupCallback) 
{
	var objApp = nexacro.getApplication();
//--------------------------------------------------------------------------------:) 여기서부터/개발자용 추가/2018.11.05 월/Yi Geon-Jin
var _trace_=null;
if(objApp.av_sSvrType == "NEXACRO")
if(arguments[(arguments.length-1)] == "_trace_"){
  arguments[(arguments.length-1)] = null;
  _trace_ = "_trace_";
}
//--------------------------------------------------------------------------------:) 여기까지 /개발자용 추가/2018.11.05 월/Yi Geon-Jin
	var arrScrInfo = this.gfn_getScreenInfo(sScrId);
	
	arrScrInfo["PROGRAM_WIDTH"] = nWidth;
	arrScrInfo["PROGRAM_HEIGHT"] = nHeight;
	
	if (arrScrInfo["RESULT"]) {

		if ( this.gfn_isNull(sPopupCallback) ) {
			var oFuncArgs = arguments;
			var sCallbackFunc = oFuncArgs[(oFuncArgs.length - 1)];
			if ( objOpener[sCallbackFunc] ) {
				sPopupCallback = oFuncArgs[(oFuncArgs.length - 1)];
			}
		}

		this._gfn_showPopupByURL(objOpener, sPopId, arrScrInfo, oArgs, bIsModal, bVscrollbar,
			nLeft, nTop, bResize, bTitleBar, bStatusBar,
			sPopupTitle, bWrapForm, sPopupCallback, _trace_); //개발자용 trace를 위해 추가/2018.11.05 월/Yi Geon-Jin
	}
};

