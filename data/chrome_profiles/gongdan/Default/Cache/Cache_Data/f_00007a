//파일업로드 초기화
pForm.gfn_initFileUpload = function(objFileDs, oCallbackFunc)
{
	//파일업로드용 Component생성
	var sFileUploadName = "_comp_fileUpload";
	var objFileUpload;
	if(!this.isValidObject(sFileUploadName)){
		objFileUpload = new FileUpload();
		objFileUpload.init( sFileUploadName, 0, 0, 0, 0 );
		this.addChild(sFileUploadName, objFileUpload); 
		objFileUpload.set_visible(false);
		objFileUpload.show(); 
		
		objFileUpload._objFileDs = objFileDs;	
		objFileUpload._objCallbackFunc = oCallbackFunc;
		
        objFileUpload.addEventHandler('onitemchanged' ,
            function (obj, e) {
				//trace("_gfn_fileUpload_onitemchanged>>>>>");
				if ( this.gfn_isNull(e.newvalue) ) {
					trace("신규 선택 파일이 없습니다.");
					return;
				}
				var vFile = obj.filelist[0];	
				
				// 	trace("filename==="+vFile.filename);
				// 	trace("fullpath==="+vFile.fullpath);
				//파일 중복체크
				var objFileDs = obj._objFileDs;	
				var nFindRow = objFileDs.findRow( "ATMT_FILE_NM", vFile.filename );
				if ( nFindRow > -1 ) {
					this.gfn_msgShow(this, "XWTZ0051",["동일한 파일이 존재"]);//{0}합니다.
					return;
				}
				
				//확장자 체크
				//var sExtsFile = vFile.filename.split(".")[1];
				//trace("sExtsFile==="+sExtsFile);
				var bResult = this.gfn_isRestrictFile(vFile.filename);	
				if(!bResult){
					this.gfn_msgShow(this, "XITZ0094",["[" + vFile.filename + "] 업로드", "\n\n PDF 및 이미지(bmp, jpg, jpeg, gif, png)만 업로드가능합니다."]);//{0}할 수 없습니다.
					return;
				}
				
				//업로드 수행 : 사이즈 체크는 업로드후에
				//var strUrl = "svcUrl::sample/multipart/uploadAttachFile.do";
				var strUrl = "svcUrl::" + nexacro.getApplication().av_aFileInfo.uploadAttachFile;	
				var bSucc = obj.upload(strUrl);
            }, this);
		
        objFileUpload.addEventHandler('onerror' ,
            function (obj, e) {
                this.gfn_msgShow(this, "XETZ0010",["업로드에 실패"]);//{0}하였습니다.
            }, this);

        objFileUpload.addEventHandler('onsuccess' ,
            function (obj, e) {
				//trace("file upload success");
				if( e.datasets == null ){
					this.gfn_msgShow(this, "XETZ0010",["업로드에 실패"]);//{0}하였습니다.
					return;
				}else{
					//trace(this, "파일업로드 성공!!!");
					//this.gfn_dsView(e.datasets[0]);
				}
				
				var nMaxSize = 5; // 단위 Mbyte
				var nKBIndex = 1024 ;
				var nMBIndex = 1024 * 1024;
				
				//파일 사이즈 체크
				var objFileDs = obj._objFileDs;
				var nRealSize = Math.ceil( e.datasets[0].getColumn(0,"filesize"));
				//trace("nRealSize==="+nRealSize);
				//첨부파일 최대용량 초과 체크로직
				if(nRealSize > nMaxSize * nMBIndex) {
					this.gfn_msgShow(this, "XWTZ0005",["최대용량을 초과","(최대용량 : " + nMaxSize + "Mbyte)"]);//{0}하였습니다. {1}
					//alert("최대용량을 초과하였습니다. (최대용량 : " + nMaxSize + "Mbyte)" );
				} 
				else {
					//filename : 파일 Full name
					//contenttype : 파일 type
					//filesize : 파일 size
					//file : BLOB 파일Data	
					
					//데이타 이관(BLOB 및 파일정보)
					var vFile = obj.filelist[0];
					var nRow = objFileDs.addRow();
					objFileDs.setColumn(nRow,"ATMT_FILE_PATH_SAVE_NM" , "");
					objFileDs.setColumn(nRow,"ATMT_FILE_NM"           , vFile.filename);
					objFileDs.setColumn(nRow,"ATMT_FILE_EXTS_NM"      , vFile.filename.split(".")[1]);
					objFileDs.setColumn(nRow,"ATMT_FILE_SIZE"         , nRealSize);
					objFileDs.setColumn(nRow,"ATMT_FILE"              , e.datasets[0].getColumn(0,"file"));
					
					//첨부파일 등록 후처리(업무쪽화면에서 등록후에 처리 해야 하는 부분이 있으면 해당 fucntion을 생성하여 처리)
					if(!this.gfn_isNull(obj._objCallbackFunc)) 
					{
						obj._objCallbackFunc.call(this, nRow);
					}
				}
				
				//업로드 자료 삭제
				var nItemCnt = obj.getItemCount();
				for ( var i=nItemCnt-1; i>=0; i--) {
					obj.deleteItem(i);
				}
            }, this);
	} else {
		objFileUpload = this.all[sFileUploadName];
	}
	return objFileUpload;
};

