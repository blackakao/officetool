/**---------------------------------------------------------------------
* 기능 : 특수문자 제거
* 인수 : N/A
* Return : _selectedInfo
----------------------------------------------------------------------*/	
pForm.gfn_checkSpecialChar = function (value, replaceChar) 
{
	var arrChar = ["\\","/",":","*","?","<",">","|"];
	var i=0;

	if (!replaceChar) { replaceChar = ""; }

	do {
		value = value.replace(arrChar[i], replaceChar);
	} while (arrChar[++i]);

	return value;
};	

/**---------------------------------------------------------------------
* HTML5 지원 불가
* 기능 : 파일을 열거나 저장할 경로를 선택하기 위한 파일 선택 대화상자를 어는 함수
* 인수 :  openMode : FileDialog의 종류 SAVE/LOAD/MULTILOAD
		   filterFlag : FileDialog의 표시대상 파일 형식을 지정 EXCEL/IMAGE/
		   fileName : FileDialog open 시 초기 file명을 지정
* Return : filePath : 파일명을 포함한 로컬 경로
----------------------------------------------------------------------*/	
pForm.gfn_openFileDialog = function (openMode, filterFlag, fileName) {
	var titleText = "";
	var cOpenMode = null;
	if (fileName == null) { fileName = ""; }

	if (openMode == "SAVE") {
		titleText = "Save";
		cOpenMode = FileDialog.SAVE;
	} else if (openMode == "LOAD") {
		titleText = "Open";
		cOpenMode = FileDialog.LOAD;
	} else if (openMode == "MULTILOAD") {
		titleText = "Open";
		cOpenMode = FileDialog.MULTILOAD;
	}

	var filterString = "";
	if (filterFlag === "EXCEL") {
		filterString = "Excel 통합문서 (*.xlsx)|*.xlsx|Excel 97 - 2003 통합문서 (*.xls)|*.xls|텍스트 파일 (*.csv)|*.csv|";
	} else if (filterFlag === "EXCEL_XLS") {
		filterString = this.getExtFilterString("XLS");
	} else if (filterFlag === "IMAGE") {
		filterString = "image files (*.bmp;*.jpg;*.jpeg;*.gif;*.png)|*.bmp;*.jpg;*.jpeg;*.gif;*.png";
	} else {
		filterString = "All (*.*)|*.*";
	}

	var objFD = new FileDialog();

	objFD.defaultextention = true;
	objFD.set_filter(filterString);

	var objVirtualFile = objFD.open(titleText, cOpenMode, "%MyDocument%", fileName);
	var filePath = "";

	if (objVirtualFile === undefined || objVirtualFile === null) {
		filePath = "";
	} else {
		filePath = objVirtualFile.fullpath;
		this.x2n_close(objVirtualFile);
	}

	objFD = null;

	return filePath;
};	

/**---------------------------------------------------------------------
* 기능 : File_Dialog 에서 사용되는 확장자 Filter String을 반환한다.
* 인수 : sFilterFlag : 확장자
* Return : 확장자 Filter String
----------------------------------------------------------------------*/
pForm.gfn_getExtFilterString = function(sFilterFlag) {
	switch(sFilterFlag) {
		case "XLS" :
			return "Excel 통합문서 (*.xlsx)|*.xlsx|Excel 97 - 2003 통합문서 (*.xls)|*.xls";
		case "DOC" :
			return "Word 통합문서 (*.docx)|*.docx|Word 97 - 2003 통합문서 (*.doc)|*.doc";
		case "PPT" :
			return "PowerPoint 통합문서 (*.pptx)|*.pptx|PowerPoint 97 - 2003 통합문서 (*.ppt)|*.ppt";
		case "IMAGE" :
			return "image files (*.bmp;*.jpg;*.jpeg;*.gif;*.png)|*.bmp;*.jpg;*.jpeg;*.gif;*.png";
		default :
			return "All (*.*)|*.*";
	}
};	


