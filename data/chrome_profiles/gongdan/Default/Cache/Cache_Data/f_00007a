/**
 * @class	팝업 닫기 close()는 string만 리턴 되므로 공통함수로 처리함
 * @param	{object} objForm : 공통팝업 form object
 * @param	{object} variant : 부모 창으로 리턴되는 object
 * @return	N/A
 */
pForm.gfn_closePopup = function(variant)
{
	var objForm = this.getOwnerFrame().form;
	
	if(objForm.opener && typeof variant !="string")
	{
		variant = this.gfn_isNull(variant) ? "" : variant;
		objForm.opener._variant = variant;
		objForm.close();
	}
	else
	{
		objForm.opener._variant = variant;
		objForm.close(variant);
	}
};

