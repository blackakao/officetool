            function (obj, e) {
                this.gfn_msgShow(this, "XETZ0010",["다운로드에 실패"]);//{0}하였습니다.
            }, this);

        objFileDownload.addEventHandler('onsuccess' ,
            function (obj, e) {
				//파일 다운로드 후 임시파일 삭제 
				//this.gfn_deleteDownloadFile(obj._DownloadFileName);
                this.gfn_msgShow(this, "XITZ0088",["다운로드에 성공"]);//{0}하였습니다.
            }, this);
