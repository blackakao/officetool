        		if(this.ds_OI.rowcount > 0 && !this.gfn_isEmpty(this.rad_dtlAdminPttnCd.value)){
        			this.ds_OI.set_enableevent(false);
        			this.ds_previewList.set_enableevent(false);

        			for(var i = 0, len = this.ds_OI.rowcount; i < len; i++){
        				var sHipin = this.ds_OI.getColumn(i, 'SIOP_HOO_DSCM_NO');
        				var iDD = this.ds_OI.getColumn(i, 'DD');
        				var sEntoutCd = this.ds_OI.getColumn(i, 'ENTOUT_CD');
        				var iRow = this.ds_previewList.findRow('SIOP_HOO_DSCM_NO', sHipin);
        				if(iRow > -1){
        					if(this.gfn_isEmpty(this.ds_previewList.getColumn(iRow, 'IN_NM_DD' + iDD)) &&
        					   !this.gfn_isEmpty(this.ds_previewList.getColumn(iRow, 'IN_NM_DD' + (iDD - 1)))){
        						this.ds_previewList.setColumn(iRow, 'IN_NM_DD' + iDD, '퇴소');

        						this.ds_previewList.setColumn(iRow, 'LTCP_TYPE_CD_NM' + iDD, this.ds_previewList.getColumn(iRow, 'LTCP_TYPE_CD_NM' + (iDD - 1)));
        						this.ds_previewList.setColumn(iRow, 'LTC_RCGT_GRADE_CD' + iDD, this.ds_previewList.getColumn(iRow, 'LTC_RCGT_GRADE_CD' + (iDD - 1)));
        						this.ds_previewList.setColumn(iRow, 'LTCP_CTR_NO' + iDD, this.ds_previewList.getColumn(iRow, 'LTCP_CTR_NO' + (iDD - 1)));
        						this.ds_previewList.setColumn(iRow, 'DTL_ADMIN_PTTN_CD_NM' + iDD, this.ds_previewList.getColumn(iRow, 'DTL_ADMIN_PTTN_CD_NM' + (iDD - 1)));
        						this.ds_previewList.setColumn(iRow, 'IN_DD' + iDD, sEntoutCd);

        					}
        				}
        			}

        			this.ds_OI.set_enableevent(true);
        			this.ds_previewList.set_enableevent(true);
        		}else{
        			trace("empty");
        		}

        		if (this.ds_lastPretn.rowcount > 0 && !this.gfn_isEmpty(this.ds_lastPretn.getColumn(0, "LAST_PRETN"))) {
        			this.ds_cond.setColumn(0, "LAST_PRETN", this.ds_lastPretn.getColumn(0,"LAST_PRETN"));
        		}

        		// 최종제출일자
        		this.stc_workSaveTm.set_text("[공단최종제출일시 : "+ (this.gfn_isEmpty(this.ds_cond.getColumn(0, "LAST_PRETN")) ? "미제출" : this.ds_cond.getColumn(0, "LAST_PRETN") ) +"]");

        		this.grid.set_enableredraw(true);
        	    this.grid.set_enableevent(true);
        	    this.fn_holiinfo();   //20150912

        		if(!this.PRN_ABLE && !this.fv_bAlert)
        		{
        			this.fv_bAlert = true; //당월 제출 불가 알림 한번만 띄우도록
        			this.gfn_msgShow(this,"XWTZ0009", ["당월은 제출 "]);   // {0}  할수없습니다.
        			return;
        		}else if( this.PRN_ABLE){
        			if(!this.fv_bAlertDmEmpty && this.parent100.ds_fm_cond.getColumn(0, "DM_YN") == 'Y' && this.ds_cond.getColumn(0, "ADMIN_PTTN_CD") == "A03" && this.gfn_isEmpty(this.rad_dtlAdminPttnCd.value)){
        				this.fv_bAlertDmEmpty = true;
        				var nRow = this.ds_previewList.findRowExpr("DM_CNT > 0");
        				if(nRow < 0){
        					var tgtYyyy = this.ds_cond.getColumn(0, "TGT_YYYYMM").substring(0,4);
        					var tgtMm = this.ds_cond.getColumn(0, "TGT_YYYYMM").substring(4,6);

        					this.gfn_msgShow(this, "XWTZ0001", [tgtYyyy + "년 " + tgtMm + "월 치매전담형 장기요양기관의 입퇴소 내용이 존재하지 않습니다."]);
        				}

        			}
        		}
        	}

        	if (sSvcId == "selectholi") {
        		for (var i=1; i<= 31; i++) {
        			this.fn_setGrdHeaderColorKang(i);
        		}
        	}

