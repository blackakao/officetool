         this.fn_callback = function(sSvcId,nErrorCode,sErrorMsg) {
         	this.setWaitCursor(false);

        	if (nErrorCode < 0) {
        		return;
        	}

        	if (sSvcId == "selectEntOutPreviewChk") {

