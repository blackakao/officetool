/**---------------------------------------------------------------------
* 기능 :  그리드를 엑셀에 export  
* 인수 :  objScope : 함수 호출 Form Object
		   sSheetName : 엑셀 sheet에 적용할 이름.
		   objGrid : 엑셀로 변환할 grid.
		   bExecExcel : export 후 엑셀 실행여부 default : false
		   sExportFile : [option] export 파일명
		   sRange : [option] 시작위치 default : A1
		   bAnysignFlag : anysign사용여부
* Return : N/A
----------------------------------------------------------------------*/
pForm.gfn_exportExcel = function (objScope, arrSheetName, arrGrid, bExecExcel, sExportFile, arrRange, bAnysignFlag) 
{
	//trace(">>>>> pForm.gfn_exportExcel = function (objScope, arrSheetName, arrGrid, bExecExcel, sExportFile, arrRange, bAnysignFlag)");
	
	var arrReturnGrid = [];
	var objGrid;
	// 실행 오브젝트
	var objApp = nexacro.getApplication();
	/* 다운로드 사유 : 공통코드값이 아닌 '90000'으로 무조건 셋팅(by 정보부 요청사항) */
	objApp.mainframe.fv_indiInfInqRsnCd = "";
	objApp.mainframe.fv_busi24Log 		= "엑셀저장";
	
	 fv_excelDownRowCnt = 0; //applyDefaultBizLogPolicy에서 recordCount로 세팅하기때문에 불필요. (2026.01.19 check)

	for(var i=0; i < arrGrid.length; i++) {
		if ( !(arrGrid[i] instanceof Grid) ) {
			alert( arrGrid[i] + "는 그리드 Object가 아닙니다.");
			return;
		}
	
		objGrid = new Grid("grd_exportTemp_"+i, 0, 0, 0, 0);
		objScope.addChild(objGrid.name, objGrid); 
		objGrid.show(); 
		
		objGrid.set_formats(arrGrid[i].formats);
		objGrid.set_formatid(arrGrid[i].formatid);
		objGrid.set_binddataset(arrGrid[i].binddataset);
		objGrid.set_autosizebandtype("allband");
		objGrid.set_autosizingtype("col");
		//objGrid.set_autofittype(arrGrid[i].autofittype);
		arrReturnGrid[i] 			= objGrid;
	
		fv_excelDownRowCnt += arrGrid[i].getBindDataset().rowcount; // applyDefaultBizLogPolicy에서 recordCount로 세팅하기때문에 불필요. 
	}

	objApp.mainframe.fv_inqDataCnt 		= fv_excelDownRowCnt; // applyDefaultBizLogPolicy에서 recordCount로 세팅하기때문에 불필요. 

	this.fn_excelBizLog(objScope.ds_cond); //업무로그 (TZ20) 저장 
	
	this.gfn_exportMultiSheetExcel(objScope, arrSheetName, arrReturnGrid, bExecExcel, sExportFile, arrRange, bAnysignFlag);
	
};


/**---------------------------------------------------------------------
* 기능 :  데이터셋을를 엑셀에 export  
* 인수 :  objScope : 함수 호출 Form Object
		   sSheetName : 엑셀 sheet에 적용할 이름.
		   objGrid : 엑셀로 변환할 grid.
		   bExecExcel : export 후 엑셀 실행여부 default : false
		   sExportFile : [option] export 파일명
		   sRange : [option] 시작위치 default : A1
		   bAnysignFlag : anysign사용여부
* Return : N/A
----------------------------------------------------------------------*/
pForm.gfn_exportDataset2Excel = function (objScope, arrSheetName, arrDataset, bExecExcel, sExportFile, arrRange, arrHeadDataset, bAnysignFlag) 
{
	var arrGrid = [];
	var objGrid ;
	
	if(arrDataset.length <= 0) return ;
	
	//trace("----------->>>>>>>>>>>>>>>>");
	// 실행 오브젝트
	var objApp = nexacro.getApplication();
	/* 다운로드 사유 : 공통코드값이 아닌 '90000'으로 무조건 셋팅(by 정보부 요청사항) */
	objApp.mainframe.fv_indiInfInqRsnCd = "";
	objApp.mainframe.fv_busi24Log 		= "엑셀저장";
	
	for (var i=0; i<arrDataset.length; i++) {
		objGrid = new Grid("grd_exportTemp_"+i, 0, 0, 0, 0);
		objScope.addChild(objGrid.name, objGrid); 
		objGrid.show(); 			
		objGrid.set_binddataset(arrDataset[i]);
		objGrid.createFormat();
		arrGrid[i] = objGrid;
		
		if(!this.gfn_isEmpty(arrHeadDataset)) {
			for (var j=0; j<arrHeadDataset[i].getColCount(); j++) {
				if(!this.gfn_isEmpty(arrHeadDataset[i].getColumn(0,j))) {
					arrGrid[i].setCellProperty( "Head", j, "text", arrHeadDataset[i].getColumn(0,j));
				}
			}							
		}
		arrGrid[i].set_autosizebandtype("allband");
		arrGrid[i].set_autosizingtype("col");
	}

	this.fn_excelBizLog(objScope.ds_cond); 	//업무로그 (TZ20) 저장 
	
	this.gfn_exportMultiSheetExcel(objScope, arrSheetName, arrGrid, bExecExcel, sExportFile, arrRange, bAnysignFlag);

};	

/**---------------------------------------------------------------------
* 기능 :  그리드를 엑셀에 export  (개인정보보호 팝업처리용)
* 인수 :  objScope : 함수 호출 Form Object
		   sSheetName : 엑셀 sheet에 적용할 이름.
		   objGrid : 엑셀로 변환할 grid.
		   bExecExcel : export 후 엑셀 실행여부 default : false
		   sExportFile : [option] export 파일명
		   sRange : [option] 시작위치 default : A1
		   bAnysignFlag : anysign사용여부
* Return : N/A
----------------------------------------------------------------------*/
pForm.gfn_exportPerInfoExcel = function (objScope, arrSheetName, arrGrid, bExecExcel, sExportFile, arrRange, bAnysignFlag) 
{
	//trace(">>>>> pForm.gfn_exportPerInfoExcel = function (objScope, arrSheetName, arrGrid, bExecExcel, sExportFile, arrRange, bAnysignFlag)");

	var arrReturnGrid = [];
	var objGrid;
	
	fv_excelDownRowCnt = 0;
	for(var i=0; i < arrGrid.length; i++) {
		if ( !(arrGrid[i] instanceof Grid) ) {
			alert( arrGrid[i] + "는 그리드 Object가 아닙니다.");
			return;
		}
		fv_excelDownRowCnt += arrGrid[i].getBindDataset().rowcount;
	}
	/*
	* 	엑셀다운로드 사유 등록
	*   500명이상 다운로드시 사유등록창 떠야하지만 테스트 임시로 10명이상인경우 다운로드 사유등록팝업 띄움
	*/
	if(fv_excelDownRowCnt >= 1 ){	
		this.gfn_excelDownloadSaveChk(objScope, arrSheetName, arrGrid, bExecExcel, sExportFile, arrRange, null, bAnysignFlag, fv_excelDownRowCnt);
		return;
	}
	// excel download
	for(var i=0; i < arrGrid.length; i++) {
		objGrid = new Grid("grd_exportTemp_"+i, 0, 0, 0, 0);
		objScope.addChild(objGrid.name, objGrid); 
		objGrid.show(); 
		
		objGrid.set_formats(arrGrid[i].formats);
		objGrid.set_formatid(arrGrid[i].formatid);
		objGrid.set_binddataset(arrGrid[i].binddataset);
		objGrid.set_autosizebandtype("allband");
		objGrid.set_autosizingtype("col");
		//objGrid.set_autofittype(arrGrid[i].autofittype);
		arrReturnGrid[i] 			= objGrid;
	}
	this.gfn_exportMultiSheetExcel(objScope, arrSheetName, arrReturnGrid, bExecExcel, sExportFile, arrRange, bAnysignFlag);

};


