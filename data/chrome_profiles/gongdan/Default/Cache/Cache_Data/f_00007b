/**---------------------------------------------------------------------
* 기능 :  2개이상의 그리드를 하나의 엑셀에 sheet로 나눠서 export  
* 인수 :  objScope : 함수 호출 Form Object
		   arrSheetName : 엑셀 sheet에 적용할 이름 array.
		   arrGrid : 엑셀로 변환할 grid array.
		   bExecExcel : export 후 엑셀 실행여부 default : false (사용안함)
		   sExportFile : [option] export 파일명
		   arrRange : [option] 시작위치 array default : A1
* Return : N/A
----------------------------------------------------------------------*/
pForm.gfn_exportMultiSheetExcel = function (objScope, arrSheetName, arrGrid, bExecExcel, sExportFile, arrRange, bAnysignFlag) 
{	
	//trace(">>>>> pForm.gfn_exportMultiSheetExcel = function (objScope, arrSheetName, arrGrid, bExecExcel, sExportFile, arrRange, bAnysignFlag)");
	
	if (arrGrid.length==0) { return; }
	
	if ( this.gfn_isNull(bAnysignFlag) ) {
		var oBizInfo = this.getOwnerFrame()._bizInfo;
		var sAnySignUse = "";
		if ( !this.gfn_isNull(oBizInfo)) {
			var sMenuId = oBizInfo.menuId;
			sAnySignUse = nexacro.getApplication().gds_allMenu.lookup("MENU_ID",sMenuId, "WB_FAX_SEND_FUNC_YN");
		}

		if ( sAnySignUse == "Y" && nexacro.getApplication().av_sSvrType != "NEXACRO") {	//웹에서만 실행가능
			bAnysignFlag = true;
		} else {
			bAnysignFlag = false;
		}
	}
	
	var i=0, tempComp, range;
	var convertSheetName, isExistFile;
	var sImages  = new Array();
	var sImages2 = new Array();
	var arrOrgSelectType = new Array();
	if (this.gfn_isEmpty(arrRange)) arrRange = [];

    if (arrSheetName.length != arrGrid.length) {
		trace("gfn_exportMultiSheetExcel(). 엑셀 sheet와 grid Array개수가 다릅니다.");
		return;
	}
	
	this.setWaitCursor(true,true);
	
	//Export정보 설정
	var svcUrl = "svcUrl::XExportImport.do";
	if ( bAnysignFlag == true ) {
		svcUrl = "anysign::" + nexacro.getApplication().av_sHost + "XExportImport.xeni?excelmode=export";
		//svcUrl = "anysign::localhost:18080/npbs/XExportImport.xeni?excelmode=export";
	}

	//this.objExport = null
	var objExport = new nexacro.ExcelExportObject(sExportFile+"_ExcelImport");
	
	objExport.set_exporturl(svcUrl);
	objExport.set_exporttype(nexacro.ExportTypes.EXCEL2007);
 	objExport.set_exporteventtype("itemrecord");
// 	objExport.set_exportuitype("exportprogress");	//exportprogress, statusbar, none
// 	objExport.set_exportmessageready("Export Begin");
// 	objExport.set_exportmessageprocess("%d Item, %d Record / %d Total");
// 	objExport.set_exportmessagecomplete("Export Complete");
 	objExport.set_exportuitype("none");
 	objExport.set_exportmessageprocess("");
	objExport.set_transferrowcount(2000);
	objExport.addEventHandler("onsuccess", this._gfn_exportOnsuccess, this);	
	objExport.addEventHandler("onerror", this._gfn_exportOnerror, this);	
	
	//var tempSaveExcelFileName = sExportFile + "_" + this.gfn_getLocalDateTime() + fileExtension;
	var tempSaveExcelFileName = sExportFile + "_" + this.gfn_getLocalDateTime();
	if ( this.gfn_isNull(sExportFile) ) {
		objExport.set_exportfilename(tempSaveExcelFileName);
	} else {
		objExport.set_exportfilename(sExportFile);
	}
	
	//임시 그리드 삭제용
	this._arrExportGridList = arrGrid;

	//그리드 여러개 
	for ( var i=0; i< arrGrid.length; i++ ) {
		var tempComp = arrGrid[i];

		arrOrgSelectType[i] = tempComp.selecttype;
		if (arrOrgSelectType[i] != "row") {
			tempComp.set_selecttype("row");
		}
		
		range = arrRange[i];
		if (this.gfn_isEmpty(range)) { range = "A1"; }

		convertSheetName = this.gfn_checkSpecialChar(arrSheetName[i]);
//trace("GRID name ===="+tempComp.name+":::::::::::::convertSheetName===="+convertSheetName);
		var nItem = objExport.addExportItem(nexacro.ExportItemTypes.GRID, tempComp, convertSheetName+"!"+range, "allband", "allrecord", "nosuppress");
	}
	
	//Export 실행
	//this.setWaitCursor(true,true);
//trace("url===="+objExport.exporturl);
	//this.setWaitCursor(true,true);
	var result = objExport.exportData();
};

/**
 * @class excel export on sucess <br>
 * @param {Object} obj	
 * @param {Event} e		
 * @return N/A
 * @example
 */
pForm._gfn_exportOnsuccess = function(obj, e)
{	
	this.setWaitCursor(false,true);

   	//임시 그리드 삭제
	var arrGrid = this._arrExportGridList;
	for (var i=0; i<arrGrid.length; i++) {
		var objGrid = this.removeChild(arrGrid[i].name);
		objGrid.destroy();
	}	
	this._arrExportGridList = null;

};

/**
 * @class  excel export on error <br>
 * @param {Object} obj	
 * @param {Event} e		
 * @return N/A
 * @example
 */
pForm._gfn_exportOnerror = function(obj,  e)
{
	this.setWaitCursor(false,true);
   	//임시 그리드 삭제
	var arrGrid = this._arrExportGridList;
	if ( !this.gfn_isNull(arrGrid) ) {
		for (var i=0; i<arrGrid.length; i++) {
			var objGrid = this.removeChild(arrGrid[i].name);
			objGrid.destroy();
		}	
		this._arrExportGridList = null;
	}
	this.alert("Export Error : " + e.errormsg);
	//this.alert("Excel Export Error!!");
};

/**
 * @class  excel import( 데이터 헤더포함 ) <br>
 * @param {String} sDataset - dataset	명
 * @param {String} [sSheet]	- sheet name(default:Sheet1)
 * @param {String} sHead - Head 영역지정	
 * @param {String} [sBody] - body 영역지정(default A2)	
 * @param {String} [sCallback]	- callback 함수
 * @param {String} [sImportId] - import id(callback호출시 필수)	
 * @param {Object} [objForm] - form object(callback호출시 필수)
 * @return N/A
 * @example
 * //this.gfn_excelImportAll("dsList","SheetName","A1:G1","A2","fnImportCallback","import",this);
 * this.gfn_excelImport("dsList","head=sheet1A1B1;body=sheet1A2B2","fnImportCallback","import",this);
 * 주의 : 시트정보가 없는경우 전체 레코드를 임포트합니다.
 *         시트정보가 있는경우 A2부터 임포트합니다.
 */
pForm.gfn_importExcel = function(objForm, sDataset, sSheet, sCallback, sImportId, bAnysignFlag)
{
	//alert("pForm.gfn_importExcel = function(objForm : " + objForm.name + " , sDataset : " + sDataset.name + " , sSheet : " + sSheet + " , sCallback : " + sCallback + " , sImportId : " + sImportId + " , bAnysignFlag : " + bAnysignFlag + " )");
	
	var ds = objForm.objects[sDataset];
	if( this.gfn_isNull(sDataset) || this.gfn_isNull(ds) )
	{
		alert("반환받을 데이타셋이 존재하지 않습니다.");
		//trace("반환받을 데이타셋이 존재하지 않습니다.");
		return;
	}
	
	if( this.gfn_isNull(sSheet) )
	{
		//trace("시트정보가 없습니다.");
		//return;
	}
	
	
	////////////////////////////////////////////////////////////////
	//// bAnysignFlag >>> 구간암호화 적용 여부
	if ( this.gfn_isNull(bAnysignFlag) ) bAnysignFlag = false;
	
	//Import정보 설정
	var svcUrl = "svcUrl::XExportImport.do";
	if ( bAnysignFlag == true ) {
		svcUrl = "svcUrl::XExportImport.xeni?excelmode=import";
	}
	////////////////////////////////////////////////////////////////
	
	//alert("bAnysignFlag ==> " + bAnysignFlag + "\n\n Import정보 설정 ===> " + svcUrl);
	
	
	//var objImport ;	
	//objImport = new nexacro.ExcelImportObject(sDataset+"_ExcelImport",this);				
	
	this.fv_objImport = this.objects["Export_ExcelImport"];	
	if( this.gfn_isNull(this.fv_objImport) )
	{
		this.fv_objImport = new nexacro.ExcelImportObject("Export_ExcelImport",this);
		this.addChild("Export_ExcelImport", this.fv_objImport);		
	}
	
	this.fv_objImport.set_importurl(svcUrl);						
	this.fv_objImport.set_importtype(nexacro.ImportTypes.EXCEL);			
	
	sCallback = sCallback||"fnImportCallback";
	sImportId = sImportId||sDataset;
	objForm = this;
	
	this.fv_objImport.callback = sCallback;
	this.fv_objImport.importid = sImportId;
	this.fv_objImport.form = objForm;
	
	//alert(">>>>>>>>>>>>>>>>>>>>>\n\n objImport : " + objImport.name + "\n\n objImport.callback : " + objImport.callback + "\n\n objImport.importid : " + objImport.importid + "\n\n objImport.form : " + objImport.form.name);
	
	var sBody = "A2";
	var sParam1, sParam2;
	
	this.fv_objImport.addEventHandler("onsuccess", this._gfn_importOnsuccess, this);
	this.fv_objImport.addEventHandler("onerror"  , this._gfn_importOnerror  , this);	
	
	if ( this.gfn_isNull(sSheet) ) {
		sParam1 = "[Command=getsheetdata;Output=outds;"+"]";
	} else {
		sParam1 = "[Command=getsheetdata;Output=outds;Body="+sSheet+"!"+sBody+"]";
	}
	
	sParam2 =   "["+sDataset+"=outds]";
	
	//alert(">>>>>>>>>>>>>>>>>>>>>5\n\n  sParam1 : " + sParam1 + "\n\n  sParam2 : " + sParam2);
	
	this.setWaitCursor(true);
	this.fv_objImport.importData("", sParam1, sParam2);
	this.setWaitCursor(false);
	
	//alert(">>>>>>>>>>>>>>>>>>>>>6\n\n  objImport : " + objImport.name);
	
	//objImport = null;
};

/**
 * @class excel import on success <br>
 * @param {Object} obj	
 * @param {Event} e		
 * @return N/A
 * @example
 */
pForm._gfn_importOnsuccess = function(obj,  e)
{		
//this.alert("Excel Import Success!!");
	var sCallback = obj.callback;
	var sImportId = obj.importid;
	
	//화면의 callback 함수 호출
	if (!this.gfn_isNull(sCallback)) {
		if (this[sCallback]) this.lookupFunc(sCallback).call(sImportId,true);
	}
};

/**
 * @class excel import on error <br>
 * @param {Object} obj	
 * @param {Event} e		
 * @return N/A
 * @example
 */
pForm._gfn_importOnerror = function(obj,  e)
{		
//this.alert("Excel Import Error!!");
	var sCallback = obj.callback;
	var sImportId = obj.importid;
	
	//화면의 callback 함수 호출
	if (!this.gfn_isNull(sCallback)) {
		if (this[sCallback]) this.lookupFunc(sCallback).call(sImportId,false);
	}
};

/**
 * @class 엑셀다운로드시 사유등록팝업 오픈 <br>
 * @param {Object} obj	
 * @param {Event} e		
 * @return N/A
 * @example
 */
pForm.gfn_excelDownloadSaveChk = function(objScope, arrSheetName, arrGridOrDataset, bExecExcel, sExportFile, arrRange, arrHeadDataset, bAnysignFlag, iExcelDownRowCnt)
{
	var initValue = {arg1:objScope, arg2:arrSheetName, arg3:arrGridOrDataset, arg4:bExecExcel, arg5:sExportFile, arg6:arrRange, arg7:arrHeadDataset, arg8:bAnysignFlag, arg9:iExcelDownRowCnt};
	
	trace("initValue:"+initValue);
	trace("iExcelDownRowCnt:"+iExcelDownRowCnt);
	
	var sPopId		= "nptz001p02";
	var sScrId		= "nptz001p02";
    var sArgs       =  {initValue:initValue};
	var nWidth		= 490;
	var nHeight		= 330;
	var bIsModal	= true;
	var bVscrollbar = true;

	this.gfn_showPopupByID(this, sPopId, sScrId, sArgs, bIsModal, nWidth, nHeight, bVscrollbar,"","","","","","","","fn_excelPopupCallback");
}
pForm.fn_excelPopupCallback = function (sFrameid, sVarRtn)
{	
	trace(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>");
    trace(">>>>>" + this.name + ".fn_popupCallback = function (" + sFrameid + ", " + sVarRtn + ")");
    trace(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>");	
	
	if( sFrameid == "nptz001p02" && sVarRtn == "CLOSEONLY" ) {
		return;
	}else if( sFrameid == "nptz001p02" && this._variant == "[object Object]" ) {
		var objGrid;
		
		var objScope			= this._variant.initValue.arg1;
		var arrSheetName		= this._variant.initValue.arg2;
		var arrGridOrDataset	= this._variant.initValue.arg3;
		var bExecExcel			= this._variant.initValue.arg4;
		var sExportFile			= this._variant.initValue.arg5;
		var arrRange			= this._variant.initValue.arg6;
		var arrHeadDataset		= this._variant.initValue.arg7;
		var bAnysignFlag		= this._variant.initValue.arg8;
		var iExcelDownRowCnt	= this._variant.initValue.arg9;
	
		//실행 오브젝트
		var objApp = nexacro.getApplication();
		/*
		다운로드 사유 : 공통코드값이 아닌 '90000'으로 무조건 셋팅(by 정보부 요청사항)
		*/
		//objApp.mainframe.fv_indiInfInqRsnCd = this._variant.rdnRsn;
		objApp.mainframe.fv_indiInfInqRsnCd = "90000";
		objApp.mainframe.fv_inqDataCnt 		= iExcelDownRowCnt;
		objApp.mainframe.fv_busi24Log 		= this._variant.edt_rdnRsn;
		
		if (arrGridOrDataset instanceof nexacro.Dataset || (typeof arrGridOrDataset == "object" && arrGridOrDataset._type_name == "Dataset")) {
			var arrGrid = [];
			
			//업무로그 (TZ20) 저장 
			this.fn_excelBizLog(arrGridOrDataset[0]);
			
			// excel download
			for (var i=0; i<arrGridOrDataset.length; i++) {
				objGrid = new Grid("grd_exportTemp_"+i, 0, 0, 0, 0);
				objScope.addChild(objGrid.name, objGrid); 
				objGrid.show(); 			
				objGrid.set_binddataset(arrGridOrDataset[i]);
				objGrid.createFormat();
				arrGrid[i] = objGrid;
				
				if(!this.gfn_isEmpty(arrHeadDataset)) {
					for (var j=0; j<arrHeadDataset[i].getColCount(); j++) {
						if(!this.gfn_isEmpty(arrHeadDataset[i].getColumn(0,j))) {
							arrGrid[i].setCellProperty( "Head", j, "text", arrHeadDataset[i].getColumn(0,j));
						}
					}							
				}
				arrGrid[i].set_autosizebandtype("allband");
				arrGrid[i].set_autosizingtype("col");
			}
			this.gfn_exportMultiSheetExcel(objScope, arrSheetName, arrGrid, bExecExcel, sExportFile, arrRange, bAnysignFlag);
		}else{
			var arrReturnGrid = [];
			//업무로그 (TZ20) 저장 
			this.fn_excelBizLog(arrGridOrDataset[0].getBindDataset());
			
			// excel download
			for(var i=0; i < arrGridOrDataset.length; i++) {
				objGrid = new Grid("grd_exportTemp_"+i, 0, 0, 0, 0);
				objScope.addChild(objGrid.name, objGrid); 
				objGrid.show(); 
				
				objGrid.set_formats(arrGridOrDataset[i].formats);
				objGrid.set_formatid(arrGridOrDataset[i].formatid);
				objGrid.set_binddataset(arrGridOrDataset[i].binddataset);
				objGrid.set_autosizebandtype("allband");
				objGrid.set_autosizingtype("col");
				//objGrid.set_autofittype(arrGrid[i].autofittype);
				arrReturnGrid[i] 			= objGrid;
			}
			this.gfn_exportMultiSheetExcel(objScope, arrSheetName, arrReturnGrid, bExecExcel, sExportFile, arrRange, bAnysignFlag);
		}		
	}
}
pForm.fn_excelDownCallBack = function(sSvcId, nErrCd, sErrMsg)
{
    trace(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>");
    trace(">>>>> " + this.name + ".fn_callBack = function(" + sSvcId + ", " + nErrCd + ", " + sErrMsg + ")");
    trace(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>");

    if (sSvcId == "excelBizLog") {		
		this.fn_postExcelBizLog();
    }
	return;
};
pForm.fn_excelBizLog = function(arrDataset){

	var sDsName = "ds_excel_tmp";
    var dataset  = new Dataset;
		dataset.set_name(sDsName);
	this.addChild(sDsName, dataset);
	dataset.copyData(arrDataset);

	var sSvcId			= "excelBizLog";
	var sPath  			= "t/z/001/excelBizLog.do";
	var sInputDsName 	= "ds_excel_tmp=ds_excel_tmp";
	var sOutputDsName 	= "ds_excel_tmp=ds_excel_tmp";
	var sArg 			= "";
	var oPreArgs  		= [];
	var sCallback 		= "fn_excelDownCallBack";
	
	this.gfn_callService(sSvcId, sPath, sInputDsName, sOutputDsName, sArg, oPreArgs, sCallback);
	
	var objDelete = this.removeChild("ds_excel_tmp");
    objDelete.destroy();
} 
pForm.fn_preExcelBizLog = function() {
	return true;
}
pForm.fn_postExcelBizLog = function() {	
	trace(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>");
    trace(">>>>> " + this.name + ".fn_postExcelBizLog = function()");
    trace(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>");
	// 엑셀인쇄사유 
	var objApp = nexacro.getApplication();
	objApp.mainframe.fv_indiInfInqRsnCd = "";
	objApp.mainframe.fv_busi24Log 		= "";
	objApp.mainframe.fv_inqDataCnt 		= "";
	objApp.gds_userInfo.setColumn(0, "INDI_INFO_INQ_RSN_CD", "");
	objApp.gds_userInfo.setColumn(0, "BUSI_LOG_CONTN", "");
	objApp.gds_userInfo.setColumn(0, "INQ_DATA_CNT", "");
	
	return true;
}
