        this.fn_createCalendar = function(ds_bind,grid_obj,yyyymm)
        {
            var i, day, row, colid;
            var start_day, end_date, lunar;
            var holiday, aHolidays;
            var sDD = "";

            grid_obj.UserData = yyyymm;
            ds_bind.clearData();

            start_day = this.gfn_getDay(yyyymm+"01");
            this.last_date = this.gfn_lastDateNum(yyyymm+"01");

            row = ds_bind.addRow();
            ds_bind.setColumn(row, "weekNo", 0);

            for(var i = 1, day = start_day ;  i <= this.last_date ; i++ )
            {
                if((i+"").length == 1){
                    sDD = "0" + i;
                } else {
                    sDD = i + "";
                }

                ds_bind.setColumn(row, "day"+day, i);

                if(this.ds_enOutMonth.rowcount > 0)
                {
                     this.nDataRow = this.ds_enOutMonth.findRow("ENTOUT_DT",yyyymm+sDD);
                    if( this.nDataRow != -1 )
                    {
                        /*치매전담형_고시_개정_[201607]*/
                        /*수급자가 치매전담실에 있는 경우에만 실정보를 표시한다.*/
                        var roomNm = this.ds_enOutMonth.getColumn(this.nDataRow, 'ROOM_NM');
                        roomNm = roomNm && this.fv_bShowRoomNm ? '\n' + roomNm : '';

        				ds_bind.setColumn(row, "hol"+day, this.ds_enOutMonth.getColumn(this.nDataRow,"ENTOUT_NM") + roomNm);
                    }
                }

                day = (day + 1) % 7;

                if( day == 0 && i != this.last_date ) {
                    row = ds_bind.addRow();
                    ds_bind.setColumn(row, "weekNo", 0);
                }
            }

        //    ds_bind.set_rowposition(-1);
        };


