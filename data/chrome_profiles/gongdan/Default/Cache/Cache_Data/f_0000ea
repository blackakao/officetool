        		trace("fn_check_ia21_adminPttnCd >> ia21_ADMIN_PTTN_CD = " + ia21_ADMIN_PTTN_CD);
        		trace("fn_check_ia21_adminPttnCd >> cond_ADMIN_PTTN_CD = " + cond_ADMIN_PTTN_CD);
        		trace("fn_check_ia21_adminPttnCd >> cond_DTL_ADMIN_PTTN_CD = " + cond_DTL_ADMIN_PTTN_CD);

        		trace(">>>>>> ds_etrcOutBasic.ADMIN_PTTN_CD : "+this.ds_etrcOutBasic.getColumn(0,"ADMIN_PTTN_CD"));
        		trace(">>>>>> ds_etrcOutBasic.ADMIN_PTTN_CD : "+this.ds_etrcOutBasic.getColumn(this.ds_etrcOutBasic.rowposition,"ADMIN_PTTN_CD"));

        		if ( ia21_ADMIN_PTTN_CD == cond_ADMIN_PTTN_CD ) {
        			chk_val = true;
        		} else if ( ia21_ADMIN_PTTN_CD == "G30"  && cond_DTL_ADMIN_PTTN_CD.substring(0,1) == "G" ) { /* 치매가형 */
        			chk_val = true;
        		} else if( ia21_ADMIN_PTTN_CD == "M30" && cond_DTL_ADMIN_PTTN_CD.substring(0,1) == "M") { /* 치매나형 */
        			chk_val = true;
        		} else if( ia21_ADMIN_PTTN_CD == "S41" && cond_DTL_ADMIN_PTTN_CD.substring(0,1) == "S") { /* 치매공생 */
        			chk_val = true;
        		}
        		else {
        			chk_val = false;
        		}

        		// 계약이 없을 땐 우선 통과
        		if ( this.cfn_str_isNull(ia21_ADMIN_PTTN_CD) ) {
        			chk_val = true;
