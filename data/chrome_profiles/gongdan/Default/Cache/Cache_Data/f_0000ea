        this.fn_chkEdaDt = function(entTime) {
        	// 특례 신규등록이 가능한지 계약관계 check
        	var bCrtFlag = false;
        	if (this.ds_edaDt.rowcount > 0)
        	{
        		var strCrtFrDt;
        		var strCrtToDt;
        		for (var i=0; i<this.ds_edaDt.rowcount; i++)
        		{
        			strCrtFrDt = this.ds_edaDt.getColumn(i, "CTR_FR_DT");
        			strCrtToDt = this.ds_edaDt.getColumn(i, "CTR_TO_DT");
        			if (!this.gfn_isEmpty(strCrtFrDt) && !this.gfn_isEmpty(strCrtToDt))
        			{
        				// 계약시작일자 <= 입소일자 <= 계약종료일자
        				if (this.cfn_dt_compareDate(entTime, strCrtFrDt) != -1 && this.cfn_dt_compareDate(entTime, strCrtToDt) != 1)
        				{
        					bCrtFlag = true;
        					break;
        				}
        			}
        		}
        	}
        	if (bCrtFlag != true)
        	{
        		this.alert("수급자(대상자)의 입소일자는 시설급여 계약기간 이내이어야 합니다.\n시작일자를 확인하여 주십시요");
        		return false;
        	}
        	return true;
        }
