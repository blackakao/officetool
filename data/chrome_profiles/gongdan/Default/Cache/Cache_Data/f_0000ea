        /*======================================================================================*
         * 5. Transaction CallBack처리 함수
         *======================================================================================*/
         this.fn_callback = function(sSvcId,nErrorCode,sErrorMsg) {
         	this.setWaitCursor(false);

            if (nErrorCode < 0) {
                return;
            }

            if (sSvcId == "saveCreateSctnAll") {
                trace( "saveCreateSctnAll");
            }

            if (sSvcId == "selectEntOutTgtList") {
                trace( "selectEntOutTgtList");
        		this.fv_spcTotCnt = 0;
        		for(var i=0; i<=this.ds_entOutTgtList.getCount(); i++) {
        			if (this.ds_entOutTgtList.getColumn(i,"SIOP_SCPS_PTTN_CD") == "S") {
        				this.fv_spcTotCnt++;
        			}
        		}
            }

            if (sSvcId == "selectSctnErrorCheck") {

                var sSelNm = this.ds_entOutTgtList.getColumn(this.ds_entOutTgtList.rowposition, "NM");
