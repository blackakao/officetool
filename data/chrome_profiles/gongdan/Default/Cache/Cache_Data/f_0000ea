        this.fn_checkHHMM = function(sTime)
        {
            var bCheck = true;

            if(sTime.length != 4 || !sTime.match(/[012][0-9][0-5][0-9]/))
            {
                return false;
            }


            var inHh = sTime.substring(0,2);
            var inMm = sTime.substring(2,4);

            if(inHh > 23 || inMm > 60)
            {
                //trace("toNum(inHh) : " + inHh);
                return false;
            }

            return bCheck;
        };

