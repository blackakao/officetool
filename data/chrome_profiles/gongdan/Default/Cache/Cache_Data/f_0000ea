        this.fn_setPocyType = function() {     // 201801 KHCHO 정책가산금 구분 코드 조회

            var DTL_ADMIN_PTTN_CD = this.ds_cond.getColumn(0, "DTL_ADMIN_PTTN_CD");
        	if(DTL_ADMIN_PTTN_CD == "AAA") {
        		var nRow = this.ds_ra21.findRowExpr("String(ADMIN_PTTN_CD).charAt(0) == 'A'") ;
        	}
        	else {
        		var nRow = this.ds_ra21.findRowExpr("ADMIN_PTTN_CD == '"+ DTL_ADMIN_PTTN_CD + "'");
        	}

        	/* 201801 KHCHO */
        	if(   this.ds_cond.getColumn(0, "TGT_YYYYMM") >= "201801" // 변경 해야만 함 201801
        	   && this.ds_cond.getColumn(0, "DTL_ADMIN_PTTN_CD") != null
        	   && this.ds_cond.getColumn(0, "DTL_ADMIN_PTTN_CD").substring(0,1) != "A"
        	   && (this.ds_ra21.getColumn(nRow, "POCY_TO_YYYYMM") >= this.ds_cond.getColumn(0, "TGT_YYYYMM"))
        	  )
        	{
        		this.sta_POCY.set_visible(true);
        		this.cmb_pocyType.set_visible(true);
        		this.cmb_pocyType.set_enable(true);

        		this.fn_selectPocyType();
        	}
        	else {

        		this.sta_POCY.set_visible(false);
        		this.cmb_pocyType.set_visible(false);
        		this.cmb_pocyType.set_enable(false);

        		// 정책지원금 콤보박스 관련 데이터셋 및 변경여부 초기화
