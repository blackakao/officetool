        // 입퇴소 외박/복귀 ROW 추가
        this.btn_grdAdd_sub_onclick = function(obj,e)
        {
            var iRow  = this.ds_etrcOutBasic.rowposition;

        	var sStatus = this.gfn_getDataStatusGrid(this.grd_etrcOutBasic, iRow );
        	//trace("this.sStatus = " + this.sStatus );
            if( !this.gfn_isEmpty(sStatus) && sStatus != "N"){
        		 this.gfn_msgShow(this, "XWTZ0020",["입퇴소 변경", "저장후 추가 가능합니다."]);
        		return;
            }

            /* 신규 외박건 추가 가능한지 검증 */
            for(var i = 0; i < this.ds_etrcOutSub.rowcount ; i++){

        		/* 1. 외박중퇴소 시 퇴소 했으므로 외박 불가 */
                if(this.ds_etrcOutSub.getColumn(i, "STOUT_CBK_RSN_CD")  == "20"){
        			 this.gfn_msgShow(this, "XWFA0050");  // 퇴소후 외박 불가
                    return;
                }

                /* 2. 외박중사망 시 사망 했으므로 외박 불가 */
                if(this.ds_etrcOutSub.getColumn(i, "STOUT_CBK_RSN_CD")  == "30"){
        			 this.gfn_msgShow(this, "XWFA0051");  // 사망후 외박 불가
                    return;
                }

                /* 3. 미복귀 외박건이 있다면 신규 외박 추가 불가 */
                if(this.gfn_isEmpty(this.ds_etrcOutSub.getColumn(i, "ADPT_TO_DT")) ||
        			this.ds_etrcOutSub.getColumn(i, "ADPT_TO_DT") == "99991231" || this.gfn_isEmpty(this.ds_etrcOutSub.getColumn(i, "TO_TM")) ||
                    this.ds_etrcOutSub.getColumn(i, "STOUT_CBK_RSN_CD") == "00"
                ){
        			 this.gfn_msgShow(this, "XWTZ0007", ["복귀 후 추가 "]);  // 복귀후 추가 할수 있습니다.
                    return;
                }
            }

            var nAddRow = this.ds_etrcOutSub.insertRow(0);

            this.ds_etrcOutSub.setColumn(nAddRow, "LTC_ADMIN_SYM", this.ds_cond.getColumn(0, "LTC_ADMIN_SYM"));

            /*치매전담형_고시_개정_[201607]*/
            /*
            기존에는 AAA로 다 커버가 됐지만 이제는 G31등 도 들어가므로 실제 코드를 파라미터로 던질 필요가 있다.
            외박은 구간에 추가되는 형태이기 때문에 해당 구간의 기관유형코드를 따라간다.
            */
            this.ds_etrcOutSub.setColumn(nAddRow, "ADMIN_PTTN_CD", this.ds_etrcOutBasic.getColumn(iRow, "ADMIN_PTTN_CD"));

            this.ds_etrcOutSub.setColumn(nAddRow, "SIOP_HOO_DSCM_NO", this.ds_cond.getColumn(0, "SIOP_HOO_DSCM_NO"));
            this.ds_etrcOutSub.setColumn(nAddRow, "SIOP_HOO_TYPE_CD", this.ds_cond.getColumn(0, "SIOP_HOO_TYPE_CD"));

            this.ds_etrcOutSub.setColumn(nAddRow, "QLF_TYPE", this.ds_cond.getColumn(0, "QLF_TYPE"));
            this.ds_etrcOutSub.setColumn(nAddRow, "ODR2_JUDG_GRADE_CD", this.ds_cond.getColumn(0, "ODR2_JUDG_GRADE_CD"));
            this.ds_etrcOutSub.setColumn(nAddRow, "LTC_MGMT_NO", this.ds_cond.getColumn(0, "LTC_MGMT_NO"));

            this.ds_etrcOutSub.setColumn(nAddRow, "DEL_YN", "N");

            var sFrDay = this.gfn_getDbToday();
            /* 신규 외박 시작일자는 현재 일자로 초기화한다 */
            if( this.gfn_isEmpty(this.ds_etrcOutBasic.getColumn(iRow, "ADPT_TO_DT")) || (this.ds_etrcOutBasic.getColumn(iRow, "ADPT_FR_DT") <= sFrDay && sFrDay <= this.ds_etrcOutBasic.getColumn(iRow, "ADPT_TO_DT"))){
        		this.ds_etrcOutSub.setColumn(nAddRow, "ADPT_FR_DT", sFrDay);
        		this.ds_etrcOutSub.setColumn(nAddRow, "FR_TM", "0000");
            }else{
        		/* 현재 일자가 구간을 벗어 났다면? 일단 공란으로 두자 */
            }


            this.ds_etrcOutSub.setColumn(nAddRow, "SCTN_ADPT_FR_DTTM", this.ds_etrcOutBasic.getColumn(iRow, "ADPT_FR_DT") + this.ds_etrcOutBasic.getColumn(iRow, "FR_TM"));
            this.ds_etrcOutSub.setColumn(nAddRow, "ENTOUT_SCTN_TO_PTTN_CD", this.ds_etrcOutBasic.getColumn(iRow, "ENTOUT_SCTN_TO_PTTN_CD"));

            this.ds_etrcOutSub.setColumn(nAddRow, "ENTOUT_SCTN_SEQ_NO", this.ds_etrcOutBasic.getColumn(iRow, "ENTOUT_SCTN_SEQ_NO"));

            if(this.ds_etrcOutBasic.getColumn(iRow, "ENTOUT_SCTN_TO_PTTN_CD") != "00" )
            {
                this.ds_etrcOutSub.setColumn(nAddRow, "ADPT_TO_DT", this.ds_etrcOutBasic.getColumn(iRow, "ADPT_TO_DT")) ;
                this.ds_etrcOutSub.setColumn(nAddRow, "TO_TM", this.ds_etrcOutBasic.getColumn(iRow, "TO_TM"));
                this.ds_etrcOutSub.setColumn(nAddRow, "STOUT_CBK_RSN_CD", "20");
                this.ds_etrcOutSub.setColumn(nAddRow, "SCTN_ADPT_TO_DTTM", this.ds_etrcOutBasic.getColumn(iRow, "ADPT_TO_DT") + this.ds_etrcOutBasic.getColumn(iRow, "TO_TM"));
            }
            else
            {
                this.ds_etrcOutSub.setColumn(nAddRow, "ADPT_TO_DT", "");
                this.ds_etrcOutSub.setColumn(nAddRow, "TO_TM", "");
                this.ds_etrcOutSub.setColumn(nAddRow, "STOUT_CBK_RSN_CD", "00");
                this.ds_etrcOutSub.setColumn(nAddRow, "SCTN_ADPT_TO_DTTM", "999912310000");
            }
            this.ds_etrcOutSub.setColumn(nAddRow, "STOUT_TYPE_CD", "01" );

        };


        // 외박/복귀 내역 저장 버튼 클릭
        this.btn_saveStout_onclick = function(obj,e)
        {
            var iRow  = this.ds_etrcOutBasic.rowposition;
            var sRoomOutPairYn = this.ds_etrcOutBasic.getColumn(iRow, "ROOM_OUT_PAIR_YN");

            if(!this.gfn_getDatasetUpdated(this.ds_etrcOutSub)){
                 this.gfn_msgShow(this,"XITZ0046");   // 변경내역이 없습니다.
                return false;
            }

        	var sStatus = this.gfn_getDataStatusGrid(this.grd_etrcOutBasic, this.ds_etrcOutBasic.rowposition );
            if( !this.gfn_isEmpty(sStatus) && sStatus != "N"){
        		this.gfn_msgShow(this, "XWTZ0020",["입퇴소 변경", "저장후 외박/복귀 저장이 가능합니다."]);
        		return;
            }

        	for(var i = 0; i < this.ds_etrcOutSub.rowcount; i++)
            {
                var iRow2  = i;

        		sStatus = this.gfn_getDataStatusGrid(this.grd_inOut, iRow2 );

        		if( sStatus != null && sStatus != "N"){
                    if( this.gfn_isEmpty(this.ds_etrcOutSub.getColumn(iRow2, "FR_TM")))
                    {
                        this.gfn_msgShow(this,"XWTZ0046", ["외박 시작시간"]);   // {0} 이 없습니다.
                        return false;
                    }

                    if(!this.fn_checkHHMM(this.ds_etrcOutSub.getColumn(iRow2, "FR_TM")))
                    {
                        this.gfn_msgShow(this,"XITZ0006", ["시작시간"]);   // {0} 의 형식이 잘못되었습니다.
                        return false;
                    }

                    if(this.ds_etrcOutBasic.getColumn(iRow, "ENTOUT_SCTN_TO_PTTN_CD") != "00" && (this.ds_etrcOutSub.getColumn(iRow2, "STOUT_CBK_RSN_CD") == "00" || this.ds_etrcOutSub.getColumn(iRow2, "ADPT_TO_DT") == ""))
                    {
                        this.gfn_msgShow(this, "XITZ0001",["복귀사유 및 종료"]);  //{0}는 필수입력항목입니다.
                        return;
                    }

                    if(this.ds_etrcOutSub.getColumn(iRow2, "STOUT_CBK_RSN_CD") != "00")
                    {
                        if( this.gfn_isEmpty(this.ds_etrcOutSub.getColumn(iRow2, "ADPT_TO_DT")))
                        {
                            this.grd_etrcOutBasic.setCellPos(6);
                            this.gfn_msgShow(this,"XWTZ0048", ["외박 종료일자"]);   // {0} 가 없습니다.
                            return false;
                        }

                        if( this.gfn_isEmpty(this.ds_etrcOutSub.getColumn(iRow2, "TO_TM")))
                        {
                            this.gfn_msgShow(this,"XWTZ0046", ["외박 종료시간"]);   // {0} 이 없습니다.
                            return false;
                        }

                        if(!this.fn_checkHHMM(this.ds_etrcOutSub.getColumn(iRow2, "TO_TM")))
                        {
                            this.gfn_msgShow(this,"XITZ0006", ["종료시간"]);   // {0} 의 형식이 잘못되었습니다.
                            return false;
                        }

                        /* 외박이 속한 구간이 퇴소(이동)으로 인해 잠겨있는 경우 외박복귀 사유가
                           20 외박중퇴소, 30 외박중사망
                        */
                        if(sRoomOutPairYn == "Y" && (this.ds_etrcOutSub.getColumn(iRow2, "STOUT_CBK_RSN_CD") == "20" || this.ds_etrcOutSub.getColumn(iRow2, "STOUT_CBK_RSN_CD") == "30")){
        					this.gfn_msgShow(this, "XWTZ0020",["연관된 입소(이동)","삭제 후 진행 가능합니다."]);  //{0}내역이 있습니다. {1}
        					this.fn_selectEntOutStout();
        					return false;
        				}
                    }

                    var outSubTime = "";
                    var entSubTime = "";
                    var outTime = "";
                    var entTime = "";
                    var sToday = this.gfn_getLocalToday(); //현재일
                    outSubTime = this.ds_etrcOutSub.getColumn(iRow2, "ADPT_TO_DT");
                    entSubTime = this.ds_etrcOutSub.getColumn(iRow2, "ADPT_FR_DT");

                    outTime = this.ds_etrcOutBasic.getColumn(iRow, "ADPT_TO_DT");
                    entTime = this.ds_etrcOutBasic.getColumn(iRow, "ADPT_FR_DT");

                    if( !this.gfn_isEmpty(entTime) && this.cfn_dt_compareDate(outSubTime, outTime) == 1)
                    {
                        this.gfn_msgShow(this,"XETZ0031", ["외박 종료일자는 퇴소보다"]);   // {0} 작습니다.
                        return false;
                    }

                    if( !this.gfn_isEmpty(outSubTime) && this.cfn_dt_compareDate(entSubTime, outSubTime) == 1)
                    {
                        this.gfn_msgShow(this,"XETZ0031", ["외박 시작일자는 외박 종료일자보다 "]);   // {0} 작습니다.
                        return false;
                    }

                    if( !this.gfn_isEmpty(entTime) && this.cfn_dt_compareDate(entTime, outTime) == 0)  // 같은경우
                    {
                        var frTm = nexacro.toNumber(this.ds_etrcOutSub.getColumn(iRow, "FR_TM"));
                        var toTm = nexacro.toNumber(this.ds_etrcOutSub.getColumn(iRow, "TO_TM"));

                        if(frTm > toTm)
                        {
                            this.gfn_msgShow(this,"XETZ0031", ["외박시작시간은 외박종료시간보다 "]);   // {0} 작아야 합니다.
                            return false;
                        }
                    }

                    if(this.cfn_dt_compareDate(outSubTime, sToday) == 1)
                    {
                        this.gfn_msgShow(this,"XETZ0031", ["종료일자는 현재일자보다 "]);   // {0} 작아야 합니다.
                        return false;
                    }


                    if(this.cfn_dt_compareDate(entTime, entSubTime) == 1)
                    {
                        this.gfn_msgShow(this,"XETZ0029", ["외박시작일자가 입소일자 "]);   // {0} 작습니다.
                        return false;
                    }

                    if(this.ds_etrcOutSub.getColumn(iRow, "STOUT_CBK_RSN_CD") == "00")
                    {
                        this.ds_etrcOutSub.setColumn(iRow, "ADPT_TO_DT", "");
                        this.ds_etrcOutSub.setColumn(iRow, "TO_TM", "");
                    }
                }
            }

            if( this.gfn_msgShow(this, "XCTZ0002",[])){
                this.fn_saveEntOutStout();
            }

        };


