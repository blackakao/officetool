/*---------------------------------------------------------------------------------------
 * 컴포넌트의 onkeyup 이벤트에 사용하며 Enter 입력시 탭오더 순서에 따라 다음 컴포넌트로 이동하며 조회 버튼의 경우 fn_search함수를 호출한다.
 * @param : oObj                onkeyup 이벤트가 발생하는 오브젝트
 * @param : eKeyEventInfo       KeyEventInfo 오브젝트
 * @param : sLastBtnText        조회에 사용될 버튼의 text (default: "조회")
 * @param : sFunctionNm         조회에 사용될 함수명 (default: "fn_search")
 * @param : aArgs               조회에 사용될 함수의 인자값 배열 (default: [])
 *--------------------------------------------------------------------------------------*/
pForm.bfn_moveNextTabOrder = function(oObj, eKeyEventInfo, sLastBtnText, sFunctionNm, aArgs)
{
if(eKeyEventInfo.ctrlkey || eKeyEventInfo.altkey) return;
    var lastBtnText = sLastBtnText || "조회";
    var functionNm = sFunctionNm || "fn_select";
    var args = aArgs || [];
    if (eKeyEventInfo.keycode == "13") {
        if (oObj instanceof Button && oObj.text == lastBtnText) {
            if (this["fn_search"]) this.fn_search();
        }
        else {
            var curTabOrder = oObj.taborder;
            var nextTabOrder = curTabOrder + 1;
            var nextObject = this.getNextComponent(oObj);
            if(!this.gfn_isNull(nextObject)){
            if (nextObject instanceof Button && nextObject.text == lastBtnText) {
                if (this[functionNm]) this[functionNm].apply(this, args);
                else return;
            }
            else nextObject.setFocus();
            }
        }
    }
};

/*---------------------------------------------------------------------------------------
 * 선행 콤보박스에서 선택된 데이터를 이용하여 후행 콤보박스의 데이터를 필터링 한다.
 * @param : oCombo                  선행 콤보박스 오브젝트
 * @param : oTargetCombo            후행 콤보박스 오브젝트
 * @param : sTargetColumnName       후행 콤보박스에서 선행 콤보박스의 값을 이용하여 데이터를 필터링할때 사용할 컬럼명
 * @param : sAdditionalCondition    후행 콤보박스의 데이터를 필터링하기 위한 추가 조건
 *--------------------------------------------------------------------------------------*/
pForm.bfn_filterComboChain = function(oCombo, oTargetCombo, sTargetColumnName, sAdditionalCondition)
{
    if (!oCombo || !oTargetCombo || !sTargetColumnName) return;
    if (!oCombo.value) {oCombo.set_index(0);if (!oCombo.value) return;}

    oCombo.tempTargetCombo = oTargetCombo;
    oCombo.tempTargetColumnName = sTargetColumnName;
    oCombo.tempAdditionalCondition = sAdditionalCondition;
    oCombo.addEventHandler('onitemchanged' ,
        function (obj, e) {
            this.bfn_filterComboDataset(obj.tempTargetCombo, obj.tempTargetColumnName, e.postvalue, obj.tempAdditionalCondition);
        }, this);

    oInnerDs = this.objects[oCombo.innerdataset];
    oInnerDs.tempTargetCombo = oTargetCombo;
    oInnerDs.tempTargetColumnName = sTargetColumnName;
    oInnerDs.tempAdditionalCondition = sAdditionalCondition;
    oInnerDs.tempCodecolumn = oCombo.codecolumn;
    oInnerDs.addEventHandler('onrowsetchanged' ,
        function (obj,e) {
            this.bfn_filterComboDataset(obj.tempTargetCombo, obj.tempTargetColumnName, obj.getColumn(0, obj.tempCodecolumn), obj.tempAdditionalCondition);
        }, this);

    this.bfn_filterComboDataset(oTargetCombo, sTargetColumnName, oCombo.value, sAdditionalCondition);
};

/*---------------------------------------------------------------------------------------
 * 콤보박스와 바인딩된 데이터셋을 필터링 한다.
 * @param : oTargetCombo            후행 콤보박스 오브젝트
 * @param : sTargetColumnName       후행 콤보박스에서 선행 콤보박스의 값을 이용하여 데이터를 필터링할때 사용할 컬럼명
 * @param : sFilterValue            후행 콤보박스에서 데이터를 필터링할때 사용할 값
 * @param : sAdditionalCondition    후행 콤보박스의 데이터를 필터링하기 위한 추가 조건
 *--------------------------------------------------------------------------------------*/
pForm.bfn_filterComboDataset = function(oTargetCombo, sTargetColumnName, sFilterValue, sAdditionalCondition)
{
    var filterString = sTargetColumnName + "=='" + sFilterValue + "'" + (sAdditionalCondition ? sAdditionalCondition : "");
