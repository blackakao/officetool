 * 특정 데이터셋의 특정 행(row) 데이터를 객체화하여 반환한다. 컴럼명은 객체의 프로퍼티명(camel case를 따름)이 되며, 값은 프로퍼티값으로 매핑된다.
 * @param : oDataset    객체화할 row를 가지고 있는 데이터셋 오브젝트
 * @param : nRow        객체화할 row 인덱스
 * @param : isNonCamelCase  속성명 CamelCase 여부(default=false)   //:)추가/2018.10.26 금
 *--------------------------------------------------------------------------------------*/
pForm.bfn_getObjectFromRow = function(oDataset, nRow, isNonCamelCase)
{
    var row = nRow ? nRow : 0;
    var isNonCamelCase = (isNonCamelCase == undefined || isNonCamelCase == null) ? false : isNonCamelCase;

    if (!oDataset || !(oDataset instanceof Dataset)) return;
    var columnCount = oDataset.getColCount();
    var returnObject = {};
    for(var i=0; i<columnCount; i++) {
        var columnInfo = oDataset.getColumnInfo(i);
        //var propName = this.bfn_getCamelCase(columnInfo.name);
        var propName = isNonCamelCase ? columnInfo.name : this.bfn_getCamelCase(columnInfo.name);  //:)변경/2018.10.26 금
        returnObject[propName] = oDataset.getColumn(row, columnInfo.name);
    }
    return returnObject;
};

/*---------------------------------------------------------------------------------------
 * "_"를 포함한 문자열을 camel case로 변환한다.
 * @param : oDataset    객체화할 row를 가지고 있는 데이터셋 오브젝트
 * @param : nRow        객체화할 row 인덱스
 *--------------------------------------------------------------------------------------*/
pForm.bfn_getCamelCase = function(sStr)
{
    return sStr.toLowerCase().replace(/(\_[a-z])/g, function($1) {return $1.toUpperCase().replace('_','');});
};

/*---------------------------------------------------------------------------------------
 * 대상 컴포넌트의 세로 위치를 특정 컴포넌트를 기준으로 가운데 위치하게 한다.
 * @param : oObj            위치를 조정할 대상 컴포넌트
 * @param : nBaseHeight     기준이 되는 컴포넌트의 높이 ex) component.position.height
 *--------------------------------------------------------------------------------------*/
pForm.bfn_setVerticalCenterPosition = function(oObj, nBaseHeight)
{
    if (!oObj || !nBaseHeight) return;
    var targetObject = oObj;
    var TARGET_HEIGHT = targetObject.getOffsetBottom() - targetObject.getOffsetTop();
    var top = Math.round(nBaseHeight/2) - Math.round(TARGET_HEIGHT/2);
    var bottom = top + TARGET_HEIGHT;
    targetObject.setOffsetTop(top);
    targetObject.setOffsetBottom(bottom);
};

/*---------------------------------------------------------------------------------------
 * 대상 컴포넌트의 가로 위치를 특정 컴포넌트를 기준으로 가운데 위치하게 한다.
 * @param : oObj            위치를 조정할 대상 컴포넌트
 * @param : nBaseWidth      기준이 되는 컴포넌트의 너비 ex) component.position.width
 *--------------------------------------------------------------------------------------*/
pForm.bfn_setHorizontalCenterPosition = function(oObj, nBaseWidth)
{
    if (!oObj || !nBaseWidth) return;
    var targetObject = oObj;
    var TARGET_WIDTH = targetObject.getOffsetRight() - targetObject.getOffsetLeft();
    var left = Math.round(nBaseWidth/2) - Math.round(TARGET_WIDTH/2);
    var right = left + TARGET_WIDTH;
    targetObject.setOffsetLeft(left);
    targetObject.setOffsetRight(right);
};

/*---------------------------------------------------------------------------------------
 * 대상 컴포넌트의 가로 및 세로 위치를 특정 컴포넌트를 기준으로 가운데 위치하게 한다.
 * @param : oObj        위치를 조정할 대상 컴포넌트
 * @param : oBaseObj    기준이 되는 컴포넌트
 * @param : sMode       위치 조절 구분 (A: 정가운데, V: 세로 가운데, H: 가로 가운데)
 *--------------------------------------------------------------------------------------*/
pForm.bfn_setCenterPosition = function(oObj, oBaseObj, sMode)
{
    if (!oObj || !oBaseObj || !oBaseObj.position) return;
    var baseHeight = oBaseObj.getOffsetBottom() - oBaseObj.getOffsetTop();
    var baseWidth = oBaseObj.getOffsetRight() - oBaseObj.getOffsetLeft();
    if (!sMode) {
        this.bfn_setHorizontalCenterPosition(oObj, baseWidth);
    } else if (sMode == "A") {
        this.bfn_setVerticalCenterPosition(oObj, baseHeight);
        this.bfn_setHorizontalCenterPosition(oObj, baseWidth);
    } else if (sMode == "V") {
        this.bfn_setVerticalCenterPosition(oObj, baseHeight);
    } else {
        this.bfn_setHorizontalCenterPosition(oObj, baseWidth);
    }
};

/*---------------------------------------------------------------------------------------
 * 데이터 셋과 컴포넌트를 동적으로 바인딩 한다.
