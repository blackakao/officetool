/*---------------------------------------------------------------------------------------
 * 후행 콤보박스의 데이터를 표시하기 위해 특정 로직(function)을 실행한다.
 * @param : oTargetCombo    후행 콤보박스 오브젝트
 * @param : oFunction       후행 콤보박스에서 데이터를 표시하기 위해 실행해야할 함수
 * @param : aPrmArray       후행 콤보박스에서 데이터를 표시하기 위해 실행해야할 함수의 인자 배열 (인자값 중 실행시간(Runtime)에 결정되어야 할 인자값은 실행가능한 스크립트 문자열 형태에 "d:" 를 붙여야 한다. ex) "d:someComponent.value")
 *--------------------------------------------------------------------------------------*/
pForm.bfn_callInputFunction = function(oTargetCombo, oFunction, aPrmArray)
{
    var prms = [];
    for(var i=0; i<aPrmArray.length; i++) {
        if (typeof aPrmArray[i] === "string" && aPrmArray[i].indexOf("d:") >= 0) {
            prms.push(eval(aPrmArray[i].split("d:")[i]));
        } else prms.push(aPrmArray[i]);
    }
    oFunction.apply(this, prms);
    oTargetCombo.set_index(0);
};

