/*---------------------------------------------------------------------------------------
 * 시범사업 참여기관 종사자 메뉴 권한 조회
 * @param : pgmId           종사자 프로그램 ID  
 *          arrAdminPttnCd 	기관유형코드			
 *--------------------------------------------------------------------------------------*/
pForm.bfn_selectNpsAuthInfo = function(pgmId, arrAdminPttnCd)
{ 			
	//임시로 데이터셋(in) 생성
    var inDataset = new Dataset;
    inDataset.set_name("ds_authCond");
	inDataset.addColumn("PGM_ID", "STRING");  	
    inDataset.addRow();    
    inDataset.setColumn(0,"PGM_ID", pgmId);	
    this.addChild(inDataset.name, inDataset);
			
	//임시로 데이터셋(out) 생성
	var outDataset = new Dataset;
    outDataset.set_name("ds_authResult");	
    this.addChild(outDataset.name, outDataset);	
	
	var outDataset2 = new Dataset;
    outDataset2.set_name("ds_adminPttnCd");	
    this.addChild(outDataset2.name, outDataset2);	
	
	
    var sSvcId = "selectAuthInfo";
    var sPath  = "/s/c/100/selectAuthInfo.do";
    var sInputDsName = "ds_cond=" + inDataset.name;
    var sOutputDsName = outDataset.name + "=ds_result " + outDataset2.name + "=ds_adminPttnCd";
    var sArg = "";
    var oPreArgs = "";
    var sCallback = "bfn_callBack_common";
    var bASync    = false;
    var bWait     = true;
    var bBinary   = true;
    var bCompress = false;

	//트렌젝션 호출
    this.gfn_callService(sSvcId, sPath, sInputDsName, sOutputDsName, sArg, oPreArgs, sCallback, bASync, bWait, bBinary, bCompress);
	
	//trace(outDataset2.saveXML());
	
	//기관유형 체크
	var adminPttnYn = (arrAdminPttnCd != null && arrAdminPttnCd.length > 0) ? "N" : "Y";
	if(adminPttnYn == "N") {
		for(var i = 0; i < arrAdminPttnCd.length; i++) {
			if(outDataset2.getCaseCount("ADMIN_PTTN_CD=='" + arrAdminPttnCd[i] + "'") > 0) {
				adminPttnYn = "Y";
				break;
			}		
		}
	}	
		
	//결과값
	var admYn      = outDataset.rowcount >= 1 ? outDataset.getColumn(0, "ADM_YN") : "N";
	var userAtrtCd = outDataset.rowcount >= 1 ?	outDataset.getColumn(0, "USER_ATRT_CD") : "";	
	
	//임시로 생성한 데이터셋 삭제
	var objInDataset = this.removeChild(inDataset.name);
    objInDataset.destroy();	
	var objOutDataset = this.removeChild(outDataset.name);
    objOutDataset.destroy();
	var objOutDataset2 = this.removeChild(outDataset2.name);
    objOutDataset2.destroy();
		
	//참여신청여부(admYn)가 승인이 아닐때
	if(admYn != "Y") {		
		return admYn;					
	} else if(adminPttnYn != "Y") {
		return "X";		
	} 
		
	return userAtrtCd;	
	
};

