 *--------------------------------------------------------------------------------------*/
pForm.bfn_isMale = function(sCustNo)
{
    if (!sCustNo) return null;
    if (parseInt(sCustNo.substr(6, 1))%2) return true;
    else return false;
};

/*---------------------------------------------------------------------------------------
 * 주민등록 번호를 입력받아 생년월일을 YYYYMMDD 형태로 반환한다.
 * @param : sCustNo         주민등록번호
 *--------------------------------------------------------------------------------------*/
pForm.bfn_getBirthday = function(sCustNo)
{
    if (!sCustNo) return null;
    var key = sCustNo.substr(6, 1);
    if (key == "9" || key == "0") return "18" + sCustNo.substr(0, 6);
    else if (key == "1" || key == "2" || key == "5" || key == "6") return "19" + sCustNo.substr(0, 6);
    else if (key == "3" || key == "4" || key == "7" || key == "8") return "20" + sCustNo.substr(0, 6);
};

/*---------------------------------------------------------------------------------------
 * 주민등록 번호를 입력받아 만 나이를 반환한다.
 * @param : sCustNo         주민등록번호
 *--------------------------------------------------------------------------------------*/
pForm.bfn_getManAge = function(sCustNo)
{
    if (!sCustNo) return null;
    var birthday = this.bfn_getBirthday(sCustNo);
    var today = this.gfn_getDbToday();
    var age = 0;

    var byear = parseInt(birthday.substr(0, 4));
    var bmonth = parseInt(birthday.substr(4, 2));
    var bday = parseInt(birthday.substr(6, 2));
    var tyear = parseInt(today.substr(0, 4));
    var tmonth = parseInt(today.substr(4, 2));
    var tday = parseInt(today.substr(6, 2));

    if (tmonth > bmonth || (tmonth == bmonth && tday >= bday)) return tyear - byear;
    else return tyear - (byear + 1);
};

/*---------------------------------------------------------------------------------------
 * 주민등록 번호와 숫자를 입력받아 숫자에 해당하는 만 나이가 되는 일자를 반환한다.
 * @param : sCustNo         주민등록번호
 * @param : nAge            만 나이
 *--------------------------------------------------------------------------------------*/
pForm.bfn_getManAgeAdvtDd = function(sCustNo, nAge)
{
    if (!sCustNo) return null;
    var age = nAge ? nAge : 65;
    var birthday = this.bfn_getBirthday(sCustNo);

    var byear = parseInt(birthday.substr(0, 4));
    byear += age;
    return "" + byear + sCustNo.substr(2, 4);
};


