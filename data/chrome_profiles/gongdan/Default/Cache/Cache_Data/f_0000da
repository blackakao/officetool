        this.setWkgHr = function(){
        	var nTotalTime = 0;
        	var moreLess = 0;
        	this.ds_eggrWkgList.set_enableevent(false);
        	for(i=0; i<this.ds_eggrWkgListTemp.rowcount; i++) {
        		nTotalTime += this.toNum(this.ds_eggrWkgListTemp.getColumn(i, "DAY_REAL_WKG_TM")) +
        			this.toNum(this.ds_eggrWkgListTemp.getColumn(i, "NGT_REAL_WKG_TM")) +
        				this.toNum(this.ds_eggrWkgListTemp.getColumn(i, "WKG_RCGT_TM")) * 60;
        	}
        	this.ds_eggrWkgList.set_enableevent(true);

        	moreLess = parseInt(this.ds_cond.getColumn(0, "WORKING_TIME"))*60 - nTotalTime;

        	if(moreLess > 0){
        		moreLess = " / "+ this.minToHour(moreLess) + " 부족";
        	}
        	else{
        		//moreLess = " / "+ minToHour(Math.abs(moreLess)) + " 초과"
        		moreLess = "";
        	}

        	this.stc_wkgHr.set_text(this.minToHour(nTotalTime) + moreLess);
        };

        this.minToHour = function(min ){
        	var tm = Math.floor(min/60) + "시간";
        	if ( min%60 > 0 ){
        		tm = tm + " " + (min%60) + "분";
        	}
        	return tm;
        };

