        this.fn_pageOutScreen = function(objForm)
        {
        	//trace("페이지 out");
        	var objApp = nexacro.getApplication();
        	var objMDIFrame = objApp.av_oWorkFrame;
        	var objFrame = objForm.getOwnerFrame();

        	var sScreenId = objFrame.name;
        //trace("_bizInfo===="+objForm._bizInfo+":::::sScreenId==="+sScreenId);

        	//열린메뉴 dataset 설정
        	var nRow = objApp.gds_openMenu.findRow("screen_id", sScreenId);
        	objApp.gds_openMenu.setColumn(nRow, "screen_out", "Y");

        	var nTitleHeight = 24;
         	var nLeft   = system.clientToScreenX(objForm, 0);
         	var nTop    = system.clientToScreenY(objForm, 0);
        	var nWidth  = objFrame.getOffsetWidth() + 2;
        	var nHeight = objFrame.getOffsetHeight() + 2 + nTitleHeight;

        	var oArgs = { nLeft   : nLeft
        	             ,nTop    : nTop
        	             ,nWidth  : nWidth
        			     ,nHeight : nHeight
        				 ,nTitleHeight : nTitleHeight
        				 ,menuId  : objForm._bizInfo.menuId
        		        };
        //trace("nLeft=="+nLeft+"::::nTop=="+nTop+"::::nWidth=="+nWidth+"::::nHeight=="+nHeight);

        	//화면종료
        	this.fv_objMenuInfo = oArgs;
        	objForm.fv_bPageFlag = true;	//page In, Out 여부
        	//objForm.setFocus();
        	objForm.close();

        	//새창열기
        	this.setTimer(1, 1000);
        };

