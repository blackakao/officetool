        {
        	this.ds_output.clearData();
            var sTrId		= "checkAnysignMsg";
            //var sPath		= this.gfn_getServerUrl() + "assets/solution/AnySign4PC/anysign_result.jsp";
        	var sPath		= "svcUrl::/assets/solution/AnySign4PC/anysign_result.jsp";
            var sArg		= "";
            var sInputDs	= "ds_anysign=ds_anysign:A";
            var sOutputDs	= "ds_output=ds_output";
            var sCallBack	= "fn_callBackAnysignResult";
        	this.transaction(sTrId, sPath, sInputDs, sOutputDs, sArg, sCallBack, false, 2);
        }

        //anysign 인증서 검증 callback
        this.fn_callBackAnysignResult = function(sTrId,nErrCd,sErrMsg)
        {
        //trace("fn_callBackAnysign"+"::::sTrId==="+sTrId+"::::nErrCd==="+nErrCd+"::::sErrMsg==="+sErrMsg);
        	if ( nErrCd != 0 ) {
        		if ( !this.gfn_isNull(this.fv_callBackFuncAnysign) ) {
        			this.fv_callBackFormAnysign[this.fv_callBackFuncAnysign].call(this.fv_callBackFormAnysign, false, nErrCd, sErrMsg);
        		}
        	}
        	else {
        		var nRtnCode = this.ds_output.getColumn(0,"aErrCode");
        		var sRtnMsg  = this.ds_output.getColumn(0,"aErrReason");
        		if ( !this.gfn_isNull(this.fv_callBackFuncAnysign) ) {
        			if(nRtnCode == 0) {
        				//trace("로직 실행 콜백 호출 : " + sRtnMsg);
        				this.fv_callBackFormAnysign[this.fv_callBackFuncAnysign].call(this.fv_callBackFormAnysign, true, nRtnCode, sRtnMsg);
        			} else {
        				//trace("로직 실행 콜백 호출 : " + sRtnMsg);
        				this.fv_callBackFormAnysign[this.fv_callBackFuncAnysign].call(this.fv_callBackFormAnysign, false, nRtnCode, sRtnMsg);
