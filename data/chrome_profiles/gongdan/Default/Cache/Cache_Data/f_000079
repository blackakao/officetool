//공통 트랜잭션 callback
pForm._gfn_callBack = function(sSvcId, nErrorCode, sErrorMsg)
{
	//this.gfn_jspdEnd();
//trace(	"sSvcId==="+sSvcId+"::::nErrorCode==="+nErrorCode+"::::sErrorMsg==="+sErrorMsg);
// 	if(this.parent["ds_bizLog"] || this.parent.parent["ds_bizLog"]){
// 		this.ifn_setTraffic();
// 	}
	
	var objSvcID = JSON.parse(sSvcId);
	
	var sSvcId			= objSvcID.svcId;
	var sWait			= objSvcID.isWait;
	var sUserCallback	= objSvcID.callback;
	var oResultDs		= this.objects[objSvcID.outDs];
	
	if(sWait == "Y") this.setWaitCursor(false, true);
	
	this.GV_nErrorCode  = nErrorCode;
	this.GV_strErrorMsg = sErrorMsg;
//trace(	"sSvcId==="+sSvcId+"::::nErrorCode==="+nErrorCode+"::::sErrorMsg==="+sErrorMsg);	
	if(!this.gfn_isNull(oResultDs))
	{
		oResultDs.appendData(this.objects[objSvcID.outDs + "_paging"]);
	}
// trace("sSvcId==="+sSvcId);
// trace("sWait==="+sWait);
// trace("sUserCallback==="+sUserCallback);
// 	var oResultDs		= eval(objSvcID.outDs);
// 	
// 	if(!this.gfn_isNull(oResultDs))
// 	{
// 		oResultDs.appendData(eval(objSvcID.outDs+"_paging"));
// 	}
	
	// System Exception
    if(nErrorCode == -1)
	{
		if(sSvcId != "login") {
			var aMsg = sErrorMsg.split("|");
			var args = {argSvcId:sSvcId, argErrorCode:nErrorCode, argErrorMsg:aMsg[1], argMsgCd:aMsg[0]};
			//this.gfn_msgShow(this, nErrorCode+"::::"+sErrorMsg);
			this.ifn_detailShowMsg(args);
			return;
		}
	}
	
	// Business Exception
	if(nErrorCode == -2)
	{
		if(sSvcId != "login") {
			var aMsg = sErrorMsg.split("|");
			var sMsgCode = aMsg[0];
			//this.gfn_msgShow(this, aMsg[0],[aMsg[1]]);//에러가 발생했습니다.\n{0}
			
			var errMsg = aMsg[1].replace(/\\n/g, String.fromCharCode(13, 10));
			
			this.alert(errMsg);
			
			// form에 callback 함수가 있을때
			if (this[sUserCallback+"Err"]) {
				this[sUserCallback+"Err"].call(this, sSvcId, nErrorCode, aMsg[1], aMsg[0]);
			}
			return;			
		}
	}	

	// SessionOut Exception
	if(!nexacro.getApplication().gv_isQuick) {
		if(nErrorCode == -3)
		{
//trace("sErrorMsg==="+sErrorMsg);
			nexacro.getApplication().av_installPage  = false;		// install 페이지로 이동할지 여부
			nexacro.getApplication().av_bDirLogout = true;		// "로그아웃 하시겠습니까?" confirm창을 뜨우지 않고 로그아웃할지 여부
			//var rtn = this.gfn_msgShow(this,"XETZ0047", [sErrorMsg], "C");
			var rtn = this.gfn_msgShow(this,sErrorMsg, "", "C");
			if ( rtn == true) {
				nexacro.getApplication().exit();
				return;
			}				
		}	
	}	
	
	// 화면의 callBack 함수 실행
	if(!this.gfn_isNull(sUserCallback))
	{
		// form에 callback 함수가 있을때
		if (this[sUserCallback]) this[sUserCallback].call(this, sSvcId, nErrorCode, sErrorMsg);
	}
};

/**
 * @class Form에 있는 Dataset의 변경여부를 반환 <br>
 * @param  objForm - form object
 * @return {boolean} true/false
 */
pForm.gfn_isUpdatedDataset = function(objForm) 
{
	arrObj = objForm.objects;
	for(var i=0; i<arrObj.length; i++) {
		if (arrObj[i] instanceof Dataset) {
			if(arrObj[i].updatedCheck != "true") continue;
			if(this.gfn_isUpdatedDs(arrObj[i])) {
				if(!this.gfn_msgShow(objForm,"변경된 데이터가 존재합니다.\n현재선택한 작업을 \n계속해서 진행하시겠습니까?",null,"C")) {
					return false;
				}
			}
		}
	}
	return true;
};

pForm.gfn_setTransInfo = function(svcid, strURL, inputDs, outputDs)
{
	var objApp = nexacro.getApplication();
	objApp.gds_transInfo.clearData();

	var dsInputName = this.splitDsName(inputDs,0);
	var dsOutputName = this.splitDsName(outputDs,1);
	
	for (var i = 0; i < dsInputName.length ; i++ ){
		var row = objApp.gds_transInfo.addRow();
		if (i == 0){										//svc id 와 url은 하나이다.
			objApp.gds_transInfo.setColumn(row,0, svcid);
			objApp.gds_transInfo.setColumn(row,1, strURL);
		}
		objApp.gds_transInfo.setColumn(row,2, dsInputName[i]);
	}
	
	for (var i = 0; i < dsOutputName.length ; i++ ){
		objApp.gds_transInfo.setColumn(row,3, dsOutputName[i]);
	}
	
};


pForm.splitDsName = function(objString, type){
	var strDsMapping;			//mapping string
	var objArr;					//dataset name array
	var objReturn = new Array();
	
	if(objString == null) objString = "";
	strDsMapping = objString.split(" ");
	
	for (var i = 0; i < strDsMapping.length ; i++ ){
		objArr = strDsMapping[i].split("=");    // objArr = a,cd
		if (type == 0)
			objReturn[i] = objArr[0];
		else
			objReturn[i] = objArr[1];
	}
	
	return objReturn;
};


