        this.fn_selectWorkTime = function(Type)
        {

            var work_time_total_Wrk=0;
            var work_time_total_Hday=0;
            var work_time_total_Dtl=0;

            for(var i=0; i<this.ds_data.rowcount; i++ ){
                this.ds_data.setColumn(i, "WORK_TIME", null);
                var day_real_wkg_tm_wrk=0;
                var ngt_real_wkg_tm_wrk=0;

                work_time_total_Wrk=0;
                work_time_total_Hday=0;
                work_time_total_Dtl=0;

                //근무만 있는경우
                for(var j=0; j<this.ds_eggrWkgList.rowcount; j++ ){
                    if(this.ds_eggrWkgList.getColumn(j,"WKG_DD") == this.ds_data.getColumn(i,"WORK_DATE")){

                        var dayWorkTm = this.fn_getWorkTime2("DAY", this.toStr(this.ds_eggrWkgList.getColumn(j, "WKG_FR_HR_MT")), this.toStr(this.ds_eggrWkgList.getColumn(j, "WKG_TO_HR_MT")));
                        var ngtWorkTm = this.fn_getWorkTime2("NGT", this.toStr(this.ds_eggrWkgList.getColumn(j, "WKG_FR_HR_MT")), this.toStr(this.ds_eggrWkgList.getColumn(j, "WKG_TO_HR_MT")));
                        var dayWorkTm2 = this.fn_getWorkTime2("DAY", this.toStr(this.ds_eggrWkgList.getColumn(j, "WKG_FR_HR_MT2")), this.toStr(this.ds_eggrWkgList.getColumn(j, "WKG_TO_HR_MT2")));
                        var ngtWorkTm2 = this.fn_getWorkTime2("NGT", this.toStr(this.ds_eggrWkgList.getColumn(j, "WKG_FR_HR_MT2")), this.toStr(this.ds_eggrWkgList.getColumn(j, "WKG_TO_HR_MT2")));
                        var exceptDay = this.toNum(this.ds_eggrWkgList.getColumn(j, "EXCEPT_DAY_TM"));
                        var exceptNgt = this.toNum(this.ds_eggrWkgList.getColumn(j, "EXCEPT_NGT_TM"));
                        var exceptDay2 = this.toNum(this.ds_eggrWkgList.getColumn(j, "EXCEPT_DAY_TM2"));
                        var exceptNgt2 = this.toNum(this.ds_eggrWkgList.getColumn(j, "EXCEPT_NGT_TM2"));
                        day_real_wkg_tm_wrk += dayWorkTm+dayWorkTm2;
                        ngt_real_wkg_tm_wrk += ngtWorkTm+ngtWorkTm2;
                        work_time_total_Wrk = work_time_total_Wrk + this.toNum(day_real_wkg_tm_wrk) + this.toNum(ngt_real_wkg_tm_wrk)-exceptDay-exceptNgt-exceptDay2-exceptNgt2;
                        this.ds_data.setColumn(i,"WORK_TIME", work_time_total_Wrk);
                    }
                }//for

                //휴가만 있는경우
               for(var k=0; k<this.ds_eggrWkgHdayList.rowcount; k++ ){
                    if(this.ds_eggrWkgHdayList.getColumn(k,"WKG_DD") == this.ds_data.getColumn(i,"WORK_DATE")
                    ){
                        var  dayWorkTm_Hday = this.fn_getWorkTime2("DAY", this.toStr(this.ds_eggrWkgHdayList.getColumn(k, "WKG_FR_HR_MT")), this.toStr(this.ds_eggrWkgHdayList.getColumn(k, "WKG_TO_HR_MT")));
                        var  ngtWorkTm_Hday = this.fn_getWorkTime2("NGT", this.toStr(this.ds_eggrWkgHdayList.getColumn(k, "WKG_FR_HR_MT")), this.toStr(this.ds_eggrWkgHdayList.getColumn(k, "WKG_TO_HR_MT")));
                        /* 추가 start */
                        var  dayWorkTm2_Hday = this.fn_getWorkTime2("DAY", this.toStr(this.ds_eggrWkgHdayList.getColumn(k, "WKG_FR_HR_MT2")), this.toStr(this.ds_eggrWkgHdayList.getColumn(k, "WKG_TO_HR_MT2")));
                        var  ngtWorkTm2_Hday = this.fn_getWorkTime2("NGT", this.toStr(this.ds_eggrWkgHdayList.getColumn(k, "WKG_FR_HR_MT2")), this.toStr(this.ds_eggrWkgHdayList.getColumn(k, "WKG_TO_HR_MT2")));
                        /* 추가 end */
                        var  wkgRcgtTmHday = this.toNum(this.ds_eggrWkgHdayList.getColumn(k, "WKG_RCGT_TM"));
                        var exceptDay = this.toNum(this.ds_eggrWkgHdayList.getColumn(k, "EXCEPT_DAY_TM"));
                        var exceptNgt = this.toNum(this.ds_eggrWkgHdayList.getColumn(k, "EXCEPT_NGT_TM"));
                        var  WKG_RCGT_CD = this.ds_eggrWkgHdayList.getColumn(k, "WKG_RCGT_CD");
                        /* 기존소스
                        work_time_total_Hday = this.toNum(work_time_total_Hday) + (this.toNum(dayWorkTm_Hday) + this.toNum(ngtWorkTm_Hday) + this.toNum(wkgRcgtTmHday)-exceptDay-exceptNgt);
                        */

                        if(Type=="select"){
                            /* 수정 start */
                            work_time_total_Hday = this.toNum(work_time_total_Hday) + (this.toNum(dayWorkTm_Hday) + this.toNum(ngtWorkTm_Hday) + this.toNum(dayWorkTm2_Hday) + this.toNum(ngtWorkTm2_Hday) + this.toNum(wkgRcgtTmHday)-exceptDay-exceptNgt);
                            /* 수정 end */
                            this.ds_data.setColumn(i,"WORK_TIME", work_time_total_Hday);
                        }

                        if(Type=="save"){
                           if(WKG_RCGT_CD !="67"){
                                /* 수정 start */
                                work_time_total_Hday = this.toNum(work_time_total_Hday) + (this.toNum(dayWorkTm_Hday) + this.toNum(ngtWorkTm_Hday) + this.toNum(dayWorkTm2_Hday) + this.toNum(ngtWorkTm2_Hday) + this.toNum(wkgRcgtTmHday)-exceptDay-exceptNgt);
                                /* 수정 end */
                                this.ds_data.setColumn(i,"WORK_TIME", work_time_total_Hday);
                           }
                        }
                     }
                }
                //trace ("work_time_total_Hday "+work_time_total_Hday);
                // 상세만 있는경우
                for(var t=0; t<this.ds_eggrWkgDtlList.rowcount; t++ ){
                    if(this.ds_eggrWkgDtlList.getColumn(t,"WKG_DD") == this.ds_data.getColumn(i,"WORK_DATE")){
                        var wkgTypeCd = this.ds_eggrWkgDtlList.getColumn(t,"WKG_TYPE_CD");
                        var  dayWorkTm_Dtl = this.fn_getWorkTime2("DAY", this.toStr(this.ds_eggrWkgDtlList.getColumn(t, "WKG_FR_HR_MT")), this.toStr(this.ds_eggrWkgDtlList.getColumn(t, "WKG_TO_HR_MT")));
                        var  ngtWorkTm_Dtl = this.fn_getWorkTime2("NGT", this.toStr(this.ds_eggrWkgDtlList.getColumn(t, "WKG_FR_HR_MT")), this.toStr(this.ds_eggrWkgDtlList.getColumn(t, "WKG_TO_HR_MT")));
                        var except_dayTm = this.ds_eggrWkgDtlList.getColumn(t, "EXCEPT_DAY_TM");
                        if(wkgTypeCd =="01"){
                            work_time_total_Dtl +=  this.toNum(dayWorkTm_Dtl) + this.toNum(ngtWorkTm_Dtl)- this.toNum(except_dayTm);
                        }else if(wkgTypeCd =="10"){
                            work_time_total_Dtl += 0;
                        }else{
                            work_time_total_Dtl +=  this.toNum(dayWorkTm_Dtl) + this.toNum(ngtWorkTm_Dtl);
                        }
                        this.ds_data.setColumn(i,"WORK_TIME", work_time_total_Dtl);
                    }
                }

                //근무 +휴가  있는경우
                for(var j=0; j<this.ds_eggrWkgList.rowcount; j++ ){
                    if(this.ds_eggrWkgList.getColumn(j,"WKG_DD") == this.ds_data.getColumn(i,"WORK_DATE")){
                        for(var k=0; k<this.ds_eggrWkgHdayList.rowcount; k++ ){
                            if(this.ds_eggrWkgHdayList.getColumn(k,"WKG_DD") == this.ds_data.getColumn(i,"WORK_DATE")
                            && this.ds_eggrWkgList.getColumn(j,"WKG_DD") == this.ds_data.getColumn(i,"WORK_DATE")
                            ){
                                this.ds_data.setColumn(i,"WORK_TIME", work_time_total_Wrk+work_time_total_Hday)
                            }
                        }
                    }
                }//for

                //근무 +상세  있는경우
               for(var j=0; j<this.ds_eggrWkgList.rowcount; j++ ){
                    if(this.ds_eggrWkgList.getColumn(j,"WKG_DD") == this.ds_data.getColumn(i,"WORK_DATE")){
                        for(var k=0; k<this.ds_eggrWkgDtlList.rowcount; k++ ){
                            if(this.ds_eggrWkgDtlList.getColumn(k,"WKG_DD") == this.ds_data.getColumn(i,"WORK_DATE")
                            && this.ds_eggrWkgList.getColumn(j,"WKG_DD") == this.ds_data.getColumn(i,"WORK_DATE")
                            ){
                                this.ds_data.setColumn(i,"WORK_TIME", work_time_total_Wrk+work_time_total_Dtl);
                            }
                        }
                    }
               }//for


               // 교육+상세만 있는겨우
               for(var k=0; k<this.ds_eggrWkgHdayList.rowcount; k++ ){
                    if(this.ds_eggrWkgHdayList.getColumn(k,"WKG_DD") == this.ds_data.getColumn(i,"WORK_DATE")
                    ){
                       for(var t=0; t<this.ds_eggrWkgDtlList.rowcount; t++ ){
                            if(this.ds_eggrWkgDtlList.getColumn(t,"WKG_DD") == this.ds_data.getColumn(i,"WORK_DATE")
                            && this.ds_eggrWkgHdayList.getColumn(k,"WKG_DD") == this.ds_data.getColumn(i,"WORK_DATE")
                            ){
                                this.ds_data.setColumn(i,"WORK_TIME",work_time_total_Hday+ work_time_total_Dtl);
                            }
                        }
                    }
               }

                //근무 +교육 +상세  있는경우
               for(var j=0; j<this.ds_eggrWkgList.rowcount; j++ ){
                    if(this.ds_eggrWkgList.getColumn(j,"WKG_DD") == this.ds_data.getColumn(i,"WORK_DATE")){
                        for(var k=0; k<this.ds_eggrWkgHdayList.rowcount; k++ ){
                            if(this.ds_eggrWkgHdayList.getColumn(k,"WKG_DD") == this.ds_data.getColumn(i,"WORK_DATE")
                            && this.ds_eggrWkgList.getColumn(j,"WKG_DD") == this.ds_data.getColumn(i,"WORK_DATE")
                            ){
