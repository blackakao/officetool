        //주간야간합계세팅
        this.fn_setDayNgtTime = function()
        {
            //trace(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>");
            //trace(">>>>> " + this.name + ".fn_setDayNgtTime = function()");
            //trace(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>");

            var dayWorkTm = this.fn_getWorkTime("DAY", this.cmb_wkgFrHr.value, this.cmb_wkgFrMt.value, this.cmb_wkgToHr.value, this.cmb_wkgToMt.value);
            var ngtWorkTm = this.fn_getWorkTime("NGT", this.cmb_wkgFrHr.value, this.cmb_wkgFrMt.value, this.cmb_wkgToHr.value, this.cmb_wkgToMt.value);
            var exceptDay = parseInt(this.cmb_dayExcepHr.value)*60 + parseInt(this.cmb_dayExcepMt.value);
            var exceptNgt = parseInt(this.cmb_ngtExcepHr.value)*60 + parseInt(this.cmb_ngtExcepMt.value);
            var dayWorkTm2 = this.fn_getWorkTime("DAY", this.cmb_wkgFrHr2.value, this.cmb_wkgFrMt2.value, this.cmb_wkgToHr2.value, this.cmb_wkgToMt2.value);
            var ngtWorkTm2 = this.fn_getWorkTime("NGT", this.cmb_wkgFrHr2.value, this.cmb_wkgFrMt2.value, this.cmb_wkgToHr2.value, this.cmb_wkgToMt2.value);
            var exceptDay2 = parseInt(this.cmb_dayExcepHr2.value)*60 + parseInt(this.cmb_dayExcepMt2.value);
            var exceptNgt2 = parseInt(this.cmb_ngtExcepHr2.value)*60 + parseInt(this.cmb_ngtExcepMt2.value);

            if(this.cbx_nxtdWkg.value){ //익일근무
                dayWorkTm = this.fn_getWorkTime("DAY", this.cmb_wkgFrHr.value, this.cmb_wkgFrMt.value, "24", "00");
                ngtWorkTm = this.fn_getWorkTime("NGT", this.cmb_wkgFrHr.value, this.cmb_wkgFrMt.value, "24", "00");
                dayWorkTm2 = this.fn_getWorkTime("DAY", "00", "00", this.cmb_wkgToHr2.value, this.cmb_wkgToMt2.value);
                ngtWorkTm2 = this.fn_getWorkTime("NGT", "00", "00", this.cmb_wkgToHr2.value, this.cmb_wkgToMt2.value);
            }

            if(this.cbx_nxtdWkg.value){ //익일근무
                 // 주간제외처리
                 var stc_dayHr=0;
                 var stc_dayHr2=0;
                 if(dayWorkTm >=exceptDay){
                     stc_dayHr  = this.toNum(dayWorkTm) - this.toNum(exceptDay);
                     stc_dayHr2 = this.toNum(dayWorkTm2);
                 } else{
                    stc_dayHr  = 0;
                    stc_dayHr2 = this.toNum(dayWorkTm2) -(this.toNum(exceptDay) -this.toNum(dayWorkTm));
                 }
                 this.stc_dayHr.set_text(this.minToHour(stc_dayHr));
                 this.stc_dayHr2.set_text(this.minToHour(stc_dayHr2));

                 //야간제외처리
                 var stc_ngtHr=0;
                 var stc_ngtHr2=0;
                 if(ngtWorkTm >=exceptNgt){
                     stc_ngtHr  = this.toNum(ngtWorkTm) - this.toNum(exceptNgt);
                     stc_ngtHr2 = this.toNum(ngtWorkTm2);
                 } else{
                    stc_ngtHr  = 0;
                    stc_ngtHr2 = this.toNum(ngtWorkTm2) -(this.toNum(exceptNgt) -this.toNum(ngtWorkTm));
                 }
                 this.stc_ngtHr.set_text(this.minToHour(stc_ngtHr));
                 this.stc_ngtHr2.set_text(this.minToHour(stc_ngtHr2));

                 this.stc_totHr.set_text(this.minToHour(stc_dayHr+stc_ngtHr));
                 this.stc_totHr2.set_text(this.minToHour(stc_dayHr2+stc_ngtHr2));
            }else{
                this.stc_dayHr.set_text(this.minToHour(this.toNum(dayWorkTm) - this.toNum(exceptDay)));
                this.stc_ngtHr.set_text(this.minToHour(this.toNum(ngtWorkTm) - this.toNum(exceptNgt)));
                this.stc_totHr.set_text(this.minToHour(this.toNum(dayWorkTm) - this.toNum(exceptDay) + this.toNum(ngtWorkTm) - this.toNum(exceptNgt)));

                this.stc_dayHr2.set_text(this.minToHour(this.toNum(dayWorkTm2) - this.toNum(exceptDay2)));
                this.stc_ngtHr2.set_text(this.minToHour(this.toNum(ngtWorkTm2) - this.toNum(exceptNgt2)));
                this.stc_totHr2.set_text(this.minToHour(this.toNum(dayWorkTm2) - this.toNum(exceptDay2) + this.toNum(ngtWorkTm2) - this.toNum(exceptNgt2)));
            }

        };


