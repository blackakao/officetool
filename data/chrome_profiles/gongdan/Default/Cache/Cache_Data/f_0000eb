                                    if(this.ds_eggrWkgDtlList.getColumn(t,"WKG_DD") == this.ds_data.getColumn(i,"WORK_DATE")
                                    && this.ds_eggrWkgList.getColumn(j,"WKG_DD") == this.ds_data.getColumn(i,"WORK_DATE")
                                    && this.ds_eggrWkgHdayList.getColumn(k,"WKG_DD") == this.ds_data.getColumn(i,"WORK_DATE")
                                    ){
                                        this.ds_data.setColumn(i,"WORK_TIME",work_time_total_Wrk+work_time_total_Hday+ work_time_total_Dtl);
                                    }
                                }
                            }
                        }
                    }
                }//for


              if(Type=="select"){
                    var workTime = this.ds_data.getColumn(i,"WORK_TIME");
                    var nText    = this.ds_data.getColumn(i,"WORK_TEXT");
                    if(!this.gfn_isEmpty(nText) && !this.gfn_isEmpty(workTime)){
