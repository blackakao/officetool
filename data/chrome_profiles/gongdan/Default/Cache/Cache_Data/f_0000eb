        //칼렌다 체크박스 컨트럴(개별 세팅)
        this.fn_setCheckboxToggle = function()
        {
            //trace(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>");
            //trace(">>>>> " + this.name + ".fn_setCheckboxToggle = function()");
            //trace(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>");

            var cntDay = 0;
            var cntFill = 0;
            var chkAll = true;

            //Row 기준 세팅
            for(var i=0; i<this.ds_bind.rowcount; i++ ){
                for(var j=0; j<7; j++){
                    if( !this.gfn_isEmpty(this.ds_bind.getColumn(i,"day"+j))){
                        cntDay++;
                        if( this.ds_bind.getColumn(i,"work"+j) != null && !this.gfn_isEmpty(this.ds_bind.getColumn(i,"work"+j)) ){ ///
                            cntFill++;
                        }
                    }
                }
                //trace("cntDay : "+cntDay+", cntFill : "+cntFill);
                if(cntDay == cntFill){
                    this.ds_bind.setColumn(i,"weekNo","1");
                }
                else{
                    this.ds_bind.setColumn(i,"weekNo","0");
                }
                cntDay = 0;
                cntFill = 0;

                if(this.ds_bind.getColumn(i,"weekNo") == "0"){
                    chkAll = false;
                }
            }

            //Column 기준 세팅
            for(var j=0; j<7; j++){
                for(var i=0; i<this.ds_bind.rowcount; i++ ){
                    if(!this.gfn_isEmpty(this.ds_bind.getColumn(i,"day"+j))){
                        cntDay++;
                        if( this.ds_bind.getColumn(i,"work"+j) != null && !this.gfn_isEmpty(this.ds_bind.getColumn(i,"work"+j))){ ///
                            cntFill++;
                        }
                    }
                }

                //trace("cntDay : "+cntDay+", cntFill : "+cntFill);
                if(cntDay == cntFill){
                    //this.grid_calendar.setCellProperty("Head",j+1,0,"text","1");
                    this.grid_calendar.setCellProperty("head",j*2+1,"text","1"); ///
                    this.ds_bind.setColumn(0, "week"+j,"1");
                }
                else{
                    //this.grid_calendar.setCellProperty("Head",j+1,0,"text","0");
                    this.grid_calendar.setCellProperty("head",j*2+1,"text","0"); ///
                    this.ds_bind.setColumn(0, "week"+j,"0");
                }
                cntDay = 0;
                cntFill = 0;

                if(this.ds_bind.getColumn(0,"week"+j) == "0"){
                    chkAll = false;
                }
            }

            //월 전체선택 체크박스
            if(chkAll){
                this.grid_calendar.setCellProperty("Head",0,"text","1"); ///
            }
            else{
