        // 근무시간 산출. (분단위)
        this.fn_getWorkTime = function(gubun,inHh,inMm,outHh,outMm )
        {
            //trace(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>");
            //trace(">>>>> " + this.name + ".fn_getWorkTime = function(" + gubun + ", " + inHh + ", " + inMm + ", " + outHh  + ", " + outMm + ")");
            //trace(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>");

            var dayWorkTm = 0; // 주간근로시간
            var ngtWorkTm = 0;  // 야간 근로시간

            var inTm = this.toNum(inHh +"" + inMm);
            var outTm = this.toNum(outHh + "" + outMm );

            for( var i = inHh; i <= outHh; i++){
                if( i == ''){
                    // 근로시간2 근로시간이 설정되지않은경우.
                    break;
                }
                var overMin = 0; //초과분
                var tm = i * 100;

                if (tm >= outTm){
                    break;
                }

                if ( 600 <= tm && tm < 2200 ){
                    // 주간 근무시간대.
                    if ( dayWorkTm == 0 && inHh >= 6 ){
                        overMin = this.toNum(inMm);
                    }
                    dayWorkTm += (60) - overMin;

                    if ( i == outHh ){
                        dayWorkTm -= (60 - this.toNum(outMm));
                    }
                }
                else{
                    // 야간 근무시간대.
                    if ( ngtWorkTm == 0 && (inHh >= 22 || inHh < 6) ){
                        overMin = this.toNum(inMm);
                    }
                    ngtWorkTm += (60) - overMin;

                    if ( i == outHh ){
                        ngtWorkTm -= (60 - this.toNum(outMm));
                    }
                }
            }

            if ( gubun == "NGT" ){
                return ngtWorkTm;
            }
            else{
                return dayWorkTm;
            }

        };


