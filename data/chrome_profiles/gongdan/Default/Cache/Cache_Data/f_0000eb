            //this.fn_bind2Data();
            this.fn_setTotalTime();
        };

        // cell Text 생성
        this.fn_createCellTextDtl = function(day) {
            var sReturn = [];
            sReturn["text"] = "";
            sReturn["value"] = 0;

            var isChecked = false;
            for(var i=0; i<this.grid_wkgDtl.rowcount; i++ ){
                var chk =  this.ds_wkgDtl.getColumn(i,"CHK");
                if(chk == "1"){
                    isChecked = true;
                }
            }

            if(!isChecked){
                this.gfn_msgShow(this, "XWFA0009", []);
                //등록할 근무상세내용을 먼저 체크하세요.
                return;
            }
            /* 2016.06.13 gsg 임산부 단축근무 추가  */
            var wkg_04_tm_sum = 0;
            var wkg_06_tm_sum = 0;

            /* 20180727 KHCHO 수유시간(04), 임산부단축근무시간(06) , 육아기 근로단축(09) 제외한 시간 체크 추가 8시간 한정함*/
            var wkg_else_tm_sum = 0;

            for(var i=0; i<this.grid_wkgDtl.rowcount; i++ ){
                var chk =  this.ds_wkgDtl.getColumn(i,"CHK");


                if(this.toStr(chk) == "1"){
                    var wkg_div = this.ds_wkgDtl.getColumn(i,"WKG_DIV");
                    var wkg_con = this.ds_wkgDtl.getColumn(i,"WKG_CON");
                    var wkg_fr_hr = this.ds_wkgDtl.getColumn(i,"WKG_FR_HR");
                    var wkg_fr_mt = this.ds_wkgDtl.getColumn(i,"WKG_FR_MT");
                    var wkg_to_hr = this.ds_wkgDtl.getColumn(i,"WKG_TO_HR");
                    var wkg_to_mt = this.ds_wkgDtl.getColumn(i,"WKG_TO_MT");
                    var rmk = this.toStr(this.ds_wkgDtl.getColumn(i,"RMK"));
                    var wekWkgExcepTmn1 = this.toNum(this.fn_nvl(this.ds_wkgDtl.getColumn(i,"WEK_WKG_EXCEP_TMN1"),0))*60;
                    var wekWkgExcepTmn2 = this.toNum(this.fn_nvl(this.ds_wkgDtl.getColumn(i,"WEK_WKG_EXCEP_TMN2"),0));
                    var wekWkgExcepTot  =  wekWkgExcepTmn1 +wekWkgExcepTmn2;


                    var wkg_div_txt = this.ds_5077.getColumn(this.ds_5077.findRow("BASE_CD", wkg_div), "BASE_CD_NM");

                    //근무구분이 출장일 경우, 비고 입력여부 체크
                    if ( wkg_div == "02" && rmk == "" ){
                        this.gfn_msgShow(this, "XWFA0010", []);
                        //근무구분이 출장일 경우, 비고에 출장내용을 입력하세요.
                        return ;
                    }

                    //근무구분이 공가이며 근무내용이 기타일경우 비고 입력여부 체크
                    if ( wkg_div == "03" && wkg_con == "04" && rmk == "" ){
                        this.gfn_msgShow(this, "XWFA0011", []);
                        //근무구분이 공가, 근무내용이 기타일 경우  비고에 기타내용을 입력하세요.
                        return;
                    }

                    if ( wkg_fr_hr + wkg_fr_mt == wkg_to_hr + wkg_to_mt){
                        this.gfn_msgShow(this, "XWFA0012", []);
                        //근무시작과 종료시각이 동일합니다
                        return ;
                    }

                    /* 2019.07.15 익일 처리 추가 */
                    if ( wkg_fr_hr > wkg_to_hr)
                    {
                        /* 예  22시 ~ 익일 02시 */
                        var real_wrk_to_hr;
                        //real_wrk_to_hr = this.toStr((24 - this.toNum(wkg_fr_hr)) + this.toNum(wkg_to_hr));
                        real_wrk_to_hr = this.toStr(this.toNum(wkg_to_hr) + 24);
                        trace("실제 환산 시간:" + real_wrk_to_hr);
                        wkg_to_hr = real_wrk_to_hr;
                    }

                    //수유시간 체크
                    /* 2016.06.13 gsg 합산 버그 수정  */
                    if ( wkg_div == "04" ){
                        wkg_04_tm_sum = (this.toNum(wkg_to_hr)*60 + this.toNum(wkg_to_mt)) - (this.toNum(wkg_fr_hr)*60 + this.toNum(wkg_fr_mt)) + wkg_04_tm_sum;
                        var lacTmM04 = this.minToHour(wkg_04_tm_sum);
                        if ( wkg_04_tm_sum > 120 ){
                            this.gfn_msgShow(this, "XWFA0013", [lacTmM04 ]);
                            //수유시간은 1일 2시간까지만 가능합니다.\n입력 수유 시간 : {0}
                            return;
                        }
                    }

                    /* 2016.06.13 gsg 임산부 단축근무 추가  */
                    /* 2019.07.15 육아기 단축근로 추가 */
                    if ( wkg_div == "06" || wkg_div == "09"){
                        wkg_06_tm_sum = (this.toNum(wkg_to_hr)*60 + this.toNum(wkg_to_mt)) - (this.toNum(wkg_fr_hr)*60 + this.toNum(wkg_fr_mt)) + wkg_06_tm_sum;
                        var lacTmM06 = this.minToHour(wkg_06_tm_sum);
                        if ( wkg_06_tm_sum > 120 ){
                            this.gfn_msgShow(this, "XWFA0060", [lacTmM06 ]);
                            //단축근무시간은 1일 2시간까지만 가능합니다.\n입력 시간 : {0}
                            return;
                        }
                    }
                    /* 2019.07.15 육아기 단축근로 추가 */
                    /* 2021.2.8.  PCR 검체 근무시간 검증필요없음.. */
                    if(wkg_div != "01" && wkg_div != "04" && wkg_div != "06" && wkg_div != "09" && wkg_div != "10" ) {
                        wkg_else_tm_sum = (this.toNum(wkg_to_hr)*60 + this.toNum(wkg_to_mt)) - (this.toNum(wkg_fr_hr)*60 + this.toNum(wkg_fr_mt)) + wkg_else_tm_sum;
                        var lacTmMelse = this.minToHour(wkg_else_tm_sum);
                        if ( wkg_else_tm_sum > 540 ){
                            this.gfn_msgShow(this, "XWFA0064", [lacTmMelse ]);
                            //근무시간은 1일 8시간까지만 가능합니다.\n입력 시간 : {0}
                            return;
                        }
                    }

                    if(wkg_div == "01"){
                        wkg_else_tm_sum = (this.toNum(wkg_to_hr)*60 + this.toNum(wkg_to_mt)) - (this.toNum(wkg_fr_hr)*60 + this.toNum(wkg_fr_mt)) + wkg_else_tm_sum;
                        if(wekWkgExcepTot >wkg_else_tm_sum){
                          this.gfn_msgShow(this, "SICA0007", ["휴게시간이 교육시간"]);
                          return;
                        }

                        var wkg_fr_hr2 = this.ds_wkgDtl.getColumn(i,"WKG_FR_HR");
                        var wkg_fr_mt2 = this.ds_wkgDtl.getColumn(i,"WKG_FR_MT");
