        			//this.gfn_msgShow(this, "XETZ0015", ["해외연수는 1일 최대 8시간 인정 가능하며, 연간 8일을 초과"]);  //{0}할 수 없습니다.
        			this.alert("해외연수는 1일 최대 8시간 연간 7일 이내 인정 가능합니다.");
        			return;
        			}
        		}
        	}

            if(bCheck){
                sCell = this.fn_createCellTextDtl(day);
