            //trace(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>");
            //trace(">>>>> " + this.name + ".minToHour = function(" + min + ")");
            //trace(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>");

            var tm = Math.floor(min/60);
            if(tm<10){
               tm ='0'+tm;
            }
            if ( min%60 > 0 ){
                tm = tm.toString() + (min%60).toString();
            }else{
               tm = tm.toString() + "00";
            }
            return tm;

