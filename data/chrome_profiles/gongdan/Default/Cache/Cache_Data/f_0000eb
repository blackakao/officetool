        this.fn_setDateCellTextDtl = function(oDs,nRow,nCell,bCheck,work_text,day) {

            var sCell = [];
            sCell["text"] = "";
            sCell["value"] = 0;
            sCell["time"]  = 0;

            if(this.rad_dclzType.value =="2"  || this.rad_dclzType.value=="3"){
                if(this.cbx_dataWkgAdd.value =="N"){
                    oDs.setColumn(nRow,"work"+nCell,"");
                    oDs.setColumn(nRow,"time"+nCell,0);
                    oDs.setColumn(nRow,"temp"+nCell,"");
                    this.fn_dataDelete(day);
                    return;
                }
            }

            // 데이타 중복 체크로직
            var rowCnt = this.fn_dataDuplicateDtl(day);
            if(rowCnt > 0){
               this.gfn_msgShow(this, "XWTZ0041", []);
               return;
            }

            // 근무와 상세 중복인경우
            rowCnt = this.fn_dataDuplicateWkgDtl(day);
            if(rowCnt > 0){
               this.gfn_msgShow(this, "SETZ0015", ["근무와 상세신고"]);
               return;
            }

            // 휴급근무와 상세 중복인경우
            rowCnt = this.fn_dataDuplicate_Dtl_Hday67(day);
            if(rowCnt > 0){
               this.gfn_msgShow(this, "SETZ0015", ["유급휴가근무 와 교육"]);
               return;
            }

        	//20240101
        	// 교육일수체크(해외연수(20)연7일내) + 해외연수 Code일때만 체크

        	for(var i = 0 ; i < this.ds_wkgDtl.rowcount ; i++){
        		if(this.ds_wkgDtl.getColumn(i,"CHK") == 1 && this.ds_wkgDtl.getColumn(i,"WKG_CON") == 20){
        			var eduDdChk;
        			eduDdChk= this.fn_eduCnt();
