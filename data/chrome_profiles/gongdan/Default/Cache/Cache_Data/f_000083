    }

    this.cfn_bizFrameLog();

    var nMaxBottom = this.cfn_getMaxBottomPosition(objForm);
    var nMaxRight = this.cfn_getMaxRightPosition(objForm);
//
//  trace("===================================================================");
//  trace("nMaxBottom : "+nMaxBottom);
//  trace("nMaxRight : "+ nMaxRight);
//  trace("===================================================================");
//
    this.bv_nMaxBottom = nMaxBottom;
    this.bv_nMaxRight = nMaxRight;

    objForm.bv_sToDay = this.bfn_getUserInfo().today;   // 현재 DB날짜

    if (objForm["fn_frmInit"]) {
        objForm.fn_frmInit();
    }
};


pForm.cfn_formOnkeyup = function(obj, e)
{
    var sSvrType = nexacro.getApplication().av_sSvrType;

    //ctrl + F12
    if ((sSvrType == "NEXACRO" || sSvrType == "LOCAL" || sSvrType == "DEV") && (e.keycode == 123) && (e.ctrlkey) && (!e.altkey) && (!e.shiftkey)) {
        this.cfn_showObjects(obj);
    }
};


