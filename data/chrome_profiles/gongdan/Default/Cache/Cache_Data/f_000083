pForm.cfn_deleteRow = function(oGrid)
{
    var girdBindDs = oGrid.getBindDataset();

    var iRow  = girdBindDs.rowposition;
    var sStatus = this.gfn_getDataStatusGrid(oGrid, iRow );
    var sGrdStatusUse = oGrid._rowstatus;
    var chkCnt = 0;
    if(oGrid._check) {
        for(var i=0; i<girdBindDs.rowcount; i++) {
            if (girdBindDs.getColumn(i, "CHK") == "1" ) {
                chkCnt++
                break;
            }
        }
    }

    if(chkCnt>0) {
        for(var i=girdBindDs.rowcount; i >= 0 ; i--) {

            if (girdBindDs.getColumn(i, "CHK") == 1 || girdBindDs.getColumn(i, "CHK") == "Y") {

                sStatus = this.gfn_getDataStatusGrid(oGrid, i );

                //girdBindDs.setColumn(i, "CHK", 0);// 체크항목 해제

                if(sStatus == "I") {
                    girdBindDs.deleteRow( i );
                } else {
                    this.gfn_deleteRowDatasetGrid(oGrid, i);
                }

                if(sStatus == "D") {//삭제 상태를 원복 할 때

                    girdBindDs.set_updatecontrol(false);
                    girdBindDs.setColumn(i,"_ROW_STATUS",1);
                    girdBindDs.setRowType(i, Dataset.ROWTYPE_NORMAL);
                    girdBindDs.set_updatecontrol(true);
                }

                //상태가 그리드에 없을 경우에 삭제가능.
                if(sGrdStatusUse == "") {
                    girdBindDs.deleteRow( i );
                }

            }
        }
    } else {


        if(sStatus == "I") {
            girdBindDs.deleteRow( iRow );
        } else {
            this.gfn_deleteRowDatasetGrid(oGrid, iRow);
        }


        if(sStatus == "D") {//삭제 상태를 원복 할 때

            girdBindDs.set_updatecontrol(false);
            girdBindDs.setColumn(iRow,"_ROW_STATUS",1);
            girdBindDs.setRowType(iRow, Dataset.ROWTYPE_NORMAL);
            girdBindDs.set_updatecontrol(true);
        }
        //상태가 그리드에 없을 경우에 삭제가능.
        if(sGrdStatusUse == "") {
            girdBindDs.deleteRow( iRow );
        }
    }
};


