pForm.cfn_getMaxBottomPosition = function(objForm)
{
    var allcomponents = objForm.components;
    var obj;
    var nMaxBottom = 0;

    for(var i=0; i<allcomponents.length; i++)
    {
        obj = allcomponents[i];

        if(!obj.visible) continue;

        //obj.anchor = "default";

        if(nMaxBottom < obj.getOffsetBottom()){
            nMaxBottom = obj.getOffsetBottom();
        }
    }
    return nMaxBottom;
};


pForm.cfn_getMaxRightPosition = function(objForm){

    var allcomponents = objForm.components;
    var obj;
    var nMaxRight = 0;

    for(var i=0; i<allcomponents.length; i++)
    {
        obj = allcomponents[i];

        //obj.anchor = "default";

        if(nMaxRight < obj.getOffsetRight()){
            nMaxRight = obj.getOffsetRight();
        }
    }
    return nMaxRight;
};



