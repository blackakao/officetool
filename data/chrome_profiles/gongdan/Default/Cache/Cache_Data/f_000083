pForm.cfn_getDbDateTime = function()
{
    this.cfn_newDataset("", "ds_timeStamp", this);

    var sTrId           = "timeSelect";
    var sPath           = "/common/bizcommon/selectDateTime.do";
    var sInputDs        = "";
    var sOutputDs       = "ds_timeStamp=ds_result";
    var sArg            = "";
    var oPreArgs        = [];
    var sCallback       = "";
    var bAsync          = false;
    this.gfn_callService(sTrId, sPath, sInputDs, sOutputDs, sArg, oPreArgs, sCallback, bAsync);

    var sTimeStamp = this.ds_timeStamp.getColumn(0, "DT");

    var objDs = this.removeChild("ds_timeStamp");
    objDs.destroy();

    return sTimeStamp;

};

// Dataset 추가
pForm.cfn_newDataset = function(sUseType, sDsNm, objForm)
{
    var objDs;
    var objForm = this.gfn_isNull(objForm) ? this : objForm;
    if (!objForm.isValidObject(sDsNm)) {
        objDs = new Dataset();
        objDs.set_name(sDsNm);
        objForm.addChild(objDs.name, objDs);

        this.cfn_addColumn(sUseType, objDs);
    } else {
        objDs = objForm[sDsNm];
        if (objDs.getColCount() == 0) {
            this.cfn_addColumn(sUseType, objDs);
        }
    }

    return objDs;
};


// Dataset에 대한 Column정보 추가
pForm.cfn_addColumn = function(sUseType, objDs)
{
    switch (sUseType) {
        case "TRANS_INFO" :
            objDs.addColumn("strInDataset",       "string", 100);
            objDs.addColumn("strInVOClass",       "string", 100);
            objDs.addColumn("strInDatasetLocal",  "string", 100);
            objDs.addColumn("strOutDataset",      "string", 100);
            objDs.addColumn("strOutVOClass",      "string", 100);
            objDs.addColumn("strOutDatasetLocal", "string", 100);
            break;

        case "QUERY_INFO" :
        case "QUERY_LIST" :
            objDs.addColumn("formId",         "string",     32);
            objDs.addColumn("execTime",       "string",     32);
            objDs.addColumn("execDuration",   "bigdecimal", 16);
            objDs.addColumn("queryId",        "string",     32);
            objDs.addColumn("queryStatement", "string",     32);
            break;
    }
};




