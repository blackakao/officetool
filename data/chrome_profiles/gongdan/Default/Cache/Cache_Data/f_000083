pForm.cfn_frmInit = function(objForm)
{
    var objApp = nexacro.getApplication();
    if(objApp.gv_isQuick == true)
    {
        var nIndex = objForm.addEventHandler('onkeyup' ,this.cfn_formOnkeyup, objForm);
