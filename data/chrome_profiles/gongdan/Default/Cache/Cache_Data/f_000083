        objApp.mainframe.titlebarheight = 25;

        //mainframe 타이틀바에 공통버튼 배치
        var oTitlebar = objApp.mainframe.titlebar;
        if(!oTitlebar["div_quickBtn"]){
            var objDivQuickBtn = new Div("div_quickBtn", null, 0, 324, 24, 100, null);
            objDivQuickBtn.set_url("frame_common::comQuickviewButton.xfdl");
            trace("objDivQuickBtn name=="+objDivQuickBtn.name);
