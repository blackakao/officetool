pForm.cfn_getCommonCode = function(oForm)
{
    if (!oForm.objects["ds_commonCodeList"])
    {
        trace("===============================================================");
        trace("ds_commonCodeList이 존재하지 않습니다. 확인하세요");
        trace("===============================================================");
        return;
    }

    var oDsCommonCodeList = oForm.objects["ds_commonCodeList"];
    var oDsCommonCode = oForm.objects["_ds_commonCode"];

    if (this.gfn_isNull(oDsCommonCode)) {
        var sTempDsCommonCode = "_ds_commonCode";
        oDsCommonCode  = new Dataset();
        oDsCommonCode.set_name(sTempDsCommonCode);
        oForm.addChild(sTempDsCommonCode, oDsCommonCode);
    }

    var oDsCond = oForm.objects["_ds_cond"];
    if (this.gfn_isNull(oDsCond)) {
        var sTempDsCond = "_ds_cond";
        oDsCond  = new Dataset();
        oDsCond.set_name(sTempDsCond);
        oForm.addChild(sTempDsCond, oDsCond);
        oDsCond.addColumn( "BASE_CD_PTTN", "string" );
    }

    for(var i=0; i<oForm.ds_commonCodeList.rowcount; i++)
    {
        oDsCond.addRow();
        oDsCond.setColumn(oDsCond.rowposition,"BASE_CD_PTTN",oForm.ds_commonCodeList.getColumn(i,"BASE_CD_PTTN"));
    }

    var sSvcId = "selectCommonCodeList";
    var sPath  = "/common/bizcommon/selectBaseCdList.do";
    var sInputDsName = "ds_cond=_ds_cond";
    var sOutputDsName = "_ds_commonCode=ds_result";
    var sArg = "";
    var sCallPrev = "";
    var sCallback = "";

    this.gfn_callService(sSvcId, sPath, sInputDsName, sOutputDsName, sArg, sCallPrev, sCallback, false);

    var sFilterstr = "";

    for(var i=0; i<oForm.ds_commonCodeList.rowcount; i++) {

        if(!this.gfn_isNull(oForm.ds_commonCodeList.getColumn(i,"BASE_CD_PTTN"))) { // 유형코드
            sFilterstr = "BASE_CD_PTTN == '" + oForm.ds_commonCodeList.getColumn(i,"BASE_CD_PTTN")   + "' && ";
        }

        if(!this.gfn_isNull(oForm.ds_commonCodeList.getColumn(i,"SPST_LTC_BASE_CD_PTTN"))) { // 상위유형코드
            sFilterstr += "SPST_LTC_BASE_CD_PTTN == '" + oForm.ds_commonCodeList.getColumn(i,"SPST_LTC_BASE_CD_PTTN")   + "' && ";
        }

        if(!this.gfn_isNull(oForm.ds_commonCodeList.getColumn(i,"SYS_CD"))) { //시스템코드
            sFilterstr += "SYS_CD == '" + oForm.ds_commonCodeList.getColumn(i,"SYS_CD") + "'";
        }

        if(!this.gfn_isNull(oForm.ds_commonCodeList.getColumn(i,"SPARE_1"))) { //여분1
            sFilterstr += " && SPARE_1 == '" + oForm.ds_commonCodeList.getColumn(i,"SPARE_1") + "'";
        }

		if(!this.gfn_isNull(oForm.ds_commonCodeList.getColumn(i,"SPARE_2"))) { //여분2
            sFilterstr += " && SPARE_2 == '" + oForm.ds_commonCodeList.getColumn(i,"SPARE_2") + "'";
        }

		if(!this.gfn_isNull(oForm.ds_commonCodeList.getColumn(i,"SPARE_3"))) { //여분3
            sFilterstr += " && SPARE_3 == '" + oForm.ds_commonCodeList.getColumn(i,"SPARE_3") + "'";
        }

		if(!this.gfn_isNull(oForm.ds_commonCodeList.getColumn(i,"SPARE_4"))) { //여분4
            sFilterstr += " && SPARE_4 == '" + oForm.ds_commonCodeList.getColumn(i,"SPARE_4") + "'";
        }

        if(!this.gfn_isNull(oForm.ds_commonCodeList.getColumn(i,"SPARE_5"))) { //여분5
            sFilterstr += " && SPARE_5 == '" + oForm.ds_commonCodeList.getColumn(i,"SPARE_5") + "'";
        }

        //if(!this.gfn_isNull(ds_commonCodeList.getColumn(i,"ADPT_YN"))) { //적용여부
        //  sFilterstr += " && ADPT_YN == '" + ds_commonCodeList.getColumn(i,"ADPT_YN") + "'";
        //}

        if(!this.gfn_isNull(oForm.ds_commonCodeList.getColumn(i,"ADPT_FR_DT"))) { //순번
            sFilterstr += " && ADPT_FR_DT == '" + oForm.ds_commonCodeList.getColumn(i,"ADPT_FR_DT") + "'";
        }

		if(!this.gfn_isNull(oForm.ds_commonCodeList.getColumn(i,"ADPT_TO_DT"))) { //순번
            sFilterstr += " && ADPT_TO_DT == '" + oForm.ds_commonCodeList.getColumn(i,"ADPT_TO_DT") + "'";
        }

		if(!this.gfn_isNull(oForm.ds_commonCodeList.getColumn(i,"SORT_ORD"))) { //순번
            sFilterstr += " && SORT_ORD == '" + oForm.ds_commonCodeList.getColumn(i,"SORT_ORD") + "'";
        }

        if(!this.gfn_isNull(oForm.ds_commonCodeList.getColumn(i,"BASE_CD"))) { //기초코드
            sFilterstr += " && BASE_CD == '" + oForm.ds_commonCodeList.getColumn(i,"BASE_CD") + "'";
        }

        if(!this.gfn_isNull(oForm.ds_commonCodeList.getColumn(i,"BASE_CD_NM"))) { //기초코드명
            sFilterstr += " && BASE_CD_NM == '" + oForm.ds_commonCodeList.getColumn(i,"BASE_CD_NM") + "'";
        }

        if(!this.gfn_isNull(oForm.ds_commonCodeList.getColumn(i,"SPST_LTC_BASE_CD"))) { //상위기초코드
            sFilterstr += " && SPST_LTC_BASE_CD == '" + oForm.ds_commonCodeList.getColumn(i,"SPST_LTC_BASE_CD") + "'";
        }

        if(!this.gfn_isNull(oForm.ds_commonCodeList.getColumn(i,"BASE_CD_USE_BUSI_TYPE_CD"))) { //기초코드사용업무구분코드
            sFilterstr += " && BASE_CD_USE_BUSI_TYPE_CD == '" + oForm.ds_commonCodeList.getColumn(i,"BASE_CD_USE_BUSI_TYPE_CD") + "'";
        }

		if(this.gfn_isNull(oForm.ds_commonCodeList.getColumn(i,"BASE_CD_USE_BUSI_TYPE_CD"))) { //기초코드사용업무구분코드
            sFilterstr += " && ( BASE_CD_USE_BUSI_TYPE_CD == '' || BASE_CD_USE_BUSI_TYPE_CD == undefined )";
        }

        oForm._ds_commonCode.set_filterstr(sFilterstr);

        var sRtnDsName = oForm.ds_commonCodeList.getColumn(i,"RETURN_DATASET");
        oDs = oForm.objects[sRtnDsName];
        oDs.copyData(oForm._ds_commonCode,true);

        if(oForm.ds_commonCodeList.getColumn(i,"TYPE") == "T"){
            oDs.insertRow(0);
            oDs.setColumn(0,"BASE_CD","");
            oDs.setColumn(0,"BASE_CD_NM","전체");
            oDs.setColumn(0,"BASE_CD_NM2","전체");
        }

        if(oForm.ds_commonCodeList.getColumn(i,"TYPE") == "S"){
            oDs.insertRow(0);
            oDs.setColumn(0,"BASE_CD","");
            oDs.setColumn(0,"BASE_CD_NM","선택");
            oDs.setColumn(0,"BASE_CD_NM2","선택");
        }

        if(oForm.ds_commonCodeList.getColumn(i,"TYPE") == "S+") {

            for(var z=0; z<oDs.rowcount; z++) {
                oDs.setColumn(z,"BASE_CD_NM",oDs.getColumn(z,"BASE_CD_NM2"));
            }
            oDs.insertRow(0);
            oDs.setColumn(0,"BASE_CD","");
            oDs.setColumn(0,"BASE_CD_NM","선택");
            oDs.setColumn(0,"BASE_CD_NM2","선택");
        }

        if(oForm.ds_commonCodeList.getColumn(i,"TYPE") == "T+") {

            for(var x=0; x<oDs.rowcount; x++) {
                oDs.setColumn(x,"BASE_CD_NM",oDs.getColumn(x,"BASE_CD_NM2"));
            }
            oDs.insertRow(0);
            oDs.setColumn(0,"BASE_CD","");
            oDs.setColumn(0,"BASE_CD_NM","전체");
            oDs.setColumn(0,"BASE_CD_NM2","전체");
        }

        oForm._ds_commonCode.set_filterstr("");
    }

    if (typeof(oForm.fn_commonCodeCallBack) == "function") {
            oForm.fn_commonCodeCallBack();
    }

//  if (oForm["fn_commonCodeCallBack"]) {
//      oForm.fn_commonCodeCallBack();
//  }

};

