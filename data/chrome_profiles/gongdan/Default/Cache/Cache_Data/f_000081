/*****************************************************************************************
 * [내부함수] Validation 체크 Component 추출.
 *
 * @param : vObj  		체크 대상 Object
 * @param : strVal		Check 항목(","로 구분)
 * @param : strProp		Object 속성 확인(value/text)
 * @return: true/false
 *****************************************************************************************/   
pForm.ifn_frm_getValidItem = function(vObj, strVal, strProp) {

	var strObjVal;
	var arrValid = strVal.split(",");
	if(arrValid.length < 2) return;

	var arrItem = arrValid[0].split(":");
	var strItem = arrItem[1];	


	if (strProp == "value") {
		strObjVal = vObj.value;
	} else if(strProp == "getValue") {
		 strObjVal = vObj.getValue();	
	} else {
		strObjVal = String(vObj.text).replace("-", "");
		strObjVal = String(strObjVal).replace("-", "");
		strObjVal = String(strObjVal).replace(".", "");
	}

	for (var j=1; j<arrValid.length; j++) {
		var rtnVal = this.ifn_frm_procValidationChk(strObjVal, arrValid[j], strItem, vObj);
//trace("vObj===="+vObj.name+">>>>>>>>>rtnVal==="+rtnVal);
		//trace("rtnVal::"+rtnVal);
		if (("" + rtnVal).indexOf('#J#') == 0) {	// 주민등록번호체크
			if (this.cfn_pop_confirm(rtnVal.substr(3), "확인")) {
				rtnVal = true;
			} else {
				return false;
			}
		}

		if (rtnVal == "SKIP") {
			vObj.set_value(null);
			return true;
		} else if (rtnVal != true) {
			this.alert(rtnVal);
			return false;
		}
	}

	return true;
};


/*****************************************************************************************
 * [내부함수] Check 항목에 대한 Object의 Value 확인.
 *
 * @param : strObjValue 	Validation 체크 Value
 * @param : strVal			Validation 항목
 * @param : strTitle		Message 출력용 Object Name
 * @param : strObj
 * @return: true/false
 *****************************************************************************************/ 
pForm.ifn_frm_procValidationChk = function(strObjValue, strVal, strTitle, strObj) {

	var rtnVal = true;
	var strMsg = "";
	var arrValid = strVal.split(":");
	var strCompareTitle;
	var strObjVal = this.cfn_str_trim(strObjValue);
	
	//trace("arrValid:" + arrValid[0]);
	
	switch( arrValid[0] )
	{
		case "required" :
			if (this.cfn_str_isNull(this.cfn_str_trim(strObjVal))) {
				if (arrValid[1] == "false") {
					rtnVal = "SKIP";
				} else {
					rtnVal = this.cfn_app_getMsg("XITZ0001", strTitle); // {0}은(는) 필수입력 항목입니다
				}
			}
			break;

		case "digits" :
			if (!this.cfn_str_isNull(strObjVal) && !this.cfn_str_isNumber(strObjVal)) {
				rtnVal = this.cfn_app_getMsg("XITZ0002", strTitle); // {0}은(는) 숫자 입력 항목입니다.
			}
			break;

		case "date":
			if (!this.cfn_str_isNull(strObjVal) && !this.cfn_str_isNull(this.cfn_str_trim(strObjVal, ""))) {
				strObjVal = strObjVal.replace(".", "");

				if (!this.cfn_dt_isValidYyyymmdd(strObjVal)) {
					rtnVal = this.cfn_app_getMsg("XITZ0003", strTitle); // {0}은(는) 날짜 입력 항목입니다.
				}
			}
			break;
			
		case "notfuture" :	
			if (!this.cfn_str_isNull(this.cfn_str_trim(strObjVal, ""))) {
				if (!this.cfn_dt_isValidDate(strObjVal)) {
					rtnVal = this.cfn_app_getMsg("XITZ0003", strTitle); // {0}은(는) 날짜 입력 항목입니다.
				} else if (this.cfn_dt_compareDate(this.gfn_getLocalToday(), this.cfn_dt_getDateByFullType(strObjVal)) < 0) {
					rtnVal = this.cfn_app_getMsg("XITZ0004", strTitle); // {0}은(는) 미래일 수 없습니다.
				}
			}
			break;



		case "dateym" :
			if (!this.cfn_str_isNull(this.cfn_str_trim(strObjVal, ""))) {
				strObjVal = strObjVal.replace(".", "");

				if (!this.cfn_dt_isValidYyyymm(strObjVal)) {
					rtnVal = this.cfn_app_getMsg("XITZ0005", strTitle); // {0}은(는) 년월 입력 항목입니다.
				}
			}
			break;

		case "jumin" :
			if (!this.cfn_str_isNull(strObjVal) && !this.cfn_str_isValidJumin(strObjVal)) {
			
				rtnVal = this.cfn_app_getMsg("XITZ0006", strTitle); // {0}의 형식이 잘못되었습니다.
				//rtnVal = "#J#" + cfn_app_getMsg("confirm.bi.z.0006", strTitle); // {0}의 형식이 잘못되었습니다. 계속 진행하시겠습니까?
			}
			break;

		case "max" :
			if (!this.cfn_str_isNull(strObjVal) && parseInt(strObjVal) > parseInt(arrValid[1])) {
				rtnVal = this.cfn_app_getMsg("XITZ0007", strTitle + "|" + arrValid[1]); // {0}의 최대값은 {1}입니다.
			}
			break;

		case "min" :
			if (!this.cfn_str_isNull(strObjVal) && parseInt(strObjVal) < parseInt(arrValid[1])) {
				rtnVal = this.cfn_app_getMsg("XITZ0008", strTitle + "|" + arrValid[1]); // {0}의 최소값은 {1}입니다.
			}
			break;

		case "maxlength" :
			if (!this.cfn_str_isNull(strObjVal) && strObjVal.length > parseInt(arrValid[1])) {
				rtnVal = this.cfn_app_getMsg("XITZ0009", strTitle + "|" + arrValid[1]); // {0}은(는) 최대 {1}자리 입니다.
			}
			break;

		case "minlength" :
			if (!this.cfn_str_isNull(strObjVal) && strObjVal.length < parseInt(arrValid[1])) {
				rtnVal = this.cfn_app_getMsg("XITZ0010", strTitle + "|" + arrValid[1]); // {0}은(는) 최소 {1}자리 입니다.
			}
			break;

		case "maxlengthB" :
			if (!this.cfn_str_isNull(strObjVal) && this.cfn_str_byteLen(strObjVal) > parseInt(arrValid[1])) {
				rtnVal = this.cfn_app_getMsg("XITZ0011", strTitle + "|" + arrValid[1]); // {0}의 최대 길이는 {1}입니다. (한글 3Byte, 영문/숫자 1Byte)
			}
			break;

		case "minlengthB" :
			if (!this.cfn_str_isNull(strObjVal) && this.cfn_str_byteLen(strObjVal) < parseInt(arrValid[1])) {
				rtnVal = this.cfn_app_getMsg("XITZ0012", strTitle + "|" + arrValid[1]); // {0}의 최소 길이는 {1}입니다. (한글 3Byte, 영문/숫자 1Byte)
			}
			break;

		case "equallen":
			// 공백 제거(replace)하고 비교하도록 추가 2014.07.04
			if(!this.cfn_str_isNull(strObjVal) && strObjVal.replace(" ", "").length != parseInt(arrValid[1])) {
				rtnVal = this.cfn_app_getMsg("XITZ0013", strTitle + "|" + arrValid[1]); // {0}의 길이는 {1}자리로 구성되어야 합니다.
			}
			break;

 		default :
			rtnVal = this.cfn_app_getMsg("XITZ0014", strObj.name); // {0}컴포넌트의 Validation 구분이 명확하지 않습니다.
			break;
	}

	return rtnVal;
};



/*****************************************************************************************
 * 입력된 날짜정보를 이용해서 'yyyyMMdd'형태로 변환해서 반환하는 함수
 *
 * @param : strDate		날짜구분값이 들어가 있는 날짜
 * @return: 'yyyyMMdd'형태의 일자
 *****************************************************************************************/
pForm.cfn_dt_getDateByFullType = function(strDate) 
{
	var strRDate = String(strDate).replace("-", "");
	strRDate = String(strRDate).replace("/", "");
	strRDate = String(strRDate).replace(".", "");

	return strRDate;
};


/*****************************************************************************************
 * 입력값을 체크하여 Null인경우 ""을 리턴, Null이 아니면 입력값을 반환하는 함수
 *
 * @param : sValue		문자열
 * @return: 변환된 문자열
 *****************************************************************************************/
pForm.cfn_str_trim = function(sValue) 
{
	if(sValue == null) {
		return "";
	}

	if(new String(sValue).valueOf() == "undefined") {
		return "";
	}

	if(new String(sValue) == null) {
		return "";
	}

	return (new String(sValue)).replace(/^\s+|\s+$/g, '');
};



