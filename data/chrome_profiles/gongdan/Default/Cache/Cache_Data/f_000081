/*****************************************************************************************
 * 그리드(Grid) Check 항목에 대한 Object의 Value 확인.
 *
 * @param : rowPos  		Check Dataset의 Row Position
 * @param : colIdx			Check Dataset의 Row Column
 * @param : objGrd			Check 대상 Grid Object
 * @param : dsObj			Grid Binding Dataset
 * @param : objDsValid		Check Info Dataset
 * @return: true/false
 *****************************************************************************************/  
pForm.ifn_frm_itemCheck = function(rowPos, colIdx, objGrd, dsObj, objDsValid) 
{
	var arrItem 	= new Array();
	var arrItem2 	= new Array();
	var strColNm 	= dsObj.getColID(colIdx);
	var strCol 		= objDsValid.getColumn(0, strColNm);//dsGrid00.getColumn(0,j);

	if (this.cfn_str_isNull(strCol)) {
		return true;
	}

	arrItem 		= strCol.split(",");
	var value = dsObj.getColumn(rowPos, colIdx);
	var rtnVal;

	for (var k=0;k<arrItem.length;k++) {
		
		rtnVal = this.ifn_frm_itemValueCheck(rowPos, arrItem[k], value, dsObj, colIdx, objGrd);
		
		if (("" + rtnVal).indexOf('#J#') == 0) {	// 주민등록번호체크
			if (this.cfn_pop_confirm(rtnVal.substr(3), "확인")) {
				rtnVal = true;
			} else {
				return false;
			}
		}
		
		if ( rtnVal == true ) {
			continue;
		} else if (rtnVal == "SKIP") {
			if (this.cfn_str_isNull(value)) {
				return true;
			} else {
				continue;
			}

		} else {
			return rtnVal;
		}

	}//end for

	return true;
};



/*****************************************************************************************
 * [내부함수] Check 항목에 대한 그리드의 Value 확인.
 *
 * @param : rowPos  			Check Dataset의 Row Position
 * @param : Value			Validation Check 항목
 * @param : itemValue		체크 대상 Vlaue
 * @param : objDs			Grid Binding Dataset
 * @param : colIdx
 * @param : objGrd
 * @return: true/false
 *****************************************************************************************/ 
pForm.ifn_frm_itemValueCheck = function(rowPos, Value, itemValue, objDs, colIdx, objGrd) 
{
	var arrItem2 	= new Array();
	var rtnVal 		= true;
	arrItem2 		= Value.split(":");
	
	//trace("arrItem2:" + arrItem2[0] + "/itemValue:" + itemValue + "/value:" + Value);
	switch (arrItem2[0]) {
		case "title":
			strTitle = arrItem2[1];
			break;
		case "required":
			//필수입력항목 여부
			if (arrItem2[1] == "true") {
				if (this.cfn_str_isNull(this.cfn_str_trim(itemValue))) 
				{
					var rtnVal = this.cfn_app_getMsg("XITZ0001", strTitle); // {0}은(는) 필수입력 항목입니다
				}
			} else {
				return "SKIP";
			}
			break;
		case "digits":
			if (!this.cfn_str_isNull(this.cfn_str_trim(itemValue, "")) && !this.cfn_str_isNumber(itemValue) && !this.cfn_str_isNull(itemValue)) {
				rtnVal = this.cfn_app_getMsg("XITZ0002", strTitle); // {0}은(는) 숫자 입력 항목입니다.
			}
			break;
		case "date":
			if (!this.cfn_str_isNull(this.cfn_str_trim(itemValue, ""))) {
				itemValue = itemValue.replace(".", "");

				if (!this.cfn_dt_isValidYyyymmdd(itemValue)) {
					rtnVal = this.cfn_app_getMsg("XITZ0003", this.strTitle); // {0}은(는) 날짜 입력 항목입니다.
				}
			}
			break;

		case "notfuture" :	
			if (!this.cfn_str_isNull(this.cfn_str_trim(itemValue, ""))) {
				if (!this.cfn_dt_isValidDate(itemValue)) {
					rtnVal = this.cfn_app_getMsg("XITZ0003", strTitle); // {0}은(는) 날짜 입력 항목입니다.
				} else if (this.cfn_dt_compareDate(this.gfn_getLocalToday(), this.cfn_dt_getDateByFullType(itemValue)) < 0) {
					rtnVal = this.cfn_app_getMsg("XITZ0004", strTitle); // {0}은(는) 미래일 수 없습니다.
				}
			}
			break;
			
		case "dateym" :
			if (!this.cfn_str_isNull(this.cfn_str_trim(itemValue, ""))) {
				itemValue = itemValue.replace(".", "");

				if (!this.cfn_dt_isValidYyyymm(itemValue)) {
					rtnVal = this.cfn_app_getMsg("XITZ0005", strTitle); // {0}은(는) 년월 입력 항목입니다.
				}
			}
			break;
		case "jumin" :
			if (!this.cfn_str_isNull(itemValue) && !this.cfn_str_isValidJumin(itemValue)) {
				rtnVal = this.cfn_app_getMsg("XITZ0006", strTitle); // {0}의 형식이 잘못되었습니다.
				//rtnVal = "#J#" + cfn_app_getMsg("confirm.bi.z.0006", strTitle); // {0}의 형식이 잘못되었습니다. 계속 진행하시겠습니까?
			}
			break;
		case "max":
			if (!this.cfn_str_isNull(itemValue) && parseFloat(itemValue) > parseFloat(arrItem2[1])) {
				rtnVal = this.cfn_app_getMsg("XITZ0007", strTitle + "|" + arrItem2[1]); // {0}의 최대값은 {1}입니다.
			}
			break;
		case "min":
			if (!this.cfn_str_isNull(itemValue) && parseFloat(itemValue) < parseFloat(arrItem2[1])) {
				rtnVal = this.cfn_app_getMsg("XITZ0008", strTitle + "|" + arrItem2[1]); // {0}의 최소값은 {1}입니다.
			}
			break;
		case "maxlength":
			if (!this.cfn_str_isNull(itemValue)) {
				if (itemValue.length > parseInt(arrItem2[1])) {
					rtnVal = this.cfn_app_getMsg("XITZ0009", strTitle + "|" + arrItem2[1]); // {0}은(는) 최대 {1}자리 입니다.
				}
			}
			break;
		case "minlength":
			if (!this.cfn_str_isNull(itemValue)) {
				if (itemValue.length < parseInt(arrItem2[1])) {
					 rtnVal = this.cfn_app_getMsg("XITZ0010", this.strTitle + "|" + arrItem2[1]); // {0}은(는) 최소 {1}자리 입니다.
				}
			}
			break;
		case "maxlengthB" :
			if (!this.cfn_str_isNull(itemValue) && this.cfn_str_byteLen(itemValue) > parseInt(arrItem2[1])) {
				rtnVal = this.cfn_app_getMsg("XITZ0011", strTitle + "|" + arrItem2[1]); // {0}의 최대 길이는 {1}입니다. (한글 3Byte, 영문/숫자 1Byte)
			}
			break;
		case "minlengthB" :
			if (!this.cfn_str_isNull(itemValue) && this.cfn_str_byteLen(itemValue) < parseInt(arrItem2[1])) {
				rtnVal = this.cfn_app_getMsg("XITZ0012", strTitle + "|" + arrItem2[1]); // {0}의 최소 길이는 {1}입니다. (한글 3Byte, 영문/숫자 1Byte)
			}
			break;
		case "equallen" :
			// 공백을 제거하고 길이비교하도록 변경 : 2014.07.04
			if(!this.cfn_str_isNull(itemValue) && itemValue.replace(" ", "").length != parseInt(arrItem2[1])) {
				rtnVal = this.cfn_app_getMsg("XITZ0013", strTitle + "|" + arrItem2[1]); // {0}의 길이는 {1}자리로 구성되어야 합니다.
			}
			break;
			
		case "focus" :
			break;			
			
 		default :
			rtnVal = this.cfn_app_getMsg("XITZ0014", strObj.name); // {0}컴포넌트의 Validation 구분이 명확하지 않습니다.
			break;
	}//end switch

	return rtnVal;
};
