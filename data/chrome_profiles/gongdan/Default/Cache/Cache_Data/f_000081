			if(cObj.parent instanceof Tabpage) {
				var iIndex = this.ifn_getTabpageIndex(cObj.parent.parent);
				cObj.parent.parent.parent.set_tabindex(iIndex);
 			}

			cObj.setFocus();
			return false;
		}
	}

	return true;
};

pForm.ifn_getTabpageIndex = function(tabpage) {
	var tab = tabpage.parent;
	var iIndex = -1;

	for(var i=0; i < tab.tabpages.length; i++) {
		if(tab.tabpages[i].name == tabpage.name) {
			iIndex = i;
			break;
		}
	}

	return iIndex;
};

