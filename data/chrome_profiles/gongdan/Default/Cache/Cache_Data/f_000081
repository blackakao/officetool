	var nRow = nexacro.getApplication().gds_message.findRow("MESSAGE_KEY", msgCd);

	if(nRow != -1) {
		msg = nexacro.getApplication().gds_message.getColumn(nRow, "MESSAGE");

		for(var i=0; i <arrVal.length; i++) {
			msg = String(msg).replace("{" + i + "}", arrVal[i]);
		}
	}
	else {
