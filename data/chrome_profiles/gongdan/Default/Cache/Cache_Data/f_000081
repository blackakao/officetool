var pForm = nexacro.Form.prototype;

/*****************************************************************************************
 * Component Validation 체크
 *
 * @param : vObj			Validation체크대상 컨터이너 Object(Form, Div, Tab 등)
 * @param : bSearchFlag		조회 컴포넌트 대상여부(Default:false)
 * @return: true/false
 *****************************************************************************************/
pForm.cfn_frm_getValidateCompList = function(vObj, aTarget)
{
	var bSearchFlag = false;

	var arrayCompList = new Array();
	var propType;
	var arrRtn;
	var nRtnStr;
	var bEnable = false;

	if(vObj instanceof Form
		|| vObj instanceof Div
		|| vObj instanceof Tab) {
		//arrayCompList = cfn_frm_sortByTabOrder(vObj);
	}
	else {
		//arrayCompList[0] = vObj;
	}
	
	arrayCompList = aTarget;

	for(var i=0; i < arrayCompList.length; i++) {
	
		//alert(arrayCompList[i].name);
	
		// 기능추가
		if(arrayCompList[i] instanceof Div) { 
			if (!this.ifn_frm_getValidateCompList(arrayCompList[i].form, bSearchFlag)) return false;
			continue;
		}
		else if(arrayCompList[i] instanceof Tab) {
			var Tabpagelist = arrayCompList[i].tabpages;

			for(var j=0; j < Tabpagelist.length; j++) {
				if (!this.ifn_frm_getValidateCompList(Tabpagelist[j].form, bSearchFlag)) return false;;
				continue;
			}
		}

		if(this.cfn_str_isNull(arrayCompList[i].validate)) continue;

		if(!this.cfn_str_isNull(arrayCompList[i].bEnable)) {
			bEnable = arrayCompList[i].bEnable;
			if (bEnable == "true" || bEnable == true) {
				bEnable = true;
			} else {
				bEnable = false;
			}
		}

		// Visible = false 또는 enable = false인 경우 예외 처리
		if(arrayCompList[i].visible == false) continue;
		//if(bEnable == false && arrayCompList[i].enable == false) continue;
		if(arrayCompList[i].enable == false) continue;	//bEnable사용안함

		// 조회 컴포넌트 대상 예외 처리(문자열 "_s_" 존재여부로 체크 처리)
		var nIdx = String(arrayCompList[i].name).indexOf(this.cfn_const_getSearchComponentPrefix());

		if(bSearchFlag) {
			if(nIdx == -1) continue;
		} else {
			if(nIdx != -1) continue;
		}

		//arrayCompList[i].validate;
		propType = "value";

		//모두 value처리(2018.11.08)
		//if(arrayCompList[i] instanceof Calendar) 		propType = "text";
		//if(arrayCompList[i] == "uobj_multiSelCombo") 	propType = "getValue";

		var arrValid = arrayCompList[i].validate;
		arrRtn = this.ifn_frm_getValidItem(arrayCompList[i], arrValid, propType);

		if(arrRtn == false) {
			var cObj = arrayCompList[i];

			// Component가 Tab에 소속된 경우, 해당 Tab으로 Focus 이동
			if(cObj.parent.parent instanceof Tabpage) {
				var iIndex = this.ifn_getTabpageIndex(cObj.parent.parent);
				cObj.parent.parent.parent.set_tabindex(iIndex);
 			}

			cObj.setFocus();
			return false;
		}
	}

	return true;
};


/*****************************************************************************************
 * null 문자인지의 여부를 점검하는 함수
 *
 * @param : sValue 문자열
 * @return: 점검결과 (true / false)
 *****************************************************************************************/
pForm.cfn_str_isNull = function(sValue) { 
	if(sValue == null || new String(sValue).valueOf() == "undefined" || new String(sValue).valueOf() == "null") {
		return true;
	}

	var v_ChkStr = new String(sValue);

	if(v_ChkStr == null || v_ChkStr.toString().length == 0) {
		return true;
	}

	return false;
};



/*****************************************************************************************
 * composite의 전체 object를 taborder순으로 sort하여 배열로 return
 *
 * @param : oComposite	Composite Object
 * @return: Array
 *****************************************************************************************/
pForm.cfn_frm_sortByTabOrder = function(oComposite) {
    var aryUnsorted = [];

	this.ifn_frm_travelComponents(oComposite, function(comp, nLvl, owner)
	{
		comp._sort;
		owner._sort;

        if(comp.taborder == undefined) {
			comp.set_taborder(0);
//			return;
		}

        if(nLvl == 1) {
            owner._sort = 1;
        }

		comp._sort = (owner._sort) + ((comp.taborder + 1) / Math.pow(10, nLvl));
        aryUnsorted.push(comp);
	});

	this.ifn_frm_sortArray(aryUnsorted, function(a, b) {
		return a._sort > b._sort;
	});

	return aryUnsorted;
};

/*****************************************************************************************
 * [내부함수] oOwner에 해당하는 Component를 재귀적으로 호출한다.
 *
 * @param : oOwner	
 * @param : fncCallback	
 * @param : nLvl	
 * @return: none
 *****************************************************************************************/ 
pForm.ifn_frm_travelComponents = function(oOwner, fncCallback, nLvl) 
{
	if(nLvl == undefined) nLvl = 1;

	for(var i=0, size=oOwner.all.length; i < size; i++) {
		var oComp = oOwner.all[i];
		fncCallback(oComp, nLvl, oOwner);
	}
};


/*****************************************************************************************
 * [내부함수] a에 해당하는 component들을 fncCompare 순으로 Sort 한다.
 *
 * @param : a				Component Array
 * @param : fncCompare		정렬기준
 * @return: none
 *****************************************************************************************/  
pForm.ifn_frm_sortArray = function(a, fncCompare) {
    for(var i=1; i < a.length; i++) {
        var j = i;
        var tmp = a[i];

        while ((j > 0) && fncCompare(a[j - 1], tmp)) {
            a[j] = a[j - 1];
            j--;
        }

        a[j] = tmp;
    }
};



/*****************************************************************************************
