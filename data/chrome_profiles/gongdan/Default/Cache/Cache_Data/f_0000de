        this.afn_setSeparatesize = function(strType)
        {
        	var strType = strType||'';
        	if( strType == '' ) return;

        	switch(strType)
        	{
        		case "LOGOUT":
        			this.av_oVFrameSet.set_separatesize("*,0,0,0");

        			this.av_oLoginFrame.set_formurl("frame_main::frameLogin.xfdl");
        // 			this.av_oLeftFrame.set_formurl("");
        // 			this.av_oLeftFrameFold.set_formurl("");
        // 			this.av_oTopFrame.set_formurl("");
        // 			this.av_oMainFrame.set_formurl("");
        // 			this.av_oBottomFrame.set_formurl("");
        			break;
        		case "LOGIN":
        			this.av_oVFrameSet.set_separatesize("0,70,*,27");

        			this.av_oLoginFrame.set_formurl("");
        			this.av_oTopFrame.form.fn_setTopMenu();
        			this.afn_setSeparatesize("MAIN");

        			break;
        		case "MAIN":
        			this.av_oMainFrame.set_formurl("frame_main::frameIntro.xfdl");
        			this.av_oVFrameSetSub.set_separatesize("*,0,0");
        			break;
        		case "WORK":
        			this.av_oVFrameSetSub.set_separatesize("0,*,0");
        			break;
        		case "LEFT_FOLD":
        			this.av_oHFrame.set_separatesize("0,10,*");
        			break;
        		case "LEFT_UNFOLD":
        			this.av_oHFrame.set_separatesize("218,10,*");
        			break;
        		case "EXIT":
        			this.exit() ;
        			break;
        	}
        };

