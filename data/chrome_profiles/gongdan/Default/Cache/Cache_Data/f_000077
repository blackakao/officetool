//Fixed Column
pForm._gfn_gridCommE_fixedColumn = function(objPopupMenu)
{
    //trace("_gfn_gridCommE_fixedColumn >>>>>");
    var objGrid = objPopupMenu.grid;
    if (objGrid.autofittype != "none") {
        objGrid.set_autofittype("none")
    }

    var cnt=0;
    var nMergecell = 0;

    for(var j=objGrid.eventCol; j>=0; j--) {
        var aa = objGrid.getCellProperty("Head", j, "col");
        var icell = objGrid.eventCol;

        for(var i=icell; i>=0; i--) {
            if(objGrid.getCellProperty("Head", i, "row")==0 && aa==objGrid.getCellProperty("Head", i, "col")) {
                if(cnt==0) {
                    //trace("컬럼idex == " + i + " | " + objGrid.getCellProperty("Head", i, "col"));

                    var bb = objGrid.getCellProperty("Head", i, "col");
                    var cc = objGrid.getCellProperty("Head", i, "colspan")-1;
                    var dd = bb+cc;

                    if(objGrid.getCellProperty("Head", i, "colspan") > 1 || objGrid.getCellProperty("Head", i, "rowspan") > 1)
                    {
                        nMergecell++;
                        break;
                    }

                    var bRtn;

                    for(var k=0; k <= dd;  k++) {
                        if(nMergecell > 0) break;

                        bRtn = objGrid.setFormatColProperty(k, "band", "left");
                        if(k == dd) {
                            objGrid.setCellProperty("Body", k, "border", "1px solid #d3d3d3,2px solid #ef793e,1px solid #d3d3d3,1px solid #d3d3d3");
                        }
                    }

                }
                cnt++;
            }
        }
    }

    if(nMergecell > 0) {
        this.alert("병합된셀이 존재합니다.");
    }

    for(var j=objGrid.eventCol+1; j<objGrid.getCellCount("head"); j++) {
        objGrid.setFormatColProperty(j, "band", "body");
        objGrid.setCellProperty("Head", j, "background", "");
    }
}
