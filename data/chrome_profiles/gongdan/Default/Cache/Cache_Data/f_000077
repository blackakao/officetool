/**
 * @desc Dataset Row의 값이 변경되었을때
 * @param obj:Dataset Dataset
 * @param e:DSColChangeEventInfo
 */
pForm._gfn_gridCommE_bind_dataset_oncolumnchanged = function(obj, e)
{
//trace("pForm._gfn_gridCommE_bind_dataset_oncolumnchanged = function("+obj.name+", e), e.row="+e.row+", e.columnid="+e.columnid+", e.newvalue="+e.newvalue);

    var objGrid = obj.bindgrid;
    if(e.columnid == "CHK") {

        if(e.newvalue == 0 || e.newvalue == "" || e.newvalue == "0")
        {
            var bChange = false;
            // CHK, _ROW_STATUS를 제외한 컬럼 변경여부 확인(bChange)
            for(var i=0; i < obj.getColCount(); i++) {

                if(obj.getColID(i) != "CHK" && obj.getColID(i) != "_ROW_STATUS") {

                    if(obj.getColumn(e.row, obj.getColID(i)) != obj.getOrgColumn(e.row, obj.getColID(i))) {
                    //if(obj.getColumn(e.row, obj.getColID(i)) != aOrgVal[sColId]) {
                        bChange = true;
                        break;
                    }
                }
            }
            //변경된 값이 없으면 _ROW_STATUS 초기화
            if(!bChange) {
                obj.setColumn(e.row, "_ROW_STATUS", obj.getOrgColumn(e.row, "_ROW_STATUS"));
            }

            //obj.setColumn(e.row, "CHK", obj.getOrgColumn(e.row, "CHK"));
            obj.setColumn(e.row, "CHK", "0");
            //변경된 값이 없고, getRowType이 UPDATE이면
            if(!bChange && obj.getRowType(e.row) == 4) {
                obj.set_updatecontrol(false);
                obj.setRowType(e.row,1);
                obj.set_updatecontrol(true);
            }

        } else {    //CHK 값이 0이 아니면

            var bChange = false;
            // CHK, _ROW_STATUS를 제외한 컬럼 변경여부 확인(bChange)
            for(var i=0; i < obj.getColCount(); i++) {
                if(obj.getColID(i) != "CHK" && obj.getColID(i) != "_ROW_STATUS") {
                    if(obj.getColumn(e.row, obj.getColID(i)) != obj.getOrgColumn(e.row, obj.getColID(i))) {
                    //if(obj.getColumn(e.row, obj.getColID(i)) != aOrgVal[sColId]) {
                        bChange = true;
                        break;
                    }
                }
            }

            //obj.setColumn(e.row, "CHK", obj.getOrgColumn(e.row, "CHK"));
            //변경된 값이 없고, getRowType이 UPDATE이면
            if(!bChange && obj.getRowType(e.row) == 4) {
                obj.set_updatecontrol(false);
                obj.setRowType(e.row,1);
                obj.set_updatecontrol(true);
            }
        }

    } else {    //e.columnid 가 CHK가 아니면

        if(obj.getColumn(e.row, "_ROW_STATUS") == 2) {

            // 그리드 ROW  자동선택
            this._gfn_gridCommE_setAutoSelect(objGrid, obj, e.row);


        } else if (obj.getColumn(e.row, "_ROW_STATUS") == 8) {

            obj.set_enableevent(false);
            obj.setColumn(e.row, "_ROW_STATUS", 8);
            obj.set_enableevent(true);

        } else {

            var bChange = false;
            var sColId = '';

            for(var i=0; i < obj.getColCount(); i++) {
                sColId = obj.getColID(i);
                if(sColId != "_ROW_STATUS" && sColId != "CHK") {

                    objGrid.aOrgVal[sColId] = obj.getOrgColumn(e.row, sColId);

                    // 값이 달라졌거나, 이전/변경 값이 모두 빈값('' or undefined) 이 아니면 변경된것으로 체크한다. 2014.06.02 수정
                    //if( (obj.getColumn(e.row, sColId) != aOrgVal[sColId])
                    if(     (obj.getColumn(e.row, sColId) != obj.getOrgColumn(e.row, sColId))
                        && !( this.gfn_isEmpty(obj.getColumn(e.row, sColId)) && this.gfn_isEmpty(obj.getOrgColumn(e.row, sColId)))
                       )
                    {
                        // 그리드 ROW  자동선택
                        this._gfn_gridCommE_setAutoSelect(objGrid, obj, e.row);

                        bChange = true;
                        break;
                    }
                }
            }

            if(!bChange) {
                obj.set_enableevent(false);
                for(var i=0; i < obj.getColCount();i++) {
                    obj.setColumn(e.row, obj.getColID(i), obj.getOrgColumn(e.row, obj.getColID(i)));
                }
                obj.set_enableevent(true);
            } else {
                obj.setColumn(e.row, "_ROW_STATUS", 4);
            }
        }
    }

    //checkbox 필드에서 Y/N값 변경
    if (objGrid.arrPrevCellInfo.length == 3) {

        //이전 정보 가지고 오기
        var sPrevRow            = objGrid.arrPrevCellInfo[0];
        var sPrevCheckColName   = objGrid.arrPrevCellInfo[1];
        var sPrevCheckColVal    = objGrid.arrPrevCellInfo[2];

        //checkbox 일때 이전속성의 반대로
        var sVal = "";
        if (sPrevCheckColVal == "1" || sPrevCheckColVal == "Y") {

            var sOrgVal = obj.getOrgColumn(sPrevRow, sPrevCheckColName);
            var sCheckVal;
            if (sOrgVal  == "Y") {
                sCheckVal = "N";
            } else {
                sCheckVal = sOrgVal;
            }
        } else {
            sCheckVal = "Y";
        }
        obj.set_enableevent(false);
        obj.setColumn(sPrevRow, sPrevCheckColName, sCheckVal);
        obj.set_enableevent(true);
    }
    objGrid.arrPrevCellInfo = new Array();
};

