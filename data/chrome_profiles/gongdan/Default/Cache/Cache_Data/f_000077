/**
 * @desc 상태값을 설정
 * @param nRow 줄번호
 * @param sStatus 설정할 상태값
 */
 //setDataStatus
pForm.gfn_setDataStatusGrid = function(objGrid, nRow, sStatus) {
    var dsBind = objGrid.getBindDataset();

    /*
    Dataset.ROWTYPE_EMPTY 0 존재하지 않는 Row 상태
    Dataset.ROWTYPE_NORMAL 1 초기 Row 상태
    Dataset.ROWTYPE_INSERT 2 추가된 Row 상태
    Dataset.ROWTYPE_UPDATE 4 수정된 Row 상태
    Dataset.ROWTYPE_DELETE 8 삭제된 Row 상태
    Dataset.ROWTYPE_GROUP 16 Group 정보 Row 상태
    */
    var nRowType = 0;
    if (sStatus == "N" || sStatus == "n" ) nRowType = 1;
    else if (sStatus == "I" || sStatus == "i" ) nRowType = 2;
    else if (sStatus == "U" || sStatus == "u" ) nRowType = 4;
    else if (sStatus == "D" || sStatus == "d" ) nRowType = 8;
    else nRowType = sStatus;

    //상태값 변경
    dsBind.set_updatecontrol(false);
    var nOriRowType = dsBind.getRowType(nRow);
    if (nOriRowType == 8 && nRowType == 8) {
        nRowType = 1;
    }
    var bSucc = dsBind.setRowType(nRow, nRowType);
    dsBind.set_updatecontrol(true);
};

