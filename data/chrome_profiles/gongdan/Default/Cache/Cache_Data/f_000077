/**
 * @desc 해당되는 idx 에 있는 cell 의 checkbox 를 전체 선택/해제
 * @param nCellIdx Cell Index
 * @param isCheck 체크 여부 (true / false)
 */
pForm.gfn_checkAllGrid = function(objGrid, nCellIdx, isCheck)
{
//trace("gfn_checkAllGrid isCheck==="+isCheck);
    //0.초기값 설정
    if (this.gfn_isNull( isCheck ) ) isCheck = true; //기본값 true

    var sEditType   = objGrid.getCellProperty ( "Body", nCellIdx, "edittype" );
    var objDS       = objGrid.getBindDataset();

    //1.하나라도 해당이 되지 않으면 무시
    if (nCellIdx == -1 || sEditType != "checkbox")
        return;

    //2.Head셋팅
    var strVal = objGrid.getCellProperty("head", nCellIdx, "text");
    if (this.gfn_isNull(strVal) || strVal == "0" ) strVal = "false";
    if (strVal == "false") {
        isCheck = "true";
    } else {
        isCheck = "false";
    }
    objGrid.setCellProperty("head", nCellIdx, "text", isCheck);

    //3.Body셋팅
    var sColNm = this.gfn_getBindColNameGrid(objGrid, nCellIdx);

    if ( objGrid._checkheadevent == "false" )   objDS.set_enableevent(false);
    for(var i=0 ; i< objDS.rowcount ; i++) {
        objDS.setColumn( i, sColNm, isCheck == "true" ? "1" : "0");
    }
    if ( objGrid._checkheadevent == "false" )   objDS.set_enableevent(true);
//this.gfn_dsView(objDS);
    return isCheck;
};

