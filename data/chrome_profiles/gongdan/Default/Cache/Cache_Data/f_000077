    this._gfn_gridCommE_delete2updateRowtype(oOrgDs);
    oOrgDs.filter("");
    this._gfn_gridCommE_update2deleteRowtype(oOrgDs);

    for(var i=0; i<oOrgDs.rowcount; i++) {
        if(oOrgDs.getColumn(i,"_ROW_STATUS") == 8){
            oOrgDs.set_updatecontrol(false);
            bSucc = oOrgDs.setRowType(i,8);
            oOrgDs.set_updatecontrol(true);
        }
