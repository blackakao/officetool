/**
 * @class Grid에 기능 추가
 * @param {Object} obj  - 대상그리드
 * @return N/A
 * @example
 * this.gfn_setGrid(this.grdMain);
*/
pForm.gfn_setGrid = function(objGrid)
{
    var objApp = nexacro.getApplication();

    // redraw여부 체크
    if ( objGrid._draw ) {
        trace("이미 초기화된 그리드입니다. 확인바랍니다.");
        return;
    } else {
        objGrid._draw = true;
    }

    //변수 설정(private)
    objGrid.nHeaderRowSize  = 23;              //지정할 header 사이즈
    objGrid.nRowSize        = 23;              //지정할 row 사이즈
    objGrid.arrPrevCellInfo = new Array();     //이전 컬럼 정보
    objGrid.arrColWidth = new Array();
    objGrid.arrDeleteRow = new Array();        //삭제된 row 번호를 기억해둠
    objGrid.CONST_ASC_MARK = "▲";             //ASC
    objGrid.CONST_DESC_MARK = "▼";            //DESC
    objGrid.sGridNm     = objGrid.name;        //그리드 이름
    objGrid.sPopupBMenuID = "_pmenuB_rButton"; //팝업명
    objGrid.sPopupHMenuID = "_pmenuH_rButton"; //팝업명
    objGrid.objBizForm    = objGrid.parent;    //화면 폼
    objGrid.objPopupMenuB;                      //팝업object
    objGrid.objPopupMenuH;                      //팝업object
    objGrid.sRunAtB ="";                       //그리드 Body부문 function case문
    objGrid.sRunAtH ="";                       //그리드 Head부문 function case문
    //objGrid._draw   = false;                   //Grid 를 다시 그릴지 여부 (처음에 한번 그린다음에 true로 바뀜
    objGrid._popUpH ="";                       //Head부문 Dataset true/false
    objGrid._popUpB ="";                       //Head부문 Dataset true/false
    objGrid._headfilter = "";                  //헤더전체 필터생성
    objGrid._dsHeadPopupMenu = "";             //팝업데이타셋명
    objGrid.adsTempXml = new Array();
    objGrid.bCkfirst = false;
    objGrid.filterString="";
    objGrid.dsBind;
    objGrid.nCellId;
    objGrid.sDsTemp="";
    objGrid.aOrgVal = [];
    //Title Area Object
    objGrid._gridTitle;
    objGrid._gridRowCount;
    objGrid._isFilter = false;
    objGrid.nStatusCellIdx;
    objGrid.nCheckCellIdx;
    //마우스 이벤트용
    objGrid.eventCol;
    objGrid.eventCell;
    objGrid.eventRow;
    objGrid.filterX;
    objGrid.filterY;
//trace("objGrid._isFilter==="+objGrid._isFilter);
    //변수 설정(public)
    if ( this.gfn_isNull(objGrid._dsBodyPopupMenu)) objGrid._dsBodyPopupMenu = "";             //팝업데이타셋명
    if ( this.gfn_isNull(objGrid._rowstatus))       objGrid._rowstatus  = "";                  //상태표시 true/false
    if ( this.gfn_isNull(objGrid._check))           objGrid._check  = "";                      //_check 가 "true 일때 "CHK" Column 을 추가
    if ( this.gfn_isNull(objGrid._checkhead))       objGrid._checkhead = true;                 //checkbox 헤더 true/false
    if ( this.gfn_isNull(objGrid._checkheadevent))  objGrid._checkheadevent = "false";         //checkbox 헤더 클릭시 dataset이벤트 제어(true이면 이벤트실행)
    if ( this.gfn_isNull(objGrid._sort))            objGrid._sort   = "";                      //헤더정렬 true/false
    if ( this.gfn_isNull(objGrid._tooltip))         objGrid._tooltip    = "";                  //툴팁 true/false
    if ( this.gfn_isNull(objGrid._required))        objGrid._required= "";                     //필수 항목 컬럼 a,b,c,d,..
    if ( this.gfn_isNull(objGrid._multiSort))       objGrid._multiSort = "false";              //멀티정렬
    if ( this.gfn_isNull(objGrid._filter))          objGrid._filter = "true";                  // 필터
    if ( this.gfn_isNull(objGrid._hideColumn))      objGrid._hideColumn = "true";              // 컬럼 숨기기
    if ( this.gfn_isNull(objGrid._fixedColumn))     objGrid._fixedColumn = "true";             // 컬럼 고정
    if ( this.gfn_isNull(objGrid._autoSelectRowCol)) objGrid._autoSelectRowCol = "";            // 자동 row선택 Key 컬럼 column1,column2,column3....
    if ( this.gfn_isNull(objGrid._parentGrid))      objGrid._parentGrid       = "";            // 계층관계일 경우,  부모 그리드명
    if ( this.gfn_isNull(objGrid.objectType))       objGrid.objectType = "gridCommE";
//trace("objGrid._sort==="+objGrid._sort);
    //Grid의 binddataset설정
    var objDs = objGrid.getBindDataset();

    // grid에 바인드된 Dataset이 없는 경우 return;
    if (this.gfn_isNull(objDs)) {
        return;
    }
    else {
        // Validation에서 foucus 처리 및 그리드 제어
        objDs.bindgrid = objGrid;
    }

    objGrid.set_enableevent(false);
    objGrid.set_enableredraw(false);
    objDs.set_enableevent(false);

    //Head 팝업메뉴 dataset생성
    var sFilter = " levelCol =='0' ";
    if(objGrid._filter != "true") {
        sFilter += " && groupCol != 'filter' ";
    }
    if(objGrid._hideColumn != "true") {
        sFilter += " && groupCol != 'hide' ";
    }
    if(objGrid._fixedColumn != "true") {
        sFilter += " && groupCol != 'fix' ";
    }
    objApp.gds_gridHeadPopupmenu.set_filterstr("");
    objApp.gds_gridHeadPopupmenu.set_filterstr(sFilter);

    //Head 팝업메뉴 dataset생성
    var oDsHeadPopupMenu = new Dataset();
    objGrid.parent.addChild(objGrid.sGridNm+"_headPopupMenu", oDsHeadPopupMenu);
    oDsHeadPopupMenu.copyData(objApp.gds_gridHeadPopupmenu, true);

    //Body 팝업메뉴 dataset생성
    var oDsBodyPopupMenu = new Dataset();
    objGrid.parent.addChild(objGrid.sGridNm+"_bodyPopupMenu", oDsBodyPopupMenu);
    oDsBodyPopupMenu.copyData(objApp.gds_gridBodyPopupmenu);

    //Body 팝업메뉴 추가
    if (objGrid.parent.objects[objGrid._dsBodyPopupMenu] != null) {
        oDsBodyPopupMenu.appendData(objGrid.parent.objects[objGrid._dsBodyPopupMenu]);
    }

    if (oDsHeadPopupMenu.rowcount > 0)
    {
        objGrid._popUpH = "true";
    } else {
        objGrid._popUpH = "fale";
    }

    if (oDsBodyPopupMenu.rowcount > 0)
    {
        objGrid._popUpB = "true";
    } else {
        objGrid._popUpB = "fale";
    }

    if (objGrid._popUpH == "true")
    {
        // Head 팝업메뉴
        objGrid.addEventHandler('onrbuttondown',this._gfn_gridCommE_onrbuttondown, this);           // 우측버튼 이벤트
        objGrid.objPopupMenuH = this._gfn_gridCommE_createPopupMenu(objGrid, objGrid.sGridNm + objGrid.sPopupHMenuID ,oDsHeadPopupMenu);
        objGrid.sRunAtH = this._gfn_gridCommE_makePopupMenuEvent(oDsHeadPopupMenu);
        objGrid.objPopupMenuH.addEventHandler('onmenuclick',this._gfn_gridCommE_objPopupMenuH_onmenuclick, this);
    }

    if (objGrid._popUpB == "true")
    {
        // Body 팝업메뉴
        objGrid.addEventHandler('onrbuttondown',this._gfn_gridCommE_onrbuttondown, this);           // 우측버튼 이벤트
        objGrid.objPopupMenuB = this._gfn_gridCommE_createPopupMenu(objGrid, objGrid.sGridNm + objGrid.sPopupBMenuID, oDsBodyPopupMenu);
        objGrid.sRunAtB = this._gfn_gridCommE_makePopupMenuEvent(oDsBodyPopupMenu);
//trace("objGrid.sRunAtB==="+objGrid.sRunAtB);
        objGrid.objPopupMenuB.addEventHandler('onmenuclick',this._gfn_gridCommE_objPopupMenuB_onmenuclick, this);
    }

    //기본 이벤트 추가
    objGrid.addEventHandler('oncellclick' ,this._gfn_gridCommE_oncellclick, this);
    objGrid.addEventHandler('onselectchanged' ,this._gfn_gridCommE_onselectchanged, this);

    //그리드 설정 적용
    this._gfn_gridCommE_redraw(objGrid);
};

//그리드 설정적용
pForm._gfn_gridCommE_redraw = function(objGrid)
{
    var objDs = objGrid.getBindDataset();

    // grid에 바인드된 Dataset이 없는 경우 return;
    if (this.gfn_isNull(objDs)) return;

    objGrid.set_enableevent(false);
    objGrid.set_enableredraw(false);
    objDs.set_enableevent(false);

    // Bind Dataset 이벤트 연결
    objDs.addEventHandler('onrowposchanged' ,this._gfn_gridCommE_bind_dataset_onrowposchanged, this);
    objDs.addEventHandler('oncolumnchanged' ,this._gfn_gridCommE_bind_dataset_oncolumnchanged, this);
    objDs.addEventHandler('onrowsetchanged' ,this._gfn_gridCommE_bind_dataset_onrowsetchanged, this);
    objDs.addEventHandler('onload' ,this._gfn_gridCommE_bind_dataset_onload, this);

    //_ROW_STATUS 는 무조건 추가
    if (this.gfn_isNull(objDs.getColumnInfo("_ROW_STATUS"))) {
        objDs.addColumn("_ROW_STATUS", "string");
    }

    //_ROW_STATUS 초기설정 하기
    var nOrgRow = objDs.rowposition;
    for(var i=0; i<objDs.rowcount; i++) {
        objDs.setColumn(i,"_ROW_STATUS",objDs.getRowType(i));
    }
    objDs.set_rowposition(nOrgRow);
    objDs.applyChange();

    //_check 가 "true 일때 "CHK" Column 을 추가
    if (objGrid._check=="true") this._gfn_gridCommE_checkboxNoStatusAdd(objGrid, "checkbox");

    //_rowstatus true 일때 상태 Column을 추가
    if (objGrid._rowstatus=="true") this._gfn_gridCommE_checkboxNoStatusAdd(objGrid, "status");

    //_sort,_check  true일때 headclick event를 연결
    if (objGrid._sort =="true" || objGrid._check=="true") {
        objGrid.addEventHandler("onheadclick" ,this._gfn_gridCommE_onheadclick, this);
        objGrid.addEventHandler("onheaddblclick" ,this._gfn_gridCommE_onheaddblclick, this);
    }

    //_tooltip true일때  event를 연결
    if (objGrid._tooltip == "true") {
        objGrid.addEventHandler('onmousemove' ,this._gfn_gridCommE_onmousemove, this);
    }

    //keydown 이벤트 추가(Ctrl + C, Ctrl + V)
    objGrid.addEventHandler('onkeydown' ,this._gfn_gridCommE_onkeydown, this);

    //필수항목 헤더 모양 변경
    this._gfn_gridCommE_requiredDisplay(objGrid);

    //grid 를 그릴때 checkbox가 1, 0 이 아니라 Y, N 으로 표시되게 변경
    //this._gfn_gridCommE_checkboxDisplay(objGrid);

    //grid 를 그릴때 headfilter 설정
    this._gfn_gridCommE_setHeadfilter(objGrid);

    //컬럼 width 기록
    objGrid.arrColWidth = this._gfn_gridCommE_getColWidth(objGrid);

    objGrid.set_enableevent(true);
    objGrid.set_enableredraw(true);
    objDs.set_enableevent(true);
}


