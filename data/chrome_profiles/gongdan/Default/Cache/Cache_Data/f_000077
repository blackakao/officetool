pForm._gfn_gridCommE_createPopupDiv = function(objGrid, nCell)
{
//trace("_gfn_gridCommE_createPopupDiv>>>>"+":::::objGrid.name==="+objGrid.name+":::::nCell==="+nCell);
    var oOrgDs = objGrid.getBindDataset();

    var nCellCnt = objGrid.getCellCount("body");

    var sColInfo = objGrid.getCellProperty("body",nCell,"text");
    //body text정보를 찾지 못하면 return;
    if ( this.gfn_isNull(sColInfo) )    return;

    //Bind구분자를 찾지 못하면 return;
    if ( sColInfo.toString().indexOf(":") == -1 )   return;

    var sColId = objGrid.getCellProperty("body",nCell,"text").split(":")[1];

    //colid를 찾지 못하면 return;
    if ( this.gfn_isNull(sColId) )  return;

    //trace("sColId===="+sColId);

    //filter용 임시 dataset
    var objDs = this._gfn_gridCommE_createFilterDataset(objGrid, oOrgDs, sColId);
    objDs.set_rowposition(0);

    var sPopupDivName = sColId + objGrid.name;
    var objPopupDiv;
    //PopupDiv가 존재하면 PopupDiv 리턴
    if(objGrid.parent.all[sPopupDivName])
    {
        //trace("PopupDiv가 존재하면 PopupDiv 리턴");
        objPopupDiv = objGrid.parent.all[sPopupDivName];
    } else {
        //trace("PopupDiv가 존재하지 않으면 PopupDiv 생성");
        objPopupDiv = new PopupDiv();
        objPopupDiv.init(sPopupDivName, 0, 0, 162, 162);
        objPopupDiv.set_text(sColId);
        objGrid.parent.addChild(sPopupDivName, objPopupDiv);

        //objPopupDiv.addEventHandler('oncloseup' ,this._gfn_gridCommE_closeUp, this);
        objPopupDiv.set_border("1px solid #808080");
        objPopupDiv.set_background("white");
        objPopupDiv.set_opacity(200);
        objPopupDiv.set_url("frame_common::gridCommEfilterPopup.xfdl");
        objPopupDiv.show();
    }
    objPopupDiv._oFilterGrid = objGrid;
    objPopupDiv._oOrgDs      = oOrgDs;
    objPopupDiv._oFilterCol  = sColId;
    objPopupDiv._oFilterDs   = objDs;

    //popupdiv 사이즈 조정
    var nFilterRowCnt = objDs.rowcount;
    if (nFilterRowCnt > 20) {
        objPopupDiv.setOffsetHeight(673);
    } else {
        objPopupDiv.setOffsetHeight(nFilterRowCnt * 22 + 41);
    }

    return objPopupDiv;
};

// 필터용 데이타셋 생성
pForm._gfn_gridCommE_createFilterDataset = function(objGrid, oOrgDs, sColId)
{
    var sFilterDsName = "_ds_" + sColId + "_" + objGrid.name;
    var objDs = objGrid.parent.all[sFilterDsName];  //filter용 임시 dataset

    var objTempDs = new Dataset();
    objTempDs.copyData(oOrgDs, false);  //모든 데이타 copy
    var bFilterFlag = (oOrgDs.rowcount == objTempDs.rowcount)?"1":"0";  //filter여부
//trace("oOrgDs.rowcount==="+oOrgDs.rowcount+":::::objTempDs.rowcount==="+objTempDs.rowcount+"::::bFilterFlag==="+bFilterFlag);
    //신규생성
    if(objDs) {
        objDs.clearData();
    }
    else {
        objDs = new Dataset();
        objGrid.parent.addChild(sFilterDsName, objDs);

        objDs.addColumn("chk", "string");
        objDs.addColumn(sColId, "string");
    }
    var nRow = objDs.addRow();
    objDs.setColumn(nRow, "chk", bFilterFlag);
    objDs.setColumn(nRow, sColId, "전체선택");

    //filter용 data생성
    var bCheckFlag = "1";
    var varDate;
    var nRowCnt = objTempDs.getRowCount();
    for(var i=0;i<nRowCnt;i++) {
        varDate = objTempDs.getColumn(i, sColId);
        //중복처리
        if(objDs.findRow(sColId, varDate) > -1) continue;
        //체크처리
        if(oOrgDs.findRow(sColId, varDate) > -1) {
            bCheckFlag = "1";
        } else {
            bCheckFlag = "0";
        }
        nRow = objDs.addRow();
        objDs.setColumn(nRow, "chk", bCheckFlag);
        objDs.copyRow(nRow, objTempDs, i, sColId + "=" + sColId);
    }
    objTempDs = null;
//this.gfn_dsView(objDs);
    return objDs;
};

