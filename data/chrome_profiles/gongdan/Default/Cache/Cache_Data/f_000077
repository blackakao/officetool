/**
 * @class Grid에 기능 추가(addCol..)
 * @param {Object} objGrid  - 대상그리드
 * @param {Object} objDs    - 대상데이터셋
 * @param {Array} addProp   - 기능
 * @return N/A
 * @example
 * this._gfn_gridCheckboxNoStatusAdd(this.grdMain, this.dsList, [checkbox,no,status]);
*/
pForm._gfn_gridCommE_checkboxNoStatusAdd = function (objGrid, addProp)
{
//trace("_gfn_gridCommE_checkboxNoStatusAdd==="+addProp);
    var objDs = objGrid.getBindDataset();

    var nHeadColIndex = 0;
    var nBodyColIndex = 0;

    var sStatusText     = "상태";
    var sCheckColumnId  = "CHK";
    var sStatusColumnId = "_ROW_STATUS";

    var nFormatRowCount = objGrid.getFormatRowCount();
    var nHeadCount=-1;
    var nBodyCount=-1;
    for(var i=0; i<nFormatRowCount; i++)
    {
        if (objGrid.getFormatRowProperty(i, "band") == "head") nHeadCount++;
        if (objGrid.getFormatRowProperty(i, "band") == "body") nBodyCount++;
    }

    //체크박스
    if( addProp == "checkbox")
    {
        objDs.set_enableevent(false);
        var idx=-1;
        for(var j=0; j<objDs.getColCount(); j++){
            var tmpcol = objDs.getColID(j);
            if( tmpcol == sCheckColumnId){
                idx = j;
            }
        }
        if( idx < 0 ) objDs.addColumn(sCheckColumnId, "STRING", 1);

        objDs.set_enableevent(true);

        for(var i=0; i<objGrid.getCellCount("head"); i++){
            //헤드텍스트
            var tmp = objGrid.getCellProperty("head" , i, "text");
            if( tmp == "0"){
                // head cell index 에 해당하는 body cell index
                var bodyCellIndex = this._gfn_gridGetBodyCellIndex(objGrid, i);
                // body cell index 에 해당하는 바인드 컬럼명
                var columnName = this._gfn_gridGetBindColumnNameByIndex(objGrid, bodyCellIndex);
                if(columnName == sCheckColumnId) {
                    //return;
                    objGrid.deleteContentsCol("body", i);
                }
            }
        }
        objGrid.insertContentsCol(nBodyColIndex);
        objGrid.setFormatColProperty(nBodyColIndex, "size", "20");

        if (objGrid._checkhead == "true") {
            objGrid.setCellProperty("head", nHeadColIndex, "displaytype", "checkboxcontrol");
            objGrid.setCellProperty("head", nHeadColIndex, "edittype", "checkbox");
            objGrid.setCellProperty("head", nHeadColIndex, "text", "0");
        }

        objGrid.setCellProperty("body", nBodyColIndex, "displaytype", "checkboxcontrol");
        objGrid.setCellProperty("body", nBodyColIndex, "edittype", "checkbox");
        objGrid.setCellProperty("body", nBodyColIndex, "text", "bind:"+sCheckColumnId);

        objGrid.mergeContentsCell("head", 0, nBodyColIndex, nHeadCount, nBodyColIndex, nHeadColIndex, false);
        objGrid.mergeContentsCell("body", 0, nBodyColIndex, nBodyCount, nBodyColIndex, nBodyColIndex, false);
//trace("nHeadColIndex==="+nHeadColIndex+":::::nBodyColIndex==="+nBodyColIndex);
        objGrid.nCheckCellIdx = nHeadColIndex;  //idx 값 기억
    }

    //상태
    if ( addProp == "status")
    {
        for(var i=0; i<objGrid.getCellCount("head"); i++){
            var tmp = objGrid.getCellProperty("head" , i, "text");
            if( tmp == sStatusText || tmp == "Status"){
                //return;
                objGrid.deleteContentsCol("body", i);
            }
        }

        var nCurrRow = objDs.rowposition;
        for(var i=0; i<objDs.rowcount; i++) {
            objDs.setColumn(i,"_ROW_STATUS",objDs.getRowType(i));
        }
        objDs.set_rowposition(nCurrRow);
//this.gfn_dsView(objDs);

//      var sInsert = nexacro.wrapQuote("입력"); //입력
//      var sUpdate = nexacro.wrapQuote("수정"); //수정
//      var sDelete = nexacro.wrapQuote("삭제"); //삭제
//      var sExpr = "expr:"
//                + "dataset.getRowType(currow)==2?"+sInsert
//                + ":dataset.getRowType(currow)==4?"+sUpdate
//                + ":dataset.getRowType(currow)==8?"+sDelete
//                + ":''";
        var sExpr = "expr:"
                  + "(_ROW_STATUS==2)?'cel_insert'"
                  + ":(_ROW_STATUS==4)?'cel_update'"
                  + ":(_ROW_STATUS==8)?'cel_delete'"
                  + ":'cel_normal'";
//trace(sExpr);
        var nSize = 30;

        objGrid.insertContentsCol(nBodyColIndex);
        objGrid.setFormatColProperty(nBodyColIndex, "size", nSize);
        objGrid.setCellProperty("head", nHeadColIndex, "text", sStatusText);
        //objGrid.setCellProperty("head", nHeadColIndex, "textAlign","center");
        //objGrid.setCellProperty("body", nBodyColIndex, "displaytype", "expr:dataset.getRowType(currow) != 1 ? 'text' : ''");
        //objGrid.setCellProperty("body", nBodyColIndex, "text", sExpr);
        objGrid.setCellProperty("body", nBodyColIndex, "cssclass", sExpr);
        //objGrid.setCellProperty("body", nBodyColIndex, "textAlign","center");
        objGrid.mergeContentsCell("head", 0, nBodyColIndex, nHeadCount, nBodyColIndex, nHeadColIndex, false);
        objGrid.mergeContentsCell("body", 0, nBodyColIndex, nBodyCount, nBodyColIndex, nBodyColIndex, false);

        objGrid.nStatusCellIdx = nHeadColIndex; //idx 값 기억
        if ( objGrid.nCheckCellIdx == 0 ) objGrid.nCheckCellIdx = objGrid.nCheckCellIdx + 1;    //idx 값 기억
    }
};

