/**
 * @class  그리드헤드 더블클릭 이벤트 [멀티소트] + 소트 해제
 * @param {Object} objGrid - 대상그리드
 * @param {Evnet}  e       - 헤드클릭이벤트
 * @return  N/A
 * @example
 * objGrid.addEventHandler("onheadclick",    this.gfn_grid_onheadclick,      this);
 */
pForm._gfn_gridCommE_onheaddblclick = function(objGrid, e)
{
//trace("_gfn_gridCommE_onheaddblclick>>>>>>>>>");
    var objBindDs = objGrid.getBindDataset();
    var nHeadRowCount = this._gfn_gridCommE_getHeadRowCount(objGrid);
    nHeadRowCount = nHeadRowCount - 1;

    var nRowspan  = objGrid.getCellProperty("head", e.cell, "rowspan");
    nRowspan      = nRowspan - 1;

    if(objGrid.getCellCount("Head") != objGrid.getCellCount("Body")) {
        if(nHeadRowCount != 0) {
            if(nHeadRowCount != e.subrow) {
                if(nHeadRowCount != nRowspan) {
                    return;
                }
            }
        }
    }

    if (objGrid._sort=="true") {
        var sSortDs = "ds" + objGrid.name + "Sort";
        var sortDs = this.gfn_newDataset(sSortDs, objGrid.parent);

        if (objBindDs.rowcount == 0 || sortDs.rowcount == 0) return false;
        //head idx 값 가지고
        var nCellIdx = -1;
        if (objGrid.getCellCount("head") == objGrid.getCellCount("body")) nCellIdx = e.cell;
        else nCellIdx = e.col;

        var sHeadText   = objGrid.getCellText(-1, e.cell); //head cell idx 기준
        var aBodyColId  = new String(objGrid.getCellProperty("body", nCellIdx,"text")).split(":");
        var sColId      = aBodyColId[1];
        var iCell       = e.cell;

        //sort 설정 변경
        var rtn;
        if (objGrid._multiSort == "true") {

            //더블클릭한 컬럼은 sort에서 제외
            var sSortColId = "";
            for(var i=sortDs.rowcount-1; i>=0; i--) {
               sSortColId = sortDs.getColumn(i, "head");
               if (sSortColId == sColId ) {
                    sortDs.deleteRow(i);
               }
            }

            var nCnt = sortDs.getRowCount();
            if (nCnt == 0) {
                sortDs.clearData();
                sHeadText = sHeadText.replace(objGrid.CONST_ASC_MARK,"");
                sHeadText = sHeadText.replace(objGrid.CONST_DESC_MARK,"");
                objGrid.setCellProperty( "head", e.cell, "text", sHeadText);
                objBindDs.set_keystring("");
            } else {
                sHeadText = sHeadText.replace(objGrid.CONST_ASC_MARK,"");
                sHeadText = sHeadText.replace(objGrid.CONST_DESC_MARK,"");
                objGrid.setCellProperty( "head", e.cell, "text", sHeadText);
                objBindDs.set_keystring("S:"+this.gfn_keyString(objGrid,sortDs,"ncombo"));
            }

        } else {


            var iIndex  = sortDs.getColumn(0, "hindex");
            if (iIndex >= 0) {
                var sMark   = sortDs.getColumn(0, "mark");
                sMark       = sMark.substr(0, sMark.length - 1);
                objGrid.setCellProperty( "head", iIndex, "text", sMark );
            }
            if (sortDs.deleteRow(0)) {
                objBindDs.set_keystring("");
            }
        }
    }
};

