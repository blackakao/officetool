pForm._gfn_gridCommE_gridSort3 = function(obj, e)
{
    if (this.gfn_isNull(obj) || this.gfn_isNull(e)) return false;

    var sSortDs = "ds" + obj.name + "Sort";
    var sortDs = this.gfn_newDataset(sSortDs, obj.parent);
    var bindDs = obj.getBindDataset();
    if (bindDs.rowcount == 0) return false;

    if (sortDs.getColCount() == 0) {
        sortDs.addColumn("head", "string", "255");
        sortDs.addColumn("set", "string", "255");
        sortDs.addColumn("mark", "string", "255");
        sortDs.addColumn("hindex", "string", "255");
    }

    var nCellIdx = -1;
    if (obj.getCellCount("head") == obj.getCellCount("body") ) nCellIdx = e.cell;
    else nCellIdx = e.col;

    var iCellCnt    = obj.getCellCount("head");
    var aBodyColId  = String(obj.getCellProperty("body", nCellIdx, "text")).split(":"); // e.col : 바인드된 컬럼.
    var sColId      = aBodyColId[1];
    var iCell       = e.cell;
    var sHeadText = obj.getCellText( -1, iCell ); //Head(-1) 에 있는 Text 를 가지고
    var sSortType = sHeadText.substr(sHeadText.length-1); //문자열의 맨마지막 문자를 가지고와서 이미 sort가 되어 있는지
    var sNewHeadText = "";
    var sSet         = "";


    if (sSortType == obj.CONST_ASC_MARK) {
        sNewHeadText = sHeadText.substr(0, sHeadText.length - 1) + obj.CONST_DESC_MARK;
        sSet         = "-";

    } else if ( sSortType == obj.CONST_DESC_MARK) {
        sNewHeadText = sHeadText.substr(0, sHeadText.length - 1) + obj.CONST_ASC_MARK;
        sSet         = "+";

    } else {
        sNewHeadText = sHeadText+obj.CONST_ASC_MARK;
        sSet         = "+";
    }

    var iIndex  = sortDs.getColumn(0, "hindex");


    if (iIndex >= 0) {
        var sMark   = sortDs.getColumn(0, "mark");
        sMark       = sMark.substr(0, sMark.length - 1);

        obj.setCellProperty( "head", iIndex, "text", sMark );
    }


    if (obj._multiSort == "true") {
        if (e.col == e.oldcol) {
            var nRow = sortDs.findRow("hindex",e.cell);
            if (nRow == -1) nRow = sortDs.addRow();
        } else {
            var nRow = sortDs.addRow();
        }
    } else {
        if (sortDs.rowcount == 0) {
            var nRow = sortDs.addRow();
        }
    }

    sortDs.setColumn(nRow, "head"    , sColId       );
    sortDs.setColumn(nRow, "set"     , sSet         );
    sortDs.setColumn(nRow, "mark"    , sNewHeadText );
    sortDs.setColumn(nRow, "hindex" , iCell         );

    //obj.setCellProperty( "head", iCell, "text", sNewHeadText ); //head cell idx 기준

    var objComboDs = eval(obj.getCellProperty( "head", iCell, "combodataset"));
    var nSrow = objComboDs.findRow("value",sHeadText);
    objComboDs.setColumn(nSrow,"value",sNewHeadText);


    for(var i=0; i<objComboDs.rowcount; i++) {
        if(i != nSrow) {
            var sValue = objComboDs.getColumn(i,"value");
            sValue = sValue.replace(obj.CONST_ASC_MARK,"");
            sValue = sValue.replace(obj.CONST_DESC_MARK,"");
            objComboDs.setColumn(i,"value",sValue);
        }
    }

//  //expr 문자 제외
//  var sDisplayType = obj.getCellProperty("body", iCell, "displaytype");
//  if (String(sDisplayType).indexOf("expr:") != -1) {
//      sDisplayType = String(sDisplayType).substr( 5 ).replace("currow", "0");
//      sDisplayType = eval( sDisplayType );
//  }

    if (sDisplayType == "combo") {
        bindDs.set_updatecontrol(false);
        bindDs.set_enableevent(false);

        //sorts에 사용하기 위한 Column 을 추가해둔다.
        if (bindDs.getColumnInfo( "sort_col" ) != null) {
            bindDs.deleteColumn("sort_col");
        }
        bindDs.addColumn( "sort_col", "string" );

        for(var i=0; i<bindDs.rowcount; i++) {
            bindDs.setColumn(i, "sort_col", obj.getCellText(i, iCell));
        }
        bindDs.set_updatecontrol(true);
        bindDs.set_enableevent(true);
        bindDs.set_keystring("S:"+this.gfn_keyString3(obj,sortDs,"combo"));

        //default 는 click 한 column id 기준으로 정렬
    } else {
        bindDs.set_keystring("S:"+this.gfn_keyString3(obj,sortDs,"ncombo"));
    }

    obj.setCellPos( nCellIdx );
    return true;
};

