//grid 를 그릴때 headfilter 설정
pForm._gfn_gridCommE_setHeadfilter = function (objGrid)
{
    var sSetHeaddsTemp = "ds_TempHeadCol_"+objGrid.sGridNm;
    var oSetHeaddsTemp = this.gfn_newDataset(sSetHeaddsTemp, objGrid.parent);
    oSetHeaddsTemp.addColumn("code", "string", "255");
    oSetHeaddsTemp.addColumn("value", "string", "255");
