pForm.fn_printRexpertBizLog = function(arrDataset){

	var sDsName = "ds_rexpert_tmp";
    var dataset  = new Dataset;
		dataset.set_name(sDsName);
	this.addChild(sDsName, dataset);
	dataset.copyData(arrDataset);
	var sSvcId			= "printRexpertBizLog";
	var sPath  			= "t/z/001/printRexpertBizLog.do";
	var sInputDsName 	= "ds_rexpert_tmp=ds_rexpert_tmp";
	var sOutputDsName 	= "ds_rexpert_tmp=ds_rexpert_tmp";
	var sArg 			= "";
	var oPreArgs  		= [];
	var sCallback 		= "fn_printRexpertCallBack";
	
	this.gfn_callService(sSvcId, sPath, sInputDsName, sOutputDsName, sArg, oPreArgs, sCallback);
	
	var objDelete = this.removeChild("ds_rexpert_tmp");
    objDelete.destroy();
} 
