/*********************************************************************************************
 * ★ Function명 : gfn_makeXML
 * ★ 설명       : 인수로 넘어온 DataSet List를 XML로 변환한다.
 * ★ Params     :  Dataset List(String, Dataset List 구분자 : ",")
 * ★ Return     : 변환된 XML
*********************************************************************************************/
pForm.gfn_makeDatasetList = function(arrDsObj) 
{
	var sDsList = "";
	if ( this.gfn_isNull(arrDsObj) ) return sDsList;
	
	for (var i=0; i<arrDsObj.length; i++)
	{
		if ( i==0 ) {
			sDsList = arrDsObj[i].name;
		} else {
			sDsList = sDsList + "," + arrDsObj[i].name;
		}
	}
	return sDsList;
}
pForm.gfn_makeXML = function(arrDsObj) 
{
	if ( this.gfn_isNull(arrDsObj) ) return "";
	
	var sTemp  = "";
	var objDs ;
	var sColNm, sColVal;

	//sTemp += '<?xml version="1.0" encoding="utf-8"?>' + "\n";
	sTemp += '<root>' + "\n";

	//for (var i=0; i<toNumber(sDsCnt); i++)
	for (var i=0; i<arrDsObj.length; i++)
	{
		objDs = arrDsObj[i];

		sTemp += '<' + objDs.name + '>' + "\n";

		var nRowCnt = objDs.getRowCount();
		var nColCnt = objDs.getColCount();
		
		//for (var j=0; j<toNumber(nRowCnt); j++) {
		for (var j=0;  j< nRowCnt; j++) {
			sTemp += '<record>' + "\n";
			
			//for (var k=0; k<toNumber(nColCnt); k++) {
			for (var k=0; k < nColCnt; k++) {
				sColNm = objDs.getColID(k);
				sColVal = objDs.getColumn(j, k);
				sColVal = this.gfn_blankStr(sColVal);
				
				//sTemp += '<' + sColNm + '><![CDATA[' + sColVal + ']]]]><![CDATA[></' + sColNm + '>' + "\n";
				sTemp += '<' + sColNm + '><![CDATA[' + sColVal + ']]></' + sColNm + '>' + "\n";
			}
			
			sTemp += '</record>' + "\n";
		}
	
		sTemp += '</' + objDs.name + '>' + "\n";
	}

	sTemp += '</root>';
	return sTemp;
};


/*------------------------------------------------------------------
 * 인쇄용 데이터셋을 생성한다.
 * 작성자 : 응용1팀 김찬영K
 * 설명   : 필터링된(실제 활용되는) 데이터만 복사해서 데이터셋을 생성한다.
            복사시 코드컬럼 맵핑문자열을 복사한다.
 * @param  : ds1 - Source Dataset
             ds2 - Destination Dataset
             mapStr - 복사시 코드컬럼 매핑문자열
 * @return : 
 * 예 : var colMapStr = "xxdmValTpGx = dscmbValTp.id:value xxdmValFmGx = dsValFm.id:value";
 *      bfn_ue_makeRexDataset(dsSource, dsDest, colMapStr);
 *****************************************************************************************/
pForm.gfn_ue_makeRexDataset = function(ds1, ds2, mapStr) {
    
    // 필터링된 dataset 복사
    ds2.copyData(ds1, true);
    
    // mapping 할 컬럼 정보 처리
    // 0 : coldId, 1 : dataset, 2 : dataset.coldId, 3 : valNm
    var arrColsInfo = Array(); // binding된 컬럼정보를 가짐. 2차 배열로 사용됨.
    var arrBindCols = Array(); // binding 컬럼 정보만 감짐.
    
    if (mapStr != null && mapStr.length > 0) {
		
        var mapArr = mapStr.split(" ");
        
        if (mapArr.length > 0) {
        
            var colStr;
            var dsName;
            var colNm;
            
            for (var i = 0, n = mapArr.length; i < n; i++) {
            
                colStr = mapArr[i];
                
                if (colStr.trim(" ").length < 1) continue;
                
                var bindInfo = Array(4);
                var idx1 = colStr.indexOf("=");
                var idx2 = colStr.indexOf(".", idx1);
                var idx3 = colStr.indexOf(":", idx2);
                
                // dataset 조사
                // 0 : coldId, 1 : dataset, 2 : dataset.coldId, 3 : valNm
                //dsName = substr(colStr, idx1+1, idx2 - idx1 - 1);
                
                dsName = colStr.substr(idx1+1, idx2 - idx1 - 1);
                
                //var dsObj = Object(dsName);
                var dsObj = eval(dsName);
                
                if (isValidObject(dsObj) == false) continue;
                                
                colNm = colStr.substr(0, idx1);
                bindInfo[0] = colNm;
                bindInfo[1] = dsObj;
//                 bindInfo[2] = substr(colStr, idx2+1, idx3 - idx2 - 1);
//                 bindInfo[3] = substr(colStr, idx3+1);
                bindInfo[2] = colStr.substr(idx2+1, idx3 - idx2 - 1);
                bindInfo[3] = colStr.substr(idx3+1);
                
                arrColsInfo[arrColsInfo.length] = bindInfo;
                arrBindCols[arrBindCols.length] = colNm;
            } // end of for
        }
    }
    
    // dataset 코드값 설정
    var colVal;
    
    for (var i = 0, n = arrColsInfo.length; i < n; i++) {
    
        var bindInfo = arrColsInfo[i];
        var colId = bindInfo[0];
        var bindDsObj = bindInfo[1];
        var bindColId = bindInfo[2];
        var bindValId = bindInfo[3];
        
        for (var j = 0, m = ds2.rowcount; j < m; j++) {
            var colVal = this.gfn_ue_findCodeVal(bindDsObj, bindColId, bindValId, ds2.getColumn(j, colId) );
            ds2.setColumn(j, colId, colVal);
        }
    }
};

/*------------------------------------------------------------------
 * 데이터셋에서 코드값을 찾아 반환한다.
 * 작성자 : 응용1팀 김찬영K
 * 설명   : 데이터셋에서 코드값을 찾아 반환한다.
 * @param  : objDs 조회할 데이터 겟
             colId 조회시 사용할 컬럼Id
             valId 반환할 컬럼ID
             strVal 조회할 값
 * @return : 조인한 문자열
 *****************************************************************************************/
pForm.gfn_ue_findCodeVal = function(objDs, colId, valId, strVal) 
{
    var nRow = objDs.findRowAs(colId, strVal);
    
    if (nRow > -1) {
		return objDs.getColumn(nRow, valId);
	} else {
		return "";
	}
};   
