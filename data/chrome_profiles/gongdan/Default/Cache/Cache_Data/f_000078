	if(this.gfn_isEmpty(nHeight)) nHeight = 800;

	//프린트 사유 : 공통코드값이 아닌 '90000'으로 무조건 셋팅(by 정보부 요청사항)
	var objApp = nexacro.getApplication();
	objApp.mainframe.fv_indiInfInqRsnCd = "";
	objApp.mainframe.fv_inqDataCnt 		= aDataset[0].rowcount;
	objApp.mainframe.fv_busi24Log 		= "문서 출력";
	
	//문서 다운로드 로그 업무로그 (TZ20) 저장 
	this.fn_printRexpertBizLog(this.ds_cond);

	//var sPopId 		= "REXPERT";
	var sPopId 		= nexacro.replaceAll( nexacro.replaceAll( sFile, "/", "_" ), ".", "_" );  //여러개의 보고서 팝업을 한꺼번에 띄울 수 있게 합니다.
	var sScrNm 		= "REXPERT PRINT";
	var sUrl 		= "frame_common::comRexpertPrint.xfdl"; 
	var nWidth 		= nWidth;
	var nHeight 	= nHeight; 
	var sArgs   	= {argDataset:aDataset, argFile:sFile, argParam:sParam, argDuplex:sDuplex, argMarkAny:bApplyMarkAny, argFileSave:bFileSave};
	var bIsModal 	= true;

	this.gfn_rexpertShowPopupByURL(this, sPopId, sScrNm, sUrl, nWidth, nHeight, sArgs, bIsModal,-1, -1, true);

}

pForm.gfn_rexpertShowPopupByURL = function(objOpener, sPopId, sScrNm, sURL, nWidth, nHeight, oArgs, bIsModal
                                         , nLeft, nTop, bResize, bTitleBar, bStatusBar) 
{
	var arrScrInfo = [];
		arrScrInfo["PROGRAM_ID"]   		= "";
		arrScrInfo["PROGRAM_NAME"]  	= sScrNm;
		arrScrInfo["PROGRAM_PATH"]  	= sURL;
		arrScrInfo["PROGRAM_WIDTH"] 	= nWidth;
		arrScrInfo["PROGRAM_HEIGHT"] 	= nHeight;
		
		this._gfn_rexpertShowPopupByURL(objOpener, sPopId, arrScrInfo, oArgs, bIsModal, false
		                        , nLeft, nTop, bResize, bTitleBar, bStatusBar, ""
								, true, ""); 
};

//URL에 정보에 해당하는 팝업호출
pForm._gfn_rexpertShowPopupByURL = function (objOpener, sPopId, arrScrInfo, oArgs, bIsModal, bVscrollbar
                               ,nLeft, nTop, bResize, bTitleBar, bStatusBar, sPopupTitle
							   ,bWrapForm, sPopupCallback) 
{
	var objApp = nexacro.getApplication();
	
	// set Default Value
	if (this.gfn_isNull(bIsModal))      bIsModal    = false;		//default : modeless
	if (this.gfn_isNull(bVscrollbar))   bVscrollbar = false;
	if (this.gfn_isNull(nLeft))     	nLeft   = -1;
	if (this.gfn_isNull(nTop))      	nTop    = -1;
	if (this.gfn_isNull(bResize))       bResize     = true;		//modeless는 적용안됨
	if (this.gfn_isNull(bTitleBar))     bTitleBar   = true;
	if (this.gfn_isNull(bStatusBar))    bStatusBar  = false;		
	//bStatusBar  = false;	
	//if (this.gfn_isNull(sPopupTitle))   sPopupTitle = "";	
	if (this.gfn_isNull(bWrapForm))     bWrapForm   = true;
	if (this.gfn_isNull(sPopupCallback) && objOpener["fn_popupCallback"])    sPopupCallback  = "fn_popupCallback";

	var bLayered = false;
	var nOpacity = 100;
	var bAutoSize = false;
	
	var sScrId  = arrScrInfo["PROGRAM_ID"];
	var sScrNm  = arrScrInfo["PROGRAM_NAME"];
	var sURL    = arrScrInfo["PROGRAM_PATH"];
	var nWidth  = arrScrInfo["PROGRAM_WIDTH"];
	var nHeight = arrScrInfo["PROGRAM_HEIGHT"];
	
	if(nWidth == -1 || nHeight == -1) {
	    bAutoSize = true;
	}

	// TitleText 설정
	if (!this.gfn_isNull(sPopupTitle)) { sScrNm     = sPopupTitle; }
	var sTitleText = sScrNm  + "[" + sScrId +"]";

	// 공통 Popup URL
	var sBaseUrl = "";
	if ((bWrapForm) && (bIsModal)) {
		sBaseUrl = "frame_main::frameModal.xfdl";
	} else if ((bWrapForm) && (!bIsModal)) {
		sBaseUrl = "frame_main::frameModeless.xfdl";
	} else {
		sBaseUrl = sURL;
	}

	var openerBizInfo;
	var objParentFrame = objOpener.getOwnerFrame();
	var objBizInfo = { popupId : sScrId
					 , popupNm : sScrNm
					 , url     : sURL
					 , width   : nWidth
					 , height  : nHeight
				     };
	//mainframe에서 호출시 처리용
	if (objOpener === objApp.mainframe) {
		objParentFrame = objOpener;
	} 
	//업무화면에서 호출(objNewWin.isPopup  = false;)
	else if(!objParentFrame.isPopup) {
	
		if (objParentFrame["_bizInfo"]) {
			openerBizInfo = objParentFrame._bizInfo;

		} else if (objParentFrame["_frmInfo"]) {
			openerBizInfo = objParentFrame._frmInfo;
		}		
	//팝업에서 호출
	} 
	else {
		openerBizInfo = objParentFrame._bizInfo;
	}
	if (openerBizInfo) 
	{
		objBizInfo["menuId"]   		= openerBizInfo.menuId;
		objBizInfo["menuText"]   	= sScrNm;
		objBizInfo["screenId"] 		= openerBizInfo.screenId;
		objBizInfo["menuUrl"] 		= sURL;
		objBizInfo["programId"] 	= sScrId;
	}

	//팝업크기 재조정
	var nTitlebarheight = 32;
	var nRevisionValueW = 2;  // Border 1 * 2
	var nRevisionValueH = 2;     // Border 1 * 2
	var nStatusbarheight = 0;

	if (bWrapForm) {
		nRevisionValueW += 20;  // margin 10 * 2
		nRevisionValueH += 20;  // margin 10 * 2
	}

	if (bVscrollbar) {
		nRevisionValueW += 10; 
	}

	if (!bTitleBar)  { nTitlebarheight = 0; }
	if (!bStatusBar) { nStatusbarheight = 0; }

	nWidth  += nRevisionValueW;
	nHeight += nTitlebarheight + nStatusbarheight + nRevisionValueH;

	var sOpenalign = "";
	if(nLeft == -1 && nTop == -1) 
	{		
		sOpenalign = "center middle";
		if (system.navigatorname == "nexacro") {
			var curX = objApp.mainframe.left;
			var curY = objApp.mainframe.top;
		}else{
			var curX = window.screenLeft;
			var curY = window.screenTop;
		}
		
        nLeft   =  curX + (objApp.mainframe.width / 2) - Math.round(nWidth / 2);
	    nTop    = curY + (objApp.mainframe.height / 2) - Math.round(nHeight / 2) ;		
		
	}else{
		nLeft   =  this.getOffsetLeft() + nLeft;
		nTop   =  this.getOffsetTop() + nTop;
	}
	
	var sPopupType = ( bIsModal == true ) ? "modal":"modeless";
//trace("sPopupType==="+sPopupType);
	if( this.gfn_isNull(oArgs))
	{
		oArgs = {};
		oArgs["_bizInfo"] = objBizInfo;
		oArgs["isPopup"]  = true;		//팝업여부 체크용
	}
	else
	{
		if( typeof oArgs =="object" )
		{
			oArgs["_bizInfo"] = objBizInfo;
			oArgs["isPopup"]  = true;	//팝업여부 체크용
		}
	}
	//리턴변수 초기화
	this._variant = "";

    if(sPopupType == "modeless")
    {
        var sOpenStyle = "showtitlebar=true showstatusbar=" + bStatusBar + " showontaskbar=true showcascadetitletext=false border='1px solid #24322b' titlebarheight="+ nTitlebarheight 
		               + " resizable=" + bResize + " autosize=" + bAutoSize + " titletext='" + sTitleText + "'";

		// Popup(Modeless) 인 경우 화면이 열려 있으면 Focus만 줌.
		var arrPopFrame = nexacro.getPopupFrames();
		var objPopup = arrPopFrame[sPopId];
		if (arrPopFrame[sPopId]) {	
			if (system.navigatorname == "nexacro") {
				arrPopFrame[sPopId].setFocus();
			} else {
				arrPopFrame[sPopId]._getWindowHandle().focus();
			}
		}
		else {
			nexacro.open(sPopId,sBaseUrl,objParentFrame,oArgs,sOpenStyle,nLeft, nTop, nWidth, nHeight, this);
		}
    }
    else
    {	
		newChild = new nexacro.ChildFrame;
		newChild.init(sPopId, nLeft, nTop, nWidth, nHeight, null, null, sBaseUrl);
		newChild.set_dragmovetype("normal");
		newChild.set_showcascadetitletext(false);
		newChild.set_layered(bLayered);
		newChild.set_overlaycolor("RGBA(0, 0, 0, 0.2)");
		newChild.set_opacity(nOpacity);
		newChild.set_border("1px solid #24322b");
		
		newChild.set_showtitlebar(bTitleBar);
		newChild.set_titlebarheight(nTitlebarheight);
		newChild.set_titletext(sTitleText);
		newChild.set_showstatusbar(bStatusBar);
		newChild.set_autosize(bAutoSize);	
		newChild.set_resizable(bResize);
		newChild.set_openalign(sOpenalign);
		//newChild.isPopup = true; //팝업여부 체크용
		var nIndex = newChild.addEventHandler("onmove", this._gfn_modalPopup_onmove, this);
		
		//newChild.set_cssclass("");	//set_background("transparent URL('images::bg_popup.png') stretch 35,10");
		if ( this[sPopupCallback] ) {
			var bSucc = newChild.showModal(objParentFrame, oArgs, this, this[sPopupCallback]);
		} else {
			var bSucc = newChild.showModal(objParentFrame, oArgs, this, function ()	{});
		}
    }
	
	trace("bSucc: " + bSucc);
};

