        // User Script
        this.registerScript("frameLeft.xfdl", function() {
        /*=============================   Program description   ================================*
         * Form ID     : frameLeft.xadl
         * Form Desc.  : left frame
         * Author      : 황규철
         * Create Date : 2014.10.20
         * Change History
         *--------------------------------------------------------------------------------------*
         * 수정일 / 이름 / 사유
         *--------------------------------------------------------------------------------------*
         * 2014.10.20 / 황규철 / 신규
         * 2018.08.20 / 나종식 / Conversion
         *======================================================================================*/

        /*======================================================================================*
         * 1. include
         *======================================================================================*/

        /*======================================================================================*
         * 2. Form 변수
         *======================================================================================*/

        /*======================================================================================*
         * 3. Form Load
         *======================================================================================*/
        this.frameLeft_onload = function(obj,e)
        {
        	this.fn_formInit(obj);
        };

        //초기화
        this.fn_formInit = function(obj)
        {
        //trace("frameLeft fn_formInit >>>>>>>>>>>>>>>>>>>>>");
        };

        /*======================================================================================*
         * 4.Transaction
         *======================================================================================*/
        	// ~~~
        /*======================================================================================*
         * 5. Transaction 전/후 처리 함수
         *======================================================================================*
         * 5.1 CallPrev- Transaction전 처리
         *======================================================================================*/
        	// ~~~
        /*======================================================================================*
         * 5.1 CallBack- Transaction후 처리
         *======================================================================================*/
        	// ~~~

        /*======================================================================================*
         * 6. 사용자정의 함수
        *======================================================================================*/
         /**
         * @description FORM오픈 [공통함수호출]
        */
        this.fn_setLeftMenu = function ()
        {
        	var objApp = nexacro.getApplication();
        	//전체 메뉴 복사
        	this.ds_leftSubMenu.copyData(objApp.gds_allMenu);

        	this.fn_settingTreeOpen();		//트리메뉴 오픈방식설정
        	this.fn_settingMyMenuFirst();	//마이메뉴 우선방식설정
        }

         /**
         * @description FORM오픈 [공통함수호출]
        */
        this.fn_formOpen = function (objDs,nTargetRow,objArg)
        {
        	var objApp = nexacro.getApplication();
        	if( this.gfn_isNull(objDs) ) return;
        	if( this.gfn_isNull(nTargetRow) ) return;
        	if( this.gfn_isNull(objArg) ) objArg = [];

        	var sUrl = objDs.getColumn(nTargetRow , objApp.av_aMenuColumns.menuUrl);
        	if( this.gfn_isNull(sUrl) ) return;
        	//trace("sUrl=["+sUrl+"],"+sUrl.toString().length);

        	var oObj = {
        		ds    : objDs,  			// 메뉴 dataset
        		nRow  : nTargetRow,      	// 선택된 row
        		oArgs : objArg       		// 넘길 argument
        	};
        	this.gfn_call(oObj);
        };

         /**
         * @description FORM오픈 [공통함수호출]
        */
        this.fn_setTree = function (obj,e)
        {
        	var nChildCnt 	= obj.getTreeChildCount(e.row);
        	var nTreerow 	= obj.getTreeRow(e.row);
        	var bPrevStatus = obj.getTreeStatus(nTreerow);
        	var bPostStatus = 0;

        	if(bPrevStatus == 0 || bPrevStatus == 2) bPostStatus = 1;

        	if(nChildCnt > 0) {
        		obj.setTreeStatus(nTreerow,bPostStatus);
        		return;
        	}
        }

        /**
         * @description 상단 top메뉴 변경시 left메뉴 변경 처리
        */
        this.fnChangeMenu = function (topMenuId)
        {
        	var objApp = nexacro.getApplication();
        	var filterExpr = objApp.av_menuColumns.groupId + "==" + nexacro.wrapQuote(topMenuId) + "&&" + objApp.av_menuColumns.menuLevel + ">1";
        	objApp.gdsMenu.set_enableevent(false);
        	this.dsMenu.set_enableevent(false);
        	objApp.gdsMenu.filter(filterExpr);
        	this.dsMenu.copyData(objApp.gdsMenu, true);
        	objApp.gdsMenu.filter("");
        	objApp.gdsMenu.set_enableevent(true);
        	this.dsMenu.set_enableevent(true);
        };

        /**
         * 다른 Frame에서 화면변경시 메뉴 sync
        */
        this.fn_syncLeftMenu = function(sMenuId)
        {
        	var nRow 		= this.ds_leftSubMenu.findRow("MENU_ID",sMenuId);
        	var oGrid 		= this.grd_leftMenu;
        //trace("fn_syncLeftMenu sMenuId=========="+sMenuId+"::::row==="+nRow);
        	var nParentRow  = oGrid.getTreeParentRow( nRow )
        	var nChildCnt 	= oGrid.getTreeChildCount(nParentRow);
        	var nTreerow 	= oGrid.getTreeRow(nParentRow);
        	var bParentStatus = oGrid.getTreeStatus(nTreerow);

        	if(bParentStatus == 0) {
        		oGrid.setTreeStatus(nTreerow,true);
        	}

        	this.ds_leftSubMenu.set_rowposition(nRow);
        };

        //트리오픈방식 설정
        this.fn_settingTreeOpen = function()
        {
        	switch (nexacro.getPrivateProfile("TREE_CLOSE"))
        	{
        		case "true" :
        			this.grd_leftMenu.set_treeinitstatus("collapse,null");
        			this.grd_myMenu.set_treeinitstatus("collapse,null");
        		break;

        		case "false" :
        			this.grd_leftMenu.set_treeinitstatus("expand,null");
        			this.grd_myMenu.set_treeinitstatus("expand,null");
        		break;

        		default :
        			this.grd_leftMenu.set_treeinitstatus("expand,null");
        			this.grd_myMenu.set_treeinitstatus("expand,null");
        		break;
        	}
        }

        //마이메뉴 우선방식설정
        this.fn_settingMyMenuFirst = function()
        {
        	switch (nexacro.getPrivateProfile("MY_MENU_FIRST"))
        	{
        		case "true" :
        			this.btn_myMenu.click();
        		break;

        		case "false" :
        			this.btn_allMenu.click();
        		break;

        		default :
        			this.btn_allMenu.click();
        		break;
        	}
        }

        /*======================================================================================*
         * 7. 이벤트 함수
         *======================================================================================*/
        /**
         * @description  메뉴/마이메뉴 버튼 중 메뉴버튼 클릭
        */
        this.btn_allMenu_onclick = function(obj,e)
        {
         	this.btn_allMenu.set_cssclass("btn_LF_Tab_allmenu_S");
         	this.btn_myMenu.set_cssclass("btn_LF_Tab_bookmark");

        	this.grd_leftMenu.bringToFront();
        	this.grd_myMenu.sendToBack();

        	this.grd_leftMenu.set_visible(true);
        	this.grd_myMenu.set_visible(false);
        };

        /**
         * @description  메뉴/마이메뉴 버튼 중 마이메뉴버튼 클릭
        */
        this.btn_myMenu_onclick = function(obj,e)
        {
        	var objApp = nexacro.getApplication();
         	this.btn_allMenu.set_cssclass("btn_LF_Tab_allmenu");
         	this.btn_myMenu.set_cssclass("btn_LF_Tab_bookmark_S");

        	this.grd_leftMenu.sendToBack();
        	this.grd_myMenu.bringToFront();

        	this.grd_leftMenu.set_visible(false);
        	this.grd_myMenu.set_visible(true);

        	//this.gfn_dsView(objApp.gds_fvrt);
        };

        /**
         * @description 메뉴 클릭이벤트
        */
        this.grd_leftMenu_oncellclick = function(obj,e)
        {
        	this.fn_formOpen(this.ds_leftSubMenu, e.row);
        // 	//팝업메뉴 호출여부???
        };

        /**
         * @description 메뉴 더블클릭이벤트
        */
        this.grd_leftMenu_oncelldblclick = function(obj,e)
        {
        	this.fn_setTree(obj, e);
        };

        /**
         * @description 마이메뉴 클릭이벤트
        */
        this.grd_myMenu_oncellclick = function(obj,e)
        {
        	var objApp = nexacro.getApplication();
        	var sMenuId  = objApp.gds_fvrt.getColumn(e.row, "MENU_ID");
        	if ( this.gfn_isNull(sMenuId) ) return;
        	var nFindRow = this.ds_leftSubMenu.findRow("MENU_ID", sMenuId);
        	this.fn_formOpen(this.ds_leftSubMenu, nFindRow);
        };

        /**
         * @description 마이메뉴 더블클릭이벤트
        */
        this.grd_myMenu_oncelldblclick = function(obj,e)
        {
        	this.fn_setTree(obj, e);
        };

        /**
         * expand 버튼 클릭 이벤트
        */
        this.div_searchMenu_btn_collapse_onclick = function(obj,e)
        {
        	if(this.grd_leftMenu.visible) {
        		this.grd_leftMenu.set_treeinitstatus( "expand,all" );
        	} else {
        		this.grd_myMenu.set_treeinitstatus("expand,all");
        	}
        };

        /**
         * collapse 버튼 클릭 이벤트
        */
        this.div_searchMenu_btn_expand_onclick = function(obj,e)
        {
        	if(this.grd_leftMenu.visible) {
        		this.grd_leftMenu.set_treeinitstatus("collapse,all");
        		this.grd_leftMenu.setFocus();
        	} else {
        		this.grd_myMenu.set_treeinitstatus("collapse,all");
        		this.grd_myMenu.setFocus();
        	}
        };

        /**
         * 메뉴검색 Enter-key 이벤트
        */
        this.div_searchMenu_edt_searchMenuText_onkeydown = function(obj,e)
        {
        	if(e.keycode == 13)
        	{
        		this.div_searchMenu.form.btn_searchMenu.click();
        	}
        };

        /**
         * 메뉴검색 찾기 버튼 클릭 이벤트
        */
        this.div_searchMenu_btn_searchMenu_onclick = function(obj,e)
        {
        	var objApp = nexacro.getApplication();
        	var oDs;
        	var oGrid;
        	var sValue = this.div_searchMenu.form.edt_searchMenuText.value;

        	if(this.gfn_isNull(sValue)){
        		this.gfn_msgShow(this, "XITZ0086",["메뉴명 또는 메뉴코드를 입력"]);//해야 합니다.

        		return false;
        	}

        	if(this.grd_leftMenu.visible) {
        		oDs = this.ds_leftSubMenu;
        		oGrid = this.grd_leftMenu;
        	} else {
        		oDs = nexacro.getApplication().gds_fvrt;
        		oGrid = this.grd_myMenu;
        	}

            oGrid.setFocus();

            sValue = sValue.replace(" ","");

        	if(!this.fv_bStartFind){
        		this.fv_nRow = oDs.findRowExpr("String(MENU_ID).indexOf('" + sValue+ "') >= 0 || String(MENU_NM).indexOf('" + sValue+ "') >= 0 || String(PGM_ID).indexOf('" + sValue+ "') >= 0");
        		this.fv_nNextRow = oDs.findRowExpr("String(MENU_ID).indexOf('" + sValue+ "') >= 0 || String(MENU_NM).indexOf('" + sValue+ "') >= 0 || String(PGM_ID).indexOf('" + sValue+ "') >= 0",this.fv_nRow+1,-1);
        		this.fv_bStartFind = true;
        	} else {
        		this.fv_nRow = this.fv_rRow;
        		this.fv_nNextRow = oDs.findRowExpr("String(MENU_ID).indexOf('" + sValue+ "') >= 0 || String(MENU_NM).indexOf('" + sValue+ "') >= 0 || String(PGM_ID).indexOf('" + sValue+ "') >= 0",this.fv_nRow+1,-1);
        	}

        	if(this.fv_nNextRow == -1){
        		this.fv_bStartFind = false;
        	}

        	// 검색결과가 하나밖에 없을때....
        	if(this.fv_nRow >= 0 && this.fv_nNextRow == -1) {
        		var sSearchMenu = oDs.getColumn(this.fv_nRow, "MENU_ID");
        		if (this.gfn_isNull(sSearchMenu)) return;

        		if ( oDs.name == "ds_leftSubMenu" ) {
        			this.fn_formOpen(oDs, this.fv_nRow);
        		} else {
        			objApp.av_oTopFrame.form.fn_menuOpen(sSearchMenu);
        		}
        		//return;
        	}

        	if(oDs.rowposition == this.fv_nRow) {
        		oDs.set_rowposition(0);
        	}

             if(this.fv_nRow ==-1){
                oDs.set_rowposition(-1);
             } else {
         		var tRow = this.fv_nRow;
         		var iRow=0;
         		var nChildCnt;

         		while(tRow>=iRow){
         			nChildCnt = oGrid.getTreeChildCount(iRow);
         			if(nChildCnt > 0){
         				oGrid.setTreeStatus(iRow,true);
         			}
         			iRow++;
         		}

         		oGrid.setFocus();
         		oDs.set_rowposition(tRow);
             }
             this.fv_rRow = this.fv_nNextRow;
             this.div_searchMenu.form.edt_searchMenuText.setFocus();
        };
        });
        
        // Regist UI Components Event
        this.on_initEvent = function()
        {
            this.addEventHandler("onload",this.frameLeft_onload,this);
            this.btn_myMenu.addEventHandler("onclick",this.btn_myMenu_onclick,this);
            this.btn_allMenu.addEventHandler("onclick",this.btn_allMenu_onclick,this);
            this.div_searchMenu.form.btn_collapse.addEventHandler("onclick",this.div_searchMenu_btn_collapse_onclick,this);
            this.div_searchMenu.form.btn_expand.addEventHandler("onclick",this.div_searchMenu_btn_expand_onclick,this);
            this.div_searchMenu.form.btn_searchMenu.addEventHandler("onclick",this.div_searchMenu_btn_searchMenu_onclick,this);
            this.div_searchMenu.form.edt_searchMenuText.addEventHandler("onkeydown",this.div_searchMenu_edt_searchMenuText_onkeydown,this);
            this.grd_leftMenu.addEventHandler("oncelldblclick",this.grd_leftMenu_oncelldblclick,this);
            this.grd_leftMenu.addEventHandler("oncellclick",this.grd_leftMenu_oncellclick,this);
            this.grd_myMenu.addEventHandler("oncelldblclick",this.grd_myMenu_oncelldblclick,this);
            this.grd_myMenu.addEventHandler("oncellclick",this.grd_myMenu_oncellclick,this);
        };

        this.loadIncludeScript("frameLeft.xfdl");
        this.loadPreloadList();
        
        // Remove Reference
        obj = null;
    };
