					if(params.proxyUrl == null || params.proxyUrl == "") {
						params.proxyUrl = "/npbs/btrs/proxy.jsp";
					}
				} else {
					params.proxyUse = "N";
					params.proxyUrl = "";
				}
			
				BTRS.core.log("--postMessage--");
				BTRS.core.log("frameId: " 				+ frameId						);
				BTRS.core.log("func: " 					+ func							);
				BTRS.core.log("profile: "				+ params.profile				);
				BTRS.core.log("opener: "				+ params.opener					);
				BTRS.core.log("urlSpcd: "				+ params.urlSpcd				);
