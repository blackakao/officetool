	  core: {}
	, create: function(_owner, _prop, _recv) {
		BTRS.core = {
			  owner: _owner
			, prop: _prop
			, frameId: "btrsFrame"
			, webView: {}
			, params: {}
			, data: {}
			, stringify: function(obj) {
				if(obj == null) return 'null';
				switch(typeof obj) {
					case 'number':
					case 'boolean': { return obj.toString(); }
					case 'string':	{ return '"' + obj + '"'; }
					case 'object':	{
						if(obj instanceof Array) {
							let arrayContent = '';
							for(let i=0; i<obj.length; i++) arrayContent += (i ? ',' : '') + BTRS.core.stringify(obj[i]);
							return '[' + arrayContent + ']';
						} else {
							let objectContent = '';
							let first = true;
							for(let key in obj) {
								if(obj.hasOwnProperty(key)) {
									objectContent += (first ? '' : ',') + '"' + key + '":' + BTRS.core.stringify(obj[key]);
									first = false;
								}
							}
							return '{' + objectContent + '}'; 
						}
					}
					default: { return ''; }
				}
			}
			, parse: function(str) {
				try {
					return eval('(' + str + ')');
				} catch(e) {
					BTRS.core.log("JSON 변환 실패: " + str);
				}
				return null;
			}			
			, log: function(msg) {
				if("PROD" == BTRS.core.params.profile) return;
				if(BTRS.core.isNRE) trace(BTRS.core.stringify(msg));
				else console.log(BTRS.core.stringify(msg));
			}
			, formatBytes: function(bytesString) {
				const bytes = parseInt(bytesString, 10);
				if(isNaN(bytes)) {
					return '';
				}
				const units = ['B', 'KB', 'MB', 'GB', 'TB'];
				var index = 0;
				var value = bytes;
				while(value >= 1024 && index < units.length - 1) {
					value /= 1024;
					index++;
				}
				return "" + value.toFixed(0) + " " + units[index] + "  ";
			}			
			, getToken: function(url, func) {
				/*
				BTRS.core.params.token = "43806b00-f527-404f-9e3f-c421c50bf4cb";
				func(BTRS.core, true);
				*/
				BTRS.core.getUrl();
				var tokenUrl = "/npbs/btrs/getToken.do";
				if(url == null || url == "") { }
				else { tokenUrl = url }
				$.post(tokenUrl, {
					  profile: 	BTRS.core.params.profile		
					, opener:	BTRS.core.params.opener
					, urlSpcd:	BTRS.core.params.urlSpcd
					, svcSpcd:	BTRS.core.params.svcSpcd
