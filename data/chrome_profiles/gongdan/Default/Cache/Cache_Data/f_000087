				var data = BTRS.core.stringify(params);
				BTRS.core.log(data);
				
				if(BTRS.core.params.isNRE) { //runtime
					frameId = BTRS.core.getWebView();
					try { //nexacro
						frameId.callMethod(func, data);
					} catch(e) { //xplatform
						if('setParams' == func) frameId.document.defaultView.setParams(data);
					}
				} else { //browser
					var frameObj = document.getElementById(frameId).contentWindow;
					frameObj.postMessage({func: func, params: data}, '*');
				}
			}
			, callBackFunc: function(cbData) {
				
				BTRS.core.log("--callBackFunc--");
				BTRS.core.log(cbData);

				BTRS.core.data = cbData.data;
				_recv(BTRS.core.owner, BTRS.core.data);
				if("Y" == BTRS.core.params.autoApply) {
					//동작없음					
				} else {
					window.removeEventListener('message', BTRS.core.callBackFunc);	
				}
			}
			, createIframe: function(containerId) {
				var url = BTRS.core.getUrl();
				var frameId = BTRS.core.getFrameId();
				
				BTRS.core.log("--createIframe--");
				BTRS.core.log(url);				
				BTRS.core.log(frameId);

				var iframe = document.createElement('iframe');
				iframe.setAttribute('id'	, frameId);
				iframe.setAttribute('src'	, url);
				iframe.style.width			= '100%';
				iframe.style.height			= '100%';
				iframe.style.border			= '0px solid #eaeaea';
				iframe.style.background		= '#ffffff';

				iframe.onload = function() {
					BTRS.core.postMessage(frameId, 'setParams', BTRS.core.params);
				};

				document.getElementById(containerId).appendChild(iframe);
			}
			, removeIframe: function() {
				var frameId = BTRS.core.getFrameId();
				
				BTRS.core.log("--removeIframe--");
				BTRS.core.log(frameId);
				
				var iframe = document.getElementById(frameId);
				iframe.parentNode.removeChild(iframe);
			}
		}
		BTRS.core.isNRE = false;
		try { //browser
			window.addEventListener('message', BTRS.core.callBackFunc);
		} catch(e) { //runtime
			BTRS.core.isNRE = true;
		}
		BTRS.core.getParams();
		BTRS.core.params.isNRE = BTRS.core.isNRE;
		
		if(BTRS.core.params.isNRE) BTRS.core.log("===== BTRS [NRE] =====");		
		else BTRS.core.log("===== BTRS [WEB] =====");
		
		return BTRS.core;
	}
};
try { //runtime
	nexacro.Form.prototype.BTRS = BTRS;
	BTRS = nexacro.Form.prototype.BTRS;	
} catch(e) { //browser
	if(false) { console.log(e); }
}
this.BTRS = BTRS;
