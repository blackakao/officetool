					, bizCode:	BTRS.core.params.bizCode
					, url:		BTRS.core.params.url
				}
				, function(data, status) {
					BTRS.core.log("--getToken--");
					BTRS.core.params.token = "";
					if("success" == status) {
						BTRS.core.log(data);
						var json = BTRS.core.parse(data);
						BTRS.core.params.token = json.tknId; 
						BTRS.core.params.publicKeyModulus = json.publicKeyModulus;
						BTRS.core.params.publicKeyExponent = json.publicKeyExponent;

						//20250204, 대용량송수신 문서번호 발급
						if (null == BTRS.core.params.grpCode || "" == BTRS.core.params.grpCode) {
							if(null != BTRS.core.params.useSvrGroupCode && "Y" == BTRS.core.params.useSvrGroupCode) {
								BTRS.core.params.grpCode = "" + json.svrGroupCode; 
							}
						}

						//BTRS.core.log(BTRS.core.params);

						func(BTRS.core, true);
						return;
					}
					func(BTRS.core, false);
				});
			}
