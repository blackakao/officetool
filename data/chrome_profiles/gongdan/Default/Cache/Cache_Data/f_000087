			, getUrl: function() {
				var profile 	= BTRS.core.params.profile;
				var mobileYn	= BTRS.core.params.mobileYn;
				
				BTRS.core.log("--getUrl--");
				BTRS.core.log("profile: "	+ profile);
				BTRS.core.log("mobileYn: "	+ mobileYn);
				
				var url = BTRS.core.prop.url_base;
				
				if("LOCAL"	== profile)		url = BTRS.core.prop.url_local;
				if("DEV"	== profile)		url = BTRS.core.prop.url_dev;
				if("TEST"	== profile)		url = BTRS.core.prop.url_test;
				if("PROD"	== profile)		url = BTRS.core.prop.url_prod;
				
				if("Y" 		== mobileYn)	url += "/btaa110p02.html";
				else 						url += "/btaa110p01.html";
				
				BTRS.core.params.url = url;
				
				return url;
			}
