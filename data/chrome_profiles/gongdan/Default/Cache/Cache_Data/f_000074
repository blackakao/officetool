/**
 * 프로그램 Url에서 Prefix 변경
 */
pForm.gfn_changePgmUrl = function(objDs)
{
	var nRowCnt = objDs.rowcount;
	var sPgmUrl = "";
	var sPgmPrefix = "";
	
	for ( var i=0; i<nRowCnt; i++ ) {
		sPgmUrl = objDs.getColumn(i, "PGM_URL");
		if ( !this.gfn_isNull(sPgmUrl) ) {
			sPgmPrefix = sPgmUrl.split("::")[0];
			sPgmPrefix = nexacro.replaceAll( sPgmPrefix, ".", "_" );
			sPgmUrl = sPgmPrefix + "::" + sPgmUrl.split("::")[1];
			
			objDs.setColumn(i, "PGM_URL", sPgmUrl);
		}
	}
}

//현재 PC DateTime값 trace
pForm.gfn_traceCurrentTime = function (sMemo)
{
	var objDate  = new Date();
	var sDate    = objDate.getYear()
					+"-"+String(objDate.getMonth()  ).padLeft(2, '0')
					+"-"+String(objDate.getDate()   ).padLeft(2, '0')
					+" "+String(objDate.getHours()  ).padLeft(2, '0')
					+":"+String(objDate.getMinutes()).padLeft(2, '0')
					+":"+String(objDate.getSeconds()).padLeft(2, '0')
					+" "+objDate.getMilliseconds();	
	trace(sMemo + ">>>>>>>>>>>>>>>>>> 현재시간 : " + sDate);
}