pForm.gfn_newOpen = function(sMenuId, oArgs)
{
	var objApp = nexacro.getApplication();
	
	var gdsOpen  = objApp.gds_openMenu;		//열린 dataset
	var gdsMenu  = objApp.gds_allMenu;
	//var winid  = "win" + sMenuId + "_" + gdsOpen.getRowCount() + "_" + parseInt(Math.random() * 1000);		
	var winid  = "win" + sMenuId;
	
	//화면이 존재하면 이동
	var objTargetChild = nexacro.getPopupFrames(objApp.mainframe)[winid];
	if (objTargetChild) {
		if (system.navigatorname == "nexacro") {
			objTargetChild.setFocus();
		} else {
			objTargetChild._getWindowHandle().focus();
		}
		return;
	}
	
	var nMenuRow 	= gdsMenu.findRow("MENU_ID",sMenuId);
	var sMenuText 	= gdsMenu.getColumn(nMenuRow,"MENU_NM");
	var sMenuUrl 	= gdsMenu.getColumn(nMenuRow,"PGM_URL");
	var sMenuDesc 	= gdsMenu.getColumn(nMenuRow,"MENU_PATH");
	var sMultiOpen 	= gdsMenu.getColumn(nMenuRow,"MULTI_OPEN_YN");	
	var sProgramId 	= gdsMenu.getColumn(nMenuRow,"PGM_ID");	
	var sMenuParm   = gdsMenu.getColumn(nMenuRow, "MENU_PARM");
	
	var sTouchEn 	= gdsMenu.getColumn(nMenuRow,"LKAV_FUNC_YN");			//캡쳐방지
	var sXecureWeb 	= gdsMenu.getColumn(nMenuRow,"WB_FAX_SEND_FUNC_YN");	//구간암호화
	
	if(this.gfn_isNull(sMenuUrl)) {
		this.gfn_msgShow(this, "M00001",["메뉴주소가 연결되지 않았습니다."]);
		return;		//pageURl 이 없으면 return
	}
	
	if(this.gfn_isNull(oArgs)) {
		oArgs = {};
	}
	var nLeft   = oArgs.nLeft;
	var nTop    = oArgs.nTop;
	var nWidth  = oArgs.nWidth;
	var nHeight = oArgs.nHeight;
	var nTitleHeight = oArgs.nTitleHeight;
	
	if (this.gfn_isNull(nLeft))     	nLeft   = -1;
	if (this.gfn_isNull(nTop))      	nTop    = -1;
	if (this.gfn_isNull(nWidth))     	nWidth  = -1;
	if (this.gfn_isNull(nHeight))     	nHeight = -1;
	if (this.gfn_isNull(nTitleHeight))  nTitleHeight = 24;
	
	var bAutosize = false;
	if ( nWidth == -1 || nHeight == -1 ) bAutosize = true;	
	
	// TitleText 설정
	var sTitleText = sMenuText;
	
	var obj_bizInfo = { menuId    : sMenuId
				   	   ,menuText  : sMenuText
					   ,menuUrl   : sMenuUrl
					   ,screenId  : winid
					   ,programId : sProgramId
					   ,menuDesc  : sMenuDesc
					   ,webDrm    : sTouchEn
				      };

	// 공통 Popup URL
	var sBaseUrl = "frame_main::frameWork.xfdl";
	var objParentFrame = objApp.mainframe;

	// 화면 정보 추가
	oArgs["isMenuPopup"]  = true;				//팝업여부 체크용
	oArgs["_bizInfo"]  	  = obj_bizInfo;		//화면정보
				   
	var sOpenStyle = "topmost=true showtitlebar=true"
	               + " showstatusbar=false"
	               + " showontaskbar=true"
				   + " showcascadetitletext=false"
				   + " border='1px solid #24322b'"
				   + " titlebarheight=" + nTitleHeight
				   + " resizable=true"
				   + " autosize=" + bAutosize
				   + " titletext='" + sTitleText + "'";

	nexacro.open(winid, sBaseUrl, objParentFrame, oArgs, sOpenStyle, nLeft, nTop, nWidth, nHeight, objParentFrame);
};

/**
 * @class 열린화면 데이터셋에 추가 <br>
 * @param {String} winid
 * @param {String} menuId
 * @param {String} strTitle
 * @param {String} spageUrl
 * @param {String} sGroupId
 * @return N/A
 */
pForm.gfn_addOpenMenuDs = function(sChildFrameId, nScreenSeq, sMonitorId, sMenuId, sMenuText, sGroup, sTouchEn)
{
	var gdsOpen = nexacro.getApplication().gds_openMenu ;  //열린 dataset
	var nAddrow = gdsOpen.addRow();
	gdsOpen.setColumn(nAddrow,"screen_id",sChildFrameId);
	gdsOpen.setColumn(nAddrow,"screen_idSeq",nScreenSeq);
	gdsOpen.setColumn(nAddrow,"screen_virtuaMonitor",sMonitorId);
	gdsOpen.setColumn(nAddrow,"screen_menuId",sMenuId);	
	gdsOpen.setColumn(nAddrow,"screen_name",sMenuText);
	gdsOpen.setColumn(nAddrow,"screen_group",sGroup);	
	gdsOpen.setColumn(nAddrow,"web_drm",sTouchEn);
};

/**
 * @class 열린화면 데이터셋에 제거 <br>
 * @param {String} winid
 * @param {String} menuId
 * @param {String} strTitle
 * @param {String} spageUrl
 * @param {String} sGroupId
 * @return N/A
 */
pForm.gfn_delOpenMenuDs = function(sChildFrameId)
{
	var gdsOpen = nexacro.getApplication().gds_openMenu ;  //열린 dataset
	var nRow = gdsOpen.findRow("screen_id", sChildFrameId);
	if ( nRow > -1 ) gdsOpen.deleteRow(nRow);
	
	if ( gdsOpen.rowcount == 0)	nexacro.getApplication().afn_viewIntro(true);
};
