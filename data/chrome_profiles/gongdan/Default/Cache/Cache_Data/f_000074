/**
 * @class 클라이언트 IP Address 리턴
 * @return String
 */
pForm.gfn_getClientIP = function()
{
	var sClientIP  = nexacro.getApplication().gds_userInfo.getColumn(0,"USER_IP");
	if ( sClientIP == null || sClientIP == "" || sClientIP == undefined ) {
		sClientIP = "0.0.0.0";
	}
	return sClientIP;
};

/**
 * @class 실행폼의 타입이 팝업창인지를 판별하여 반환한다. <br>
 * @param  none
 * @return boolean
 */
pForm.gfn_isPopup = function()
{
	var popFrames = nexacro.getPopupFrames();
	var isPopFrame=false;

	for(var i=0; i<popFrames.length; i++)
	{
		if(this.getOwnerFrame().name==popFrames[i].name){
			isPopFrame = true;
		}
	}
	// nexacro.getPopupFrames() 오픈창에서 popFrames.length=0
	if( isPopFrame == false && this.getOwnerFrame().form.opener ) {
		isPopFrame = true;
	}
	
	return isPopFrame;
};
