/**
 * @class 실행 환경에 따라 WebBroswer 객체 가져오기 <br>
 * @return String
 */
pForm.gfn_getWebComp = function(objWb)
{
    var oWb =  null;
    var sBrowser  	= nexacro._Browser.toUpperCase(); //system.navigatorname.toUpperCase();
//trace("sBrowser==="+sBrowser);
	if (sBrowser == "RUNTIME") { 
        try {        
            // 윈도우 런타임
            oWb = objWb.getProperty("Document").getProperty("parentWindow");
        } catch (e) {
            //안드로이드 런타임
            oWb = objWb;
        }
	} 
    else 
    {
		//윈도우 html5, 안드로이드 html5,  iOS html5 , iOS런타임
		oWb = objWb.getProperty("window");
	}
	return oWb;
};

