/**
 * @class 모든 팝업을 종료처리 한다. <br>
 * @param  none
 * @return boolean
 */
pForm.gfn_popCloseAll = function()
{
	var popFrames = nexacro.getPopupFrames();
	for (var i=popFrames.length-1; i>=0; i--)
	{
		// Runtime, html5에서도 모두 작동
		var rObj = popFrames[i];
		rObj.destroy();
		rObj = null;
	}
};
/**
 * @class 로그인후 세션객체 설정처리 <br>
 * @param  none
 * @return N/A
 */
pForm.gfn_setSession = function()
{
	var objApp  = nexacro.getApplication();
	var gds = objApp.gds_userInfo ;
	objApp.session = {};
	for(var i=0;i<gds.colcount;i++)
	{
		var key = gds.getColID( i );
		var str = gds.getColumn( 0 , key )||'';
		objApp.session[key] = str;
	}
};
/**
 * @class 요청받은 세션값을 반환한다. <br>
 * @param  none
 * @return string / {}
 */
pForm.gfn_getSession = function(opt)
{
	var objApp  = nexacro.getApplication();
	if( objApp.session )
	{
		if( this.gfn_isNull(opt) ) {
			return objApp.session;
		} else {
			var rtn = objApp.session[opt]||'';
			return rtn;
		}
	}
	return ;
};


