        this.fn_selectScreen = function()
        {
        	this.ds_scprint.clearData();
        	this.ds_scprint.addRow();
        	this.ds_scprint.setColumn(0, "PGM_ID", this._bizInfo.programId);

        	var sSvcId			= "selectScreen";
        	var sPath  			= "t/z/001/selectScreen.do";
        	var sInputDsName 	= "ds_scprint=ds_scprint";
        	var sOutputDsName 	= "ds_scresult=ds_scresult";
        	var sArg 			= "";
        	var oPreArgs  		= [];
        	var sCallback 		= "fn_callBack";

        	this.gfn_callService(sSvcId, sPath, sInputDsName, sOutputDsName, sArg, oPreArgs, sCallback);
        };

        this.fn_preselectScreen = function() {
        	return true;
        }
        this.fn_postselectScreen = function() {

        	// 화면인쇄시 개인정보 사유 입력 팝업 대상 체크(2026.01.18.)
        	var objApp = nexacro.getApplication();
        	var sCheckData = this.ds_scresult.getColumn(0,"INDI_INFO_RDN_RSTR_YN"); // 개인정보유무 컬럼
        	var sCheckDataSetList = this.ds_scresult.getColumn(0,"INDI_INFO_DATST_NM"); // 개인정보 데이터셋
        	var sCheckDataSet = "";

        	var objForm = this._div_bizFrameMain.form; // 화면명
        	var arrObj = objForm.objects; // 화면 오브젝트(데이터셋) 전체
        	var cnt = 0;

        	if(sCheckData == "Y" && sCheckDataSetList != "undefined"){ // 개인정보유무 컬럼 Y
        	  sCheckDataSet = sCheckDataSetList.split(","); // 구분자(,) 분할
        		for(var i=0; i<arrObj.length; i++) { // 데이터셋
        		 for(var j=0; j<sCheckDataSet.length; j++){ // 개인정보 데이터셋
        			if (arrObj[i] instanceof Dataset) {
        				// 일치 시 건수 합계
        				if(arrObj[i].name == sCheckDataSet[j]) cnt = cnt + arrObj[i].rowcount;
        			}
        		  }
        		}
        	}

        	 // 개인정보 미해당 or 0건
        	if(sCheckData != "Y" || cnt == 0){
        		objApp.mainframe.fv_indiInfInqRsnCd = "";
        		objApp.mainframe.fv_busi24Log 		= "화면인쇄(개인정보미해당)";
        		objApp.mainframe.fv_inqDataCnt   = 0; //0건

        		var nMaxHeight;
        		var nWidth;
        		try
        		{
        			nMaxHeight = this._div_bizFrameMain.form.formMaxHeight;
        		}catch(e){}

        		if(!this.gfn_isNull(nMaxHeight))
        		{
        			var nHeight = this.height;
        			this.set_height(this._div_bizFrameMain.form.formMaxHeight+44 +12);
        			nWidth = this.width;
        			this.set_width(1046);
        			this.resetScroll();
        			// 출력
        			var rtn = system.print(this, false);
        			this.set_height(nHeight);
        			this.set_width(nWidth);
        			this.resetScroll();
        		}
        		else
        		{
        			var rtn = system.print(this, false);
        		}

        		this.fn_printScreen(); //화면인쇄 로그 업무로그 (TZ20) 저장

        		if(rtn) {
        			this.alert("출력되었습니다.");
        		}
        	}else{  // 개인정보 해당 - 사유등록 팝업
        		this.fn_uz_screenSaveChk();
        	}
        }

