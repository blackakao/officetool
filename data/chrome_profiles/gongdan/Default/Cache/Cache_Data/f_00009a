        this.frameWork_onload = function(obj,e)
        {
        	//this.resetScroll();
        	var nIndex = obj.addEventHandler('onkeyup' ,this.cfn_formOnkeyup, obj);

        	this._bizFrm  = obj;
        	this._workFrm = this._div_bizFrameMain.form;
        	this._bizInfo = this.getOwnerFrame()._bizInfo;
        //trace("_bizInfo===="+this._bizInfo+":::::winid==="+this.getOwnerFrame().name);

        	//this.divTitle.form.set_scrollbartype("none");

        	if(this._bizInfo.menuUrl.indexOf(".xfdl") < 0) {
        		this._bizInfo.menuUrl = this._bizInfo.menuUrl + ".xfdl";
        	}

        	this._div_bizFrameMain.set_url(this._bizInfo.menuUrl);
        	this.sta_bizTitle.set_text(this._bizInfo.menuText);
        	this.set_titletext(this._bizInfo.menuText);

        	if(!this.gfn_isNull(this._bizInfo.programId)) {
        		this.sta_bizTitleid.set_text(this._bizInfo.programId);
        		this.sta_bizTitleid.set_visible(true);
        	}

        	if(!this.gfn_isNull(this._bizInfo.menuDesc)){
        		this.sta_bizTitleNavi.set_text(this._bizInfo.menuDesc);
        	}

        	if(!this.gfn_isNull(this._bizInfo.menuDesc)) {
        		this.sta_bizTitleNavi.set_text(this._bizInfo.menuDesc);
        		this.sta_bizTitleNavi.set_tooltiptext(this._bizInfo.menuDesc);

        		var sTxt = this._bizInfo.menuDesc;

        		if(sTxt.length > 20) {
        			sTxt = sTxt.substr(0,20) + "...";
        			this.sta_bizTitleNavi.set_text(sTxt);
        		}
        		this.sta_bizTitleNavi.set_visible(true);
        	}

        	// form로딩시 화면에 표시할 page URL 설정
        	this._div_bizFrameMain.set_url(this._bizInfo.menuUrl);

        	this.resetScroll();
        };

