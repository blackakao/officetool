        				bRtn = false; nPsn = i;  nPos = 2;
        			}
        			else if(this.gfn_isEmpty(ds_tmp.getColumn(i, "REPR_NM"))){
        				this.gfn_msgShow(this, "XITZ0001", ["대표자성명" ]);
        				bRtn = false; nPsn = i;  nPos = 3;
        			}
        			else if(this.gfn_isEmpty(ds_tmp.getColumn(i, "ADPT_FR_DT"))){
        				this.gfn_msgShow(this, "XITZ0001", ["계약기간 시작일자" ]);
        				bRtn = false; nPsn = i;  nPos = 4;
        			}
        			else if(this.gfn_isEmpty(ds_tmp.getColumn(i, "ADPT_TO_DT"))){
        				this.gfn_msgShow(this, "XITZ0001", ["계약기간 종료일자" ]);
