         *======================================================================================*/
        //include "biz.library::nyb_include.xjs";
        //include "biz.library::nyb_tCommon.xjs";
        /*======================================================================================*
         * 2. Form 변수
         *======================================================================================*/
        this.showCnt = 0;
        this.parent100 = this.parent.parent.parent.parent.parent.parent.parent;
        var gosi_20250101 =  this.parent100.gosi_20250101;   //this.parent100.gosi_20250101="202501", 고시적용시작일은 개발[2024.01.01] 운영[2025.01.01]
        var gosi_202501_colNm = "";
        /*======================================================================================*
         * 3. Form Load
         *======================================================================================*/
        this.frm_onload = function(obj,e){
        	this.cfn_frmInit(obj);
        };

        this.fn_frmInit = function() {
        	this.gfn_setGrid(this.grid_insuList);
        	this.gfn_setGrid(this.grid_foodList);
        	this.gfn_setGrid(this.grid_cleanList);

        	this.ds_cond.setColumn(0, "LTC_ADMIN_SYM", this.parent100.ds_fm_cond.getColumn(0, "LTC_ADMIN_SYM"));
        	this.ds_cond.setColumn(0, "ADMIN_PTTN_CD", this.parent100.ds_fm_cond.getColumn(0, "ADMIN_PTTN_CD"));
        	this.ds_cond.setColumn(0, "TGT_YYYYMM", this.parent100.ds_fm_cond.getColumn(0, "TGT_YYYYMM"));
        	this.ds_cond.setColumn(0, "INSU_TYPE", "1");
        	//2025.01 고시 변수 생성
        	if(this.parent100.fn_isGosiFlag(gosi_20250101,this.ds_cond.getColumn(0, "TGT_YYYYMM"),this.ds_cond)){
        		this.ds_cond.setColumn(0, "GOSI_ADPT_202501_YN", "Y");
        	}
        	trace("※고시cd : " + gosi_20250101 + "|| 고시여부:" + this.ds_cond.getColumn(0, "GOSI_ADPT_202501_YN"));
        	this.CHG_ABLE = this.parent100.CHG_ABLE;
        	this.SPR_ABLE = this.parent100.SPR_ABLE;
        	trace("npfa401m01 this.SPR_ABLE = [" + this.SPR_ABLE + "]");

        	// 배상보험 조회
        	this.fn_selectInsuList();


        	this.fn_selectFoodCleanListNew();

        	// 급식세탁물 시군구 연계자료의 변경자료를 기등록(FA55)자료와 비교하여 먼저 업데이트 함
        	// 계약종료, 삭제등
        	//20231123
        	this.fn_updateFoodClean();
        	this.fn_selectFoodList();  //급식조회
        	this.fn_selectCleanList(); //세탁조회

        	// 최종저장일시 조회
        	this.fn_selectSaveTm();

        	// 배상책임보험 미가입 소명
        	this.fn_selectInsuExpUnetr();

        	// 급식인원조회
        	this.fn_selectMlsNopList();

        	//운영관리 권한/버튼 컨트롤
        	this.btn_addInsu.set_enable(this.CHG_ABLE);
        	this.btn_modInsu.set_enable(this.CHG_ABLE);
        	this.btn_delInsu.set_enable(this.CHG_ABLE);

        	/* 급식세탁물 시군구 자료 연계 added by jykang 20220221 - start */
        	if( this.ds_cond.getColumn(0, "TGT_YYYYMM") >= "202202")   // 운영은 202202 으로 바꿔야 함.
        	{
        		this.btn_addFood.set_enable(0);
        		this.btn_delFood.set_enable(0);
        		this.btn_saveFood.set_enable(0);
        		this.btn_addClean.set_enable(0);
        		this.btn_delClean.set_enable(0);
        		this.btn_saveClean.set_enable(0);
        	}
        	else
        	{
        	/* 급식세탁물 시군구 자료 연계 added by jykang 20220221 - end */
        		this.btn_addFood.set_enable(this.CHG_ABLE);
        		this.btn_delFood.set_enable(this.CHG_ABLE);
        		this.btn_saveFood.set_enable(this.CHG_ABLE);
        		this.btn_addClean.set_enable(this.CHG_ABLE);
        		this.btn_delClean.set_enable(this.CHG_ABLE);
        		this.btn_saveClean.set_enable(this.CHG_ABLE);
        	}  /* 급식세탁물 시군구 자료 연계 added by jykang 20220221 */

        	this.btn_chgInsu.set_enable(this.CHG_ABLE);

        	//삭제버튼 활성화(관리자) 20250717
        	if(this.SPR_ABLE) {
        	   this.btn_delFood.set_enable(true);
        	   this.btn_delClean.set_enable(true);
        	} else {
        	   this.btn_delFood.set_enable(false);
        	   this.btn_delClean.set_enable(false);
        	}

        	//급식인원조회 버튼 및 그리드 타이틀
        	if(this.ds_cond.getColumn(0, "TGT_YYYYMM") >= "201607" && this.ds_cond.getColumn(0, "ADMIN_PTTN_CD") == "A03"){ //201601부터 적용
        		this.div_nop.form.grid_nop.setCellProperty("Head",0,"text", this.ds_cond.getColumn(0, "TGT_YYYYMM").substring(0,4) +"년 "+ this.ds_cond.getColumn(0, "TGT_YYYYMM").substring(4,6) +"월");
        	}
        	else{
        		this.btn_regMls.set_visible(false);
        	}

        	//영양사, 조리원 칼럼추가
        	if(this.showCnt == 0 && this.ds_cond.getColumn(0, "TGT_YYYYMM") < "201607"){ //201607부터 적용
        		this.grid_foodList.setFormatColProperty(6,"size",0);
        		this.grid_foodList.setFormatColProperty(7,"size",0);
        		this.showCnt++;
        	}

        	//조리원 칼럼숨김(개정법, 공생외)
        	//20200910 A1 노인요양시설(구법) 추가
        	if(this.showCnt == 0 && this.ds_cond.getColumn(0, "ADMIN_PTTN_CD") != "A03" && this.ds_cond.getColumn(0, "ADMIN_PTTN_CD") != "A04" && this.ds_cond.getColumn(0, "ADMIN_PTTN_CD") != "A01"){
        		this.grid_foodList.setFormatColProperty(7,"size",0);
