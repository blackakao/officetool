        			this.fn_checkboxValueFromYnColumn(this.div_nop.form.chk00, this.ds_mlsNopList.getColumn(this.ds_mlsNopList.rowposition, "EAA_CSMT_YN"));
        		}
        	}

        	if (sSvcId == "selectFoodCleanListNew") /* 2023 이승진. */
        	{
        		if ( this.ds_rz05List.rowcount > 0 )
        		{
        		  this.fn_saveFoodCleanNew();

        		}
        	}

        	// 배상보험 조회
        	if (sSvcId == "selectInsuList1") {
        		//2025.01 고시적용에 따른 변경 ds_insuInfoAll => ds_insuInfo 기존 데이터셋 필터후 기존대로 처리
        		//제출시 같은 selectInsuList 호출로 인하여 수정
        		this.ds_insuListAll.filter("ADMIN_PTTN_CD =='"+this.ds_cond.getColumn(0, "ADMIN_PTTN_CD")+"'");
        		this.ds_insuList.copyData(this.ds_insuListAll,true);
        		this.ds_insuListAll.filter("");
        		this.ds_insuList.set_rowposition(-1);
        		this.fn_seqCheck();
        	}

        	if (sSvcId == "updateFoodClean") {
        		trace("#######변경자료 update######");
        	}
        	// 급식위탁 조회
        	if (sSvcId == "selectFoodList") {
        		this.ds_foodList.set_rowposition(-1);
        	}
        	// 세탁물위탁 조회
        	if (sSvcId == "selectCleanList") {
        		this.ds_cleanList.set_rowposition(-1);
        	}

        	//최종저장일시
        	if (sSvcId == "selectSaveTm") {
        		var saveTmInsu = this.ds_saveTm.getColumn(0, "WORK_SAVE_TM_INSU");
        		if(this.gfn_isEmpty(saveTmInsu)){
        			saveTmInsu = "미확인";
        		}
        		this.stc_workSaveTmInsu.set_text("[최종저장일시 : "+ saveTmInsu +"]");

        		var saveTmFood = this.ds_saveTm.getColumn(0, "WORK_SAVE_TM_FOOD");
        		if(this.gfn_isEmpty(saveTmFood)){
        			saveTmFood = "미확인";
        		}
        		this.stc_workSaveTmFood.set_text("[최종저장일시 : "+ saveTmFood +"]");

        		var saveTmClean = this.ds_saveTm.getColumn(0, "WORK_SAVE_TM_CLEAN");
        		if(this.gfn_isEmpty(saveTmClean)){
        			saveTmClean = "미확인";
        		}
        		this.stc_workSaveTmClean.set_text("[최종저장일시 : "+ saveTmClean +"]");
        	}

        	//배상보험 삭제
        	if (sSvcId == "deleteInsuInfo") {
        		this.gfn_msgShow(this, "XITZ0019",[]);

        		this.fn_selectInsuList();
        		this.fn_selectSaveTm();
        	}

         	//급식/세탁물위탁 저장
        	if (sSvcId == "saveFoodClean") {

        		if(this.ds_cond.getColumn(0,"WMC_TYPE_CD") =="02"|| this.ds_cond.getColumn(0,"WMC_TYPE_CD") =="04"){
        			this.fn_selectFoodList();
        		}
        		else if(this.ds_cond.getColumn(0,"WMC_TYPE_CD") == "01" || this.ds_cond.getColumn(0,"WMC_TYPE_CD") == "03"){
        			this.fn_selectCleanList();
        		}
        		this.fn_selectSaveTm();
        	}


        	//급식/세탁물위탁 삭제
        	if (sSvcId == "deleteFoodClean") {
        		this.gfn_msgShow(this, "XITZ0019",[]);

        		if(this.ds_cond.getColumn(0,"WMC_TYPE_CD") =="02"|| this.ds_cond.getColumn(0,"WMC_TYPE_CD") =="04"){
        			this.fn_selectFoodList();
        		}
        		else if(this.ds_cond.getColumn(0,"WMC_TYPE_CD") == "01" || this.ds_cond.getColumn(0,"WMC_TYPE_CD") == "03"){
        			this.fn_selectCleanList();
        		}
        		this.fn_selectSaveTm();
        	}

        	//배상책임보험 미가입 소명
        	if (sSvcId == "selectInsuExpUnetr") {
