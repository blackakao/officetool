        this.chk_regNo_oncolumnchanged = function(obj,e){
        //trace("######## 1");

        	//사업자 등록번호 길이체크
        	if(e.columnid == "REG_NO"){
        		if(obj.getColumn(e.row, "REG_NO").length != 0 && obj.getColumn(e.row, "REG_NO").length != 10){
        			this.gfn_msgShow(this, "XITZ0111", ["사업자등록번호는 ","10" ]);
        			obj.setColumn(e.row, "REG_NO", "");
        		}
        	}

        	//영양사 컨트럴
        	if(e.columnid == "ADPT_FR_DT" || e.columnid == "ADPT_TO_DT"){
        		var first_dt = this.ds_cond.getColumn(0, "TGT_YYYYMM")+"01";
        		var last_dt = this.ds_cond.getColumn(0, "TGT_YYYYMM") + this.gfn_lastDateNum(this.ds_cond.getColumn(0, "TGT_YYYYMM")+"01");
        		var fr_dt = obj.getColumn(e.row, "ADPT_FR_DT");
        		var to_dt = obj.getColumn(e.row, "ADPT_TO_DT");



        		if(fr_dt <= first_dt && last_dt <= to_dt){
        			obj.setColumn(e.row, "NUTPSN_RCGT_YN", "Y");
        		}
        		else{
        			obj.setColumn(e.row, "NUTPSN_RCGT_YN", "N");
        		}
        	}

        	//조리원선택
        	if(e.columnid == "ASCK_RCGT_YN"){
        		if(obj.getColumn(e.row, "ASCK_RCGT_YN") == "Y"){
        			this.gfn_msgShow(this, "XWTZ0001",["급식 위탁 업체에 조리원이 소속되어 있는 경우에만 조리원 위탁이 인정됩니다"]);
