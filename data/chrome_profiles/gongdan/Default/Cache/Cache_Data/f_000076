var pForm = nexacro.Form.prototype;

pForm.gfn_characterChk = function(strInput, strLang, strAddChar) {
	
	var strComp = " ";		//Space 포함 적용
	var strChkChar;
	var rtnVal = "";
	
	strComp += strAddChar;
	
	if (strLang.length < 1) strLang = "KR";

	var arrLang ;
	arrLang = strLang.split(",");

	for (i=0; i<arrLang.length; i++) {
		switch( (arrLang[i]) )		{
			case "KR": 	// Korean
				strComp += this.gfn_setChar_Korean() + String.fromCharCode(13);
				break;
			case "EN":	// English
				strComp += this.gfn_setChar_English() + String.fromCharCode(13);
				break;
			case "JP": 	// Japaness
				strComp += this.gfn_setChar_Japaness() + String.fromCharCode(13);
				break;
			case "CN":	// Chiness
				strComp += this.gfn_setChar_Chiness() + String.fromCharCode(13);
				break;
			case "NB": 	// Number
				strComp += this.gfn_setChar_Number() + String.fromCharCode(13);
				break;
			case "SB":	// Symbol
				strComp += this.gfn_setChar_Symbol() + String.fromCharCode(13);
				break;
		}
	}	
	
	// 오류 문자 비교 검색
	for (i=0; i<strInput.length; i++) {
		strChkChar = strInput.substr(i,1);		
		if (strComp.indexOf(strChkChar) < 0) {
			rtnVal += strChkChar + ",";
		}		
	}
	
	if ((rtnVal.length) > 0) {
		rtnVal = this.gfn_left(rtnVal, rtnVal.length - 1);
		return rtnVal;
	} else {
		return "";
	}
};

pForm.gfn_setChar_Number = function() {
	var strFixChar;	
	strFixChar += "1234567890";
	return strFixChar;	
};


