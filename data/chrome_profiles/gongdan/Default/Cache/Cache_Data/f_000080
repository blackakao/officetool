pForm.bfn_t_progYn = function(obj,e)
{
	if( this.gfn_getDatasetUpdated(obj) ) {
		if(!this.gfn_msgShow(this,"XCTB0001",["변경된 정보가 있습니다. \n\nRow 이동시 변경 정보는 사라집니다.\n\n계속 진행하시겠습니까?."])){
			return false;
		} else {
			obj.reset();
			obj.set_rowposition(e.newrow);
		}
	}
};

