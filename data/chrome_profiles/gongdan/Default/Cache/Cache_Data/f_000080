pForm.bfn_t_batch_call = function(as_batch_pgm_id, as_arg, as_form_id,as_gb,dsObj) {
    //데이터셋 생성
    var strDsName ="ds_tbnptz66";	
    var ds_zz_insert = new Dataset;
    ds_zz_insert.set_name(strDsName);
    this.addChild(strDsName, ds_zz_insert);
        
    ds_zz_insert.addColumn("_ROW_STATUS", "STRING");
    ds_zz_insert.addColumn("USER_ID", "STRING");
    ds_zz_insert.addColumn("SYS_CD", "STRING");
    ds_zz_insert.addColumn("CRE_BRCH_CD", "STRING");
    ds_zz_insert.addColumn("PSTN_TYPE", "STRING");
    ds_zz_insert.addColumn("USER_IP", "STRING");
    ds_zz_insert.addColumn("WRK_PGM_ID", "STRING");
    ds_zz_insert.addColumn("BTH_PGM_ID", "STRING");
    ds_zz_insert.addColumn("WRK_PROC_COND", "STRING");
    ds_zz_insert.addColumn("CRE_EMP_NO", "STRING");
    ds_zz_insert.addColumn("CHG_EMP_NO", "STRING");
    ds_zz_insert.addColumn("BTH_WRK_SEQ_NO", "STRING");
        
    // 변수 지정
    var ls_userid     = "000000";
    var ls_ipaddress  = nexacro.getApplication().gds_userInfo.getColumn(0, "USER_IP");
    var ls_brch_cd    = nexacro.getApplication().gds_userInfo.getColumn(0, "BRCH_CD");
    var ls_pstn_type  = nexacro.getApplication().gds_userInfo.getColumn(0, "PSTN_TYPE");
    var ls_sys_cd     = as_batch_pgm_id.substr(2,2);
  
    ds_zz_insert.addRow();
    
    ds_zz_insert.setColumn(0,"_ROW_STATUS"  , 1);
    ds_zz_insert.setColumn(0,"USER_ID"      , ls_userid);
    ds_zz_insert.setColumn(0,"SYS_CD"       , ls_sys_cd.toUpperCase());
    ds_zz_insert.setColumn(0,"CRE_BRCH_CD"  , ls_brch_cd);
    ds_zz_insert.setColumn(0,"PSTN_TYPE"    , ls_pstn_type);
    ds_zz_insert.setColumn(0,"USER_IP"      , String(ls_ipaddress).substr(0,20));
    ds_zz_insert.setColumn(0,"WRK_PGM_ID"   , as_form_id);
    //ds_zz_insert.setColumn(0,"WRK_PGM_ID"   , gv_pgmId);
    ds_zz_insert.setColumn(0,"BTH_PGM_ID"   , as_batch_pgm_id);
    ds_zz_insert.setColumn(0,"WRK_PROC_COND", as_arg);
    ds_zz_insert.setColumn(0,"CRE_EMP_NO"   , "SYSBAT");
