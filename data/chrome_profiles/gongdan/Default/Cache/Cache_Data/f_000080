/*****************************************************************************************
 * 공통조회 Transaction Callback 처리
 *
 * @param : strSvcID
 * @param : nErrorCode
 * @param : strErrorMsg
 * @return: none
 *****************************************************************************************/
pForm.bfn_t_callBack = function(strSvcID, nErrorCode, strErrorMsg) {
	switch(strSvcID) {
		case "svselectBatchPgm":
			break;
		case "svselectSysTm":
			break;
		case "selectBillboardPopCnt":
		
			if ( this.ds_result.rowcount > 0) {
 				for(var i =0; this.ds_result.rowcount>i;i++){
 					this.bfn_t_billboard_popup(this.ds_result.getColumn(i, "BLBD_ID"), this.ds_result.getColumn(i, "ARTI_NO"), this.ds_result.getColumn(i, "BLBD_NM"));
 				}
			}
			break;
    }

};

