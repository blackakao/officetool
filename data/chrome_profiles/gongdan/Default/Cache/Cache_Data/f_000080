/*****************************************************************************************
 * 공휴일정보 조회 bfn_t_holiday
 *
 * @param : as_yyyymm	적용년월
 * @param : as_dsObj	공휴일정보결과 Dataset DT
 * @return: none
 *****************************************************************************************/
pForm.bfn_t_holiday = function(as_yyyymm, as_dsObj) {
    if(this.cfn_str_isNull(as_yyyymm) || as_yyyymm.length != 6) { 
	   this.gfn_msgShow(this, "XWTZ0043",["년월이 입력되지 "]);//않았습니다.
	   return "";
    }
    // 출력데이터셋 설정
	var ds_t_output  = new Dataset;
	this.addChild("ds_t_output", ds_t_output);	
    var sSvcId = "selectHoliday";
	var sPath = "/common/bizcommon/selectHoliday.do";
	var sInputDsName  = "";
	var sOutputDsName = "ds_t_output=ds_result";
	var sArg = "ADPT_YYYYMM=" + as_yyyymm ;
	var oPreArgs = [];
	var sCallback = "bfn_t_callBack";
    var sExtncYn = "";	// 내역존재여부 (Global Variable)
	
	this.gfn_callService(sSvcId, sPath, sInputDsName, sOutputDsName, sArg, oPreArgs, sCallback,false);

    as_dsObj.copyData(ds_t_output);    
    //데이터셋 제거
	var objDelete = this.removeChild("ds_t_output");
	objDelete.destroy();
};



