/**---------------------------------------------------------------------
 * 기능   :  oTarget으로 입력 한 콤포넌트를 visible 상태를 변경 하는 함수
 * 인수   :  oTarget : component ID 배열
 *           bEnable : true, false
 * return : 
----------------------------------------------------------------------*/
pForm.bfn_t_fn_objVisibleSetting = function(oTarget, bEnable) 
{
	//this.set_enable(false);//readonly 변경 전 화면 갱신 정지
	var componetlist = oTarget;
	var bBtnEnable = bEnable;
	
	if(bEnable == true) { 
		bBtnEnable = false;
	} else {
		bBtnEnable = true;
	}

	for(var i=0; i<componetlist.length; i++) {

		if(   componetlist[i] instanceof Edit
		   || componetlist[i] instanceof MaskEdit
		   || componetlist[i] instanceof CheckBox
		   || componetlist[i] instanceof TextArea
		   || componetlist[i] instanceof Combo
		   || componetlist[i] instanceof ListBox
		   || componetlist[i] instanceof Spin
		   || componetlist[i] instanceof Grid
		  ) {
			componetlist[i].set_visible(bEnable);
		}		
		else if( componetlist[i] instanceof Button || componetlist[i] instanceof Radio) {
			componetlist[i].set_visible(bBtnEnable);
		}
		else if( componetlist[i] instanceof Div ) {
			if( componetlist[i].url.indexOf("singleCalendar") > -1 ) {
				componetlist[i].form.cal_begin.set_visible(bEnable);
				componetlist[i].form.btn_calOpen.set_visible(bBtnEnable);
			}		
			else if( componetlist[i].url.indexOf("doubleCalendar") > -1 ) {
				componetlist[i].form.cal_begin.set_visible(bEnable);
				componetlist[i].form.cal_end.set_visible(bEnable);
				componetlist[i].form.btn_calOpen.set_visible(bBtnEnable);
			}
		}
	}
	//this.set_enable(true);//visible 변경 후 화면 갱신
};



