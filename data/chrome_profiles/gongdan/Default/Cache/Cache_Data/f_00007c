/**
 * @class 문자열의 좌측부터 지정한 길이만큼 가져오는 함수 (byte계산)
 * @param {String} sString - 원본 문자열
 * @param {Number} nSize - 얻어올 크기. [Default Value = 0]
 * @return {String} 문자열
 */
pForm.gfn_leftB = function(sString, nSize) 
{
	var sVal = "";
	var nCnt = 0;
	var nSizeB = this.getLengthB(sString);
	if (nSize > nSizeB || nSize == null) {    
		sVal = sString;
	} else {
		for (var i=0; i<sString.length; i++) {
			if (sString.charCodeAt(i) > 127) {
				nCnt += 2;
			} else {
				nCnt += 1;
			}
			if (nCnt > nSize) { break; }
			sVal += sString.substr(i, 1);
		}
	}

	return sVal;
};

