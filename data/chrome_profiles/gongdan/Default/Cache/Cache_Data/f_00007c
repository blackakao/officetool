/**---------------------------------------------------------------------
* 기능 :  component의 width계산
* 인수 :  component
* Return : font object
----------------------------------------------------------------------*/		
pForm.gfn_getComponentWidth = function(component, flag, nWidth, isPadding) {

	var	w = isNaN(nWidth) ? component.getOffsetWidth() : nWidth;

	if ( isPadding === undefined ) isPadding = true;
	
	/* [X-LOG] currentstyle은 지원되지 않는 속성입니다.*/var currentStyle = component.currentstyle;
	var border = currentStyle.border;
	
	if ( border ) {
		if ( isNaN(border.width) ) {
			w += flag*(/* [X-LOG] right은 지원되지 않는 속성입니다.*/ border.left.width + border.right.width);
		} else {
			w += flag*(border.width*2);
		}
	}

	var left, right;
	var margin = currentStyle.margin;
	if ( margin ) {
		left = (isNaN(margin.left) ? 0 : margin.left);
		right = (/* [X-LOG] right은 지원되지 않는 속성입니다. [X-LOG] right은 지원되지 않는 속성입니다.*/ isNaN(margin.right) ? 0 : margin.right);
		w += flag*(left + right);
	}
	
	var imagePadding = currentStyle.imagepadding;
	if ( imagePadding ) {
		left = (isNaN(imagePadding.left) ? 0 : imagePadding.left);
		right = (/* [X-LOG] right은 지원되지 않는 속성입니다. [X-LOG] right은 지원되지 않는 속성입니다.*/ isNaN(imagePadding.right) ? 0 : imagePadding.right);
		w += flag*(left + right);
		//trace("\n\t\t#### imagePadding left="+left+" right="+right);
	}		

	/* [X-LOG] padding은 지원되지 않는 이벤트입니다.*/var padding = currentStyle.padding;
	if ( isPadding && padding ) {
		//trace("padding.left="+padding.left); 
		left = (isNaN(padding.left) ? 0 : padding.left);
		right = (/* [X-LOG] right은 지원되지 않는 속성입니다. [X-LOG] right은 지원되지 않는 속성입니다.*/ isNaN(padding.right) ? 0 : padding.right);
		//trace("#### component.text="+component.text + "   padding left="+left+" right="+right);
		w += flag*(left + right);
	}

	//trace("width="+w + " " + component.name);
	return w;	
};

/**---------------------------------------------------------------------
* 기능 :  component의 height계산
* 인수 :  component
* Return : font object
----------------------------------------------------------------------*/	
pForm.gfn_getComponentHeight = function(component, flag, nHeight, isPadding) 
{
	var h;
	h = isNaN(nHeight) ? component.getOffsetHeight() : nHeight;

	if ( isPadding === undefined ) isPadding = true;
	
	/* [X-LOG] currentstyle은 지원되지 않는 속성입니다.*/var currentStyle = component.currentstyle;
	var border = currentStyle.border;
	if ( border ) {
		if ( isNaN(border.width) ) {
			h += flag*(/* [X-LOG] bottom은 지원되지 않는 속성입니다.*/ border.top.width + border.bottom.width);
		} else {
			h += flag*(border.width*2);
		}
	}
	
	var top, bottom;
	var margin = currentStyle.margin;
	if ( margin ) {
		top = (isNaN(margin.top) ? 0 : margin.top);
		bottom = (/* [X-LOG] bottom은 지원되지 않는 속성입니다. [X-LOG] bottom은 지원되지 않는 속성입니다.*/ isNaN(margin.bottom) ? 0 : margin.bottom);
		h += flag*(top + bottom);
	}
	
	/* [X-LOG] padding은 지원되지 않는 이벤트입니다.*/var padding = currentStyle.padding;
	if ( isPadding && padding ) {
		top = (isNaN(padding.top) ? 0 : padding.top);
		bottom = (/* [X-LOG] bottom은 지원되지 않는 속성입니다. [X-LOG] bottom은 지원되지 않는 속성입니다.*/ isNaN(padding.bottom) ? 0 : padding.bottom);
		h += flag*(top + bottom);
	}
	return h;
};

