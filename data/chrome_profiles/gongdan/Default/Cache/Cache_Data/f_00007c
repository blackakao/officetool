/**---------------------------------------------------------------------
* 기능 : 정수인 nStart ~ nEnd의 범위에 있는 숫자에 대하여 random값을 return한다.
* 인수 : nStart : 시작숫자 ( 단, 정수, 만일 정수가 아니면 Math.floor(nStart)를 적용함)
*         nEnd   : 끝숫자 ( 단, 정수, 만일 정수가 아니면 Math.floor(nStart)를 적용함)
* Return : random 숫자값
----------------------------------------------------------------------*/
pForm.gfn_rand = function(nStart, nEnd) {
	var nRange_unit, nRand, nTmp;

	nStart = Math.floor(nStart);
	nEnd = Math.floor(nEnd);
	
	if( nStart > nEnd )
	{
		nTmp = nStart;
		nStart = nEnd;
		nEnd = nTmp;
	}
	nRange_unit = nEnd-nStart+1;
	nRand = Math.random();
	nRand = Math.random();

	return Math.floor(nRand*nRange_unit)+nStart;
};

/**---------------------------------------------------------------------
* 기능 : Grid에 Band의 cell에 바인드된 정보를 return한다.
* 인수 : obj    : Grid Object Name
*         nCell : Cell Position
*		  sBand : Cell의 영역	
*         sProperty : Cell의 Property 명
* Return : 바인드된 정보
----------------------------------------------------------------------*/
pForm.gfn_getGridBind = function(obj, nCell, sBand, sProperty) {
	var sColumnID = "";

	if ((obj == null) || (nCell < 0)) {
		return sColumnID;
	}

	if ((sBand == null) || (sBand == ""))  sBand = "body"; 
	if ((sProperty == null) || (sProperty == ""))  sProperty = "text"; 

	if ((obj == null) || (nCell < 0) || (nCell >= obj.getCellCount(sBand))) {
		return sColumnID;
	}

	var sProperty = obj.getCellProperty(sBand, nCell, sProperty);
	
	if ((sProperty != null) && (sProperty != "")) {
		var arrProperty = sProperty.split(":");

		if (arrProperty.length == 2) {
			if (arrProperty[0].toString().toLowerCase() == "bind") {
				sColumnID = arrProperty[1].toString();
			}
		}
	}

	return sColumnID;
};

/**---------------------------------------------------------------------
* 기능 : Grid에 displaytype = checkbox인 Cell에 Check 처리
* 인수 : objGrid    : Grid Object Name
*         nHeadCellId : Grid Cell Position
*		  objDs : Grid에 Bind된 Dataset Object Name	
*         sColumnId : Grid Body에 Bind된 ColumnId
* Return : boolean : true 성공 / false 실패
----------------------------------------------------------------------*/
pForm.gfn_setGridHeadCheck = function(objGrid, nHeadCellId, objDs, sColumnId) {
	if (objGrid.readonly) return false;
	if (objGrid.getCellProperty("head", nHeadCellId, "displaytype") != "checkbox") { return false; }

	objGrid.set_enableevent(false);
	objGrid.set_enableredraw(false);

	// Head셋팅
	var sHeadText = objGrid.getCellProperty("head", nHeadCellId, "text");
	var sHeadNewText;
	if (this.isEmpty(sHeadText)) sHeadText = "0";

	if (sHeadText == "1") {
		sHeadNewText = "0";
	} else {
		sHeadNewText = "1";
	}
	objGrid.setCellProperty("head", nHeadCellId, "text", sHeadNewText);

	objDs.set_enableevent(false);
	var nRowCount = objDs.getRowCount();
	var sPreText;
	for (var i=0; i<nRowCount; i++) {
		sPreText = objDs.getColumn(i, sColumnId);
		if (this.isEmpty(sPreText)) sPreText = "0";
		if (((sPreText == "0") && (sHeadNewText == "1"))
			|| ((sPreText == "1") && (sHeadNewText == "0"))) {
			objDs.setColumn(i, sColumnId, sHeadNewText);
		}
	}
	objDs.set_enableevent(true);

	objGrid.set_enableevent(true);
	objGrid.set_enableredraw(true);

	return true;
};

/**---------------------------------------------------------------------
* 기능 : TreeGrid의 Click event 처리
*         Text click시 Collapse / Expand 처리
*         Checkbox click시 부모 및 자식노드 Check Value 동기처리
* 인수 : obj : Grid Object
*         e   : GridClickEventInfo Event Object
*		  bChkParent : Checkbox click시 부모노드 Check Value 동기처리 여부(default : true)
*         bChkChild : Checkbox click시 자식노드 Check Value 동기처리 여부(default : true)
* Return : n/a
----------------------------------------------------------------------*/
pForm.gfn_treeGridOncellclick = function(obj, e, bChkParent, bChkChild) {
	var nCell = e.cell;
	if (obj.getCellProperty("body", nCell, "displaytype") != "tree") return;

	var nTreeRow    = obj.getTreeRow(e.row);
	var nTreeStatus = obj.getTreeStatus(nTreeRow);

	if (e.clickitem == "text") {
		if (nTreeStatus == 0) { //Collapse
			obj.setTreeStatus(nTreeRow, true);
		} else if (nTreeStatus == 1) { //Expand
			obj.setTreeStatus(nTreeRow, false);
		}
	} else if (e.clickitem == "control") {
		if (bChkParent == null) bChkParent = true;
		if (bChkChild == null)  bChkChild  = true;

		var objDs = eval(obj.binddataset);
		var arrColId = (obj.getCellProperty("body", nCell, "treecheck")).toString().split(":");
		var sChkColId = arrColId[1];
		var nCurRow   = e.row;
		var nTreeRow  = obj.getTreeRow(nCurRow);
		var sClickValue = objDs.getColumn(nCurRow, sChkColId); // 클릭한 checkbox의 값

		obj.set_enableevent(false);
		obj.set_enableredraw(false);
		objDs.set_enableevent(false);

		if (bChkParent) this.treeGridCheckParentRow(obj, objDs, sChkColId, nCurRow, sClickValue);
		if (bChkChild) this.treeGridCheckChildRow(obj, objDs, sChkColId, nCurRow, sClickValue);

		objDs.set_enableevent(true);
		obj.set_enableredraw(true);
		obj.set_enableevent(true);
	} else {
		//trace(e.clickitem);
	}
};

// 부모 체크박스 설정
pForm.gfn_treeGridCheckParentRow = function(objGrid, objDs, sChkColId, nCurRow, sNewValue) {
	if (sNewValue != "1") return; 

	var nParentRow;
	var sCurValue;
	while (true) {
		nParentRow = objGrid.getTreeParentRow(nCurRow);
		if (nParentRow < 0) break;

		sCurValue = objDs.getColumn(nParentRow, sChkColId);
		if (sCurValue == sNewValue) { break; }

		objDs.setColumn(nParentRow, sChkColId, sNewValue);

		nCurRow = nParentRow;
	}
};

// 자식 체크박스 설정
pForm.gfn_treeGridCheckChildRow = function(objGrid, objDs, sChkColId, nCurRow, sNewValue) 
{
	var nChildCount = objGrid.getTreeChildCount(nCurRow);
	if (nChildCount < 0) return;

	var nLastChildRow  = objGrid.getTreeChildRow(nCurRow, -1);
	var sCurValue;

	nCurRow += 1;

	for (; nCurRow <= nLastChildRow; nCurRow++) {
		sCurValue = objDs.getColumn(nCurRow, sChkColId);
		if (sCurValue == sNewValue) continue;

		objDs.setColumn(nCurRow, sChkColId, sNewValue);
	}
};

/**---------------------------------------------------------------------
* 기능 : Grid Head에 Click된 Cell의 Body 위치에 Binding된 Dataset Column을 Sort
* 인수 : objForm    : 해당 함수를 호출하는 form
*         objGrid    : Grid Object Name
*         e          : GridClickEventInfo
*		  bMultiSort : Multi Sort여부 true : Multi Sort / false : Single Sort(default)
* Return : boolean : true 성공 / false 실패
----------------------------------------------------------------------*/
pForm.gfn_setGridSort = function(objForm, objGrid, e, bMultiSort) {
	if (bMultiSort == null) bMultiSort = false;

	var sSortDs = "_ds_" + objGrid.name + "Sort";
	/* [X-LOG] 변수(adv_objHiddenFrameForm)가 있는지 확인이 필요합니다.*/var objSortDs = this.x2n_lookupPath("adv_objHiddenFrameForm").fn_newDataset("GRID_SORT", sSortDs, objForm);
	var objBindDs = eval(objGrid.binddataset);
	if (objBindDs.rowcount == 0) return false;

	var nCellIdx = -1;
	if (objGrid.getCellCount("head") == objGrid.getCellCount("body")) nCellIdx = e.cell;
	else nCellIdx = e.col;

	var nCellCnt 	= objGrid.getCellCount("head");
	var sBodyColId 	= String(objGrid.getCellProperty("body", nCellIdx, "text")).split(":");	// e.col : 바인드된 컬럼.
	var sColId		= sBodyColId[1];
	var nCell 		= e.cell;
	var sHeadText   = objGrid.getCellText(-1, nCell); //Head(-1) 에 있는 Text 를 가지고 
	var sSortType   = sHeadText.substr(sHeadText.length - 1); //문자열의 맨마지막 문자를 가지고와서 이미 sort가 되어 있는지
	var sNewHeadText = "";
	var sSet 		 = "";

	if (/* [X-LOG] 변수(adv_const)가 있는지 확인이 필요합니다.*/ sSortType == this.x2n_lookupPath("adv_const").SORT_ASC_MARK) {
		/* [X-LOG] 변수(adv_const)가 있는지 확인이 필요합니다.*/ sNewHeadText = sHeadText.substr(0, sHeadText.length - 1) + this.x2n_lookupPath("adv_const").SORT_DESC_MARK;
		sSet 		 = "-";
	} else if (/* [X-LOG] 변수(adv_const)가 있는지 확인이 필요합니다.*/ sSortType == this.x2n_lookupPath("adv_const").SORT_DESC_MARK) {
		sNewHeadText = sHeadText.substr(0, sHeadText.length - 1);
		sSet 		 = "";
	} else {
		/* [X-LOG] 변수(adv_const)가 있는지 확인이 필요합니다.*/ sNewHeadText = sHeadText + this.x2n_lookupPath("adv_const").SORT_ASC_MARK;
		sSet 		 = "+";
	}

	var nIndex = objSortDs.getColumn(0, "hindex");
	if (nIndex >= 0) {
		var sMark = objSortDs.getColumn(0, "mark");
		sMark 	  = sMark.substr(0, sMark.length - 1);

		objGrid.setCellProperty("head", nIndex, "text", sMark);
	}

	var nRow = objSortDs.findRow("hindex", e.col);
	if ((bMultiSort) && (sSet == "")) {
		if (nRow >= 0) objSortDs.deleteRow(nRow);
		nRow = -1;
	} else if (bMultiSort) {
		if (nRow == -1) nRow = objSortDs.addRow(); 
	} else if ((!bMultiSort) && (sSet == "")) {
		objSortDs.deleteRow(0);
		nRow = -1;
	} else if (!bMultiSort) {
		if (objSortDs.rowcount == 0) {
			nRow = objSortDs.addRow();
		} else {
			nRow = 0;
		}
	}

	if (nRow >= 0) {
		objSortDs.setColumn(nRow, "head",   sColId		);
		objSortDs.setColumn(nRow, "set",    sSet		);
		objSortDs.setColumn(nRow, "mark",   sNewHeadText);
		objSortDs.setColumn(nRow, "hindex", nCell  		);
	}

	objGrid.setCellProperty("head", nCell, "text", sNewHeadText); //head cell idx 기준

	//expr 문자 제외
	var sDisplayType = objGrid.getCellProperty("body", nCell, "displaytype");
	if (String(sDisplayType).indexOf("expr:") != -1) {
		sDisplayType = String(sDisplayType).substr(5).replace("currow", "0");
		sDisplayType = eval(sDisplayType);
	}

	if (sDisplayType == "combo") {
		objBindDs.set_updatecontrol(false);
		objBindDs.set_enableevent(false);
		
		//sorts에 사용하기 위한 Column 을 추가해둔다.
		if (objBindDs.getColumnInfo( "_sort_col" ) != null) {
			objBindDs.deleteColumn("_sort_col");
		}
		objBindDs.addColumn( "_sort_col", "string" );			

		for (var i=0; i<objBindDs.rowcount; i++) {
			objBindDs.setColumn(i, "_sort_col", objGrid.getCellText(i, nCell));
		}
		objBindDs.set_updatecontrol(true);
		objBindDs.set_enableevent(true);

	//default 는 click 한 column id 기준으로 정렬
	} else {
		sDisplayType == "ncombo";
	}

	//click 한 column id 기준으로 정렬
	/* [X-LOG] 변수(adv_objHiddenFrameForm)가 있는지 확인이 필요합니다.*/var sKeystring = this.x2n_lookupPath("adv_objHiddenFrameForm").fn_getKeyString(objGrid, objSortDs, sDisplayType);
	if (sKeystring != "") sKeystring = "S:" + sKeystring; 
	objBindDs.set_keystring(sKeystring);	
	//trace("objBindDs.keystring=" + objBindDs.keystring);

	objGrid.setCellPos(nCellIdx);

	return true;
};

/**---------------------------------------------------------------------
* 기능 : Grid에 displaytype = checkbox인 Cell에 CheckBox 및 Sort Mark Clear
* 인수 : objForm : 해당 함수를 호출하는 form
*         objGrid : Grid Object Name
* Return : N/A
----------------------------------------------------------------------*/
pForm.gfn_clearGridHead = function(objForm, objGrid) {
	// clear Checkbox
	var nCellCnt = objGrid.getCellCount("head");
	for (var i=0; i<nCellCnt; i++) {
		if (objGrid.getCellProperty('head', i, "edittype") == "checkbox") {
			objGrid.setCellProperty("head", i, "text", "false");
		}
	}

	// clear Sort mark
	var sSortDs = "_ds_" + objGrid.name + "Sort";
	var objSortDs = objForm[sSortDs];
	if (!objSortDs) return;
	if (objSortDs.rowcount == 0) return;
	
	var sHeadText;
	var nIndex;

	for (var j=0; j<objSortDs.rowcount; j++) {
		sHeadText = objSortDs.getColumn(j, "mark");
		nIndex 	  = objSortDs.getColumn(j, "hindex");				
		objGrid.setCellProperty("head", nIndex, "text", sHeadText.substr(0, sHeadText.length - 1));	
	}
	objSortDs.clearData();

	var objBindDs = eval(objGrid.binddataset);
	objBindDs.set_keystring("");
};


/**---------------------------------------------------------------------
* 기능 :  component의 style 및 font정보, text내용에 따른 
		   width와 height 객체반환
* 인수 :  component, flag, 
		   iLimitWidth, sConstWordWrapOption (tooltip text 사용으로 인수 추가)
* Return : object
----------------------------------------------------------------------*/	
pForm.gfn_getTextSize = function(component, flag, iLimitWidth, sConstWordWrapOption) 
{
	var textSize;
	
	if (iLimitWidth) {
		//툴팁처리용.
		/* [X-LOG] canvas은 지원되지 않는 속성입니다. [X-LOG] getPainter은 지원되지 않는 속성입니다. [X-LOG] getTextSize은 지원되지 않는 속성입니다.*/ textSize = component.canvas.getPainter().getTextSize(component.text, this.getFont(component), iLimitWidth, sConstWordWrapOption);
	} else {
		/* [X-LOG] canvas은 지원되지 않는 속성입니다. [X-LOG] getPainter은 지원되지 않는 속성입니다. [X-LOG] getTextSize은 지원되지 않는 속성입니다.*/ textSize = component.canvas.getPainter().getTextSize(component.text, this.getFont(component));
	}

	if (!flag) flag = 1;

	var adjustWidth = this._getAdjustWidth(component, flag, textSize.cx);
	var adjustHeight = this._getAdjustHeight(component, flag, textSize.cy);

	return {width:adjustWidth, height:adjustHeight};		
};

/**---------------------------------------------------------------------
* 기능 :  component의 text size계산을 위한 font 객체반환
* 인수 :  component
* Return : font object
----------------------------------------------------------------------*/
pForm.gfn_getFont = function(component) {
	/* [X-LOG] currentstyle은 지원되지 않는 속성입니다.*/var font = component.font;
	/* [X-LOG] Font 객체를 지원하지 않습니다.*/var newFont = new Font();
	if (font) {
		var isBold = (font.type.toString().indexOf("bold") > -1);
		newFont.set_name(font.face);
		newFont.set_size(font.size);
		newFont.set_bold(isBold);
	} else {
		newFont.set_name("Verdana");
		newFont.set_size(10);
	}
	
	return newFont;
};

