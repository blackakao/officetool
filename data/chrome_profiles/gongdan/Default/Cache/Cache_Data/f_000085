 *------------------------------------------------------------------------------------------------*/
pForm.bfn_i_setMmDtlDescForPct = function(o){
	var pThis = o;
	var sLtcpCtrNo = pThis.cmb_obj.value;
	var sLtcpOffrYyyymm = pThis.cmb_ctrYm.value;
	 
	if( this.ds_mmDtlInfo.rowcount == 0){
		 this.ds_mmDtlInfo.addRow();
		 this.ds_mmDtlInfo.setColumn(0,'LTCP_CTR_NO',sLtcpCtrNo);
		 this.ds_mmDtlInfo.setColumn(0,'LTCP_OFFR_YYYYMM',sLtcpOffrYyyymm);
		 this.ds_mmDtlInfo.setColumn(0,'LTCP_FR_DT',pThis.fv_sLtcpFrDt);
		 this.ds_mmDtlInfo.setColumn(0,'LTCP_TO_DT',pThis.fv_sLtcpToDt);			
	}
	
	var sUtilAmt = 0;
	var sMmUtilAmt = 0;
	var sUtilFreq = 0;
	
	/* 이용횟수 세팅 */
	var sDtChk;
	var nTotCnt = 0;
	for(var i=0;  i<this.ds_paymtDypr.rowcount; i++){
		
		for(var j=1;  j<=pThis.fv_sLastDate; j++){
			 sDtChk = this.ds_paymtDypr.getColumn(i,'DT'+j);
			
			if(sDtChk == '1'){
				nTotCnt++;
			}
		}
	}	
	sUtilFreq = nTotCnt;
	
	/* 월한도 세팅 */
	var sPctActionFreq;
	var nPctActionFreq = 0;
	var nPctActionUtilAmt = 0;
	var nPctActionUtilAmtTot = 0;
	
	if( this.ds_ddMech.rowcount > 0){
		
		for(var i=0;  i<this.ds_ddMech.rowcount; i++){
		
			 sUtilAmt = this.ds_ddMech.getColumn(i,'UTIL_AMT');
			sMmUtilAmt = sMmUtilAmt + (Number(sUtilAmt)/2);
			
			 sPctActionFreq = this.ds_ddMech.getColumn(i,'PCT_ACTION_FREQ');
			
			if(sPctActionFreq=='1'){
				
				nPctActionFreq++;
				 nPctActionUtilAmt = Number(this.ds_ddMech.getColumn(i,'UTIL_AMT'));
				nPctActionUtilAmtTot = nPctActionUtilAmtTot + nPctActionUtilAmt;
			}
		}
	}	
	
	 this.ds_mmDtlInfo.setColumn(0,'MM_UTIL_FREQ',sUtilFreq);
	 this.ds_mmDtlInfo.setColumn(0,'MM_UTIL_AMT',sMmUtilAmt);
	 this.ds_mmDtlInfo.setColumn(0,'PCT_ACTION_FREQ', nPctActionFreq);
	 this.ds_mmDtlInfo.setColumn(0,'PCT_ACTION_UTIL_AMT', nPctActionUtilAmtTot);
	
	 pThis.fv_sTotAmt = sMmUtilAmt;																		//월금액
	 pThis.fv_sMmTotAmt = Number(pThis.fv_sOthorMmAmt) + Number(this.fv_sTotAmt);						//타기관포함 월금액 = 타기관 월금액 + 월금액
	 pThis.fv_sBlcAmt = Number(pThis.fv_sLimitAmt) - Number(this.fv_sMmTotAmt);							//잔액 = 월한도액 - 월금액
	 pThis.fv_sTotPctActUtilFreq = Number(pThis.fv_sOtherPctActUtilFreq) + Number(nPctActionFreq);		//타기관포함 인지활동횟수
	
	if( Number(pThis.fv_sMmTotAmt) >= Number(pThis.fv_sLimitAmt)){
		 this.fv_sExcsCost = Number(pThis.fv_sMmTotAmt) - Number(pThis.fv_sLimitAmt);					//초과금액 = 타기관포함 월금액 - 한도액
	}else{
		 pThis.fv_sExcsCost = 0;
	}
	
	//월한도 미포함 = 15일초과이용금액 + 가족휴가제이용금액 + 건강관리서비스이용금액
	//fv_sMmExcepAmt = Number(fv_sDd15ExcsUtilAmt) + Number(fv_sFhoUtilAmt) + Number(fv_sHltMgmtSvcUtilAmt);	
		
	 pThis.ds_limitAmt.setColumn(0,'MM_FREQ',sUtilFreq);										//이용횟수	
	 pThis.ds_limitAmt.setColumn(0,'TOT_AMT',sMmUtilAmt);										//월총액
	 pThis.ds_limitAmt.setColumn(0,'MM_TOT_AMT',pThis.fv_sMmTotAmt);							//타기관포함 월금액
	 pThis.ds_limitAmt.setColumn(0,'BLC_AMT',pThis.fv_sBlcAmt);									//잔액
	 pThis.ds_limitAmt.setColumn(0,'EXCS_COST',pThis.fv_sExcsCost);								//초과금액
	 pThis.ds_limitAmt.setColumn(0,'MM_EXCEP_AMT',pThis.fv_sMmExcepAmt); 						//월한도 미포함
	 pThis.ds_limitAmt.setColumn(0,'PCT_ACTION_UTIL_FREQ',nPctActionFreq);						//인지활동횟수
	 pThis.ds_limitAmt.setColumn(0,'TOT_PCT_ACTION_UTIL_FREQ',pThis.fv_sTotPctActUtilFreq);		//타기관포함 인지활동횟수
	//ds_limitAmt.setColumn(0,'MM_EXCEP_AMT',fv_sMmExcepAmt); 									//월한도 미포함
};

/*------------------------------------------------------------------------------------------------*
 * 수정/지연 정보 세팅
 *------------------------------------------------------------------------------------------------*/
pForm.bfn_i_setUpdDlyInfo = function(pThis){
	
	var sUpdYn;	
	var sChgYn;	
	var sNwrYn;
	var sCnclYn;
	var nChgCnt = 0;
	var sLastChgYn = 'N';
	
	var sChgRsnCd1 = this.div_chgRsn.form.cmb_chgRsnCd1.value;		//변경사유1
	var sChgRsnCd2 = this.div_chgRsn.form.cmb_chgRsnCd2.value;		//변경사유2
	
	//수정횟수 세팅	
	for(var i=0;  i<this.ds_apprvCtrDtl.rowcount; i++){
			
		 sUpdYn = this.bfn_i_chkNull(this.ds_apprvCtrDtl.getColumn(i,'UPD_YN'));
		 sChgYn = this.bfn_i_chkNull(this.ds_apprvCtrDtl.getColumn(i,'CHG_YN'));
		 sNwrYn = this.bfn_i_chkNull(this.ds_apprvCtrDtl.getColumn(i,'NWR_YN'));
		 sCnclYn = this.bfn_i_chkNull(this.ds_apprvCtrDtl.getColumn(i,'CNCL_YN'));
		
		if(sUpdYn=='Y'){
			
			if(sChgYn=='Y'){
				 this.ds_apprvCtrDtl.setColumn(i,'CHG_RSN_CD1', sChgRsnCd1);
				 this.ds_apprvCtrDtl.setColumn(i,'CHG_RSN_CD2', sChgRsnCd2);
			}
			
			nChgCnt++;
			
			if(sNwrYn=='' || sCnclYn=='Y'){
				sLastChgYn = 'Y';
			}
		}	
	}
	 this.ds_mmDtlInfo.setColumn(0,'UPD_FREQ',nChgCnt);
	
	//최종수정사유 세팅
	if(nChgCnt>0 && sLastChgYn=='Y'){
		 this.ds_mmDtlInfo.setColumn(0,'LAST_CHG_RSN_CD1',sChgRsnCd1);
		 this.ds_mmDtlInfo.setColumn(0,'LAST_CHG_RSN_CD2',sChgRsnCd2);
	}
	
	// 지연구분세팅
	var sFstRegDt   = this.ds_mmDtlInfo.getColumn(0,'FST_REG_DT');
	var sLtcpOffrDt = pThis.cmb_ctrYm.value+'01';
	
	if(Number(sFstRegDt) >= Number(sLtcpOffrDt)){
		 this.ds_mmDtlInfo.setColumn(0,'DLY_TYPE_CD','01');	//지연
	}else{
		 this.ds_mmDtlInfo.setColumn(0,'DLY_TYPE_CD','00');	//최초
	}
	
	return true;
};

