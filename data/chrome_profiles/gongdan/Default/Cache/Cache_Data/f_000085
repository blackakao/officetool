	n8HhMechCnt = n8HhMechCnt + Number(sDayDd20UtilFreq) + Number(sDmDayDd20UtilFreq);
	var sInitLimitAmt = this.ds_limitAmt.getColumn(0,'MM_LMT_AMT');
	
	//if((fv_sLtcpClsfcCd=='018' && n8HhMechCnt >= 15) || (fv_sDm20 > 0 && n8HhMechCnt >= 15) || (n8HhMechCnt >= 20)){
	if(n8HhMechCnt >= 20){
