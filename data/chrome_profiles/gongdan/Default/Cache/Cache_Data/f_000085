		this.gfn_msgShow(this, "XWIA0050");
		return;
	}
	
	//주야간보호인 경우 미이용수가 체크
	var sNotUtilYn   = '';
	var sNotUtilYn3  = '';
	var sNotUtilYn44 = '';  // 20220411
	
	if( pThis.fv_sLtcpClsfcCd=='004' || pThis.fv_sLtcpClsfcCd=='018'){
		sNotUtilYn   = this.bfn_i_chkNull(this.ds_paymtDypr.getColumn(nRow, 'DAY_NOT_UTIL_ADPT_YN'));
		sNotUtilYn3  = this.bfn_i_chkNull(this.ds_paymtDypr.getColumn(nRow, 'COVID19_NOT_UTIL_ADPT_YN'));
		sNotUtilYn44 = this.bfn_i_chkNull(this.ds_paymtDypr.getColumn(nRow, 'COVID19_CLOF_NOT_UTIL_YN'));  // 20220411
		sNotUtilYn   = this.bfn_i_chgChkYn(sNotUtilYn);
		sNotUtilYn3  = this.bfn_i_chgChkYn(sNotUtilYn3);
		sNotUtilYn44  = this.bfn_i_chgChkYn(sNotUtilYn44);  // 20220411
	}
	
	if(sNotUtilYn == ''){
		sNotUtilYn = 'N';
	}else if(sNotUtilYn3 == ''){
	    sNotUtilYn3 = 'N';
	}else if(sNotUtilYn44 == ''){
	    sNotUtilYn44 = 'N';    // 20220411
	}
	
	//합산여부 세팅
	var nAcCnt = 0;
	var nAcRow;
	var sAcSeqNo2;
	var sLtcpOffrFrTm2;
	for(var i=0; i<this.ds_paymtDypr.rowcount; i++){
	
		if(i != nRow){
			sAcSeqNo2 = this.ds_paymtDypr.getColumn(i,'AC_SEQ_NO');
			
			if(sAcSeqNo==sAcSeqNo2){
				nAcCnt++;
				nAcRow = i;
			}
		}
	}
	
	if(nAcCnt == 1){
		this.ds_paymtDypr.setColumn(nAcRow,'AC_YN','N');
	}
	
	
	//지난일정 존재여부 체크
	var sUpdYn = 'N';
	var sChgRsnCd1;
	/*
	for(var i=0; i<ds_apprvCtrDtl.rowcount; i++){	//재가급여상세내역
			
		sChgRsnCd1 = bfn_i_chkNull(ds_apprvCtrDtl.getColumn(i, 'CHG_RSN_CD1'));
		if(sChgRsnCd1 != ''){
			sUpdYn = 'Y';
			break;
		}
	} */

	//재가급여상세내역 및 일수가정보 세팅
	var sChk;
	var sColNm;
	for(var i=1; i<=pThis.fv_sLastDate; i++){
	
		sColNm = 'DT'+i;
		sChk = this.ds_paymtDypr.getColumn(nRow,sColNm);

		if(sChk=="1"){
		
			if(pThis.fv_sLtcpClsfcCd=='001' && pThis.fv_sLtcRcgtGradeCd=='5'){	//방문요양 5등급인 경우
				
				if(sUpdYn=='N'){	//지난일정이 없는 경우
				
					if ( pThis2 ) {
						pThis2.fn_setApprvCtrDtlForPct(nRow, sColNm, true);
					} else {
						pThis.fn_setApprvCtrDtlForPct(nRow, sColNm, true);
					}
					
					
					
				}else{	//지난일정이 있는 경우
				
					this.bfn_i_cnclApprvCtrDtl(nRow, sColNm, pThis.fv_sLtcRcgtGradeCd,pThis);
				}
					
				
			}else if((pThis.fv_sLtcpClsfcCd=='004' || pThis.fv_sLtcpClsfcCd=='018') && (sNotUtilYn=='Y' || sNotUtilYn3=='Y' || sNotUtilYn44=='Y')){	//주야간보호 미이용수가인 경우 20220411
				
			
				if(sUpdYn=='N'){	//지난일정이 없는 경우
				
					//미이용수가 제거
					if(sNotUtilYn=='Y'){
					   this.fn_createNotUtilPaymtDype(nRow, 0, i, sColNm);
					}else if(sNotUtilYn3=='Y'){					  
					   this.fn_createNotUtilPaymtDype3(nRow, 0, i, sColNm);
					}else if(sNotUtilYn44=='Y'){  // 20220411					  
					   this.fn_createNotUtilPaymtDype3(nRow, 0, i, sColNm);
					}
					
				}else{	//지난일정이 있는 경우
			  		   this.bfn_i_cnclNotUtilPaymtDype(nRow, sColNm,pThis);
				}
				
			}else{
			
				if(sUpdYn=='N'){	//지난일정이 없는 경우
				
					this.fn_setApprvCtrDtl(nRow, sColNm, true);
					
				}else{	//지난일정이 있는 경우
				
					this.bfn_i_cnclApprvCtrDtl(nRow, sColNm, pThis.fv_sLtcRcgtGradeCd,pThis);
				}
			}
		}
	}
	
	if(sUpdYn=='N'){	//지난일정이 없는 경우
	
		//방문일정 삭제
		this.ds_paymtDypr.deleteRow(nRow);
	}
		
	//월상세 급여시작(종료)일자 체크
	this.bfn_i_setMmDtlLtcpDtAll(pThis);
	
	//월상세내역 세팅	
	if(pThis.fv_sLtcpClsfcCd=='001' && pThis.fv_sLtcRcgtGradeCd=='5'){	//5등급인 경우
		this.bfn_i_setMmDtlDescForPct(pThis);
	}else{
		this.bfn_i_setMmDtlDesc(pThis);
	}
};

/*-----------------------------------------------------------------------------------*
 * 재가계약상세내역 삭제(지난일정은 삭제안함)
 *-----------------------------------------------------------------------------------*/
pForm.bfn_i_cnclApprvCtrDtl = function(nRow, sDt, fv_sLtcRcgtGradeCd,o)
{
	var pThis = o;
	var sYm = pThis.cmb_ctrYm.value;
	var sLtcpOffrDt = sYm + this.bfn_i_addZero(String(sDt).substr(2));					//방문일자
	var sLtcpOffrFrTm = this.ds_paymtDypr.getColumn(nRow, 'LTCP_OFFR_FR_TM');	//방문시작시간
	var sLtcpOffrFrTm2;
	var sChgRsnCd1;
	var sChgYn = 'Y';
	
	this.ds_apprvCtrDtl.filter("LTCP_OFFR_DT == '"+sLtcpOffrDt+"'");
	
	for(var i=this.ds_apprvCtrDtl.rowcount-1; i>=0; i--){	//재가급여상세내역
	
		sLtcpOffrFrTm2 = this.ds_apprvCtrDtl.getColumn(i, 'LTCP_OFFR_FR_TM');
		sChgRsnCd1 = this.bfn_i_chkNull(this.ds_apprvCtrDtl.getColumn(i, 'CHG_RSN_CD1'));
		
		if(sChgRsnCd1 == ''){	//수정사유가 없는 경우만 취소
		
			if(sLtcpOffrFrTm==sLtcpOffrFrTm2){	//방문일자&방문시작시간이 같은 경우
		
				sChgYn = 'N';
				this.sNwrYn = this.bfn_i_chkNull(this.ds_apprvCtrDtl.getColumn(i, 'NWR_YN'));
				
				if(this.sNwrYn == ''){	//신규행이면 삭제
					this.ds_apprvCtrDtl.deleteRow(i);
				}else{
					this.ds_apprvCtrDtl.setColumn(i, 'CNCL_YN', 'Y');
					this.ds_apprvCtrDtl.setColumn(i, 'AC_YN', 'N');
					//ds_apprvCtrDtl.setColumn(i, 'UPD_YN', sUpdYn);				//수정여부
					//ds_apprvCtrDtl.setColumn(i, 'CHG_YN', sChgYn);				//변경여부
				}
			}
		}
	}
	this.ds_apprvCtrDtl.filter("");
	
	
	if(sChgYn=='N'){	//지난일정이 아닌 경우
		
		//일수가내역 삭제
		this.ds_ddMech.filter("LTCP_OFFR_DT == '"+sLtcpOffrDt+"'");
		
		for(var i=this.ds_ddMech.rowcount-1; i>=0; i--){
			this.ds_ddMech.deleteRow(i);
		}
		this.ds_ddMech.filter("");
		
		//이용횟수 감소
		pThis.fv_sMmFreq--;
		pThis.ds_limitAmt.setColumn(0,'MM_FREQ',pThis.fv_sMmFreq);
		this.ds_mmDtlInfo.setColumn(0,'MM_UTIL_FREQ',pThis.fv_sMmFreq);
				
		if(fv_sLtcRcgtGradeCd=='5'){
		
			//일수가내역 생성 전 합산여부 체크 및 시간분수 세팅(인지활동형 방문요양)
			this.fn_createApprvCtrDtlCopyForPct(sLtcpOffrDt);
		
		}else{
		
			//일수가내역 생성 전 합산여부 체크 및 시간분수 세팅
			this.fn_createApprvCtrDtlCopy(sLtcpOffrDt);
		}
		
		//방문일정 체크해제
		this.ds_paymtDypr.setColumn(nRow,sDt, 0);
	}
};

