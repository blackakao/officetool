/*------------------------------------------------------------------------------------------------*
 * 초과시간 구하기
 *------------------------------------------------------------------------------------------------*/
pForm.bfn_i_getOverTime = function(sGb,sTime)
{
	var sOverTm;
	var sHh = sTime.substr(0,2);	//시
	var sMi = sTime.substr(2);		//분
	
	if(sGb=='1'){	//2시간 미만
		
		sHh = Number(sHh)-2;	//시작시간 -2
		if(sHh<0) sHh = sHh+24;	// 0시 미만이 되는 경우 +24
		
	}else if(sGb=='2'){	//2시간 초과
		
		sHh = Number(sHh)+2;		//종료시간 +2
		if(sHh>=24) sHh = sHh-24;	// 23시 초과가 되는 경우 -24
	}
	
	sOverTm = this.bfn_i_addZero(sHh)+sMi;	// 초과시간
	
	if(sGb=='2' && sOverTm=='0000'){	//2시간 초과
		sOverTm = '2400';
	}
	
	return sOverTm;
};

