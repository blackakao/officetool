pForm.bfn_i_postSelectNisQlfInfo = function()
{
	//국정원 자격 세팅
	var sQlf = '';	
	var sChwidukDt = '';
	var sSangsilDt = '';
	var sDt = '';

	if( this.fv_pThis.ds_nisQlf.rowcount>0){
		
		sChwidukDt = this.bfn_i_chkNull(this.fv_pThis.ds_nisQlf.getColumn(0,'CHWIDUK_DT'));
		sSangsilDt = this.bfn_i_chkNull(this.fv_pThis.ds_nisQlf.getColumn(0,'SANGSIL_DT'));
		
		for(var i=1; i<=this.fv_pThis.fv_sLastDate; i++){
		
			sQlf = this.bfn_i_chkNull(this.ds_paymtCncl.getColumn(0,'QLF'+i));
			
			if(sQlf==''){
				
				sDt = this.fv_pThis.fv_sLtcpOffrYyyymm + this.bfn_i_addZero(i);
				
				if(Number(sDt) >= Number(sChwidukDt) && Number(sDt) < Number(sSangsilDt)){
					this.ds_paymtCncl.setColumn(0,'QLF'+i, '일반');
