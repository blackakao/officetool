pForm.bfn_i_formatDate = function(sDate)
{
	var sFmtDate;
	
	if(sDate==undefined || sDate==''){ 
		sFmtDate = '';
	}else{
		sFmtDate = sDate + '';
		sFmtDate = String(sFmtDate).substr(0,4)+'-'+ String(sFmtDate).substr(4,2)+'-'+ String(sFmtDate).substr(6,2); 
	}
	return sFmtDate;
};

