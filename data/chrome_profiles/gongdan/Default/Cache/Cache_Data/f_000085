/*------------------------------------------------------------------------------------------------*
 * 합산정보 세팅(합산이 아닌 경우)
 * (방문요양)90번대 이후로는 24시간 방문요양만 사용하도록 수정
 *------------------------------------------------------------------------------------------------*/
pForm.bfn_i_setAcInfo = function(nRow)
{
	var sAcSeqNo = this.bfn_i_chkNull(this.ds_paymtDypr.getColumn(nRow,'AC_SEQ_NO'));
	var sAcSeqNoMax;
	
	if(sAcSeqNo==''){
		
		//sAcSeqNo = bfn_i_chkNull(ds_paymtDypr.getMax("AC_SEQ_NO"));
		
		sAcSeqNoMax = 0;
		
		for(var i=0; i<this.ds_paymtDypr.rowcount; i++){
			
			if(i==0){
			
				sAcSeqNo = this.bfn_i_chkNull(this.ds_paymtDypr.getColumn(i,'AC_SEQ_NO'));
				
				if(sAcSeqNo < 90){	//90번 이후로는 24시간 방문요양에서만 사용	
					sAcSeqNoMax = sAcSeqNo;
				}
				
			}else{
			
				sAcSeqNo = this.bfn_i_chkNull(this.ds_paymtDypr.getColumn(i,'AC_SEQ_NO'));
				
				if(sAcSeqNo < 90){	//90번 이후로는 24시간 방문요양에서만 사용
				
					if(sAcSeqNo > sAcSeqNoMax){
						sAcSeqNoMax = sAcSeqNo;
					}
				}
			}
		}
		
		if(sAcSeqNoMax=='' || sAcSeqNoMax==0){
			sAcSeqNo = 1;
		}else{
			sAcSeqNo = Number(sAcSeqNoMax) + 1;
		}
	}
	
	if(this.fv_sLtcpClsfcCd=='001' || this.fv_sLtcpClsfcDetailItemCd == "001"){
	
		var sFhoUtilYn = this.bfn_i_chgChkYn(this.ds_paymtDypr.getColumn(nRow,'FHO_UTIL_YN'));			//치매가족휴가제이용여부
		var sPgmMngrYn = this.bfn_i_chgChkYn(this.ds_paymtDypr.getColumn(nRow,'PGM_MNGR_YN'));			//프로그램관리자여부
		
		if(sFhoUtilYn=='Y'){
			sAcSeqNo = '90';
		}else if(sPgmMngrYn=='Y'){
			//sAcSeqNo = '0'; // 20170205 3월고시 합산 수정 KHCHO
			//alert("20170205 3월고시 합산 수정 => " + sAcSeqNo);
		}
	}
					
	this.ds_paymtDypr.setColumn(nRow,'AC_YN','N');
	this.ds_paymtDypr.setColumn(nRow,'AC_SEQ_NO',sAcSeqNo);
};

