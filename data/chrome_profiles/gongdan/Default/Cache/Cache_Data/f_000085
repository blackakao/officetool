pForm.bfn_i_chkLimitAmtExcsYn = function(o){

    var pThis = o;
	////trace("bfn_i_chkLimitAmtExcsYn pThis ::: " + pThis.name);
	var nLimitAmt = this.bfn_i_chkNull(pThis.ds_limitAmt.getColumn(0,'MM_LMT_AMT'));		//월한도액
	var nMmTotAmt = this.bfn_i_chkNull(pThis.ds_limitAmt.getColumn(0,'MM_TOT_AMT'));		//타급여포함 월금액
	var nMmExcepAmt = this.bfn_i_chkNull(pThis.ds_limitAmt.getColumn(0,'MM_EXCEP_AMT'));	//월한도미포함 금액
	
	if(nLimitAmt=='') nLimitAmt = 0;
