/*-----------------------------------------------------------------------------------*
 * 시간형식체크
 *-----------------------------------------------------------------------------------*/
pForm.bfn_i_chkFormatTime = function(sTime)
{
	sTime = sTime.trim(); //4자리수 미만이 입력되는 케이스를 방지하기 위함
	if(sTime=='' || sTime=='0000' || sTime=='2400') return true;
	
	var sHh = Number(String(sTime).substr(0,2));
	var sMm = Number(String(sTime).substr(2,4));
	
	if(sTime.length < 4){
		return false;
	}
	if(sHh < 0 || sHh > 23){
		return false;
	}
	if(sMm < 0 || sMm > 59){
		return false;
	}
	return true;
};

