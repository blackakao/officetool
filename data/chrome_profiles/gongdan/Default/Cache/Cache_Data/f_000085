	//타급여포함 월금액이 월한도액보다 큰 경우
	if(nLimitAmt > 0 && (Number(nMmTotAmt)-Number(nMmExcepAmt)) > Number(nLimitAmt) && pThis.fv_sLtcpClsfcCd != '603'){
		
