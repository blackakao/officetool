pForm.bfn_i_cal_setCellProperty = function(obj, band, stCell, strPropID)
{
	//trace("bfn_i_cal_setCellProperty : " + stCell);
	
	var dsObj = obj.getBindDataset();
	var sValue = "";
	var ii = 0;
	obj.set_enableredraw(false);
	dsObj.set_enableevent(false);
	switch(strPropID) {
	   case "cssclass":
			for(var i=stCell; i< stCell + 31; i++){
				ii++; 
				if(ii > 31) break;
				//sValue = "expr:comp.parent.bfn_i_getBackgroundColor('" + String(ii)  + "',currow,comp.parent.parent.parent) == 'darkgray' || comp.parent.bfn_i_getBorderType('" + String(ii)  + "',currow,comp.parent.parent.parent) == '1 solid gray' ? 'chk_WF_gray' : ''";
				sValue = "expr:comp.parent.bfn_i_getBackgroundColor('" + String(ii)  + "',currow,comp.parent.parent.parent) != 'darkgray' ? '' : 'chk_WF_gray'";
				obj.setCellProperty( band, i, "cssclass", sValue);
			}
	        break;
	   case "cssclass_none":
			for(var i=stCell; i< stCell + 31; i++){
				ii++; 
				if(ii > 31) break;
				sValue = "";
				obj.setCellProperty( band, i, "cssclass", "");
			}
	        break;
		default :
		   break;
	}
	dsObj.set_enableevent(true);
	obj.set_enableredraw(true);

};

