pForm.bfn_i_setObjCheckAll = function(obj, e)
{
	//var dsObj = eval(obj.binddataset);
	var dsObj = obj.getBindDataset();
	var sColid = obj.getCellProperty("body", e.cell, "text").replace("bind:","");

	this.bv_nGridCheckAll = (this.bv_nGridCheckAll ? 0 : 1);

	dsObj.set_enableevent(false);
	
	for(var i=0; i<dsObj.getRowCount(); i++){
		dsObj.setColumn(i, sColid, this.bv_nGridCheckAll);
	}

	obj.setCellProperty("Head",0,"expr",this.bv_nGridCheckAll);

	dsObj.set_enableevent(true);
};

/*------------------------------------------------------------------------------------------------*
 * 그리드에서 체크된 행의 갯수
 *------------------------------------------------------------------------------------------------*/
pForm.bfn_i_getCheckCnt = function(ds)
{
	var nCnt = 0;
	var dsObj = eval(ds);

	for(var i=0; i<dsObj.rowcount; i++){
		var chk = dsObj.getColumn(i,'CHK');
        
		if(chk == '1'){
			nCnt++;
			if(nCnt>0){
				break;
			}
		}
	}
	return nCnt;
};

