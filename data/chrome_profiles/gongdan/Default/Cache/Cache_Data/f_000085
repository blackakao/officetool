pForm.bfn_i_chkCnclYn = function(o)
{
	//trace("bfn_i_chkCnclYn start.");
	
	var pThis = o;
	var sCol;
	var sCnclProcYn;
	
	var sCtrToDt;
	var sCtrToTm;
	var sCtrToDttm;
	
	var sCtrFrDt = pThis.ds_objtr.getColumn(0,'CTR_FR_DT');
	var sCtrFrTm = pThis.ds_objtr.getColumn(0,'CTR_FR_TM');
	
	if(pThis.ds_ctrCncl.rowcount > 0){
		
		sCnclProcYn = pThis.ds_ctrCncl.getColumn(0,'CNCL_YN');

		if(sCnclProcYn=='Y'){
			
			sCtrToDt = pThis.ds_ctrCncl.getColumn(0,'CTR_TO_DT');
			//sCtrToTm = ds_ctrCncl.getColumn(0,'LTCP_OFFR_TO_TM');
			
			sCol = String(sCtrToDt).substr(6);
			
			if(String(sCol).substr(0,1)=='0'){
				sCol = String(sCol).substr(1);
			}
			
			sCtrToTm = this.gfn_allTrim(this.ds_paymtCncl.getColumn(0,'LTCP_OFFR_TO_TM'+sCol));
			
			//trace("sCtrToTm : [" + sCtrToTm + "]");
			if ( this.cfn_str_isNull(sCtrToTm) ) {
				this.alert("계약해지정보가 없습니다");
				return false;
			}
			
			pThis.ds_ctrCncl.setColumn(0,'LTCP_OFFR_TO_TM',sCtrToTm);
			
			if(sCtrToDt == sCtrFrDt && sCtrFrTm > sCtrToTm){
				
				sCtrFrTm = String(sCtrFrTm).substr(0,2) + ':' + String(sCtrFrTm).substr(2);
				
				//해지시간이 계약시작시간({0})보다 빠를 수 없습니다.\n다시 확인해 주십시오. 
				this.gfn_msgShow(this, "XWIA0099",[sCtrFrTm]);
				return false;
			}
			
			sCtrToDttm = String(sCtrToDt).substr(0,4) + '년 ' + String(sCtrToDt).substr(4,2) + '월 ' + String(sCtrToDt).substr(6) + '일 '
						 + String(sCtrToTm).substr(0,2) + ':' + String(sCtrToTm).substr(2);
				
			//{0} 계약기간이 종료됩니다. 해지하시겠습니까?
			if(!this.gfn_msgShow(this, "XCIA0006",[sCtrToDttm])){
				return false;  
			}else{
				
				//해지당일 일수가 재생성
				var rst = this.bfn_i_setDdMechDesc(sCtrToDt, sCtrToTm);				
				return true;
			}
			
		}else{
			return true;
		}
	}
	return true;
};

/*------------------------------------------------------------------------------------------------*
 * 해지당일 일수가 재생성
 *------------------------------------------------------------------------------------------------*/
pForm.bfn_i_setDdMechDesc = function(sCtrToDt, sCtrToTm)
{
	var sDt = String(sCtrToDt).substr(6);
	if(String(sDt).substr(0,1)=='0'){
		sDt = String(sDt).substr(1);
	}
	
	var sDtChk;
	var sLtcpOffrFrTm;
	var nCnt = 0;
	
	for(var i=0;  i<this.ds_paymtDypr.rowcount; i++){
		
		sDtChk = this.ds_paymtDypr.getColumn(i,'DT'+sDt);
		
		if(sDtChk=='1'){
			
			sLtcpOffrFrTm = this.ds_paymtDypr.getColumn(i,'LTCP_OFFR_FR_TM');
			
			if(Number(sLtcpOffrFrTm) >= Number(sCtrToTm)){ // ★ 민성훈대리요청(2016.05.09)_해지시간이 서비스 시작시간까지는 해지되도록 수정( > 에서 >=로)
				nCnt++;
				this.ds_paymtDypr.setColumn(i, 'DT'+sDt, '0');
			}
		}
	}
	
	return nCnt;
};

