		//n8HhMechCnt = n8HhMechCnt + Number(this.fv_sDn20) + Number(this.fv_sDm20) + Number(nNotUtilMaxCnt);  //코로나 미이용 6차 지침 적용 20220414
		
		if(    ( this.fv_sNtfcAdptYm_201701 <= this.fv_sLtcpOffrYyyymm) 
//		    && ( this.fv_sLtcpClsfcCd=='018' && n8HhMechCnt >= 15) || ( this.fv_sDm20 > 0 && n8HhMechCnt >= 15) || (n8HhMechCnt >= 20)){
		    && ( this.fv_sLtcpClsfcCd=='018' && n8HhMechCnt >= 15) || ( this.fv_sDm20 > 0 && n8HhMechCnt >= 15) || (n8HhMechCnt >= 20 || this.fv_sDm20 >= 15)){
		    // KHCHO 20161215 2017.01. 치매전담형 주야간보호급여 월 15일 이상 월한도액 150% 확대
		    
		     this.fv_sLimitAmt = Number(sInitLimitAmt) * 1.5;
			 this.fv_sDayDd20ExcsYn = 'Y';
			
			 pThis.ds_limitAmt.setColumn(0,'MM_LMT_AMT',this.fv_sLimitAmt);					//월한도액
			 pThis.ds_limitAmt.setColumn(0,'DAY_DD20_EXCS_YN',this.fv_sDayDd20ExcsYn);		//주야간보호20일초과여부
			
		}else if(( this.fv_sNtfcAdptYm_201701 > this.fv_sLtcpOffrYyyymm) && n8HhMechCnt >= 20){
				
			if ((this.fv_sLtcpOffrYyyymm >= this.fv_sNtfcAdptYm_201901) &&  (nDm8HhMechCnt >= 15  || this.fv_sDm20 >= 15)){
			     this.fv_sLimitAmt = Number(sInitLimitAmt) * 1.7;
		         this.fv_sDayDd20ExcsYn = 'Y';
		     } else {this.fv_sLimitAmt = Number(sInitLimitAmt) * 1.5;
			    this.fv_sDayDd20ExcsYn = 'Y';
			}
// 			 this.fv_sLimitAmt = Number(sInitLimitAmt) * 1.5;
// 			 this.fv_sDayDd20ExcsYn = 'Y';
			
			 pThis.ds_limitAmt.setColumn(0,'MM_LMT_AMT',this.fv_sLimitAmt);					//월한도액
			 pThis.ds_limitAmt.setColumn(0,'DAY_DD20_EXCS_YN',this.fv_sDayDd20ExcsYn);		//주야간보호20일초과여부
			
		}else{
		
			//fv_sLimitAmt = sInitLimitAmt;
			this.fv_sDayDd20ExcsYn = 'N';
			
			//ds_limitAmt.setColumn(0,'MM_LMT_AMT',fv_sLimitAmt);					//월한도액
			//ds_limitAmt.setColumn(0,'DAY_DD20_EXCS_YN',fv_sDayDd20ExcsYn);		//주야간보호20일초과여부
		}

		// 승인금액이 월한도액 보다 크면 승인금액을 월한도액으로 보정(2016.04.29 민성훈 대리 지시)
		if ( Number(this.fv_sAdptAmt) > this.fv_sLimitAmt) {
			 this.fv_sAdptAmt = this.fv_sLimitAmt;
		}
		 pThis.ds_limitAmt.setColumn(0,'ADPT_AMT', this.fv_sAdptAmt);					//승인금액

		/* 승인초과금액 세팅 */
		// this.fv_sAdptExcsAmt = 0;
		
		if( Number(this.fv_sAdptAmt) > 0){	
			if( Number(this.fv_sTotAmt) > Number(this.fv_sAdptAmt)){
				 this.fv_sAdptExcsAmt = Number(this.fv_sTotAmt) - Number(this.fv_sAdptAmt);
			}
		}
		
		if ( pThis.name == "npia107p01" || pThis.name == "npia103p02") { // 고도화사업(25년) PHJ (20251016) 전체 월금액 재정산화면(npia103p02)에 대해 추가
			pThis.ds_limitAmt.setColumn(0,'ADPT_EXCS_AMT',this.fv_sAdptExcsAmt);
		} else {
			//trace("통합재가급여는 승인초과금액 화면 update 안함 this.fv_sAdptExcsAmt = " + this.fv_sAdptExcsAmt);
		}
		
		/* 초과금액 세팅 */
		if( ( Number(this.fv_sMmTotAmt)-Number(this.fv_sMmExcepAmt)) >= Number(this.fv_sLimitAmt)){
			 this.fv_sExcsCost = Number(this.fv_sMmTotAmt) - Number(this.fv_sMmExcepAmt) - Number(this.fv_sLimitAmt);						//초과금액 = 타기관포함 월금액 - 한도액
			 this.fv_sExcsYn = 'Y';
		}else{
			 this.fv_sExcsCost = 0;
			 this.fv_sExcsYn = 'N';
		}
		
		 pThis.ds_limitAmt.setColumn(0,'EXCS_YN',this.fv_sExcsYn);			//초과여부 세팅
		 pThis.ds_limitAmt.setColumn(0,'EXCS_COST',this.fv_sExcsCost);		//초과금액 세팅
		
		/* 단기보호 급여이용 연장 관련 세팅(2016년9월고시 적용) */
		if( this.fv_sLtcpClsfcCd=='005'){
		
		    this.chk_dd15ExcsYn.set_enable(true);
			
			if( this.fv_sLtcpOffrYyyymm >= this.fv_sSguExtsnAdptYm){	//2017년1월 이후 연 4회 연장 (fv_sSguExtsnAdptYm : 201701)
			
				if( Number(this.fv_sDd15ExcsUtilFreqTot) >= 4){			
					this.chk_dd15ExcsYn.set_enable(false);
				}
			
			}else{	//연 2회 연장
			
				if( Number(this.fv_sDd15ExcsUtilFreqTot) >= 2){			
					 this.chk_dd15ExcsYn.set_enable(false);
				}
			}
		}
	}
};

