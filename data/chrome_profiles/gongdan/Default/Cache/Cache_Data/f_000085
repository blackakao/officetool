/*------------------------------------------------------------------------------------------------*
 * 요일명 가져오기
 *------------------------------------------------------------------------------------------------*/
pForm.bfn_i_getDayNm = function(pDate,o)
{
    var pThis =o;
	var arrDayNm = new Array("일", "월", "화", "수","목", "금", "토");
	
	var sCtrYm = pThis.fv_sLtcpOffrYyyymm;
	var sYyyy = String(sCtrYm).substr(0,4);
	var sMm = String(sCtrYm).substr(4,2);
	var sDd = pDate;

	var objDate = new Date(sYyyy+'-'+sMm+'-'+this.bfn_i_addZero(sDd));
	var nDay = objDate.getDay();
	var sDayNm = pDate + '\n('+ arrDayNm[nDay] + ')';
	
	return sDayNm;
};

