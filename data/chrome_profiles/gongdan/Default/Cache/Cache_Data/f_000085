/*------------------------------------------------------------------------------------------------*
 * 수가재산정 여부 점검
 *------------------------------------------------------------------------------------------------*/
pForm.bfn_i_chkMechRecalcTgtYn = function(o)
{
    var pThis = o;
	//2016년03년 이후부터 적용
	if(Number(pThis.fv_sLtcpOffrYyyymm) < 201603){
		return false;		
	}
		
	//최종등록일이 오픈이후인 건은 제외
	if( Number(pThis.fv_sLastRegDt) > 20160327){
		return false;	
	}
	
	//서비스내용입력 상태가 저장인 자료 제외
	if(pThis.fv_bPaymtContnDataStat){
		return false;		
	}
	
	//방문목욕,방문간호,단기보호 제외
	if( pThis.fv_sLtcpClsfcCd=='002' || pThis.fv_sLtcpClsfcCd=='003' || pThis.fv_sLtcpClsfcCd=='005'){
		return false;		
	}	
		
	//방문요양
	if(pThis.fv_sLtcpClsfcCd=='001'){
		this.bfn_i_chk210MinOverMech(pThis);	//210, 240분 이상 수가 점검
	}
	
	pThis.fv_sMechRecalcYn = 'N';	
	
	//2시간미만 합산이 존재하는지 체크
	if( this.ds_paymtDypr.rowcount <= 1){
		return false;
	}	
	
	var sAcYn;
	for(var i=0;  i<this.ds_paymtDypr.rowcount; i++){
	
		sAcYn = this.ds_paymtDypr.getColumn(i,'AC_YN');
		if(sAcYn=='Y'){
			pThis.fv_sMechRecalcYn = 'Y';
		}
	}
	
	if(pThis.fv_sMechRecalcYn=='Y'){
		return true;
	}
	
	return false;
};

/*------------------------------------------------------------------------------------------------*
 * 방문요양 210, 240분 이상 수가 관련 점검
 *------------------------------------------------------------------------------------------------*/
pForm.bfn_i_chk210MinOverMech = function(o)
{
    var pThis = o;
	var sAcYn;
	var sAcYnOld;
	var sAcSeqNo;
	var sAcSeqNoOld;
	var sBeforeFrTm;
	var sBeforeToTm;
	var sLtcpOffrFrTm;
	var sLtcpOffrToTm;
	var sFhoUtilYn;				//치매가족휴가제(24시간방문요양)이용여부
	
	var nCnt = 0;
	var nAcCnt = 0;				//합산 횟수
	var n210Cnt = 0;			//210분 수가 횟수
	var n210OtherCnt = 0;		//210분 이외 수가 횟수
	var n240Cnt = 0;			//240분 수가 횟수
	var n240OtherCnt = 0;		//240분 이외 수가 횟수
	var nLtcpOffrTmn = 0;
	var nLtcpOffrTmnOld = 0;
	var nLtcpOffrTmnTot = 0;
	var bTsmtOffrYn = false;	//동시제공여부
		
	var sDt;
	var sDtChk;
	
	pThis.fv_b210MinOverMech = false;
	
	for(var j=1; j<=pThis.fv_sLastDate; j++){
		
		sDt = 'DT'+j;
		
		nCnt = 0;
		nAcCnt = 0;				//합산 횟수
		n210Cnt = 0;			//210분 수가 횟수
		n210OtherCnt = 0;		//210분 이외 수가 횟수
		n240Cnt = 0;			//240분 수가 횟수
		n240OtherCnt = 0;		//240분 이외 수가 횟수
		nLtcpOffrTmn = 0;
		nLtcpOffrTmnOld = 0;
		nLtcpOffrTmnTot = 0;
		
		for(var i=0; i<this.ds_paymtDypr.rowcount; i++){
		
			sDtChk = this.ds_paymtDypr.getColumn(i,sDt);	
			
			if(sDtChk=='1'){
			
				if(nCnt==0){
						
					//sAcYnOld = ds_paymtDypr.getColumn(i,'AC_YN');
					sAcSeqNoOld = this.ds_paymtDypr.getColumn(i,'AC_SEQ_NO');
					sBeforeFrTm = this.ds_paymtDypr.getColumn(i,'LTCP_OFFR_FR_TM');
					sBeforeToTm = this.ds_paymtDypr.getColumn(i,'LTCP_OFFR_TO_TM');
					nLtcpOffrTmnOld = Number(this.ds_paymtDypr.getColumn(i, 'LTCP_OFFR_TMN'));					
					sFhoUtilYn = this.bfn_i_chgChkYn(this.ds_paymtDypr.getColumn(i,'FHO_UTIL_YN'));	//치매가족휴가제(24시간방문요양)이용여부
					
					if(sFhoUtilYn == 'N' && Number(nLtcpOffrTmnOld) >= 210 && Number(nLtcpOffrTmnOld) < 240){
						n210Cnt++;
					}else{
						n210OtherCnt++;
					}
						
					if(sFhoUtilYn == 'N' && Number(nLtcpOffrTmnOld) >= 240 && Number(nLtcpOffrTmnOld) < 270){	
						n240Cnt++;
					}else{
						n240OtherCnt++;
					}
							
					nCnt++;	
										
				}else{
						
					//sAcYn = ds_paymtDypr.getColumn(i,'AC_YN');
					sAcSeqNo = this.ds_paymtDypr.getColumn(i,'AC_SEQ_NO');
					sLtcpOffrFrTm = this.ds_paymtDypr.getColumn(i,'LTCP_OFFR_FR_TM');
					sLtcpOffrToTm = this.ds_paymtDypr.getColumn(i,'LTCP_OFFR_TO_TM');
					nLtcpOffrTmn = Number(this.ds_paymtDypr.getColumn(i, 'LTCP_OFFR_TMN'));					
					sFhoUtilYn = this.bfn_i_chgChkYn(this.ds_paymtDypr.getColumn(i,'FHO_UTIL_YN'));	//치매가족휴가제(24시간방문요양)이용여부
						
					//급여제공시간 중복시 동시제공
					if( ((sBeforeFrTm >= sLtcpOffrFrTm) && (sBeforeFrTm  < sLtcpOffrToTm))
						|| ((sBeforeToTm > sLtcpOffrFrTm) && (sBeforeToTm <= sLtcpOffrToTm))
						|| ((sLtcpOffrFrTm >= sBeforeFrTm) && (sLtcpOffrFrTm < sBeforeToTm))
						|| ((sLtcpOffrToTm > sBeforeFrTm) && (sLtcpOffrToTm <= sBeforeToTm)) ){
						
						bTsmtOffrYn = true;
					}else{
						bTsmtOffrYn = false;
					}
					
					//합산여부 세팅 시작
					sAcYn = 'N';
						
					if(!bTsmtOffrYn){
					
						sAcYn = 'N';
						
						var sLtcpOffrFrTmOvr = this.bfn_i_getOverTime('1',sLtcpOffrFrTm);	// 초과시작시간
						var sLtcpOffrToTmOvr = this.bfn_i_getOverTime('2',sLtcpOffrToTm);	// 초과종료시간
						
						if(Number(sBeforeToTm)==Number(sLtcpOffrFrTm) || Number(sLtcpOffrToTm) == Number(sBeforeFrTm)){
							sAcYn = 'Y';
						}
						
						//급여제공종료시간이 시작시간보다 작거나 같고 급여제공종료시간이 초과시작시간보다 크면
						if((Number(sLtcpOffrFrTm) > Number(sBeforeToTm)) && (Number(sLtcpOffrFrTmOvr) < Number(sBeforeToTm))){							
							sAcYn = 'Y';
						}
						//급여제공시작시간이 종료시간보다 크거나 같고 급여제공시작시간이 초과종료시간보다 작으면
						else if((Number(sLtcpOffrToTm) < Number(sBeforeFrTm)) && (Number(sLtcpOffrToTmOvr) > Number(sBeforeFrTm))){							
							sAcYn = 'Y';
						}
						//이전 급여제공종료시간이 다음 급여제공시작시간과 같으면
						else if(Number(sLtcpOffrToTm) == Number(sBeforeFrTm) || Number(sLtcpOffrFrTm) == Number(sBeforeToTm)){						
							sAcYn = 'Y';						
						}
					}
					//합산여부 세팅 끝
				
					if(sAcYn=='Y' && sAcSeqNo==sAcSeqNoOld){	//합산인 경우
						
						if(nAcCnt==0){						
							nLtcpOffrTmnTot = nLtcpOffrTmnOld + nLtcpOffrTmn;
						}else if(nAcCnt>=1){
							nLtcpOffrTmnTot = nLtcpOffrTmnTot + nLtcpOffrTmn;
						}
																		
						if(sFhoUtilYn == 'N' && Number(nLtcpOffrTmnTot) >= 210 && Number(nLtcpOffrTmnTot) < 240){				
							n210Cnt++;					
							n210OtherCnt--;				
							n240OtherCnt--;												
						}else{
							n210OtherCnt++;
						}
							
						if(sFhoUtilYn == 'N' && Number(nLtcpOffrTmnTot) >= 240 && Number(nLtcpOffrTmnTot) < 270){	
							n240Cnt++;					
							n210Cnt--;										
							n210OtherCnt--;					
							n240OtherCnt--;											
						}else{
							n240OtherCnt++;
						}
						
						nAcCnt++;
											
					}else{
								
						nCnt++;
						n210OtherCnt++;
						n240OtherCnt++;
						
						if(sFhoUtilYn == 'N' && Number(nLtcpOffrTmn) >= 210 && Number(nLtcpOffrTmn) < 240){
							n210Cnt++;
						}
						
						if(sFhoUtilYn == 'N' && Number(nLtcpOffrTmn) >= 240 && Number(nLtcpOffrTmn) < 270){
							n240Cnt++;
						}
										
						//급여제공시간 중복시 동시제공
						if(bTsmtOffrYn){
							nCnt--;
						}
					}
					
					sAcYnOld = sAcYn;
					sAcSeqNoOld = sAcSeqNo;
					sBeforeFrTm = sLtcpOffrFrTm;
					sBeforeToTm = sLtcpOffrToTm;
					nLtcpOffrTmnOld = nLtcpOffrTmn;							
				}
			}
		}
		
		if(sFhoUtilYn == 'N'&&(Number(n210Cnt)!=Number(nCnt) && (Number(n210OtherCnt) > 0 && Number(n210Cnt) > 0))){	// 210분 수가 존재시 타 방문요양 불가
			pThis.fv_b210MinOverMech = false;
			this.alert("210분 수가는 1일 1회만 가능하며 해당일에는 다른 급여일정을 등록하실 수 없습니다.\n\n" +pThis.cmb_ctrYm.text + ' ' + j + "일 급여일정을 확인해 주십시오.");
			return false;
		}
		
		if(sFhoUtilYn == 'N'&&(Number(n240Cnt)!=Number(nCnt) &&(Number(n240OtherCnt) > 0 && Number(n240Cnt) > 0))){	// 240분 수가 존재시 타 방문요양 불가
			pThis.fv_b210MinOverMech = false;
			this.alert("240분 수가는 1일 1회만 가능하며 해당일에는 다른 급여일정을 등록하실 수 없습니다.\n\n" +pThis.cmb_ctrYm.text + ' ' + j + "일 급여일정을 확인해 주십시오.");
			return false;
		}
	}
	
	pThis.fv_b210MinOverMech = true;
	return true;
};


