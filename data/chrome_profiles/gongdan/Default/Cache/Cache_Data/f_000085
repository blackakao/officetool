pForm.bfn_i_getMech = function(sDt,o)
{   
	var pThis   = o;
	var sYyyymm = pThis.fv_sLtcpOffrYyyymm;
	var sDate = sYyyymm + this.bfn_i_addZero(sDt);	
	var nUtilAmt = 0;
	var nUtilAmtTot = 0;
	
	if(this.ds_ddMech.rowcount == 0) return '';
	
	this.ds_ddMech.filter("LTCP_OFFR_DT == '"+sDate+"'");
	
	for(var i=0; i<this.ds_ddMech.rowcount; i++){
		
		nUtilAmt = this.ds_ddMech.getColumn(i,'UTIL_AMT');
		nUtilAmtTot = nUtilAmtTot + Number(nUtilAmt);
	}
	
	this.ds_ddMech.filter("");
	nUtilAmtTot = nUtilAmtTot.toFixed(1);// .toFixedLocaleString(1);
	nUtilAmtTot = String(nUtilAmtTot).substr(0,nUtilAmtTot.indexOf("."));
	
	if(nUtilAmtTot==0) {
	   nUtilAmtTot = '';
   	   return nUtilAmtTot;
	}
	else {
	   return  this.gfn_appendComma(nUtilAmtTot);
	}
};

