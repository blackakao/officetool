			else if( this.fv_sLtcRcgtGradeCdMin != '6' && ( this.fv_sDm20 >= 15 || nDm8HhMechCnt >= 15 || n8HhMechCnt >= 15) ) { 			
				if ( nDm8HhMechCnt >= 15 || this.fv_sDm20 >= 15 ) {
					 this.fv_sLimitAmt = Number(sInitLimitAmt) * 1.5;
					 this.fv_sDayDd20ExcsYn = 'Y';
