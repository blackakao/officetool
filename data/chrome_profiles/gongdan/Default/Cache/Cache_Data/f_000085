/*------------------------------------------------------------------------------------------------*
 * 시간분수계산
 *------------------------------------------------------------------------------------------------*/
pForm.bfn_i_calLtcpOffrTmn = function(sLtcpOffrToTm, sLtcpOffrFrTm, bMinusYn)
{
	//trace("bfn_i_calLtcpOffrTmn start. sLtcpOffrToTm, sLtcpOffrFrTm, bMinusYn => " + sLtcpOffrToTm + " " + sLtcpOffrFrTm + " " + bMinusYn);
	
	var nLtcpOffrTmn = 0;
	var nLtcpOffrTmn1 = 0;
	var nLtcpOffrTmn2 = 0;
	
	//시작시간이 종료시간보다 큰 경우(급여제공 중 일자변경)
	if(Number(sLtcpOffrFrTm) > Number(sLtcpOffrToTm)){
	
		nLtcpOffrTmn1 = (24 * 60) - ((Number(String(sLtcpOffrFrTm).substr(0,2)) * 60) + Number(String(sLtcpOffrFrTm).substr(2)));
		nLtcpOffrTmn2 = ((Number(String(sLtcpOffrToTm).substr(0,2)) * 60) + Number(String(sLtcpOffrToTm).substr(2)));
		nLtcpOffrTmn = nLtcpOffrTmn1 + nLtcpOffrTmn2;
	
	//시작시간이 종료시간과 같은 경우(24시간 방문요양)
	}else if(Number(sLtcpOffrFrTm) == Number(sLtcpOffrToTm)){
		
		if(bMinusYn){
			nLtcpOffrTmn = 0;
		}else{
			nLtcpOffrTmn = 1440;
		}
	}else{
	
		nLtcpOffrTmn = ((Number(String(sLtcpOffrToTm).substr(0,2)) * 60) + Number(String(sLtcpOffrToTm).substr(2)))
							- ((Number(String(sLtcpOffrFrTm).substr(0,2)) * 60) + Number(String(sLtcpOffrFrTm).substr(2)));
	}
	
	//trace("return nLtcpOffrTmn => " + nLtcpOffrTmn);
	return nLtcpOffrTmn;
};

/*------------------------------------------------------------------------------------------------*
 * 월상세 급여시작(종료)일자 관련 세팅(급여일정 그리드 클릭시)
 *------------------------------------------------------------------------------------------------*/
pForm.bfn_i_setMmDtlLtcpDt = function(dt, chk,o) 
{
	var sYyyymm;
	var pThis = o;
	if(pThis.fv_sPgmGb=='org'){
		sYyyymm = pThis.cmb_ctrYm.value;
	}else if(pThis.fv_sPgmGb=='add'){ 
		sYyyymm = pThis.fv_sLtcpOffrYyyymm;
	}
	
	var sDt = sYyyymm + this.bfn_i_addZero(dt);
	
	pThis.fv_sLtcpFrDt = this.bfn_i_chkNull(this.fv_sLtcpFrDt);
	pThis.fv_sLtcpToDt = this.bfn_i_chkNull(this.fv_sLtcpToDt);
	
	if(this.ds_mmDtlInfo.rowcount == 0){
	
		pThis.fv_sLtcpFrDt = sDt;		//급여시작일자
		pThis.fv_sLtcpToDt = sDt;		//급여종료일자
	
	}else{
	
		if(chk=='1'){
		
			//급여시작일자 체크
			if(pThis.fv_sLtcpFrDt==''){
				pThis.fv_sLtcpFrDt = sDt;		
				this.ds_mmDtlInfo.setColumn(0,'LTCP_FR_DT',sDt);
			}else if(Number(pThis.fv_sLtcpFrDt) > Number(sDt)){
				pThis.fv_sLtcpFrDt = sDt;
				this.ds_mmDtlInfo.setColumn(0,'LTCP_FR_DT',sDt);
			}
			
			//급여종료일자 체크
			if(pThis.fv_sLtcpToDt==''){
				pThis.fv_sLtcpToDt = sDt;		
				this.ds_mmDtlInfo.setColumn(0,'LTCP_TO_DT',sDt);
			}else if( Number(pThis.fv_sLtcpToDt) < Number(sDt)){
				pThis.fv_sLtcpToDt = sDt;		
				this.ds_mmDtlInfo.setColumn(0,'LTCP_TO_DT',sDt);
			}
			
		}else{
		
			//급여시작일자 체크
			if( Number(pThis.fv_sLtcpFrDt) <= Number(sDt)){
				
				this.ds_apprvCtrDtl.filter("CNCL_YN == 'N'");
				pThis.fv_sLtcpFrDt = this.ds_apprvCtrDtl.getColumn(0,'LTCP_OFFR_DT');
				this.ds_mmDtlInfo.setColumn(0,'LTCP_FR_DT',pThis.fv_sLtcpFrDt);
				this.ds_apprvCtrDtl.filter("");
			}
			
			//급여종료일자 체크
			if( Number(this.fv_sLtcpToDt) >= Number(sDt)){
			
				this.ds_apprvCtrDtl.filter("CNCL_YN == 'N'");
				pThis.fv_sLtcpToDt = this.ds_apprvCtrDtl.getColumn(this.ds_apprvCtrDtl.rowcount-1,'LTCP_OFFR_DT');	
				this.ds_mmDtlInfo.setColumn(0,'LTCP_TO_DT',pThis.fv_sLtcpToDt);
				this.ds_apprvCtrDtl.filter("");
			}
		}
	}
	
};

/*------------------------------------------------------------------------------------------------*
 * 월상세 급여시작(종료)일자 관련 세팅(급여일정 그리드 조회시)
 *------------------------------------------------------------------------------------------------*/
pForm.bfn_i_setMmDtlLtcpDtAll = function(o) 
{
    var pThis = o;  
	if( this.ds_apprvCtrDtl.rowcount == 0){
		return;
	}
	
	this.ds_apprvCtrDtl.filter("CNCL_YN == 'N'");
	var sLtcpFrDt = this.ds_apprvCtrDtl.getColumn(0,'LTCP_OFFR_DT');
	var sLtcpToDt = this.ds_apprvCtrDtl.getColumn(this.ds_apprvCtrDtl.rowcount-1,'LTCP_OFFR_DT');
		
	//급여시작일자세팅
	pThis.fv_sLtcpFrDt = sLtcpFrDt;
	this.ds_mmDtlInfo.setColumn(0,'LTCP_FR_DT',sLtcpFrDt);	
		
	//급여종료일자 세팅
	pThis.fv_sLtcpToDt = sLtcpToDt;
	this.ds_mmDtlInfo.setColumn(0,'LTCP_TO_DT',sLtcpToDt);
	
	this.ds_apprvCtrDtl.filter("");
};

