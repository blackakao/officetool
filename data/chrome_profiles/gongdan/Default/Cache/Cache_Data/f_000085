/*------------------------------------------------------------------------------------------------*
 * Dataset에 수정된 Row가 있는지 여부 판단
 * Params : objOrg 원본 dataset, objMod 수정본
 * Return : boolean - true 또는 false
 *------------------------------------------------------------------------------------------------*/
pForm.bfn_isModifyDataset = function (pThis, objOrg, objMod) {

	var bFlag = false;
	var sColNm1;
	var sColNm2;
	var sColNm3;
	var sColNm4;
////trace(" org DATA====================================================");
//cfn_debug2(	objOrg);
////trace(" mod DATA====================================================");
//cfn_debug2(	objMod);
	if( objOrg instanceof Dataset && objMod instanceof Dataset ){  
	
		sColNm1 = objOrg.getColID(1);
		sColNm2 = objOrg.getColID(2);
		sColNm3 = objOrg.getColID(3);
		sColNm4 = objOrg.getColID(4);
		////trace(" obj.name :: "+	objOrg.name+", 	objMod.name : "+objMod.name);
		////trace(" sColNm1:"+sColNm1+", sColNm2:"+sColNm2+", sColNm3:"+sColNm3+", sColNm4:"+sColNm4+",  objOrg.colcount::"+objOrg.colcount);			
		
		for( var i = 0; i < objOrg.rowcount; i++ ){
			
			if( objOrg.name == 'ds_apprvCtrDtl' || objOrg.name == 'ds_ddMech' ){
			
			    if( pThis.fv_sLtcpClsfcCd == '002' ) { // 방문목욕 : 주민번호 Key 추가 
					objMod.filter(sColNm1+" == '"+objOrg.getColumn(i, sColNm1)+"' && "+sColNm2+" == '"+objOrg.getColumn(i, sColNm2)+"' && "+sColNm3+" == '"+objOrg.getColumn(i, sColNm3)+"' && "+sColNm4+" == '"+objOrg.getColumn(i, sColNm4)+"' && CHE_HIPIN == '"+objOrg.getColumn(i, 'CHE_HIPIN')+"'");
			    }else{
					objMod.filter(sColNm1+" == '"+objOrg.getColumn(i, sColNm1)+"' && "+sColNm2+" == '"+objOrg.getColumn(i, sColNm2)+"' && "+sColNm3+" == '"+objOrg.getColumn(i, sColNm3)+"' && "+sColNm4+" == '"+objOrg.getColumn(i, sColNm4)+"'");
				}
			}
			
			for( var k = 0; k < objOrg.colcount-1 ; k++ ){ 

				if( this.bfn_i_chkNull(objOrg.getColumn(i, k)) != this.bfn_i_chkNull(objMod.getColumn(0, k)) ){
				    
				    // ds_limitAmt dataset BLC_AMT 잔액항목 제외 (주야간보호 잔액항목 다를수 있음)
				    if( objOrg.getColID(k) != "BLC_AMT" ){
						////trace(k+" org : "+objOrg.getColumn(i, k)+", mod : "+objMod.getColumn(0, k)+", columnName :"+objOrg.getColID(k)+", modObj.count ::"+objMod.rowcount);
						////trace(sColNm1+" == '"+objOrg.getColumn(i, sColNm1)+"' && "+sColNm2+" == '"+objOrg.getColumn(i, sColNm2)+"' && "+sColNm3+" == '"+objOrg.getColumn(i, sColNm3)+"' && "+sColNm4+" == '"+objOrg.getColumn(i, sColNm4)+"'");

						bFlag = true;
						objMod.filter("");
						break;
					}
				}
			}
			objMod.filter("");
		}
	}
	return bFlag;
}

