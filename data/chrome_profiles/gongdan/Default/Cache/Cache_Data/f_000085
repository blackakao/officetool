	 this.fv_sMmExcepAmt = Number(this.fv_sOtherMmExcepAmt) + Number(nSguDd15ExcsAmt) + Number(nFhoUtilAmt) + Number(nHltMgmtSvcUtilAmtTot);
	
	//월한도미포함금액이 0>크면 원래대로 보여줄것(2016-05-04) 
	if( this.fv_sMmExcepAmt==0){
	
		 this.fv_sAdptAmt = this.fv_sOrgAdptAmt;
		// 승인금액이 월한도액 보다 크면 승인금액을 월한도액으로 보정(2016.04.29 민성훈 대리 지시)
		if( Number(this.fv_sAdptAmt) > this.fv_sLimitAmt) {
			 this.fv_sAdptAmt = this.fv_sLimitAmt;
		}	
	}else{
		 this.fv_sAdptAmt = this.fv_sOrgAdptAmt;
	}
	
	//초과금액 계산
	if( ( Number(this.fv_sMmTotAmt)-Number(this.fv_sMmExcepAmt)) >= Number(this.fv_sLimitAmt)){
		 this.fv_sExcsCost = ( Number(this.fv_sMmTotAmt)-Number(this.fv_sMmExcepAmt)) - Number(this.fv_sLimitAmt);	//초과금액 = 타기관포함 월금액 - 월한도 미포함금액 - 한도액
	}else{
		 this.fv_sExcsCost = 0;
	}

	// ★ 기초대상자 기간동안의 이용금액으로 승인금액 초과계산(2016.05.18_민성훈대리 요청)
	if( Number(this.fv_sBaseAmt) > Number(this.fv_sAdptAmt)){
		 this.fv_sAdptExcsAmt = ( Number(this.fv_sBaseAmt) - Number(this.fv_sAdptAmt));	//승인초과금액 = 월금액 - 승인금액
	}else{
		 this.fv_sAdptExcsAmt = 0;
	}
	
	//trace("6084 this.ds_limitAmt.setColumn ADPT_EXCS_AMT");
	
	this.ds_limitAmt.setColumn(0,'MM_FREQ',sUtilFreq);										//이용횟수	
	this.ds_limitAmt.setColumn(0,'TOT_AMT',sMmUtilAmt);										//월총액
	this.ds_limitAmt.setColumn(0,'MM_TOT_AMT',this.fv_sMmTotAmt);							//타기관포함 월금액
	this.ds_limitAmt.setColumn(0,'EXCS_COST',this.fv_sExcsCost);							//초과금액
	this.ds_limitAmt.setColumn(0,'ADPT_EXCS_AMT',this.fv_sAdptExcsAmt);						//승인초과금액
	this.ds_limitAmt.setColumn(0,'PCT_ACTION_UTIL_FREQ',nPctActionFreq);					//인지활동횟수
	this.ds_limitAmt.setColumn(0,'TOT_PCT_ACTION_UTIL_FREQ',this.fv_sTotPctActUtilFreq);	//타기관포함 인지활동횟수
	this.ds_limitAmt.setColumn(0,'MM_EXCEP_AMT',this.fv_sMmExcepAmt); 						//월한도 미포함
	this.ds_limitAmt.setColumn(0,'MM_LMT_AMT',this.fv_sLimitAmt);							//월한도액
	this.ds_limitAmt.setColumn(0,'ADPT_AMT', this.fv_sAdptAmt);								//승인금액
	this.ds_limitAmt.setColumn(0,'BASE_AMT',this.fv_sBaseAmt);								//기초기간동안의 월금액
};

