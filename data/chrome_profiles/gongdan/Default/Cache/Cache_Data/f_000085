/*------------------------------------------------------------------------------------------------*
 * 급여해지 그리드 클릭시 해지정보 데이터셋 세팅
 *------------------------------------------------------------------------------------------------*/
pForm.bfn_i_setDsCtrCncl = function(sChk, nCol,o){
	
	var pThis = o;
	var sDtChk;
	var nCnt = 0;
	var sLtcpOffrToTm;
	var sLtcpOffrToTmMax='';
	
	var sYyyymm = pThis.cmb_ctrYm.value;
	var sDate = sYyyymm + this.bfn_i_addZero(nCol);
	
	var sCtrFrDt = pThis.ds_objtr.getColumn(0,'CTR_FR_DT');
	
	var sCtrToDt = "";
	var sCtrToTm = "";
	
	/* 통합재가급여추가. 20190409 이승진. */
	if(pThis.fv_sLtcpClsfcCd=='001' || pThis.fv_sLtcpClsfcDetailItemCd=='001') {
	    sCtrToDt = pThis.ds_cnclInfo.getColumn(0,'CTR_TO_DT');//pThis
	    sCtrToTm = pThis.ds_cnclInfo.getColumn(0,'CTR_TO_TM');//pThis
	}
	else {
	    sCtrToDt = this.ds_cnclInfo.getColumn(0,'CTR_TO_DT');//pThis
	    sCtrToTm = this.ds_cnclInfo.getColumn(0,'CTR_TO_TM');//pThis
	}
	
	//계약기간 체크
	if(sDate < sCtrFrDt || sDate > sCtrToDt){
		return false;
	}
		
	if(sChk == '1'){
		pThis.fv_sCnclYn = 'Y';
		//중복선택 불가
		for(var i=1;  i<=pThis.fv_sLastDate; i++){
			if(i!=nCol){
				 this.ds_paymtCncl.setColumn(0,'CNCL_YN'+i,'0');
				 this.ds_paymtCncl.setColumn(0,'LTCP_OFFR_TO_TM'+i,'');
			}
		}
		
		//해지시간 세팅
		nCnt = 0;
		for(var i=0;  i<this.ds_paymtDypr.rowcount; i++){
			
			 sDtChk = this.ds_paymtDypr.getColumn(i,'DT'+nCol);
			
			if(sDtChk == '1'){
			
				 sLtcpOffrToTm = this.ds_paymtDypr.getColumn(i,'LTCP_OFFR_TO_TM');
				
				if(nCnt==0){
					sLtcpOffrToTmMax = sLtcpOffrToTm;
					nCnt++;
				}else{
					if(sLtcpOffrToTmMax < sLtcpOffrToTm){ 
						sLtcpOffrToTmMax = sLtcpOffrToTm;
					}
				}
			}
		}
		
		
		if(this.bfn_i_chkNull(sLtcpOffrToTmMax)==''){
			sLtcpOffrToTmMax = '2400';
		}
		
		//지난일정 존재여부 체크
		if(!this.bfn_i_chkUpdYn(nCol, sDate, sLtcpOffrToTmMax)){
			 this.ds_paymtCncl.setColumn(0,'CNCL_YN'+nCol,0);
			return false;
		}
		
		//이미 해지한 경우 해지시간을 세팅
		if(Number(sDate) == Number(sCtrToDt)){
			sLtcpOffrToTmMax = sCtrToTm;
		}
		
		 this.ds_paymtCncl.setColumn(0,'LTCP_OFFR_TO_TM'+nCol, sLtcpOffrToTmMax);
		
		//해지정보 세팅
		 sCtrToDt = pThis.cmb_ctrYm.value + this.bfn_i_addZero(nCol);
		
		 pThis.ds_ctrCncl.setColumn(0,'LTCP_CTR_NO',pThis.cmb_obj.value);
		 pThis.ds_ctrCncl.setColumn(0,'CNCL_YN','Y');
		 pThis.ds_ctrCncl.setColumn(0,'CTR_TO_DT',sCtrToDt);
		 pThis.ds_ctrCncl.setColumn(0,'LTCP_OFFR_TO_TM', sLtcpOffrToTmMax);
		 pThis.ds_ctrCncl.setColumn(0,'LTC_MGMT_NO', pThis.ds_objtr.getColumn(0, "LTC_MGMT_NO"));
		 pThis.ds_ctrCncl.setColumn(0,'LTCP_OFFR_YYYYMM', pThis.fv_sLtcpOffrYyyymm);
		
	}else{
		 pThis.fv_sCnclYn = 'N';
