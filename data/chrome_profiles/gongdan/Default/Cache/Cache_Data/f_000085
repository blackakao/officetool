 * 삭제가능여부 체크(지나간 일정 중 하나라도 방문일정이 있으면 삭제불가)
 *-----------------------------------------------------------------------------------*/
function bfn_i_setPaymtDyprDelYn(){

	var sChkYn;
	var sLtcpOffrDt;
	var sLtcpOffrFrTm;
	var sLastDate = this.fv_sLastDate;
	var sYm = String(this.fv_sToday).substr(0,6);
	var sCtrYm = this.cmb_ctrYm.value;
	var sNowTime = this.bfn_i_getTime();
	
	if(sCtrYm == sYm){
		sLastDate = String(this.fv_sToday).substr(6);
	}
	
	for(var i=0; i<this.ds_paymtDypr.rowcount; i++){
		
		for(var j=1; j<=Number(sLastDate); j++){
			
			sChkYn = this.ds_paymtDypr.getColumn(i,'DT'+j);
			sLtcpOffrFrTm = this.ds_paymtDypr.getColumn(i,'LTCP_OFFR_FR_TM');
			sLtcpOffrDt = sCtrYm + this.bfn_i_addZero(j);
			
			if(Number(sLtcpOffrDt) < Number(sLastDate)){
				if(sChkYn=='1'){
					this.ds_paymtDypr.setColumn(i,'DEL_YN','N');
				}
			}else if(sLtcpOffrDt==sLastDate){	
				if(sChkYn=='1' && Number(sNowTime) >= Number(sLtcpOffrFrTm)){
					this.ds_paymtDypr.setColumn(i,'DEL_YN','N');
				}
			}
		}
	}
}

