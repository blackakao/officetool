	}
	
	//급여제공일련번호가 없는 경우
	if( this.bfn_i_chkNull(this.fv_sLtcpOffrSeqNo)==''){
		this.fv_sLtcpOffrSeqNo = this.bfn_i_getLtcpOffrSeqNoMax();
	}
	
	//월한도 관련 전역변수 세팅
	if( this.ds_limitAmt.rowcount > 0){
				
		this.fv_sLimitAmt = Number(this.ds_limitAmt.getColumn(0,'MM_LMT_AMT'));								//월한도액
		this.fv_sLtcpSusDt = Number(this.ds_limitAmt.getColumn(0,'LTCP_SUS_DT'));								//지급소멸일
		this.fv_sAdptAmt = Number(this.ds_limitAmt.getColumn(0,'ADPT_AMT'));									//승인금액
		this.fv_sExcsYn = this.ds_limitAmt.getColumn(0,'EXCS_YN');														//초과여부
		this.fv_sExcsCost = Number(this.ds_limitAmt.getColumn(0,'EXCS_COST'));								//초과비용
		this.fv_sMmFreq = Number(this.ds_limitAmt.getColumn(0,'MM_FREQ'));									//이용횟수
		this.fv_sTotAmt = Number(this.ds_limitAmt.getColumn(0,'TOT_AMT'));									//월총액
		this.fv_sOthorMmAmt = Number(this.ds_limitAmt.getColumn(0,'OTHOR_MM_AMT'));							//타기관 월금액
		this.fv_sMmTotAmt = Number(this.ds_limitAmt.getColumn(0,'MM_TOT_AMT'));								//타기관포함 월금액
		this.fv_sPctActUtilFreq = Number(this.ds_limitAmt.getColumn(0,'PCT_ACTION_UTIL_FREQ'));				//인지활동이용횟수
		this.fv_sOtherPctActUtilFreq = Number(this.ds_limitAmt.getColumn(0,'OTHER_PCT_ACTION_UTIL_FREQ'));	//인지활동이용횟수(타기관)		 this.fv_sTotPctActUtilFreq") = Number(pThis.ds_limitAmt").getColumn(0,'TOT_PCT_ACTION_UTIL_FREQ'));		//인지활동이용횟수(타기관포함)
		this.fv_sHltMgmtSvcUtilFreq = Number(this.ds_limitAmt.getColumn(0,'HLT_MGMT_SVC_UTIL_FREQ'));			//건강관리서비스이용횟수
		this.fv_sHltMgmtSvcUtilAmt = Number(this.ds_limitAmt.getColumn(0,'HLT_MGMT_SVC_UTIL_AMT')); 			//건강관리서비스이용금액
		this.fv_sMmExcepAmt = Number(this.ds_limitAmt.getColumn(0,'MM_EXCEP_AMT')); 							//월한도 미포함
		
		/* ★ 기초대상자의 월이용금액- 승인금액 초과계산용(2016.05.18_민성훈대리 요청) */
		this.fv_sBaseAmt = Number(this.ds_limitAmt.getColumn(0,'BASE_AMT')); 									//기초대상자의 월이용금액

		/* 지급소멸일이 있는 경우 */
		if( Number(this.fv_sLtcpOffrYyyymm) >= Number(this.fv_sNtfcAdptYm) && ( this.bfn_i_chkNull(this.fv_sLtcpSusDt) != '' && Number(this.fv_sLtcpSusDt) > 0)){
			
			this.fv_sLimitAmt = Number(this.fv_sLimitAmt) - (( Number(this.fv_sLtcpSusDt)-1) * 5000);			//일 5000원씩 산정하여 한도액에서 제외
			this.ds_limitAmt.setColumn(0,'MM_LMT_AMT',this.fv_sLimitAmt);
		}
		
		/* 승인초과금액 세팅 */
		//this.fv_sAdptExcsAmt = 0;
		
		/* ★ 기초대상자 기간동안의 이용금액으로 승인금액 초과계산(2016.05.18_민성훈대리 요청)
		if(Number(fv_sAdptAmt) > 0){	
			if(Number(fv_sTotAmt) > Number(fv_sAdptAmt)){
				fv_sAdptExcsAmt = Number(fv_sTotAmt) - Number(fv_sAdptAmt);
			}
		}
		*/
		if( Number(this.fv_sAdptAmt) > 0){	
			if( Number(this.fv_sBaseAmt) > Number(this.fv_sAdptAmt)){
				this.fv_sAdptExcsAmt = Number(this.fv_sBaseAmt) - Number(this.fv_sAdptAmt);
			}
		}
		
		//trace("this.ds_limitAmt.setColumn ADPT_EXCS_AMT");
		this.ds_limitAmt.setColumn(0,'ADPT_EXCS_AMT',this.fv_sAdptExcsAmt);
		
		/* 초과금액 세팅 */
		if((Number(this.fv_sMmTotAmt) - Number(this.fv_sMmExcepAmt)) >= Number(this.fv_sLimitAmt)){
			this.fv_sExcsCost = Number(this.fv_sMmTotAmt) - Number(this.fv_sLimitAmt) - Number(this.fv_sMmExcepAmt);	//초과금액 = 타기관포함 월금액 - 한도액 - 월한도미포함금액
			this.fv_sExcsYn = 'Y';
		}else{
			this.fv_sExcsCost = 0;
			this.fv_sExcsYn = 'N';
		}
		
		this.ds_limitAmt.setColumn(0,'EXCS_YN',this.fv_sExcsYn);			//초과여부 세팅
		this.ds_limitAmt.setColumn(0,'EXCS_COST',this.fv_sExcsCost);		//초과금액 세팅
	}
};

