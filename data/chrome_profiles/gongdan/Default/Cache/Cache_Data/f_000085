/*-----------------------------------------------------------------------------------*
 * 그리드 CELL 정렬
 *-----------------------------------------------------------------------------------*/
pForm.bfn_i_gridSort = function(obj, e, sHeadTwoRow) 
{
	var sAscMark = "▼";
	var sDescMark = "▲";
	var ds = obj.getBindDataset();
	
	//현재 sort Mark
	var clickedHeadText = obj.getCellProperty("head", e.cell, "text");
	var currentMark = String(clickedHeadText).substr(clickedHeadText.length-1);
	var sortClass = (currentMark == sAscMark ? "-" : "+" );
	var newMark = (currentMark == sAscMark ? sDescMark : sAscMark );
	
	//현재 컬럼명 취득
	var columnName = "";
	// 2개의 Merge Cell인경우
	if (this.bfn_i_chkNull(obj.getCellProperty("body", e.col, "text")) == "") {
		columnName = obj.getCellProperty("body", e.col + 1, "text").replace("bind:","");
	} else {
		// 헤드Row가 2개인경우
		if (sHeadTwoRow == "2") {
			columnName = obj.getCellProperty("body", e.cell, "text").replace("bind:","");
		} else {
			columnName = obj.getCellProperty("body", e.col, "text").replace("bind:","");
		}
	}
	
	//header sort marker 제거
	for (var i = 0; i < obj.getCellCount("head"); i++) {
		var headText = obj.getCellProperty("head", i, "text");
		if (this.bfn_i_chkNull(headText)!="") {
			obj.setCellProperty("head", i, "text", headText.replace(sAscMark,"").replace(sDescMark,""));
		}
	}	
	
	// sort marker 설정
	obj.setCellProperty("head", e.cell, "text", clickedHeadText.replace(sAscMark,"").replace(sDescMark,"") + newMark);
	
	// sort 
	ds.set_keystring("S:" + sortClass + columnName);
	// focus first row
	ds.set_rowposition(0);
};

/*-----------------------------------------------------------------------------------*
 * 날짜유효성체크(날짜를 텍스트로 입력받는 경우 날짜 형식에 맞는지 유효성 체크)
 *-----------------------------------------------------------------------------------*/
pForm.bfn_i_validDate = function(sChkDate, sStr) 
{
	var sDate = sChkDate + '';
	var nLen = sDate.length;
	
	if(nLen != 6 && nLen != 8){
	
		//{0}형식 이어야 합니다. {1}
		this.gfn_msgShow(this, "XWTZ0031",[sStr + "는 날짜","\n\n다시 확인해주십시오."]);
		return false;
		
	}else if(nLen == 6){
	
		if(String(sDate).substr(0,1)=='0'){
			sDate = '20' + sDate;
		}else{
			sDate = '19' + sDate;
		}
	}
	
	var sLastDate = this.gfn_lastDateNum(sDate);
	
	var sMm = String(sDate).substr(4,2);
	var sDd = String(sDate).substr(6);
	
	if(Number(sMm)<=0 || Number(sMm)>12){
		
		//{0}형식 이어야 합니다. {1}
		this.gfn_msgShow(this, "XWTZ0031",[sStr + "는 날짜","\n\n다시 확인해주십시오."]);
		return false;
		
	}else if(Number(sDd)<=0 || Number(sDd)>Number(sLastDate)){
		
		//{0}형식 이어야 합니다. {1}
		this.gfn_msgShow(this, "XWTZ0031",[sStr + "는 날짜","\n\n다시 확인해주십시오."]);
		return false;
	}
	
	return true;
};

