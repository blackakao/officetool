/*---------------------------------------------------------------------------------------
 * 2013 청구공통 -> 공휴일 색깔표시
 * 작성자 : 2013 청구 개발자 김명주
 * 작성일 : 2015.08.20
 * @param : dsObj       공휴일이 표시되어있는 Dataset
            grdObj      색깔을 표시할 Grid
            skipColCnt  일자가 나오기 전까지 skip할 컬럼개수
 *--------------------------------------------------------------------------------------*/
pForm.bfn_setHoliday = function( dsObj, grdObj, skipColCnt )
{
        if ( dsObj == null || grdObj == null ) {
        trace("Dataset Or Grid is Null");
        return false;
    }

    if ( dsObj.rowcount == 0 ) {
        trace("Dataset Rowcount is 0");
        return false;
    }

    if ( skipColCnt == null ) {
        skipColCnt = 0;
    }

    // 급여내용 그리드에 날짜 초기화 - 기본 31일
    for ( var ix = 0; ix < 31; ix++ ) {
        grdObj.setCellProperty("Head", ( skipColCnt + ix ), "text", "");
    }

    // 급여내용 그리드에 날짜 토/일 표시
    for ( var ix = 0; ix < dsObj.rowcount; ix++ ) {

        grdObj.setCellProperty("Head", ( skipColCnt + ix ), "text", dsObj.getColumn(ix, "DT_NM"));

        if ( dsObj.getColumn(ix, "HOL_DT_YN") == "Y" ) {
            grdObj.setCellProperty("Head", ( skipColCnt - 1 + toNumber(dsObj.getColumn(ix, "DT_NM")) ), "color", "red");
        } else if ( dsObj.getColumn(ix, "HOL_DT_YN") == "S" ) {
            grdObj.setCellProperty("Head", ( skipColCnt - 1 + toNumber(dsObj.getColumn(ix, "DT_NM")) ), "color", "blue");
        } else {
            grdObj.setCellProperty("Head", ( skipColCnt - 1 + toNumber(dsObj.getColumn(ix, "DT_NM")) ), "color", "black");
        }
    }

    //alert( dsObj.rowcount );

    if ( dsObj.rowcount == 28 ) {

        grdObj.setFormatColProperty(skipColCnt+30, "size", 0);
        grdObj.setFormatColProperty(skipColCnt+31, "size", 0);
        grdObj.setFormatColProperty(skipColCnt+32, "size", 0);

    } else if ( dsObj.rowcount == 29 ) {

        grdObj.setFormatColProperty(skipColCnt+31, "size", 0);
        grdObj.setFormatColProperty(skipColCnt+32, "size", 0);

    } else if ( dsObj.rowcount == 30 ) {

        grdObj.setFormatColProperty(skipColCnt+32, "size", 0);
    }
};

/*---------------------------------------------------------------------------------------
 * 데이터셋에서 유일(Unique)값 건수 조회
 * 작성자 : 김영진
 * 작성일 : 2015.10.19
 * @param : orgDs       해당 데이터셋
            sColNm      검색 속성명
 * @retun : 건수
 *--------------------------------------------------------------------------------------*/
pForm.bfn_getUniqueCnt = function( orgDs, sName )
{
    var objDs = new Dataset();
    var nRow;

    //this.parent.addChild("tempDs"+orgDs.name, objDs);
    objDs.addColumn(sName, "string");

    for(var i=0;i<orgDs.getRowCount();i++) {
        if(objDs.findRow(sName, orgDs.getColumn(i, sName)) >= 0) continue;
        nRow = objDs.addRow();
        objDs.copyRow(nRow, orgDs, i, sName + "=" + sName);
    }

    var cnt = objDs.rowcount;

    return cnt;
};

/*---------------------------------------------------------------------------------------
 * 시간, 일자 포맷 지정
 * 작성자 : 김영진
 * 작성일 : 2015.11.12
 * @param : sValue      시간(4자리) 또는 일자(8자리)
            sType       'T':시간포맷지정, 'D':날짜포맷지정
 * @retun : string
 *--------------------------------------------------------------------------------------*/
pForm.bfn_setFormatDateTime = function( oValue )
{
    if (oValue == null || oValue == undefined) return "";

    var sValue = new String(oValue);
    var sReturn;
    var sDateTime = sValue.toString();

    if (sDateTime.length == 8){
        sReturn = sDateTime.substr(0,4)+"-"+sDateTime.substr(4,2)+"-"+sDateTime.substr(6,2);
    }else if (sDateTime.length == 4){
        sReturn = sDateTime.substr(0,2)+":"+sDateTime.substr(2,4);
    }

    return sReturn;
};

