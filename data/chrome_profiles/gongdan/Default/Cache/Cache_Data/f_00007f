/**
 * @class Date와 format를 받아서 해당 format의 String문자로 날짜 반환
 * @param {date} dt - Date
 * @param {String} psFormat - Format유형
 * @return {String} 변형된 날짜 String
 */
pForm.dfn_getDateFormatString = function(psFormat){
    return this.dfn_toFormatString(new Date(), psFormat);
};
pForm.dfn_toFormatString = function(dt, psFormat)
{
    var sDate = psFormat.replace(/(%Y|%y|%m|%d|%H|%h|%M|%S|%f|%am|%pm)/g,
        function ($1) {
            switch ($1) {
                case "%Y" : return dt.getFullYear().toString().padLeft(4,"0");
                case "%y" : return dt.getFullYear().toString().substr(2).padLeft(2,"0");
                case "%m" : return (dt.getMonth()+1).toString().padLeft(2,"0");
                case "%d" : return dt.getDate().toString().padLeft(2,"0");
                case "%H" : return dt.getHours().toString().padLeft(2,"0");
                case "%h" : return ((h = dt.getHours() % 12 ) ? h : 12).toString().padLeft(2,"0");
                case "%M" : return dt.getMinutes().toString().padLeft(2,"0");
                case "%S" : return dt.getSeconds().toString().padLeft(2,"0");
                case "%f" : return dt.getMilliseconds().toString(); //
                case "%am" :    return dt.getHours() < 12 ? "am" : "pm";
                case "%pm" :    return dt.getHours() < 12 ? "am" : "pm";
            }
        });

    return sDate;
};

