         case  56: //nuber 8
            try{fHotKeyCtrl_8();}catch(Ex){}; //예비
            //event.keyCode = 0;
            event.cancelBubble = true;
            event.returnValue = false;
            break;

         case  57: //nuber 9
            this.dfn_initLog();

            try{fHotKeyCtrl_9();}catch(Ex){}; //예비
            //event.keyCode = 0;
            event.cancelBubble = true;
            event.returnValue = false;
            break;

         default:
            //don't care
            break;
        }//end of switch
    }
};

/**
 * @class Date와 format를 받아서 해당 format의 String문자로 날짜 반환
 * @param {date} poFrDate - Date  시작시각
 * @param {date} poToDate - Date  종료시각
 * @return {String} 두 시각의 차 String
 */
pForm.dfn_timeDiffFormatString = function(poFrDate, poToDate)
{
    var nTotalDiff = poToDate.getTime() - poFrDate.getTime();
    var millseconds = (nTotalDiff % 1000 );
    var seconds = Math.floor(nTotalDiff / 1000 );
    var minutes = Math.floor(nTotalDiff / 1000 / 60);
    var hours   = Math.floor(nTotalDiff / 1000 / 60 / 60);

    var timeDiff = hours.toString().padLeft(2, "0") +":"+ minutes.toString().padLeft(2, "0") +":"+ seconds.toString().padLeft(2, "0") +" " +millseconds.toString();

    return timeDiff;

};
