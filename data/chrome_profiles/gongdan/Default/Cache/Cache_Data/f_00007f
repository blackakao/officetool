/*---------------------------------------------------------------------------------------
 * bfn_moveObject 임의의 컴포넌트 위치를 기준대상의 상하좌우 방향으로 이동합니다.
   poBasic  object    기준   콤포넌트
   poMove   object    이동할 콤포넌트
   piOffset integer   콤포넌트간 유격
   psDirect string    이동방향(상하좌우)
 * 작성자 : 이건진
 * 작성일 : 2018.10.17 수
 * 사용예
  bfn_moveObject(btn_dtstAutoCre, btn_dtstUnitSpcfDescReg, 2, "좌");
  bfn_moveObjectLeft(btn_dtstAutoCre, btn_dtstUnitSpcfDescReg, 2);
 *--------------------------------------------------------------------------------------*/
pForm.bfn_moveObject = function(poBasic, poMove, piOffset, psDirect)
{
    if(this.gfn_isNull(piOffset)){ piOffset = 2; }
    if(this.gfn_isNull(psDirect)){ psDirect = "우"; }

    var iBasicPosition =0;  //기준위치
    var width = poMove.getOffsetWidth();        //이동대상의 폭
    var height = poMove.getOffsetHeight();      //이동대상의 높이

    if(psDirect == "상"){
        iBasicPosition = poBasic.getOffsetTop()   -piOffset;
        poMove.move(poMove.left, iBasicPosition - height);
    }else
    if(psDirect == "하"){
        //iBasicPosition = poBasic.getOffsetBottom()+piOffset;
        iBasicPosition = poBasic.getOffsetTop()+poBasic.getOffsetHeight()+piOffset;
        poMove.move(poMove.left, iBasicPosition);   // + height);
    }else
    if(psDirect == "좌"){
        iBasicPosition = poBasic.getOffsetLeft()  -piOffset;
        poMove.move(iBasicPosition - width, poMove.top);
    }else
    if(psDirect == "우"){
        iBasicPosition = poBasic.getOffsetRight() +piOffset;
        //poMove.move(iBasicPosition + width, poMove.top);
        poMove.move(iBasicPosition , poMove.top);
    }

    return poMove;
};
pForm.bfn_moveObjectUp = function(poBasic, poMove, piOffset)
{
    return this.bfn_moveObject(poBasic, poMove, piOffset, "상");
};
pForm.bfn_moveObjectDown = function(poBasic, poMove, piOffset)
{
    return this.bfn_moveObject(poBasic, poMove, piOffset, "하");
};
pForm.bfn_moveObjectLeft = function(poBasic, poMove, piOffset)
{
    return this.bfn_moveObject(poBasic, poMove, piOffset, "좌");
};
pForm.bfn_moveObjectRight = function(poBasic, poMove, piOffset)
{
    return this.bfn_moveObject(poBasic, poMove, piOffset, "우");
};
/*---------------------------------------------------------------------------------------
 * 특정컴포넌트를 this form의 중앙으로 이동합니다.
   poBasic  form    기준   콤포넌트
   poMove   object    이동할 콤포넌트
 * 작성자 : 이건진
 * 작성일 : 2018.11.8 목
 * 주의 사항 : 첫번째 param이 this(form)가 아니면 문제가 될것임.
 * 사용예
            bfn_moveObjectCenter(this, this.div_rfid);
 *--------------------------------------------------------------------------------------*/
/*
 * 2018.11.8 목/Yi Geon-Jin
 */
pForm.bfn_moveObjectCenter = function(poBasic, poMove)
{
    if(poBasic.getOffsetWidth() < poMove.getOffsetWidth()) return;
    if(poBasic.getOffsetHeight() < poMove.getOffsetHeight()) return;


    var iPosLeft          = (poBasic.getOffsetWidth() - poMove.getOffsetWidth())/2
    var iPosTop           = (poBasic.getOffsetHeight() - poMove.getOffsetHeight())/2
    poMove.move(iPosLeft, iPosTop);
};

