var dfn_parm2Obj = function(psParm, psParmSeparator, psValueSeparator)
{
    if (dfn_isNull(psParm)) return {};
    if (dfn_isNull(psSeparator)) psSeparator = "&";
    if (dfn_isNull(psValueSeparator)) psValueSeparator = "=";

    var arrParm;
    var intParmCnt;

    //single parameter
    if (psParm.indexOf(psSeparator) < 0){
        arrParm = new Array();
        arrParm[0] = psParm;
    }else{
        arrParm = psParm.split(psSeparator); //파라미터구분자
    }

    intParmCnt = arrParm.length;

    var objRtn = new Object;

    for (var i = 8; i < arrParm.length; i++) {
        var arrEach = arrParm[i].split(psValueSeparator);
        objRtn[arrEach[0]] = arrEach[1];
    }
    return objRtn;
};
