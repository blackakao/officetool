/**---------------------------------------------------------------------------------------
 * 상위폼의 자원(변수, 객체..등)을 현재 폼으로 복사합니다.
 * 작성자 : 이건진
 * 작성일 : 2018.11.01
 * @param : form     poThis     : 호출하는 자신(this)
 * @param : string   psPrefix   : 복사를 원하는 변수(객체)의 시작 문자
 * @retun :
 * @exercise :
 *       this.bfn_getParentVar(this);       //상위폼의 "fv_"로 시작하는 변수를 현재폼으로 복사
 *       this.bfn_getParentVar(this, "str");//상위폼의 "str"로 시작하는 변수를 현재폼으로 복사
 *--------------------------------------------------------------------------------------*/
pForm.bfn_getParentVar = function(poThis, psPrefix){
    var frmParent = poThis.parent.parent;
    if(psPrefix === undefined || psPrefix === "" || psPrefix === null) psPrefix = "fv_";
    psPrefix = psPrefix.trim();
    if(psPrefix === "ALL") psPrefix = "";
    for (var p in frmParent)
    {
        if (frmParent.hasOwnProperty(p))
        {
            if(p.indexOf(psPrefix) === 0){
                poThis[p] = frmParent[p];
            }
        }
    }
};

/**---------------------------------------------------------------------------------------
 * 찾고자 하는 자원(변수, 객체..등)을 소유한 상위폼을 찾아서 반환합니다.
 * 작성자 : 이건진
 * 작성일 : 2018.11.01
 * @param : form     poParentForm   : 호출하는 자신의 상위폼(this.parent)
 * @param : string   psFind         : 찾고자 하는 변수(객체)의 이름
 * @param : number   piDegree       : 찾기를 시도 할 차수(default=5)
 * @retun : form     poParentForm   : 찾고자 하는 변수(객체) 소유한 상위 폼
 * @exercise :
 *       this.bfn_findParent(this.parent, "ds_dmdDtstDtl");//ds_dmdDtstDtl을 소유한 상위폼을 찾는다.
 *--------------------------------------------------------------------------------------*/
pForm.bfn_findParent = function(poParentForm, psFind, piDegree){
    if(psFind === undefined || psFind === "" || psFind === null) return null;
    if(piDegree === undefined || piDegree === "" || piDegree === null) piDegree = 5; //기본 차수, 5번까지만 시도합니다.

    for (var p in poParentForm)
    {
        if (poParentForm.hasOwnProperty(p))
        {
            if(p.indexOf(psFind) === 0){
                return poParentForm;
            }
        }
    }
    piDegree--; //찾기 회 수 삭감
    if(piDegree == 0) return null;  //10번까지만 시도합니다.
    this.bfn_findParent(poParentForm.parent, psFind, piDegree);
};

