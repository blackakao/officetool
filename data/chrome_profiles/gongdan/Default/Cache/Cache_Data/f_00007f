pForm._frTimeLapse4Debug;        //debug용/ 경과시간 시작시각 //:) 추가//2019.1.16 수/Yi Geon-Jin
pForm._toTimeLapse4Debug;        //debug용/ 경과시간 종료시각 //:) 추가//2019.1.16 수/Yi Geon-Jin
/**
 * 경과시간 계산 시작
 */
pForm.dfn_timeLapseStart = function(psMsg)
{
    this._frTimeLapse4Debug = new Date();        //경과시간 시작시각
    if(dfn_isNotNull(psMsg) ) this.dfn_setLogS(psMsg);
    return this._frTimeLapse4Debug;
};
/**
 * 경과시간 계산 종료
 */
pForm.dfn_timeLapseEnd = function(psMsg, psOption)
{
    this._toTimeLapse4Debug = new Date();        //경과시간 종료시각
    if(dfn_isNotNull(psMsg) ) this.dfn_setLogE(psMsg);
    if(psOption === "setTimeLapseLog"){
        this.dfn_setLog(this.dfn_getTimeLapseString("경과시간"), "CrLf2");
    }else
    if(psOption === "setTimeLapseLog;initTime"){
        this.dfn_setLog(this.dfn_getTimeLapseString("경과시간", "initTime:yes"), "CrLf2");
    }
    return this._toTimeLapse4Debug;
};
/**
 * 경과시간을 계산하여 반환
 * @parm {String} psHeadTitle   - 제목
 * @parm {String} psOption      - 옵션
 * @return {String} 두 시각의 차 String
 */
pForm.dfn_getTimeLapseString = function(psHeadTitle, psOption)
{
    var rtnVal = this.dfn_timeDiffFormatString(this._frTimeLapse4Debug, this._toTimeLapse4Debug);
    if(arguments.length === 2){
        rtnVal = psHeadTitle+"="+rtnVal;
    }else
    if(arguments.length === 1 && _dfn_isInitTimeYes(psHeadTitle) ){
      psOption = psHeadTitle;
      psHeadTitle = "";
    }

    if(dfn_isNotNull(psOption) && (_dfn_isInitTimeYes(psOption) )) this.dfn_initTimeLapse();
    return rtnVal;
};
//경과시간 계산용 변수 초기화
pForm.dfn_initTimeLapse = function()
{
    this._frTimeLapse4Debug = null;        //debug용/ 경과시간 시작시각
    this._toTimeLapse4Debug = null;        //debug용/ 경과시간 종료시각
};

