/*---------------------------------------------------------------------------------------
 * bfn_setGdsNpca gds_npca 정보 설정하기
 * 사용예
 include "biz.library::npb_cCommon.xjs";
 bfn_setGdsNpca();
  *--------------------------------------------------------------------------------------*/
pForm.bfn_setGdsNpca = function()
{
    var objApp = nexacro.getApplication();
    var objDate1 = new Date();
    var aGdsNpca = this.bfn_getGdsNpca();
    var sTodayYyyy = this.gfn_today().substr(0,4);
    var sTodayMm = this.gfn_today().substr(4,2);
    var sOffrYyyy = "";
    var sOffrMm = "";

    if(objApp.gds_npca.rowcount > 0){
        var sLtcpOffrYyyymm = aGdsNpca.ltcpOffrYyyymm;  // 급여제공월
        var sLtcpClsfcCd    = aGdsNpca.ltcpClsfcCd;     // 급여종별
        var sLtcpDmdTypeCd  = aGdsNpca.ltcpDmdTypeCd;   // 청구구분
        var sDmdMdmTypeCd  = aGdsNpca.dmdMdmTypeCd;   // 청구구분

        if(this.cfn_str_isNull(sLtcpOffrYyyymm)){
            if(this.cfn_str_isNull(this.fv_sLtcpOffrYyyymm))
            {
                this.fv_sLtcpOffrYyyymm = this.gfn_toFormatString(objDate1, "%Y%m");
            }

            objApp.gds_npca.setColumn(0, "LTCP_OFFR_YYYYMM", this.fv_sLtcpOffrYyyymm);
            objApp.gds_npca.setColumn(0, "OFFR_FR_DT", this.fv_sLtcpOffrYyyymm+"01");                   //:) 추가//2018.11.9 토/Yi Geon-Jin
            objApp.gds_npca.setColumn(0, "OFFR_TO_DT", this.gfn_getLastDate(this.fv_sLtcpOffrYyyymm));  //:) 추가//2018.11.9 토/Yi Geon-Jin
        }else{
            if(this.cfn_str_isNull(this.fv_sLtcpOffrYyyymm)){
                if(this.parent.parent.fv_sLtcpOffrYyyymm && !this.cfn_str_isNull(this.parent.parent.fv_sLtcpOffrYyyymm)){
                    this.fv_sLtcpOffrYyyymm = this.parent.parent.fv_sLtcpOffrYyyymm;//:)추가/2018.11.08 목/Yi Geon-Jin
                }else
                this.fv_sLtcpOffrYyyymm = this.gfn_toFormatString(objDate1, "%Y%m");
            }

            if(!this.cfn_str_isNull(this.fv_sLtcpOffrYyyymm) && this.fv_sLtcpOffrYyyymm != sLtcpOffrYyyymm){
                objApp.gds_npca.setColumn(0, "LTCP_OFFR_YYYYMM", this.fv_sLtcpOffrYyyymm);
                objApp.gds_npca.setColumn(0, "OFFR_FR_DT", this.fv_sLtcpOffrYyyymm+"01");                   //:) 추가//2018.11.9 토/Yi Geon-Jin
                objApp.gds_npca.setColumn(0, "OFFR_TO_DT", this.gfn_getLastDate(this.fv_sLtcpOffrYyyymm));  //:) 추가//2018.11.9 토/Yi Geon-Jin
            }
        }

        sOffrYyyy = objApp.gds_npca.getColumn(0, "LTCP_OFFR_YYYYMM").substr(0,4);
        sOffrMm = objApp.gds_npca.getColumn(0, "LTCP_OFFR_YYYYMM").substr(4,2);

        if(parseInt(sTodayYyyy) - parseInt(sOffrYyyy) < 3) {
            objApp.gds_npca.setColumn(0, "BILL_EXPIRE_YN", "N");
        } else if(parseInt(sTodayYyyy) - parseInt(sOffrYyyy) == 3) {
            if(parseInt(sTodayMm) > parseInt(sOffrMm))
                objApp.gds_npca.setColumn(0, "BILL_EXPIRE_YN", "Y");
            else
                objApp.gds_npca.setColumn(0, "BILL_EXPIRE_YN", "N");
        } else {
            objApp.gds_npca.setColumn(0, "BILL_EXPIRE_YN", "Y");
        }

        if(this.cfn_str_isNull(sLtcpClsfcCd)){
            objApp.gds_npca.setColumn(0, "LTCP_CLSFC_CD", this.fv_sLtcpClsfcCd);
        }else{

            if(!this.cfn_str_isNull(this.fv_sLtcpClsfcCd) && this.fv_sLtcpClsfcCd != sLtcpClsfcCd){
                objApp.gds_npca.setColumn(0, "LTCP_CLSFC_CD", this.fv_sLtcpClsfcCd);
            }
        }

        if(this.cfn_str_isNull(sLtcpDmdTypeCd)){
            objApp.gds_npca.setColumn(0, "LTCP_DMD_TYPE_CD", this.fv_sLtcpDmdTypeCd);
        }else{
            if(!this.cfn_str_isNull(this.fv_sLtcpDmdTypeCd) && this.fv_sLtcpDmdTypeCd != sLtcpDmdTypeCd){
                objApp.gds_npca.setColumn(0, "LTCP_DMD_TYPE_CD", this.fv_sLtcpDmdTypeCd);
            }
        }

        if(this.cfn_str_isNull(sDmdMdmTypeCd)){
            objApp.gds_npca.setColumn(0, "DMD_MDM_TYPE_CD", this.fv_sDmdMdmTypeCd);
        }else{
            if(!this.cfn_str_isNull(this.fv_sDmdMdmTypeCd) && this.fv_sDmdMdmTypeCd != sDmdMdmTypeCd){
                objApp.gds_npca.setColumn(0, "DMD_MDM_TYPE_CD", this.fv_sDmdMdmTypeCd);
            }
        }

    }else{

        this.fv_sLtcpOffrYyyymm = this.gfn_toFormatString(objDate1, "%Y%m");

        var nRow = objApp.gds_npca.addRow();

        objApp.gds_npca.setColumn(nRow, "LTCP_OFFR_YYYYMM", this.fv_sLtcpOffrYyyymm);
        objApp.gds_npca.setColumn(nRow, "LTCP_CLSFC_CD"   , this.fv_sLtcpClsfcCd);
        objApp.gds_npca.setColumn(nRow, "LTCP_DMD_TYPE_CD", this.fv_sLtcpDmdTypeCd);
        objApp.gds_npca.setColumn(nRow, "ADMIN_SYM"       , objApp.gds_userInfo.getColumn(0, "ADMIN_SYM"));
        objApp.gds_npca.setColumn(nRow, "ADMIN_PTTN_CD"   , objApp.gds_userInfo.getColumn(0, "ADMIN_PTTN_CD"));
    }
};


