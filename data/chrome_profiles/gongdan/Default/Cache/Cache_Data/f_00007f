/*--------------------------------------------------------*
 * 문자8자리 날짜 -> 날짜구분자포맷 적용
 * ex) bfn_convDateStrFormat("20140101","/") -> 2014/01/01
 *--------------------------------------------------------*/
pForm.bfn_convDateStrFormat = function(sDate, sFormat)
{
    if(!this.cfn_str_isNull(sDate)) {
        if(sDate.length == 8)
            return sDate.substr(0, 4)+sFormat+sDate.substr(4, 2)+sFormat+sDate.substr(6, 2);
        else
            return sDate.substr(0, 4)+sFormat+sDate.substr(4, 2);
    } else
        return "";
};

/**---------------------------------------------------------------------
* 기능 : 입력된 숫자(문자,숫자)를 금액형태로 표기하는 함수
* 인수 : nNumber : 문자열로 출력할 실수
*        nDetail : 출력시 소숫점 이하의 자릿수(Default : 0)
         nCrncy  : 통화표기단위, (원, 백만원)
* return : 문자열로 바뀐 실수
*          출력되는 실수는 정수부분에 3자리마다 ',' 가 삽입됩니다.
----------------------------------------------------------------------*/
pForm.bfn_convCurrency = function(sNumber, nDetail, nCrncy)
{
    var sStr;
    var nNumber ;

    if (this.gfn_isEmpty(sNumber)) return "";

    if (typeof(sNumber) != 'string')
        nNumber = parseInt(String(sNumber));
    else
        nNumber = parseInt(sNumber);

    if (this.gfn_isEmpty(nDetail) || nDetail==0)  nDetail = 1;
    if (this.gfn_isEmpty(nCrncy))  nCrncy = "";

    if (nDetail == 1){
        //sStr = nNumber.toFixedLocaleString(nDetail);  //toFixedLocaleString ==> gfn_appendComma로 변경
        sStr = this.gfn_appendComma(nNumber, nDetail);
        if(sStr.indexOf() >= 0)
        sStr = sStr.substr(0, sStr.indexOf("."));
    }else{
        //sStr = nNumber.toFixedLocaleString(nDetail);
        sStr = this.gfn_appendComma(nNumber, nDetail);
    }

    sStr = sStr+""+nCrncy;

    return sStr;
};

/**---------------------------------------------------------------------
* 기능 : 입력된 숫자(문자,숫자)를 금액형태로 표기하는 함수
* 인수 : nNumber : 문자열로 출력할 실수
*        nDetail : 출력시 소숫점 이하의 자릿수(Default : 0)
         nCrncy  : 통화표기단위, (원, 백만원)
* return : 문자열로 바뀐 실수
*          출력되는 실수는 정수부분에 3자리마다 ',' 가 삽입됩니다.
----------------------------------------------------------------------*/
pForm.bfn_scoreFormat = function(sNumber, nDetail)
{
    var sStr;
    var nNumber ;

    if (this.gfn_isEmpty(sNumber)) return "";

    if (typeof(sNumber) != 'string')
        nNumber = parseFloat(String(sNumber));
    else
        nNumber = parseFloat(sNumber);

    if (this.gfn_isEmpty(nDetail) || nDetail==0)  nDetail = 1;

    //sStr = nNumber.toFixedLocaleString(nDetail);
    sStr = this.gfn_appendComma(nNumber, nDetail, true);

    return sStr;
};

