        /*------------------------------------------------------------------------------------------------*
         * 일간 일정을 클릭했을때 호출해야할 외부 함수를 설정한다.
         *------------------------------------------------------------------------------------------------*/
        this.fn_setDaily = function(oFunction)
        {
            if (this.parent.parent.parent.parent.name == "npfa101m01"){
