        /*------------------------------------------------------------------------------------------------*
         * 특정날짜에 해당하는 달력 그리드의 셀을 선택한다.
         *------------------------------------------------------------------------------------------------*/
        this.fn_setCellPosition = function(sDate) {
        	var firstDateOfMonth = new Date(sDate.substr(0,4), new Number(sDate.substr(4,2))-1, 1);
        	var week = Math.ceil((parseInt(sDate.substr(6,2))+firstDateOfMonth.getDay())/7);

        	this.ds_calendar.set_rowposition(week-1);
        	this.grd_calendar.setCellPos(this.gfn_getDay(sDate));
        };

        /*------------------------------------------------------------------------------------------------*
         * 특정날짜에 대한 휴일 정보를 가져온다.
         *------------------------------------------------------------------------------------------------*/
        this.fn_getHoliday = function(sDate) {
        	return this.ds_holiday.getColumn(this.ds_holiday.findRow("DE", sDate), "RMK");
        };

        /*------------------------------------------------------------------------------------------------*
         * 특정날짜에 대한 음력 정보를 가져온다.
         *------------------------------------------------------------------------------------------------*/
        this.fn_getLunar = function(sDate) {
        // 	var lunar = Solar2Lunar(sDate); // TODO: 음력 얻어오는 함수 구현되면 해당 함수를 사용하도록 변경 해야 한다.
        // 	if(lunnar) return "(" + parseInt(lunar.substr(5,2)) + "," + parseInt(lunar.substr(7,2)) + ")";
        // 	else return "";
        };

        /*------------------------------------------------------------------------------------------------*
         * 특정날짜를 기준으로 해당 월에 대한 일정 달력을 생성한다.
         *------------------------------------------------------------------------------------------------*/
        this.fn_drawCalendar = function(sDate,oNoteDataset,sNoteDateColumnNm,sNoteColumnNm) {
        	var date = "";
        	if (sDate == 'undefined') {
        		date = this.fv_today;
        	} else {
        		date = sDate || this.fv_today;
        	}

        	var startDay = this.gfn_getDay(date.substr(0,6)+"01");
        	var lastDate = this.gfn_lastDateNum(date.substr(0,6)+"01");

        	if (this.fv_monthlyFunction) this.fv_monthlyFunction(date.substr(0,6));
        	this.ds_calendar.date = date;
        	this.ds_calendar.noteDataset = oNoteDataset || this.ds_calendar.noteDataset;
        	this.ds_calendar.noteDateColNm = sNoteDateColumnNm || this.ds_calendar.noteDateColNm;
        	this.ds_calendar.noteColNm = sNoteColumnNm || this.ds_calendar.noteColNm;

        	// 년월 표시 설정
        	this.stc_yearMonth.set_text(date.substr(0, 4) + "년 " + parseInt(date.substr(4,2)) + "월");

        	// Dataset 만들기
        	this.ds_calendar.clearData();
        	var row = this.ds_calendar.addRow();
        	var day = startDay;
        	for(var i = 1; i <= lastDate ; i++ )
        	{
        		// 달력 Data설정
        		this.ds_calendar.setColumn(row, "day"+day, i);
        		var curDate = date.substr(0, 6) + this.gfn_lPad(i,"0", 2);

        		// 휴일 및 음력설정
        		var holiday = this.fn_getHoliday(curDate);
        		var lunar = i%10 == 1 ? this.fn_getLunar(curDate) : "";
        		if(holiday) this.ds_calendar.setColumn(row, "hol"+day, holiday);
        		else this.ds_calendar.setColumn(row, "hol"+day, lunar);

        		/*********************************************/
        		if (this.ds_calendar.noteDataset && this.ds_calendar.noteDateColNm && this.ds_calendar.noteColNm) {
        			var foundRows = this.bfn_findRows(this.ds_calendar.noteDataset, this.ds_calendar.noteDateColNm, curDate, 0);
        			for (var j=0; j < foundRows.length; j++) {
        				var temp = this.ds_calendar.getColumn(row, "note"+day);
        				var noteString = (temp ? temp + "\n" : "") + this.ds_calendar.noteDataset.getColumn(foundRows[j], this.ds_calendar.noteColNm);
        				this.ds_calendar.setColumn(row, "note"+day, noteString);
        			}
        		}
        		/*********************************************/

        		// 달력 Data Row추가
        		day = (day+1)%7;
        		if( day == 0 && i != lastDate ) row = this.ds_calendar.addRow();
        	}

        	// Cell Position 이동 및 해당 일자 함수 호출
        	//fn_setCellPosition(date);
        	//if (fv_dailyFunction) fv_dailyFunction(date);

        	// Cell Position 이동 및 해당 일자 함수 호출

        	if (date.length == 6) {//yyyymm일 경우 일자를 1일로
        		date = date+"01";
        	}

        	this.fn_setCellPosition(date);

        	//if (fv_dailyFunction) fv_dailyFunction(date);

        //  	var firstDateOfMonth = new Date(sDate.substr(0,4), new Number(sDate.substr(4,2))-1, 1);
        //  	var week = Math.ceil((parseInt(sDate.substr(6,2))+firstDateOfMonth.getDay())/7);
        //  	ds_calendar.rowposition = week-1;
        //  	grd_calendar.setCellPos(UtilDate.getDay(sDate));
        };

        /*------------------------------------------------------------------------------------------------*
         * 달력 그리드의 셀 백그라운드 설정을 위해 expr에서 호출하는 함수
         *------------------------------------------------------------------------------------------------*/
        this.fn_setCellBackground = function(nRow,nCol) {
        	var date = this.fn_getDate(nRow, nCol);
        	if (this.fv_today == date) return this.TODAY_BACKGROUND_COLOR;
        	else return this.NORMAL_BACKGROUND_COLOR;
        };

        /*------------------------------------------------------------------------------------------------*
         * 달력 그리드의 셀 폰트 컬러 설정을 위해 expr에서 호출하는 함수
         *------------------------------------------------------------------------------------------------*/
        this.fn_setCellColor = function(nRow,nCol) {
        	var date = this.fn_getDate(nRow, nCol);
        	if (this.fv_today == date) {
        		if (this.fn_getHoliday(date)) {
        			return "bgfont_cbdee7ef5b3e";
        		} else {
        			return "bgfont_cbdee72e3641";
        		}
        	} else {
        		return "bgfont_f7f9f92e3641";
        	}
        };

        /*------------------------------------------------------------------------------------------------*
         * 달력 그리드의 특정위치에 대한 날짜를 반환한다.
         *------------------------------------------------------------------------------------------------*/
        this.fn_getDate = function(nRow,nCol) {
        	var day = "";
        	if ( this.gfn_isEmpty(this.ds_calendar.getColumn(nRow, nCol)) ) {
        		return "";
        	} else {
        		day = this.gfn_lPad(this.ds_calendar.getColumn(nRow, nCol),"0", 2);
        		return this.ds_calendar.date.substr(0,6) + day;
        	}
        };

