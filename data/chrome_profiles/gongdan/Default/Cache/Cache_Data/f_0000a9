        this.fn_createMenuDs = function ()
        {
        	var objApp = nexacro.getApplication();
        	this.ds_allMenu.copyData(objApp.gds_allMenu);
        	this.ds_allMenu.addColumn( "menu_rootId", "string" );
        	//top메뉴 생성
        	var sFilterstr = "MENU_LEVEL == '0'";
        	this.ds_allMenu.filter(sFilterstr);
        	this.ds_topMenu.copyData(this.ds_allMenu, true);
        	this.ds_allMenu.filter("");
        	//top sub메뉴 생성
        	var nCnt = this.ds_allMenu.getRowCount();
        	var sMenuLevel, sTopMenu, sMenuId, sMenuNm;
        	for ( i=0; i<nCnt; i++) {
        		sMenuLevel = this.ds_allMenu.getColumn(i,  objApp.av_aMenuColumns.menuLevel);

         		//sMenuNm = this.ds_allMenu.getColumn(i,  "MENU_NM");
         		sMenuId = this.ds_allMenu.getColumn(i,  "MENU_ID");

        		if ( sMenuLevel == "0" ) {
        			sTopMenu = this.ds_allMenu.getColumn(i,  objApp.av_aMenuColumns.menuId);
        			//this.ds_allMenu.setColumn(i, "menu_rootId", sTopMenu);
        			this.ds_allMenu.setColumn(i, objApp.av_aMenuColumns.menuLevel, "-1");
        		} else {
        //trace("sTopMenu==="+sTopMenu+":::::sMenuLevel==="+sMenuLevel+":::::sMenuId==="+sMenuId+":::::sMenuNm==="+sMenuNm);
        			this.ds_allMenu.setColumn(i, "menu_rootId", sTopMenu);
        			var nLvl = nexacro.toNumber(this.ds_allMenu.getColumn(i, objApp.av_aMenuColumns.menuLevel));
        			this.ds_allMenu.setColumn(i,objApp.av_aMenuColumns.menuLevel, nLvl - 1);
        // 			if ( sMenuId == "NPA02010100" || sMenuId == "NPA02010400" || sMenuId == "NPA02010200" ) {
        // 				this.ds_allMenu.setColumn(i,objApp.av_aMenuColumns.menuLevel, nLvl - 2);
        // 			} else {
        // 				this.ds_allMenu.setColumn(i,objApp.av_aMenuColumns.menuLevel, nLvl - 1);
        // 			}
        		}
        	}
        	var sFilterstr = "MENU_LEVEL != '-1'";
        	this.ds_allMenu.filter(sFilterstr);
        	this.ds_subMenu.copyData(this.ds_allMenu, true);
        }

