        	}

        	this.ds_cond.setColumn(0, "USER_TYPE", sUserAuth);
        	AdminSym = objApp.gds_userInfo.getColumn(0,"LTC_ADMIN_SYM");
        	trace(AdminSym);
        	var sTrId 			= "menuSelect";
