        //사이트맵 메뉴 생성
        this.fn_setAllMenuDiv = function()
        {
        	// nLeft는 10, 320, 1040 3단으로 구성
        	var nLeft 			= 10;
        	var nTop 			= 10;
        	var nWidth			= 338;
        	var nHeight			= 200;
        	var nHGap 			= 10;
        	var nVGap			= 10;
        	var nDan			= 4;
        	var nHeadHeight     = 24;
        	var nRowHeight  	= 24;
        	var nBorderWidth 	= 2; // 1*2

        	var nBottom 		= 210;	//nTop + nVGap
        	var nRowcount		= 0;

        	for(i=0; i<this.ds_topMenu.rowcount; i++){
        		//left 초기화
        		if(i%nDan == 0){
        			nLeft 	= nHGap;
        		}

        //trace("row==="+i+"::::nDan==="+nDan+"::::nLeft==="+nLeft+"::::nTop==="+nTop);
        		oDsSubMenu = new Dataset();
        //trace("this.ds_topMenu.getColumn MENU_ID ==="+this.ds_topMenu.getColumn(i,"MENU_ID"));
        		oDsSubMenu.set_name("_ds_" + this.ds_topMenu.getColumn(i,"MENU_ID"));
        		this.addChild(oDsSubMenu.name, oDsSubMenu);

        		var sFilterstr = "menu_rootId == '" + this.ds_topMenu.getColumn(i,"MENU_ID") + "'";

        		this.ds_allMenu.filter(sFilterstr);
        		oDsSubMenu.copyData(this.ds_allMenu,true);
        		this.ds_allMenu.filter("");

        		var nRowcount = oDsSubMenu.rowcount;
        		//oSubmenuDiv.setOffsetHeight((nRowcount * nRowHeight) + nBorderWidth) ;	//Div높이 조정
        		nHeight = ((nRowcount * nRowHeight) + nHeadHeight + nBorderWidth) ;	//Div높이 조정
        		var oSubmenuDiv = new Div("div_menu_" + this.ds_topMenu.getColumn(i,"MENU_ID"), nLeft, nTop, nWidth, nHeight);
        		oSubmenuDiv._submenuds = oDsSubMenu;
        		oSubmenuDiv._submenutitle = this.ds_topMenu.getColumn(i,"MENU_NM");
        		this.pdiv_allMenu.form.addChild(oSubmenuDiv.name, oSubmenuDiv);

        		//oSubmenuDiv.scrollbars	= "none";
        		oSubmenuDiv.set_url("frame_main::subMenuDiv.xfdl");
        		//oSubmenuDiv.set_background 	= "#ffffff";
        		//oSubmenuDiv.set_border("0 none #808080ff");
        		oSubmenuDiv.show();

        		if(i >= nDan){
        			oPrevDiv = eval("this.pdiv_allMenu.form.div_menu_" + this.ds_topMenu.getColumn(i-nDan,"MENU_ID"));
        			nBottom = oPrevDiv.getOffsetBottom();
        			nTop    = nBottom + nVGap;
        			oSubmenuDiv.move( nLeft, nTop);
        		}

        		nLeft += nWidth + nHGap;
        	}
        	this.pdiv_allMenu.form.resetScroll();
        };


        /*--------------------------------------------------------------------------------------*
         * 메뉴로 화면열기
         *--------------------------------------------------------------------------------------*/
        this.fn_menuOpen = function (sMenuId,objArg)
        {
        	var objApp = nexacro.getApplication();
        	var bRltvLink = false;	//화면 재오픈여부
        	if( this.gfn_isNull(sMenuId) ) return;
        	if( this.gfn_isNull(objArg) ) {
        		objArg = [];
        	} else {
        		bRltvLink = true;
        	}

        	var objDs = this.ds_allMenu;		//전체메뉴(초기화때 복사된)

        	var nTargetRow = objDs.findRow(objApp.av_aMenuColumns.menuId , sMenuId);
            //--------------------------------------------------------------------------------:) 여기서부터/개발자용 추가/2018.10.21 일/Yi Geon-Jin
            if(objApp.av_sSvrType == "NEXACRO")
            if(nTargetRow < 0){
                var sMsg = "■ 개발자용 메세지\n\n해당 메뉴ID를 찾을 수 없습니다.\n\nMenuId : "+sMenuId+"\n\n"+this.name+".fn_menuOpen()";
                trace(sMsg);
                alert(sMsg);
                return;
            }
            //--------------------------------------------------------------------------------:) 여기까지 /개발자용 추가/2018.10.21 일/Yi Geon-Jin
        	var sUrl = objDs.getColumn(nTargetRow, objApp.av_aMenuColumns.menuUrl);
        	if( this.gfn_isNull(sUrl) ){
                //--------------------------------------------------------------------------------:) 여기서부터/개발자용 추가/2018.10.21 일/Yi Geon-Jin
                if(objApp.av_sSvrType == "NEXACRO"){
                    var sMsg = "■ 개발자용 메세지\n\n해당 메뉴ID의 URL정보가 비어있습니다.\n\nMenuId : "+sMenuId+"\n\n"+this.name+".fn_menuOpen()";
                    trace(sMsg);
                    alert(sMsg);
                }
                //--------------------------------------------------------------------------------:) 여기까지 /개발자용 추가/2018.10.21 일/Yi Geon-Jin
                return;
            }
            //trace("sUrl=["+sUrl+"],"+sUrl.toString().length);
        	//화면 open여부 확인
        	if ( bRltvLink == true ) {
        		var objApp = nexacro.getApplication();
        		var objTargetChild, objTargetForm;
        		var sChildFrameId, sMdiOutYn;

        		sChildFrameId = objApp.gds_openMenu.lookup("screen_menuId", sMenuId, "screen_id");
        		sMdiOutYn     = objApp.gds_openMenu.getColumn("screen_menuId", sMenuId, "screen_out");

        		if (sMdiOutYn == "Y") {
        			objTargetChild = nexacro.getPopupFrames(objApp.mainframe)[sChildFrameId];
        		} else {
        			objTargetChild = objApp.av_oWorkFrame.frames[sChildFrameId];
        		}
        		//존재하는 화면 닫기
        		if (objTargetChild) {
        			objApp.av_sCloseAll == "Y";

        			objTargetForm = objTargetChild.form;
        			objTargetForm.setFocus();
        			objTargetForm.cfn_close();

        			objApp.av_sCloseAll == "N";
        		}

        		//신규화면 열기
        		this.fv_sRltvLinkArg = {
        								ds    : objDs,  			// 메뉴 dataset
        								nRow  : nTargetRow,      	// 선택된 row
        								oArgs : objArg       		// 넘길 argument
        							   };
        		this.setTimer(3,200);
        	} else {
        		var oObj = {
        			ds    : objDs,  			// 메뉴 dataset
        			nRow  : nTargetRow,      	// 선택된 row
        			oArgs : objArg       		// 넘길 argument
        		};
        		//trace("objArg==="+objArg);
        		this.gfn_call(oObj);
        	}
        };


