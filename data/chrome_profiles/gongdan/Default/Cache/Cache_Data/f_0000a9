        this.fn_setTopMenu = function()
        {
        	var objApp = nexacro.getApplication();
        	//전체 설정
        	this.fn_setApplication();

        	// 운영환경/통테환경하에서 현재 접속 환경 정보를 제거
        	if(objApp.av_sSvrType == "PROD") {
        		this.sta_serviceType.set_visible(false);
        	} else {
        		if(objApp.av_sSvrType == "NEXACRO") {
        			this.sta_serviceType.set_text("개발도구");
        			this.sta_serviceType.set_visible(true);
        		} else if (objApp.av_sSvrType == "LOCAL") {
        			this.sta_serviceType.set_text("로컬환경");
        			this.sta_serviceType.set_visible(true);
        		} else if (objApp.av_sSvrType == "DEV") {
        			this.sta_serviceType.set_text("개발환경");
        			this.sta_serviceType.set_visible(true);
        		} else if (objApp.av_sSvrType == "TEST") {
        			this.sta_serviceType.text = "통테환경";
        			this.sta_serviceType.set_visible(true);
        		}
        	}

        	//사용자명(ID) 셋팅
        	if(objApp.gds_userInfo.getColumn(0,"USER_TYPE") == "20L") {	//급여제공기관 종사자
        		this.sta_userInfo.set_text(objApp.gds_userInfo.getColumn(0,"USER_NM")+" ["+objApp.gds_userInfo.getColumn(0,"ADMIN_SYM")+"]" + " - " + objApp.gds_userInfo.getColumn(0,"EGGR_NM"));
        	} else {
        		this.sta_userInfo.set_text(objApp.gds_userInfo.getColumn(0,"USER_NM")+" ["+objApp.gds_userInfo.getColumn(0,"NM_ID")+"]");
        	}

        	//gloval 변수 설정
        	objApp.gv_today = this.bfn_getUserInfo().today; 	// 현재 DB날짜
        };


