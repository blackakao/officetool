        this.fn_setTraffic = function(nTraffic)
        {
        	if(nTraffic <= 33) {
        		this.sta_traffic1.set_visible(true);

        		this.sta_traffic2.set_visible(false);
        		this.sta_traffic2d.set_visible(true);

        		this.sta_traffic3.set_visible(false);
        		this.sta_traffic3d.set_visible(true);

        	} else if (nTraffic > 34 && nTraffic <= 78) {
        		this.sta_traffic1.set_visible(true);

        		this.sta_traffic2.set_visible(true);
        		this.sta_traffic2d.set_visible(false);

        		this.sta_traffic3.set_visible(false);
        		this.sta_traffic3d.set_visible(true);
        	} else if (nTraffic > 79) {
        		this.sta_traffic1.set_visible(true);

        		this.sta_traffic2.set_visible(true);
        		this.sta_traffic2d.set_visible(false);

        		this.sta_traffic3.set_visible(true);
        		this.sta_traffic3d.set_visible(false);
        	} else {
        		this.sta_traffic1.set_visible(true);

        		this.sta_traffic2.set_visible(false);
        		this.sta_traffic2d.set_visible(true);

        		this.sta_traffic3.set_visible(false);
        		this.sta_traffic3d.set_visible(true);
