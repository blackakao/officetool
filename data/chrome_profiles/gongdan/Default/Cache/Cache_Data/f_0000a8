        /*--------------------------------------------------------------------------------------*
         * 전체 닫기 실행
         *--------------------------------------------------------------------------------------*/
        this.fn_allClose = function()
        {
        	var objApp = nexacro.getApplication();
        	var objTargetChild, objTargetForm;
        	var sChildFrameId, sMdiOutYn;
        	var nBizCount = objApp.gds_openMenu.getRowCount();
        	//TabPage, 열린화면 ds삭제는 여기서 실행
        	objApp.av_sCloseAll = "Y";

        	// 화면 종료 여부 확인
        	for (var i=nBizCount-1; i>=0; i--) {
        		sChildFrameId = objApp.gds_openMenu.getColumn(i, "screen_id");
        		sMdiOutYn     = objApp.gds_openMenu.getColumn(i, "screen_out");

        		if (sMdiOutYn == "Y") {
        			objTargetChild = nexacro.getPopupFrames(objApp.mainframe)[sChildFrameId];
        		} else {
        			objTargetChild = objApp.av_oWorkFrame.frames[sChildFrameId];
        		}

        		if (!objTargetChild) {
        			continue;
        		}

        		objTargetForm = objTargetChild.form._workFrm;

        		if ((objTargetForm != undefined) && (objTargetForm["fn_beforeClose"] != undefined)) {
        			var rtn = objTargetForm.fn_beforeClose();
        			if (rtn == "cancel") {
        				objApp.av_sCloseAll = "N";
        				return false;
        			}
        		}
        	}

        	// 업무화면 종료
        	for (var i=nBizCount; i>=0; i--) {
        		sChildFrameId = objApp.gds_openMenu.getColumn(i, "screen_id");
        		sMdiOutYn     = objApp.gds_openMenu.getColumn(i, "screen_out");
        		if (sMdiOutYn == "Y") {
        			objTargetChild = nexacro.getPopupFrames(objApp.mainframe)[sChildFrameId];
        		} else {
        			objTargetChild = objApp.av_oWorkFrame.frames[sChildFrameId];
        		}

        		if (!objTargetChild) {
        			continue;
        		}
        		objTargetForm = objTargetChild.form;
        		objTargetForm.setFocus();
        		objTargetForm.cfn_close();
        	}

        	if ( objApp.av_oWorkFrame.all.length == 0 ) {
        		// TabPage 삭제
        		var nTabpageCount = this.tab_mdi1.getTabpageCount();
        		for (var i=nTabpageCount-1; i>=0; i--) {
        			this.tab_mdi1.removeTabpage(i);
        		}

        		//열린화면 ds 삭제
        		objApp.gds_openMenu.clearData();

        		objApp.afn_viewIntro(true);
        	}
        	objApp.av_sCloseAll = "N";
        };



