         *--------------------------------------------------------------------------------------*/
        this.fn_activeChildFrame = function(obj,nTabIndex)
        {
        //trace("fn_activeChildFrame  nTabIndex==="+nTabIndex);
        	var objApp = nexacro.getApplication();
        	var objPostTabpage = obj.tabpages[nTabIndex];
        	if (!objPostTabpage) return;

        	var sChildFrameId = objPostTabpage.name;
        // 	var sPageFlag = objApp.gds_openMenu.lookup("screen_id", sChildFrameId,"screen_out");
        // 	var objChildFrame;
        // 	if ( sPageFlag == "Y" ) {
        // 		objChildFrame = nexacro.getPopupFrames[sChildFrameId];
        // 	} else {
        // 		objChildFrame = objApp.av_oWorkFrame.frames[sChildFrameId];
        // 	}
        	var objChildFrame = objApp.av_oWorkFrame.frames[sChildFrameId];

        	if (objChildFrame) {
        		//최소화 상태일때 이전상태로로 변경
        		var sOpenstatus = objChildFrame.openstatus;
        		var sPreOpenStatus = objChildFrame.form.fv_sPreOpenStatus;
        		if ((sOpenstatus == "minimize") && (sPreOpenStatus == "normal")) {
        			objChildFrame.titlebar.normalbutton.click();
        		} else if ((sOpenstatus == "minimize") && (sPreOpenStatus == "maximize")) {
        			objChildFrame.titlebar.maxbutton.click();
        		}

        	} else {
        		objChildFrame = nexacro.getPopupFrames(objApp.mainframe)[sChildFrameId];
        		objChildFrame.setFocus();
        	}
        };

