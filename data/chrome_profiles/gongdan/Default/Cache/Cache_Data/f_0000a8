        //trace("frameBottom_ontimer>>>>>>>>>>>>>>>>>>>>");
        	var objApp = nexacro.getApplication();
        	var nTimerID = e.timerid;
        	switch (nTimerID) {

        		// 선택된 화면 focus주기
        		case 1001 :
        			obj.killTimer(nTimerID);
        			var objTabpage = this.tab_mdi1.tabpages[this.tab_mdi1.tabindex];
        			if (!objTabpage) return;
        			var sChildFrameId = objTabpage.name;

        			if (objApp.av_oWorkFrame.frames[sChildFrameId]) {
        				objApp.av_oWorkFrame.frames[sChildFrameId].setFocus();
        			} else if (nexacro.getPopupFrames(objApp.mainframe)[sChildFrameId]) {
        				nexacro.getPopupFrames(objApp.mainframe)[sChildFrameId].setFocus();
        			}
        			break;
        	}
        };

