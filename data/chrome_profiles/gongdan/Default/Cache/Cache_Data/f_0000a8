         *--------------------------------------------------------------------------------------*/
        this.fn_syncTabpage = function(sChildFrameId) {
        //trace("fn_syncTabpage>>>>>>>>>>sChildFrameId : "+sChildFrameId);
        	var objTargetMenuTab;
        	var objApp = nexacro.getApplication();
        	var nRowPos = objApp.gds_openMenu.findRow("screen_id", sChildFrameId);
        	if (nRowPos < 0) return;

        	var nStop = this.tab_mdi1.tabpages.length;
        	for (var i=0; i<nStop; i++) {
        	//trace("fn_syncTabpage>>>>>>>>>> tabpages name : "+this.tab_mdi1.tabpages[i].name);
        		if (this.tab_mdi1.tabpages[i].name == sChildFrameId) {
        			this.tab_mdi1.set_tabindex(i);
        			break;
        		}
        	}
        };

        /*--------------------------------------------------------------------------------------*
