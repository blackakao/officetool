	function fn_xecure_timeDifference()
	{
		if(AnySignNexaParam.SIDTIMEOUT == -1) return;
		
		if(!nexacro.anysign.lastdate) {
			nexacro.anysign.lastdate = new Date();
			return;
		}
		
		var earlierDate = nexacro.anysign.lastdate;
		
		var laterDate = new Date();
		var nTotalDiff = laterDate.getTime() - earlierDate.getTime();
		var minutes = Math.floor(nTotalDiff / 1000 / 60);

		if(minutes >= AnySignNexaParam.SIDTIMEOUT) {
			AnySignNexaParam.SID = null;
		}
		nexacro.anysign.lastdate = laterDate;
		laterDate = null;
	}

