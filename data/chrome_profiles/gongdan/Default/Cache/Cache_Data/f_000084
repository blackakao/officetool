    _pAnySignAdp.encrypt = function(url, data, _anySign) {
		fn_xecure_timeDifference();
		
		if (!AnySign || (!AnySign.mAnySignLoad && AnySign.mAnySignEnable)) {
			this.cancelTran(_anySign, - 1, "AnySign Not Found");
			return false;
		}
		if(AnySignNexaParam.INIT == false) nxInitForm_SignDataCMS();
		if(AnySignNexaParam.INITSID == true) AnySignNexaParam.SID = null;

		var pThis = this;
		function getSIDCallBack(aResult,uid) {
			if(aResult != null && aResult != "" ) {
				AnySignNexaParam.SID = escape(aResult);		// escape_url 함수변경
				pThis.encryptData(url, data, _anySign);
			} else {
				pThis.cancelTran(_anySign,-1,"AnySign SID Error :" + aResult + "\nXGateAddress:" + AnySignNexaParam.XGATE_ADDR);
				return;
			}
		}
		if (!AnySignNexaParam.SID)	AnySign.BlockEncEx(AnySignNexaParam.XGATE_ADDR , "", "GET", AnySignNexaParam.CHARSET, getSIDCallBack, "");
		else this.encryptData(url, data, _anySign);
	};
	/*----------------------------------------------------------------------------
	// Encrypt Data
	-----------------------------------------------------------------------------*/
	_pAnySignAdp.encryptData = function(url, data, _anySign) {
		var nFind = 0;
		var strEncodingPath;
		if( ( nFind = url.lastIndexOf("/" ) ) >= 0 ) {
			strEncodingPath = url.substr( 0, nFind );
		}
		var sutf8str = "";
		var sdatatype = "XML";
		var bBase64 = false;

		if(_anySign.item.datatype == "0" || _anySign.item.datatype == 0) {
			sutf8str  = "dataType=XML";
		} else if(_anySign.item.datatype == "2" || _anySign.item.datatype == 2) {
			sutf8str  = "dataType=SSV";
			sdatatype = "SSV";
		}
		if(AnySignNexaParam.BASE64 || sdatatype == "SSV") {
			sutf8str += "&nexaData=" + encodeURIComponent(nexacro.base64Encode(data));
			sutf8str += "&base64=Y";
			bBase64 = true;
		} else {
			sutf8str += "&nexaData=" + encodeURIComponent(data);
			sutf8str += "&base64=N";
		}
		var pThis = this;
		function encryptCallBack(aResult,uid) {
			if(!aResult || aResult == "") {
				pThis.cancelTran(_anySign, -1, "AnySign Encrypt Error");
				return false;
			}
			var strEncodeOut = encodeURIComponent(aResult);
			var output = "";
			output  = "p=" + strEncodeOut;
			output += "&q=" + AnySignNexaParam.SID;

			_anySign.item._handle = nexacro.__startCommunication(_anySign.item, _anySign.path, _anySign.cachelevel, _anySign.async, _anySign.referer,
													output, _anySign.ndatatype, _anySign.compress, _anySign.ver, _anySign.failpass, _anySign.service);	
			_anySign = null;
			return;
		}
		
		AnySign.BlockEncEx(strEncodingPath, sutf8str, "POST", AnySignNexaParam.CHARSET, encryptCallBack, "");
	};
	/*----------------------------------------------------------------------------
	// Decrypt
	-----------------------------------------------------------------------------*/
    _pAnySignAdp.decrypt = function (url, data, item, cookie, last_modified) {
		if(!data || data == "") {
			var s = this.getErrorXMLMsg("-1","AnySign Decode error --- data is null");
			item._protocol = 0;	// _pTransactionItem.on_load_data - data.js
			item.originalOn_load_data(s, cookie, last_modified);
			return;
		}
		/*
		// xml인 경우 그냥 넘겨준다.
		// 성능을 위해 처리 안함 - 필요시 주석 제거
		if(data.indexOf("<?xml")>=0 || data.indexOf("SSV:")>=0) 	{
			item._protocol = 0;	// _pTransactionItem.on_load_data - data.js
			item.originalOn_load_data(data, cookie, last_modified);
			return;
		}
		*/

		var start = 0, end = 0, pos = -1;
		var strEncData = "";
		var bError = false;

		// 개행 제거
		data = data.replace(/\s/g,"");

		pos = data.indexOf("<BEGIN_ENC>",0);
		if(pos >= 0) {
			start = pos + 11;
			end = data.indexOf("</END_ENC>",start);
			strEncData = data.substring(start,end);
		}
		if(pos < 0 || strEncData == null || strEncData.length == 0) bError = true;

		if(bError) {
			var s = this.getErrorXMLMsg("-1","AnySign Decode error");
			item._protocol = 0;	// _pTransactionItem.on_load_data - data.js
			item.originalOn_load_data(s, cookie, last_modified);
			return;
		}
		function decryptCallBack(aResult,uid) {
			if(!aResult || aResult == "") {
				var s = pThis.getErrorXMLMsg("-1","AnySign Decode error");
				item._protocol = 0;	// _pTransactionItem.on_load_data - data.js
				item.originalOn_load_data(s, cookie, last_modified);
				return false;
			}
			var output;
			if(item.datatype == "2" || item.datatype == 2 || AnySignNexaParam.BASE64) {
				output = nexacro.base64Decode(aResult);
			} else {
				output = aResult;
			}
			item._protocol = 0;	// _pTransactionItem.on_load_data - data.js
			item.originalOn_load_data(output, cookie, last_modified);
		}
		// 복호화
		AnySign.BlockDec(strEncData , "", decryptCallBack, "");
	};
