	nexacro._originalstartCommunication = nexacro._startCommunication;
	nexacro._startCommunication = function (loadItem, url, cachelevel, async, service, referer, data, ndatatype, compress, ver, failpass) {
        var path = url;
        var senddata = data;
        if (loadItem._protocol < 0) {
            var createadaptor = false;
            var protocoladp = nexacro._getProtocol(loadItem.protocol);
            if (!protocoladp) {
                var isprotocol;
				if(14 == nexacro.Version) { 
					isprotocol = application._isProtocol(loadItem.protocol);
				} else {
					isprotocol = nexacro._isProtocol(loadItem.protocol);
				}
                if (isprotocol) {
                    var adptorclass = nexacro._executeEvalStr(loadItem.protocol);
                    if (adptorclass) {
                        protocoladp = new adptorclass;
                        createadaptor = true;
                    }
                }
            }
			if (protocoladp && (protocoladp._type_name == "AnySignAdp")) {
                if (createadaptor && protocoladp.initialize) {
                    protocoladp.initialize(url);
					if(14 == nexacro.Version) {
						application._addProtocol(loadItem.protocol, protocoladp);
					} else {
						nexacro._addProtocol(loadItem.protocol, protocoladp);
					}
                }
                var protocol = protocoladp.getUsingProtocol(url);
                var sep = path.split("://");
                if (sep) path = protocol + "://" + sep[1];
                if (data && protocoladp.encrypt) {
					if (protocoladp.getCommunicationHeaders) {
						var headers = protocoladp.getCommunicationHeaders(url);
						if (headers)
							loadItem._addCookieFromVariables(headers);
					}
					if(!async) {
						trace("AnySign은 비동기만 지원합니다.");
						protocoladp.cancelTranItem(loadItem,-1,"AnySign은 비동기만 지원합니다.");
						return;
					}
					if(loadItem.datatype != "0" && loadItem.datatype != "2") {
						trace("XML 또는 SSV만 지원합니다.");
						protocoladp.cancelTranItem(loadItem,-1,"XML 또는 SSV만 지원합니다.");
						return;
					}
					var _anySign = {
										"path" 		: path ,
										"cachelevel": cachelevel ,
										"async" 	: async ,
										"referer" 	: referer ,
										"ndatatype" : ndatatype ,
										"compress" 	: compress ,
										"ver" 		: ver ,
										"failpass" 	: failpass ,
										"service" 	: service ,
										"item"		: loadItem
									};
					protocoladp.encrypt(loadItem.path, data, _anySign);
					return;
				}
			}
		}
		nexacro._originalstartCommunication(loadItem, url, cachelevel, async, service, referer, data, ndatatype, compress, ver, failpass);
	};
