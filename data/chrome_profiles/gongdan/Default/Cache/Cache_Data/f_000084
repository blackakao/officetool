	if(AnySign_NEXA_Export === true) {
		/*----------------------------------------------------------------------------
		// Import Descrypt
		-----------------------------------------------------------------------------*/
		var _pExcelImport = nexacro.ExcelImportObject.prototype;
		/*----------------------------------------------------------------------------
		// _pExcelImport Data decrypt
		-----------------------------------------------------------------------------*/
		_pExcelImport.decryptData = function (data,url) {
			if(!data || data == "") {
				var s = fn_getErrorXMLMsg("-1","AnySign Decode error --- data is null");
				return this._uploadCompleteAfter(s,url);
			}
			var start = 0, end = 0, pos = -1;
			var strEncData = "";
			var bError = false;
			
			// 개행 제거
			data = data.replace(/\s/g,"");
			pos = data.indexOf("<BEGIN_ENC>",0);
			if(pos < 0) pos = data.indexOf("<begin_enc>",0);
			if(pos >= 0) {
				start = pos + 11;
				end = data.indexOf("</END_ENC>",start);
				if(end < 0) end = data.indexOf("</end_enc>",0);
				if(end < 0) end = data.indexOf("</begin_enc>",0);
				strEncData = data.substring(start,end);
			}
			if(pos < 0 || strEncData == null || strEncData.length == 0) bError = true;

			if(bError) {
				return this._uploadCompleteAfter(data,url);
			}
			var pThis = this;
			function decryptImportCallBack(aResult,uid) {
				if(!aResult || aResult == "") {
					return pThis._uploadCompleteAfter(data,url);
				}
				var output;
				output = nexacro.base64Decode(aResult);
				return pThis._uploadCompleteAfter(output,url);
			}
			// 복호화
			AnySign.BlockDec(strEncData , "", decryptImportCallBack, "");
		};
		/*----------------------------------------------------------------------------
		// _pExcelImport _uploadComplete 후처리
		-----------------------------------------------------------------------------*/
		_pExcelImport._uploadCompleteAfter = function (data, url) {
			var error_info, evt, fileUrl, code = -1, msg = "", result = null, unique_id = this._unique_id;
			try {
					var fstr = data.substring(0, 3).toUpperCase();
					switch (fstr) {
						case "XML":
							var xmldoc = nexacro._getXMLDocument(this._unique_id, data, url);
							result = nexacro._Deserializer["XML"](xmldoc, this);
							break;
						case "SSV":
							result = nexacro._Deserializer["SSV"](data, this);
							break;
						default:
							break;
					}

					error_info = result ? result[0] : null;

					if (error_info) {
						code = error_info[0];
						msg = error_info[1];
					}

					if (code < 0) {
						evt = new nexacro.ExcelImportErrorEventInfo(this, "onerror", "ObjectError", msg, this, 9901);
						this.on_fire_onerror(this, evt);
					}
					else {
						fileUrl = this._fileurl = this._file_url_ds ? this._file_url_ds.getColumn(0, 3) : null;
						this._file_url_ds = null;
						evt = new nexacro.ExcelImportEventInfo(this, "onsuccess", fileUrl, this);
						this.on_fire_onsuccess(this, evt);
					}
			} catch (e) {
				evt = new nexacro.ExcelImportErrorEventInfo(this, "onerror", "ObjectError", "failed to get", this, 9901);
				this.on_fire_onerror(this, evt);
			}
			nexacro._remove_hidden_item(unique_id, "upfile", this._hidden_frame_handle);
			nexacro._append_hidden_item(unique_id, "upfile", this._checkUploadFile, this, this._hidden_frame_handle);			
		};
		/*----------------------------------------------------------------------------
		// _pExcelImport _uploadComplete 재정의
		-----------------------------------------------------------------------------*/
		_pExcelImport._uploadComplete = function (status, data, url) {
			var error_info, evt, fileUrl, code = -1, msg = "", result = null, unique_id = this._unique_id;
			try {
				if (this._iscors) {
					nexacro._setPostMessage(this._unique_id, this);
					this._iscors = false;
				} else {
					var xmldoc = nexacro._getXMLDocument(unique_id);
					url = xmldoc.URL ? xmldoc.URL : xmldoc.url;
					if (url == "about:blank") {
						return;
					}
					data = nexacro._getDataFromDOM(xmldoc);
					if ((!data || data.length <= 0) && xmldoc.childNodes[0].data) {
						data = xmldoc.childNodes[0].data;
					}
					else {
						data = nexacro.replaceAll(data, "&amp;", "&");
					}

					this.context = this.parent;

					var fstr = data.substring(0, 3).toUpperCase();
					if(fstr == "<SC" || fstr == "<BE") {
						this.decryptData(data,url);
						return;
					}
					this._uploadCompleteAfter(data, url);
				}
			} catch (e) {
				evt = new nexacro.ExcelImportErrorEventInfo(this, "onerror", "ObjectError", "failed to get", this, 9901);
				this.on_fire_onerror(this, evt);
			}
		};
		delete _pExcelImport;
	}
