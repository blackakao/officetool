	nexacro.anysign.encrypt= function(form,data,cbname)
	{
		if (!AnySign || (!AnySign.mAnySignLoad && AnySign.mAnySignEnable)) {
			trace("AnySign 설치가 되지 않았습니다.");
			return false;
		}
		var strEncodingPath;
		var url;
		if(14 == nexacro.Version) {
			url = application.xadl;
		} else {
			url = nexacro.getApplication.xadl;
		}
		var nFind = -1;
		if( ( nFind = url.lastIndexOf("/" ) ) >= 0 ) {
			strEncodingPath = url.substr( 0, nFind );
		}		
		if(AnySignNexaParam.INIT == false) nxInitForm_SignDataCMS();

		nexacro.anysign.robj = form;
		nexacro.anysign.data = data;
		nexacro.anysign.rcbname = cbname;

		if(!AnySignNexaParam.SID) {
			AnySign.BlockEncEx(AnySignNexaParam.XGATE_ADDR , "", "GET", AnySignNexaParam.CHARSET, __nxAnySignSingleBlockSID_Callback,strEncodingPath);
		} else {
			if(!surl) surl = null;
			AnySign.BlockEncEx(surl, nexacro.anysign.data, "POST", AnySignNexaParam.CHARSET, __nxAnySignSingleBlockEnc_Callback, strEncodingPath);
		}
	};
	function __nxAnySignSingleBlockSID_Callback(result,surl)
	{
        if(result != null && result != "" ){
			AnySignNexaParam.SID = escape(result);	// escape_url 함수변경
			if(!surl) surl = null;
			AnySign.BlockEncEx(surl, nexacro.anysign.data, "POST", AnySignNexaParam.CHARSET, __nxAnySignSingleBlockEnc_Callback, surl);
        } else {
			nexacro.anysign.robj = null;
			nexacro.anysign.data = null;
			nexacro.anysign.rcbname = null;			
			trace("AnySign SID Error :" + result + "\nXGateAddress:" + XGATE_ADDR,surl);
        	return;
        }
	};
	function __nxAnySignSingleBlockEnc_Callback(result,surl)
	{
		nexacro.anysign.robj[nexacro.anysign.rcbname](result);
		nexacro.anysign.robj = null;
		nexacro.anysign.data = null;
		nexacro.anysign.rcbname = null;
	};
	//----------------------------------------------------------------------------
	// 필드 복호화
	//----------------------------------------------------------------------------
	nexacro.anysign.decrypt= function(form,data,cbname,surl)
	{
		if (!AnySign || (!AnySign.mAnySignLoad && AnySign.mAnySignEnable))
		{
			trace("AnySign 설치가 되지 않았습니다.");
			return false;
		}

		nexacro.anysign.robj = form;
		nexacro.anysign.data = data;
		nexacro.anysign.rcbname = cbname;

		AnySign.BlockDec(data , "", __nxAnySignSingleBlockDec_Callback,"");
	};
	function __nxAnySignSingleBlockDec_Callback(result,surl)
	{
		nexacro.anysign.robj[nexacro.anysign.rcbname](result);
		nexacro.anysign.robj = null;
		nexacro.anysign.data = null;
		nexacro.anysign.rcbname = null;
	};
